---
---

<div class="shop-subnav-wrapper">
  <!-- 公告橫幅 (可關閉) -->
  <div id="announcement-banner" class="announcement-bar">
    <div class="announcement-inner container">
      <span class="announcement-text">
        <strong>2026/08/01</strong> 系統正式上線！小羊農場的理念是把每件物品的價值淋漓盡致，讓不需要的物品以 0 元分享給需要的人。大家一起讓物品發揮最大價值 🐑
      </span>
      <button id="announcement-close" class="announcement-close" aria-label="關閉公告">✕</button>
    </div>
  </div>

  <!-- 🛍️ 融合式商城子導覽列 (Shop Sub-Navbar) -->
  <div class="shop-subnav-bar">
    <div class="container shop-subnav-inner">
      <!-- 左側：商城快速切換標籤 -->
      <nav class="shop-nav-links" aria-label="商城分類導覽">
                <a class="shop-nav-item" href="/shop/products">全部商品</a>
        <a class="shop-nav-item zero-link" href="/shop/zero-price/">0元活動</a>
        <a class="shop-nav-item" href="/shop/shopping-guide">購物須知</a>
        <a class="shop-nav-item" href="/shop/about">關於我們</a>
      </nav>

      <!-- 右側：貨幣、購物車、會員操作 -->
      <div class="shop-nav-actions">
        <!-- 貨幣切換 -->
        <div class="currency-selector" id="currency-selector">
          <button class="currency-btn" id="currency-btn" title="切換顯示貨幣">
            <span id="currency-btn-label">NT$</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="currency-menu" id="currency-menu">
            <div class="currency-menu-header">選擇貨幣</div>
            <div id="currency-options"></div>
          </div>
        </div>

        <!-- 購物車按鈕 -->
        <a href="/shop/cart" class="cart-btn" aria-label="購物車">
          <span class="cart-btn-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
          </span>
          <span class="cart-badge" id="cart-badge" style="display:none">0</span>
        </a>

        <!-- 會員登入 / 帳號下拉 -->
        <div id="user-menu-container">
          <a href="/shop/login" class="btn-shop-login" id="login-btn">登入</a>
          <div id="user-dropdown" style="display:none" class="user-dropdown">
            <button id="user-btn" class="user-avatar-btn" title="會員帳號選單">
              <span id="user-avatar-initial" class="user-avatar-initial">?</span>
            </button>
            <div class="dropdown-menu" id="user-dropdown-menu">
              <div class="dropdown-user-info" id="dropdown-user-info">
                <span class="dropdown-user-name" id="dropdown-user-name"></span>
                <span class="dropdown-user-email" id="dropdown-user-email"></span>
              </div>
              <hr class="divider" style="margin:4px 0" />
              <a href="/shop/account" class="dropdown-item">個人資料</a>
              <a href="/shop/account/?tab=orders" class="dropdown-item">訂單紀錄</a>
              <a href="/shop/admin" class="dropdown-item" id="admin-link" style="display:none">管理後台</a>
              <hr class="divider" style="margin:4px 0" />
              <button class="dropdown-item logout-item" id="logout-btn">登出</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .shop-subnav-wrapper {
    background: #ffffff;
    border-bottom: 1.5px solid #0f172a;
    position: sticky;
    top: 60px;
    z-index: 99;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
  }

  .announcement-bar {
    background: #fff7ed;
    border-bottom: 1px solid #fed7aa;
    color: #c2410c;
    font-size: 13px;
    padding: 6px 0;
  }

  .announcement-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .announcement-text {
    line-height: 1.4;
  }

  .announcement-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    color: #c2410c;
    padding: 0 4px;
  }

  .shop-subnav-bar {
    background: #ffffff;
    padding: 0.6rem 0;
  }

  .shop-subnav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .shop-nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .shop-nav-brand {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
    padding: 0.4rem 0.8rem;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 0px;
    text-decoration: none;
    white-space: nowrap;
  }

  .shop-nav-item {
    font-size: 0.92rem;
    font-weight: 600;
    color: #334155;
    padding: 0.4rem 0.75rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .shop-nav-item:hover {
    color: #0f172a;
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  .shop-nav-item.zero-link {
    color: #ea580c;
    font-weight: 700;
  }

  .shop-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .currency-selector {
    position: relative;
  }

  .currency-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0.35rem 0.65rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    border-radius: 0px;
  }

  .currency-btn:hover {
    border-color: #0f172a;
  }

  .currency-menu {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    background: #ffffff;
    border: 1.5px solid #0f172a;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    min-width: 160px;
    z-index: 100;
    margin-top: 4px;
  }

  .currency-menu.show {
    display: block;
  }

  .currency-menu-header {
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    background: #f1f5f9;
    border-bottom: 1px solid #e2e8f0;
    color: #475569;
  }

  .currency-option {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: none;
    border: none;
    border-bottom: 1px solid #f8fafc;
    font-size: 13px;
    cursor: pointer;
    text-align: left;
  }

  .currency-option:hover {
    background: #f1f5f9;
  }

  .currency-option.active {
    background: #fff7ed;
    color: #ea580c;
    font-weight: 700;
  }

  .cart-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    text-decoration: none;
    border-radius: 0px;
    transition: all 0.15s ease;
  }

  .cart-btn:hover {
    border-color: #0f172a;
    background: #f8fafc;
  }

  .cart-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    background: #ea580c;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .btn-shop-login {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    background: #0f172a;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 0px;
    transition: background 0.15s ease;
  }

  .btn-shop-login:hover {
    background: #ea580c;
  }

  .user-dropdown {
    position: relative;
  }

  .user-avatar-btn {
    width: 36px;
    height: 36px;
    background: #0f172a;
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    border-radius: 0px;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    background: #ffffff;
    border: 1.5px solid #0f172a;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    min-width: 180px;
    z-index: 100;
    margin-top: 4px;
  }

  .dropdown-menu.show {
    display: block;
  }

  .dropdown-user-info {
    padding: 10px 14px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dropdown-user-name {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
  }

  .dropdown-user-email {
    font-size: 11px;
    color: #64748b;
  }

  .dropdown-item {
    display: block;
    width: 100%;
    padding: 8px 14px;
    font-size: 13px;
    color: #334155;
    text-decoration: none;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    box-sizing: border-box;
  }

  .dropdown-item:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .dropdown-item.logout-item {
    color: #dc2626;
  }

  @media (max-width: 768px) {
    .shop-subnav-inner {
      gap: 0.5rem;
    }
  }
</style>

<script is:inline>
  window.escHtml = function(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  };

  document.addEventListener('DOMContentLoaded', function() {
    var announceClose = document.getElementById('announcement-close');
    if (announceClose) {
      announceClose.addEventListener('click', function() {
        var banner = document.getElementById('announcement-banner');
        if (banner) banner.style.display = 'none';
        localStorage.setItem('announcement_closed', String(Date.now()));
        document.documentElement.classList.remove('announcement-visible');
      });
    }

    const userBtn = document.getElementById('user-btn');
    const dropdownMenu = document.getElementById('user-dropdown-menu');
    const logoutBtn = document.getElementById('logout-btn');
    const badge = document.getElementById('cart-badge');

    var count = parseInt(localStorage.getItem('shop_cart_count') || '0', 10);
    if (badge) {
      if (count > 0) {
        badge.textContent = String(count);
        badge.style.display = 'flex';
      } else {
        badge.style.display = 'none';
      }
    }

    var userStr = localStorage.getItem('shop_user');
    var token = localStorage.getItem('shop_token');
    if (userStr && token) {
      try {
        var userData = JSON.parse(userStr);
        var loginBtn = document.getElementById('login-btn');
        var userDropdown = document.getElementById('user-dropdown');
        if (loginBtn) loginBtn.style.display = 'none';
        if (userDropdown) userDropdown.style.display = 'block';
        var initial = (userData.name || userData.email || '?').charAt(0).toUpperCase();
        var avatarEl = document.getElementById('user-avatar-initial');
        if (avatarEl) avatarEl.textContent = initial;
        var nameEl = document.getElementById('dropdown-user-name');
        var emailEl = document.getElementById('dropdown-user-email');
        if (nameEl) nameEl.textContent = userData.name || '';
        if (emailEl) emailEl.textContent = userData.email || '';
        if (userData.role === 'admin') {
          var adminLink = document.getElementById('admin-link');
          if (adminLink) adminLink.style.display = 'block';
        }
      } catch(e) {}
    }

    if (userBtn && dropdownMenu) {
      userBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdownMenu.classList.toggle('show');
      });
      document.addEventListener('click', function() {
        dropdownMenu.classList.remove('show');
      });
    }

    var cc = window.__currency;
    if (cc) {
      var currencyBtn = document.getElementById('currency-btn');
      var currencyMenu = document.getElementById('currency-menu');
      var currencyOptions = document.getElementById('currency-options');
      var currencyLabel = document.getElementById('currency-btn-label');

      if (currencyOptions) {
        var codes = Object.keys(cc.currencies);
        var activeCode = cc.getCode();
        currencyOptions.innerHTML = codes.map(function(code) {
          var info = cc.currencies[code];
          var active = code === activeCode ? ' active' : '';
          return '<button class="currency-option' + active + '" data-currency="' + code + '">' +
            '<span class="currency-option-sym">' + info.symbol + '</span>' +
            '<span class="currency-option-label">' + info.label + '</span>' +
            '<span class="currency-option-check">' + (active ? '✓' : '') + '</span>' +
            '</button>';
        }).join('');

        currencyOptions.addEventListener('click', function(e) {
          var btn = e.target.closest('.currency-option');
          if (!btn) return;
          var code = btn.getAttribute('data-currency');
          if (code && code !== cc.getCode()) {
            cc.setCurrency(code);
            window.location.reload();
          } else {
            currencyMenu.classList.remove('show');
          }
        });
      }

      if (currencyLabel) {
        currencyLabel.textContent = cc.getSymbol() + (cc.getCode() !== 'TWD' ? ' ' + cc.getCode() : '');
      }

      if (currencyBtn && currencyMenu) {
        currencyBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          currencyMenu.classList.toggle('show');
        });
        document.addEventListener('click', function() {
          currencyMenu.classList.remove('show');
        });
      }
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', function() {
        var keysToRemove = [];
        for (var i = 0; i < localStorage.length; i++) {
          var key = localStorage.key(i);
          if (key && key.startsWith('shop_')) {
            keysToRemove.push(key);
          }
        }
        keysToRemove.forEach(function(k) { localStorage.removeItem(k); });
        window.location.href = '/shop/';
      });
    }
  });
</script>
