---
import BlogLayout from '../../layouts/BlogLayout.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '小羊農場 — 物品價值，淋漓盡致',
  description = '小羊農場，讓每件物品的價值淋漓盡致。',
} = Astro.props;
---

<BlogLayout title={title} description={description}>
  <!-- 🛍️ 小羊農場專屬系統狀態與匯率引擎 -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('shop_token');
      if (t) {
        document.documentElement.classList.add('auth-logged-in');
        try {
          var u = JSON.parse(localStorage.getItem('shop_user') || '{}');
          if (u.role === 'admin') document.documentElement.classList.add('auth-admin');
        } catch(e) {}
      }

      var c = parseInt(localStorage.getItem('shop_cart_count') || '0', 10);
      if (c > 0) { document.documentElement.classList.add('has-cart'); }

      var closeTs = localStorage.getItem('announcement_closed');
      var WEEK = 7 * 24 * 60 * 60 * 1000;
      if (!closeTs || (Date.now() - parseInt(closeTs) > WEEK)) {
        document.documentElement.classList.add('announcement-visible');
      }
    })();
  </script>

  <script is:inline>
    (function() {
      window.__currency = {};

      var STORAGE_KEY = 'shop_currency_code';
      var RATES_KEY = 'shop_exchange_rates';
      var RATES_TTL = 3600000;

      var cc = window.__currency;
      cc._code = localStorage.getItem(STORAGE_KEY) || 'TWD';
      cc._rates = null;
      cc._loading = false;
      cc._rateCallbacks = [];

      cc.currencies = {
        TWD: { symbol: 'NT$', label: '新台幣 TWD', rate: 1 },
        USD: { symbol: '$', label: '美元 USD', rate: null },
        EUR: { symbol: '€', label: '歐元 EUR', rate: null },
        JPY: { symbol: '¥', label: '日圓 JPY', rate: null },
        CNY: { symbol: '¥', label: '人民幣 CNY', rate: null },
        HKD: { symbol: 'HK$', label: '港幣 HKD', rate: null },
        SGD: { symbol: 'S$', label: '新加坡幣 SGD', rate: null },
        KRW: { symbol: '₩', label: '韓元 KRW', rate: null },
        GBP: { symbol: '£', label: '英鎊 GBP', rate: null },
        AUD: { symbol: 'A$', label: '澳幣 AUD', rate: null }
      };

      cc.getCode = function() { return cc._code; };
      cc.getSymbol = function(code) {
        code = code || cc._code;
        return (cc.currencies[code] && cc.currencies[code].symbol) || '$';
      };

      cc.convert = function(amountInTwd, targetCode) {
        targetCode = targetCode || cc._code;
        if (targetCode === 'TWD') return Math.round(amountInTwd);
        if (!cc._rates || !cc._rates[targetCode]) return Math.round(amountInTwd);
        var rate = cc._rates[targetCode];
        var val = amountInTwd * rate;
        if (targetCode === 'JPY' || targetCode === 'KRW') return Math.round(val);
        return Math.round(val * 100) / 100;
      };

      cc.format = function(amountInTwd, targetCode) {
        targetCode = targetCode || cc._code;
        var symbol = cc.getSymbol(targetCode);
        var val = cc.convert(amountInTwd, targetCode);
        if (targetCode === 'JPY' || targetCode === 'KRW') {
          return symbol + ' ' + val.toLocaleString();
        }
        return symbol + ' ' + (typeof val === 'number' ? val.toLocaleString(undefined, { minimumFractionDigits: targetCode === 'TWD' ? 0 : 2, maximumFractionDigits: targetCode === 'TWD' ? 0 : 2 }) : val);
      };

      cc.setCurrency = function(code) {
        if (!cc.currencies[code]) return;
        cc._code = code;
        try { localStorage.setItem(STORAGE_KEY, code); } catch(e) {}
        document.documentElement.setAttribute('data-currency', code);
        var label = document.getElementById('currency-btn-label');
        if (label) label.textContent = cc.getSymbol() + (code !== 'TWD' ? ' ' + code : '');
        cc.applyPrices();
        window.dispatchEvent(new CustomEvent('shop:currency-changed', { detail: { code: code } }));
      };

      cc.applyPrices = function(root) {
        root = root || document;
        var els = root.querySelectorAll('[data-price-twd]');
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          var twd = parseFloat(el.getAttribute('data-price-twd'));
          if (!isNaN(twd)) {
            el.textContent = cc.format(twd);
          }
        }
      };

      cc._loadRates = function(callback) {
        if (callback) cc._rateCallbacks.push(callback);
        if (cc._rates) {
          var cbs = cc._rateCallbacks;
          cc._rateCallbacks = [];
          cbs.forEach(function(fn) { try { fn(); } catch(e) {} });
          return;
        }

        try {
          var cached = localStorage.getItem(RATES_KEY);
          if (cached) {
            var parsed = JSON.parse(cached);
            if (parsed.rates && Date.now() - (parsed.ts || 0) < RATES_TTL) {
              cc._rates = parsed.rates;
              var cbs = cc._rateCallbacks;
              cc._rateCallbacks = [];
              cbs.forEach(function(fn) { try { fn(); } catch(e) {} });
              return;
            }
          }
        } catch(e) {}

        if (cc._loading) return;
        cc._loading = true;

        var script = document.createElement('script');
        script.src = 'https://open.er-api.com/v6/latest/TWD?callback=__currency_cb';
        var timeout = setTimeout(function() {
          cc._rates = { USD: 0.031, EUR: 0.028, JPY: 4.75, CNY: 0.22, HKD: 0.24, SGD: 0.041, KRW: 40.5, GBP: 0.024, AUD: 0.046 };
          cc._loading = false;
          var cbs = cc._rateCallbacks;
          cc._rateCallbacks = [];
          cbs.forEach(function(fn) { try { fn(); } catch(e) {} });
        }, 5000);

        window.__currency_cb = function(data) {
          clearTimeout(timeout);
          if (data && data.rates) {
            cc._rates = data.rates;
            try {
              localStorage.setItem(RATES_KEY, JSON.stringify({ rates: data.rates, ts: Date.now() }));
            } catch(e) {}
          } else {
            cc._rates = { USD: 0.031, EUR: 0.028, JPY: 4.75, CNY: 0.22, HKD: 0.24, SGD: 0.041, KRW: 40.5, GBP: 0.024, AUD: 0.046 };
          }
          cc._loading = false;
          var cbs = cc._rateCallbacks;
          cc._rateCallbacks = [];
          cbs.forEach(function(fn) { try { fn(); } catch(e) {} });
          delete window.__currency_cb;
        };
        document.head.appendChild(script);
      };

      cc.ready = function(callback) {
        if (cc._rates) {
          setTimeout(callback, 0);
          return;
        }
        cc._loadRates(callback);
      };

      document.documentElement.setAttribute('data-currency', cc._code);
      cc._loadRates();

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { cc.ready(cc.applyPrices); });
      } else {
        cc.ready(cc.applyPrices);
      }
    })();
  </script>

  <script is:inline>
    (function() {
      var CACHE_PREFIX = 'shop_cache_';
      var CACHE_TTL = 10000;
      window.__apiCache = {
        get: function(key) {
          try {
            var raw = localStorage.getItem(CACHE_PREFIX + key);
            if (!raw) return null;
            var entry = JSON.parse(raw);
            entry.stale = Date.now() - entry.ts > CACHE_TTL;
            return entry;
          } catch(e) { return null; }
        },
        set: function(key, data) {
          try {
            localStorage.setItem(CACHE_PREFIX + key, JSON.stringify({ data: data, ts: Date.now() }));
          } catch(e) {}
        },
        fetch: async function(url, key, options) {
          var cached = window.__apiCache.get(key || url);
          if (cached && !cached.stale) return cached.data;
          if (cached) {
            try {
              var res = await fetch(url, options || {});
              if (!res.ok) throw new Error();
              var fresh = await res.json();
              window.__apiCache.set(key || url, fresh);
              return fresh;
            } catch (e) {
              return cached.data;
            }
          }
          var res = await fetch(url, options || {});
          if (!res.ok) throw new Error('API error');
          var data = await res.json();
          window.__apiCache.set(key || url, data);
          return data;
        }
      };
    })();
  </script>

  <div class="shop-fused-container">
    <slot />
  </div>

  <script is:inline>
    (function() {
      const token = localStorage.getItem('shop_token');
      const user = localStorage.getItem('shop_user');
      if (!token && user) localStorage.removeItem('shop_user');
      window.dispatchEvent(new Event('shop:loaded'));
    })();
  </script>
</BlogLayout>

<style is:global>
  @import '../styles/global.css';

  .shop-fused-container {
    background: #ffffff;
    min-height: 70vh;
    padding-bottom: 3rem;
  }
</style>
