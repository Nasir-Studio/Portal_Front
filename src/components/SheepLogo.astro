---
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  role="img"
  aria-label="OviNas"
>
  <!-- 深炭圓角底 -->
  <rect x="0" y="0" width="64" height="64" rx="14" fill="#1c1c20" />

  <!-- 金色左捲角（新月弧） -->
  <path
    d="M20 29 C13 25 8 18 10 11 C12 5.5 18 4 21.5 8"
    stroke="#d4af37"
    stroke-width="4.5"
    stroke-linecap="round"
    fill="none"
  />
  <!-- 金色右捲角（新月弧） -->
  <path
    d="M44 29 C51 25 56 18 54 11 C52 5.5 46 4 42.5 8"
    stroke="#d4af37"
    stroke-width="4.5"
    stroke-linecap="round"
    fill="none"
  />

  <!-- 米白幾何圓臉 -->
  <circle cx="32" cy="38" r="13.5" fill="#f4f3f0" />

  <!-- 眼睛 -->
  <circle cx="27" cy="36.5" r="2.1" fill="#1c1c20" />
  <circle cx="37" cy="36.5" r="2.1" fill="#1c1c20" />

  <!-- 金色鼻點 -->
  <path d="M29.5 42.5 h5 L32 46 z" fill="#d4af37" />
</svg>
