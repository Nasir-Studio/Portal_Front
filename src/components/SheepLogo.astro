---
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  role="img"
  aria-label="OviNas"
>
  <!-- 圓滾滾絨毛身體（三團雲，手繪重疊） -->
  <circle cx="23" cy="45" r="9" fill="#f4f3f0" stroke="#1c1c20" stroke-width="2.2" />
  <circle cx="41" cy="45" r="9" fill="#f4f3f0" stroke="#1c1c20" stroke-width="2.2" />
  <circle cx="32" cy="47" r="10" fill="#f4f3f0" stroke="#1c1c20" stroke-width="2.2" />

  <!-- 大圓頭（圓滾滾，略扁橢圓） -->
  <ellipse cx="32" cy="32" rx="14" ry="13" fill="#f4f3f0" stroke="#1c1c20" stroke-width="2.4" />

  <!-- 小圓耳朵（左右略不對稱） -->
  <ellipse cx="15.5" cy="25" rx="4" ry="5" fill="#f4f3f0" stroke="#1c1c20" stroke-width="2" />
  <ellipse cx="48.5" cy="25.5" rx="4" ry="4.8" fill="#f4f3f0" stroke="#1c1c20" stroke-width="2" />

  <!-- 金色小捲角（手繪螺旋弧，左右不同） -->
  <path
    d="M21 21 C 17 17, 16 12, 19 10.5 C 22 9, 24 12, 22.5 14"
    stroke="#c9a227"
    stroke-width="2.4"
    stroke-linecap="round"
    fill="none"
  />
  <path
    d="M43 21 C 47 17, 48 12, 45 10.5 C 42 9, 40 12, 41.5 14"
    stroke="#c9a227"
    stroke-width="2.4"
    stroke-linecap="round"
    fill="none"
  />

  <!-- 豆豆眼 -->
  <circle cx="27" cy="31" r="2.4" fill="#1c1c20" />
  <circle cx="37" cy="31" r="2.4" fill="#1c1c20" />

  <!-- 腮紅（暖金，圓滾滾的蘋果肌） -->
  <circle cx="23.5" cy="36" r="2.6" fill="#c9a227" opacity="0.85" />
  <circle cx="40.5" cy="36" r="2.6" fill="#c9a227" opacity="0.85" />

  <!-- 微笑 -->
  <path
    d="M29 36.5 C 30.5 38.5, 33.5 38.5, 35 36.5"
    stroke="#1c1c20"
    stroke-width="1.8"
    stroke-linecap="round"
    fill="none"
  />
</svg>
