---
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  role="img"
  aria-label="OviNas"
>
  <!-- 紙感圓角底（像手繪紙張） -->
  <rect x="0" y="0" width="64" height="64" rx="16" fill="#f4f2ec" />
  <rect x="0.5" y="0.5" width="63" height="63" rx="15.5" stroke="#d8d3c6" stroke-width="1" />

  <!-- 草稿基準線（鉛筆打稿沒擦乾淨的痕跡） -->
  <line x1="14" y1="38" x2="50" y2="38" stroke="#d8d3c6" stroke-width="1" stroke-dasharray="2 3" opacity="0.7" />

  <!-- 左角：手繪抖動弧線（較彎、較長） -->
  <path
    d="M22 29 C 16 26, 9 20, 8.5 13.5 C 8.2 8.5, 13 5, 18.5 7.5"
    stroke="#1c1c20"
    stroke-width="3.2"
    stroke-linecap="round"
    fill="none"
  />

  <!-- 右角：與左角不同（較短、較直、角度略異）→ 打破對稱 -->
  <path
    d="M43 28 C 50 24, 55 17, 53.5 11 C 52.5 7, 46.5 4.5, 43.5 8"
    stroke="#1c1c20"
    stroke-width="3.2"
    stroke-linecap="round"
    fill="none"
  />

  <!-- 臉：手繪略歪的橢圓（非完美正圓） -->
  <path
    d="M32 25 C 40 24.5, 45 30, 44.5 38 C 44 46, 38 50, 32 49.5 C 26 49, 20 45.5, 19.5 38 C 19 30.5, 24 25, 32 25 Z"
    stroke="#1c1c20"
    stroke-width="2.8"
    stroke-linejoin="round"
    fill="none"
  />

  <!-- 眼睛：不對稱（左大右小、位置錯落） -->
  <circle cx="26.5" cy="35.5" r="2.8" fill="#1c1c20" />
  <circle cx="38" cy="34.5" r="2.1" fill="#1c1c20" />

  <!-- 口鼻：手繪短曲線（金色） -->
  <path
    d="M29 43.5 C 31 44.5, 33 44.5, 35 43.5"
    stroke="#c9a227"
    stroke-width="2.2"
    stroke-linecap="round"
    fill="none"
  />

  <!-- 草稿點綴：不對稱的雀斑點（金色） -->
  <circle cx="23" cy="41" r="1.1" fill="#c9a227" />
  <circle cx="41" cy="40.5" r="0.8" fill="#c9a227" />
</svg>
