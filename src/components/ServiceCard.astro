---
interface Props {
  number: string;
  title: string;
  desc: string;
  href: string;
  icon: 'camera' | 'badge' | 'exam';
}

const { number, title, desc, href, icon } = Astro.props;
---

<a class="card" href={href} target="_blank" rel="noopener noreferrer">
  <div class="card-head">
    <span class="card-icon" aria-hidden="true">
      {
        icon === 'camera' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2.5" y="6.5" width="19" height="13" rx="2.5" />
            <circle cx="12" cy="13" r="4" />
            <path d="M6 6.5l2-3h8l2 3" />
          </svg>
        )
      }
      {
        icon === 'badge' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="9" r="6" />
            <path d="M8.6 13.6L7 21l5-2.6L17 21l-1.6-7.4" />
            <path d="M12 6.5l.9 1.9 2 .3-1.5 1.4.4 2-1.8-1-1.8 1 .4-2L9.1 8.7l2-.3z" />
          </svg>
        )
      }
      {
        icon === 'exam' && (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="3" width="16" height="18" rx="2" />
            <path d="M8.5 8h7M8.5 12h7M8.5 16h4.5" />
            <path d="M14 16.8l1.6 1.6 3-3.2" />
          </svg>
        )
      }
    </span>
    <span class="card-number">{number}</span>
  </div>

  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{desc}</p>
  </div>

  <div class="card-foot">
    <span>前往服務</span>
    <span class="card-arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--ink);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--t), box-shadow var(--t), border-color var(--t);
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
    border-color: var(--border-strong);
  }

  /* 表頭列：圖示 + 編號，下方虛線分隔 */
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.3rem;
    border-bottom: 1px dashed var(--border);
    background: var(--bg-soft);
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--ink);
  }

  .card-number {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }

  .card-body {
    padding: 1.4rem 1.3rem 1.1rem;
    flex: 1;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 0.55rem;
  }

  .card-desc {
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  /* 底下列：前往服務 */
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.3rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink);
  }

  .card-arrow {
    transition: transform var(--t);
  }

  .card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>
