---
---

<div class="custom-hand-cursor" id="custom-hand-cursor" aria-hidden="true">
  <!-- 手掌狀態（預設） -->
  <svg class="hand-svg hand-open" viewBox="0 0 32 32" width="32" height="32" fill="none">
    <filter id="hand-shadow" x="-20%" y="-20%" width="150%" height="150%">
      <feDropShadow dx="1" dy="2" stdDeviation="1.8" flood-color="#1c1c1c" flood-opacity="0.22" />
    </filter>
    <g filter="url(#hand-shadow)">
      <path
        d="M13 3.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5V12h1V5.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5V12h1V7.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5V13h1v-3.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v9.5c0 4.97-4.03 9-9 9s-9-4.03-9-9v-3c0-.83.67-1.5 1.5-1.5.55 0 1.04.3 1.3.75L13 17.5V3.5z"
        fill="#ffffff"
        stroke="#1c1c1c"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </g>
  </svg>

  <!-- 點擊/懸停狀態（食指點擊手掌） -->
  <svg class="hand-svg hand-point" viewBox="0 0 32 32" width="32" height="32" fill="none">
    <g filter="url(#hand-shadow)">
      <path
        d="M13 2.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5V14h1.5c.83 0 1.5.67 1.5 1.5v1h1c.83 0 1.5.67 1.5 1.5v1h1c.83 0 1.5.67 1.5 1.5V20c0 4.97-4.03 9-9 9s-9-4.03-9-9v-4.5c0-.83.67-1.5 1.5-1.5.55 0 1.04.3 1.3.75L13 17.5V2.5z"
        fill="#ffffff"
        stroke="#1c1c1c"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <!-- 裝飾微光線條 -->
      <path class="click-spark spark-1" d="M14.5 -1.5v-2" stroke="#d4af37" stroke-width="1.8" stroke-linecap="round" />
      <path class="click-spark spark-2" d="M10 0.5L8.5 -1" stroke="#d4af37" stroke-width="1.8" stroke-linecap="round" />
      <path class="click-spark spark-3" d="M19 0.5l1.5 -1.5" stroke="#d4af37" stroke-width="1.8" stroke-linecap="round" />
    </g>
  </svg>
</div>

<style is:global>
  @media (hover: hover) and (pointer: fine) {
    body, a, button, input, textarea, select, [role="button"], [role="tab"] {
      cursor: none !important;
    }
  }

  .custom-hand-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 999999;
    opacity: 0;
    transform: translate(-10px, -2px);
    transition: opacity 0.2s ease, transform 0.08s ease-out;
    will-change: transform, opacity;
  }

  .hand-svg {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    transform-origin: 14px 4px;
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.15s ease;
  }

  .hand-open {
    opacity: 1;
    transform: rotate(-10deg);
  }

  .hand-point {
    opacity: 0;
    transform: rotate(-5deg) scale(0.9);
  }

  .click-spark {
    opacity: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
    transform-origin: 14.5px 2px;
  }

  /* 懸停在可互動元素上 */
  .custom-hand-cursor.is-hover .hand-open {
    opacity: 0;
    transform: scale(0.85);
  }

  .custom-hand-cursor.is-hover .hand-point {
    opacity: 1;
    transform: rotate(0deg) scale(1.1);
  }

  .custom-hand-cursor.is-hover .hand-point path[fill="#ffffff"] {
    fill: #fffdf5;
    stroke: #1c1c1c;
  }

  .custom-hand-cursor.is-hover .click-spark {
    opacity: 1;
  }

  /* 點擊瞬間 */
  .custom-hand-cursor.is-down {
    transform: translate(-10px, -2px) scale(0.88);
  }

  .custom-hand-cursor.is-down .hand-point {
    transform: rotate(4deg) scale(1.05);
  }

  @media (hover: none) or (pointer: coarse) {
    .custom-hand-cursor {
      display: none !important;
    }
  }
</style>

<script>
  (() => {
    if (window.matchMedia('(hover: none) or (pointer: coarse)').matches) return;

    const hand = document.getElementById('custom-hand-cursor');
    if (!hand) return;

    let mouseX = -100;
    let mouseY = -100;
    let handX = -100;
    let handY = -100;
    let isVisible = false;

    const render = () => {
      if (isVisible) {
        handX += (mouseX - handX) * 0.35;
        handY += (mouseY - handY) * 0.35;
        hand.style.transform = `translate3d(${handX - 10}px, ${handY - 2}px, 0)`;
      }
      requestAnimationFrame(render);
    };
    requestAnimationFrame(render);

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        handX = mouseX;
        handY = mouseY;
        hand.style.opacity = '1';
      }
    });

    window.addEventListener('mouseleave', () => {
      isVisible = false;
      hand.style.opacity = '0';
    });

    window.addEventListener('mouseenter', () => {
      isVisible = true;
      hand.style.opacity = '1';
    });

    window.addEventListener('mousedown', () => {
      hand.classList.add('is-down');
    });

    window.addEventListener('mouseup', () => {
      hand.classList.remove('is-down');
    });

    const isInteractive = (el: HTMLElement | null) => {
      if (!el) return false;
      return !!el.closest(
        'a, button, input, textarea, select, [role="button"], [role="tab"], .tool-item, .tool-card, .news-item, .banner-dot, .banner-btn, .badge-item, .audit-dl, summary, .menu-link, .topbar a'
      );
    };

    document.addEventListener('mouseover', (e) => {
      if (isInteractive(e.target as HTMLElement)) {
        hand.classList.add('is-hover');
      }
    });

    document.addEventListener('mouseout', (e) => {
      if (isInteractive(e.target as HTMLElement)) {
        hand.classList.remove('is-hover');
      }
    });
  })();
</script>
