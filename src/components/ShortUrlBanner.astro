---
import SheepLogo from './SheepLogo.astro';
---

<section class="banner" aria-label="羊短網址服務">
  <div class="banner-body">
    <p class="banner-label">NSIR.UK　短網址服務</p>
    <h2 class="banner-title">把網址變短，交給羊。</h2>
    <p class="banner-desc">
      一串長長的網址，變成小小的一片雲。<br />
      羊家的短網址服務，溫柔而可靠。
    </p>
    <a class="btn btn--light" href="https://nsir.uk" target="_blank" rel="noopener noreferrer">
      羊-短網址(nsir.uk)
      <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="banner-sheep" aria-hidden="true">
    <SheepLogo size={140} />
  </div>
</section>

<style>
  .banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    background: var(--ink);
    border-radius: var(--radius-md);
    padding: 2.8rem 3rem;
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .banner-body {
    position: relative;
    z-index: 1;
    color: var(--white);
  }

  .banner-label {
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.36em;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 0.8rem;
  }

  .banner-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 0.7rem;
  }

  .banner-desc {
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    line-height: 2;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 1.8rem;
  }

  .banner-sheep {
    flex-shrink: 0;
    opacity: 0.9;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.5));
  }

  @media (max-width: 720px) {
    .banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 2.2rem 1.7rem;
      text-align: left;
    }

    .banner-sheep {
      position: absolute;
      right: -34px;
      bottom: -34px;
      opacity: 0.14;
    }
  }
</style>
