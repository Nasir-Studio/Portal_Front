---
import SheepLogo from './SheepLogo.astro';
---

<section class="banner" aria-label="羊短網址服務">
  <div class="banner-sheep" aria-hidden="true">
    <SheepLogo size={150} />
  </div>

  <div class="banner-body">
    <p class="banner-label">NSIR.UK</p>
    <h2 class="banner-title">把網址變短，交給羊。</h2>
    <p class="banner-desc">
      一串長長的網址，變成小小的一片雲。<br />
      羊家的短網址服務，溫柔而可靠。
    </p>
    <a class="btn btn--light" href="https://nsir.uk" target="_blank" rel="noopener noreferrer">
      羊-短網址(nsir.uk)
      <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    background: var(--ink);
    border-radius: var(--radius-lg);
    padding: 3.2rem 3.4rem;
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 82% 20%, rgba(255, 255, 255, 0.08) 0%, transparent 55%);
    pointer-events: none;
  }

  .banner-sheep {
    flex-shrink: 0;
    opacity: 0.92;
    animation: floaty 6s ease-in-out infinite;
    filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.45));
  }

  .banner-body {
    position: relative;
    z-index: 1;
    color: var(--white);
  }

  .banner-label {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.4em;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 0.9rem;
  }

  .banner-title {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 0.8rem;
  }

  .banner-desc {
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    line-height: 2;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 1.9rem;
  }

  @media (max-width: 720px) {
    .banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 2.4rem 1.9rem;
      text-align: left;
    }

    .banner-sheep {
      position: absolute;
      right: -30px;
      bottom: -30px;
      opacity: 0.16;
    }
  }
</style>
