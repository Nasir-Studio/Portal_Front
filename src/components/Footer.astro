---
const links = [
  { label: '羊監視你', href: 'https://cctv.nsir.uk' },
  { label: '羊集章', href: 'https://badges.nsir.uk' },
  { label: '羊愛考試', href: 'https://1ztests.nsir.uk' },
  { label: '羊-短網址(nsir.uk)', href: 'https://nsir.uk' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label="頁尾連結">
      {
        links.map((link, i) => (
          <>
            {i > 0 && <span class="footer-sep" aria-hidden="true">・</span>}
            <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
          </>
        ))
      }
    </nav>

    <p class="footer-greeting">歡迎光臨羊家 ・ 好運綿綿 ・ 溫柔常在</p>

    <p class="footer-copy">© 2026 Nasir 羊の入口網</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding: 2.6rem 0 2.8rem;
    background: var(--surface);
    border-top: 3px double var(--border-strong);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  .footer-links a {
    transition: color var(--t);
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  .footer-sep {
    color: var(--border-strong);
  }

  .footer-greeting {
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    color: var(--ink-3);
  }

  .footer-copy {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink);
  }
</style>
