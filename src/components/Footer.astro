---
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy">© 2026 OviNas</p>
    <div class="footer-vcount" title="累計瀏覽人次">
      <span class="vcount-tag">VISITORS</span>
      <div class="vcount-img-wrap">
        <img
          src="https://www.hitwebcounter.com/counter/counter.php?page=21514902&style=0001&nbdigits=8&type=page"
          alt="訪客計數"
          decoding="async"
          width="120"
          height="24"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4.5rem;
    padding: 2.2rem 0 2.4rem;
    background: var(--surface);
    border-top: 3px double var(--border-strong);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.9rem;
    text-align: center;
  }

  .footer-copy {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ink);
    margin: 0;
  }

  .footer-vcount {
    display: inline-flex;
    align-items: center;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.35rem 0.25rem 0.8rem;
    gap: 0.6rem;
    box-shadow: 0 2px 8px -4px rgba(28, 28, 28, 0.1);
    transition: border-color var(--t), transform var(--t);
  }

  .footer-vcount:hover {
    border-color: #d4af37;
    transform: translateY(-1px);
  }

  .vcount-tag {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }

  .vcount-img-wrap {
    display: flex;
    align-items: center;
    background: #111111;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    overflow: hidden;
  }

  .vcount-img-wrap img {
    display: block;
    height: 18px;
    width: auto;
    max-width: 100%;
    filter: contrast(1.1) brightness(1.05);
  }
</style>
