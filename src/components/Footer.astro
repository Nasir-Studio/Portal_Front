<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy">© 2026 OviNas</p>
    <div class="footer-counter" title="訪客計數">
      <img
        src="https://www.hitwebcounter.com/counter/counter.php?page=21514902&style=0001&nbdigits=8&type=page"
        alt="訪客計數"
        decoding="async"
        width="110"
        height="22"
        loading="lazy"
      />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4.5rem;
    padding: 2.2rem 0 2.4rem;
    background: var(--surface);
    border-top: 3px double var(--border-strong);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.65rem;
    text-align: center;
  }

  .footer-copy {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ink);
    margin: 0;
  }

  .footer-counter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity var(--t);
  }

  .footer-counter:hover {
    opacity: 1;
  }

  .footer-counter img {
    display: block;
    height: 18px;
    width: auto;
  }
</style>
