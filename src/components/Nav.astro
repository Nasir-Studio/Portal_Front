---
import SheepLogo from './SheepLogo.astro';

const navGroups = [
  {
    titleKey: 'nav.tools',
    defaultTitle: 'Ovis Tools',
    id: 'ovis-tools',
    items: [
      { key: 'nav.nytools', label: 'NYTools', href: '/nytools/', external: false },
      { key: 'nav.cctv', label: '羊監視你', href: '/cctv', external: false },
      { key: 'nav.badges', label: '羊集章', href: '/badges/', external: false },
      { key: 'nav.vocab', label: '單字測驗', href: '/vocab/', external: false },
    ],
  },
  {
    titleKey: 'nav.services',
    defaultTitle: '主要服務',
    id: 'main-services',
    items: [
      { key: 'nav.exam', label: '羊愛考試', href: 'https://1ztests.nsir.uk', external: true },
      { key: 'nav.shorturl', label: '羊-短網址', href: 'https://nsir.uk', external: true },
    ],
  },
];
---

<header class="site-header">
  <!-- 頂部黑條 (Topbar) -->
  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-left">
        <!-- 🌐 語系切換器 (Desktop) -->
        <div class="lang-switcher" aria-label="切換語系">
          <button class="lang-btn is-active" type="button" data-lang="zh-TW">繁中</button>
          <span class="lang-divider">/</span>
          <button class="lang-btn" type="button" data-lang="en">EN</button>
          <span class="lang-divider">/</span>
          <button class="lang-btn" type="button" data-lang="ja">日本語</button>
        </div>
      </div>

      <span class="topbar-right">
        <a href="/" data-i18n="nav.home">首頁</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <a href="#news" data-i18n="nav.news">最新消息</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <a href="/vip/" data-i18n="nav.vip">VIP 專區</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <span class="topbar-user" id="topbar-user" hidden>
          <span id="topbar-username"></span>
          <button class="topbar-logout" id="topbar-logout" type="button" data-i18n="nav.logout">登出</button>
        </span>
      </span>
    </div>
  </div>

  <!-- 主品牌列 (Header Main) -->
  <div class="header-main container">
    <a class="brand" href="/">
      <SheepLogo size={58} />
      <span class="brand-text">
        <span class="brand-name">OviNas</span>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      aria-label="開啟選單"
    >
      <span class="burger-icon" aria-hidden="true">
        <span class="burger-line line-1"></span>
        <span class="burger-line line-2"></span>
        <span class="burger-line line-3"></span>
      </span>
    </button>
  </div>

  <!-- 桌面版白色選單條 (Menubar Wrap) -->
  <div class="menubar-wrap">
    <nav class="menubar container" aria-label="主導覽">
      <a class="menu-link is-home" href="/" data-i18n="nav.home">首頁</a>

      {
        navGroups.map((group) => (
          <div class="menu-dropdown-group" data-group={group.id}>
            <button
              class="menu-dropdown-btn"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span data-i18n={group.titleKey}>{group.defaultTitle}</span>
              <span class="arrow-desktop" aria-hidden="true">▾</span>
            </button>
            <div class="dropdown-panel">
              {group.items.map((item) => (
                <a
                  class="dropdown-sublink"
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  <span data-i18n={item.key}>{item.label}</span>
                  {item.external && <span class="ext-icon" aria-hidden="true">↗</span>}
                </a>
              ))}
            </div>
          </div>
        ))
      }

      <a class="menu-link menu-cta" href="/reserve/" data-i18n="nav.reserve">
        預約系統
      </a>
    </nav>
  </div>

  <!-- 📱 手機版滿版抽屜選單 (Fullscreen Animated Mobile Drawer) -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="drawer-header">
      <a class="drawer-brand" href="/">
        <SheepLogo size={42} />
        <span class="drawer-brand-name">OviNas</span>
      </a>
      <button class="drawer-close-btn" type="button" aria-label="關閉選單">
        ✕
      </button>
    </div>

    <div class="drawer-body">
      <!-- 語系切換器 (Mobile) -->
      <div class="drawer-lang-section drawer-item-1">
        <span class="drawer-section-label">LANGUAGE / 言語</span>
        <div class="drawer-lang-pills">
          <button class="lang-btn is-active" type="button" data-lang="zh-TW">繁體中文</button>
          <button class="lang-btn" type="button" data-lang="en">English</button>
          <button class="lang-btn" type="button" data-lang="ja">日本語</button>
        </div>
      </div>

      <nav class="drawer-nav" aria-label="手機主選單">
        <a class="drawer-link drawer-item-2" href="/" data-i18n="nav.home">首頁</a>

        {
          navGroups.map((group, gIdx) => (
            <div class={`drawer-accordion-group drawer-item-${gIdx + 3}`} data-group={group.id}>
              <button class="drawer-accordion-btn" type="button" aria-expanded="false">
                <span data-i18n={group.titleKey}>{group.defaultTitle}</span>
                <span class="drawer-plus" aria-hidden="true">+</span>
              </button>
              <div class="drawer-accordion-panel">
                <div class="drawer-accordion-panel-inner">
                  {group.items.map((item) => (
                    <a
                      class="drawer-sublink"
                      href={item.href}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener noreferrer' : undefined}
                    >
                      <span data-i18n={item.key}>{item.label}</span>
                      {item.external && <span class="ext-icon" aria-hidden="true">↗</span>}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))
        }

        <a class="drawer-link drawer-item-5" href="#news" data-i18n="nav.news">最新消息</a>
        <a class="drawer-link drawer-item-6" href="/vip/" data-i18n="nav.vip">VIP 專區</a>

        <div class="drawer-cta-wrap drawer-item-7">
          <a class="drawer-cta" href="/reserve/" data-i18n="nav.reserve">
            預約系統
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
  }

  /* 頂部黑條 */
  .topbar {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 32px;
  }

  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lang-btn {
    appearance: none;
    background: none;
    border: none;
    padding: 0.1rem 0.3rem;
    font-family: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    border-radius: 3px;
    transition: all var(--t);
  }

  .lang-btn:hover {
    color: var(--white);
  }

  .lang-btn.is-active {
    color: var(--white);
    font-weight: 600;
    background: rgba(255, 255, 255, 0.18);
  }

  .lang-divider {
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.7rem;
  }

  .topbar-right {
    display: inline-flex;
    align-items: center;
  }

  .topbar-right a {
    transition: color var(--t);
  }

  .topbar-right a:hover {
    color: var(--white);
  }

  .topbar-sep {
    margin: 0 0.5rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .topbar-user {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .topbar-user[hidden] {
    display: none;
  }

  .topbar-logout {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--white);
    cursor: pointer;
  }

  .topbar-logout:hover {
    text-decoration: underline;
  }

  /* 主標題列 */
  .header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0 1.1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink);
  }

  .brand svg,
  .brand img {
    filter: drop-shadow(0 4px 8px rgba(28, 28, 28, 0.2));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .menubar-wrap {
    border-top: 1px solid var(--border);
    border-bottom: 2px solid var(--ink);
    background: var(--surface);
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 0;
    min-height: 48px;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 1.35rem;
    height: 48px;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    border-right: 1px solid var(--border);
    transition: background var(--t), color var(--t);
  }

  .menu-link:hover {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .is-home {
    color: var(--ink);
  }

  /* 下拉群組 (Desktop) */
  .menu-dropdown-group {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 48px;
    border-right: 1px solid var(--border);
  }

  .menu-dropdown-btn {
    appearance: none;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    padding: 0 1.5rem;
    height: 100%;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--t), color var(--t);
  }

  .menu-dropdown-group:hover .menu-dropdown-btn,
  .menu-dropdown-group:focus-within .menu-dropdown-btn {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .arrow-desktop {
    font-size: 0.72rem;
    transition: transform var(--t);
  }

  .menu-dropdown-group:hover .arrow-desktop {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    min-width: 100%;
    box-sizing: border-box;
    background: var(--surface);
    border: 1.5px solid var(--ink);
    box-shadow: 4px 4px 0px rgba(28, 28, 28, 0.12);
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0.18s;
    z-index: 100;
  }

  .menu-dropdown-group:hover .dropdown-panel,
  .menu-dropdown-group:focus-within .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-sublink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.68rem 0.95rem;
    font-size: 0.88rem;
    color: var(--ink-2);
    letter-spacing: 0.06em;
    white-space: nowrap;
    border-bottom: 1px solid var(--border);
    transition: background var(--t), color var(--t);
  }

  .dropdown-sublink:last-child {
    border-bottom: none;
  }

  .dropdown-sublink:hover {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .ext-icon {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .menu-cta {
    margin-left: auto;
    border-right: none;
    font-weight: 500;
    background: var(--ink);
    color: var(--white);
  }

  .menu-cta:hover {
    background: #000;
    color: var(--white);
  }

  /* 漢堡按鈕與線條動畫 */
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--t), transform var(--t);
  }

  .nav-toggle:hover {
    background: var(--bg-soft);
    transform: scale(1.05);
  }

  .burger-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 20px;
    height: 14px;
  }

  .burger-line {
    display: block;
    height: 2.2px;
    width: 100%;
    background: var(--ink);
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  /* 📱 手機版滿版抽屜選單 (開闔雙向平滑動畫) */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    background: #ffffff;
    z-index: 999999;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(0.97) translateY(-12px);
    transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.32s;
  }

  .mobile-drawer.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: scale(1) translateY(0);
  }

  .mobile-drawer.is-closing {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(0.97) translateY(-12px);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.4rem;
    border-bottom: 2px solid var(--ink);
    background: var(--surface);
    flex-shrink: 0;
  }

  .drawer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
  }

  .drawer-brand-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .drawer-close-btn {
    appearance: none;
    background: none;
    border: none;
    color: var(--ink);
    font-size: 1.4rem;
    cursor: pointer;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s;
  }

  .drawer-close-btn:hover {
    transform: rotate(90deg) scale(1.15);
    background: var(--bg-soft);
  }

  .drawer-body {
    padding: 1.4rem 1.4rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    flex: 1;
  }

  .drawer-lang-section {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--border);
  }

  .drawer-section-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }

  .drawer-lang-pills {
    display: flex;
    gap: 0.5rem;
  }

  .drawer-lang-pills .lang-btn {
    flex: 1;
    padding: 0.55rem 0.6rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--ink);
    font-size: 0.84rem;
    text-align: center;
    transition: all 0.2s ease;
  }

  .drawer-lang-pills .lang-btn.is-active {
    background: var(--ink);
    color: var(--white);
    border-color: var(--ink);
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    padding: 0.95rem 0.5rem;
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: padding-left 0.2s ease, color 0.2s ease;
  }

  .drawer-link:hover {
    padding-left: 0.8rem;
    color: #000;
  }

  /* 手風琴動態開闔 (Accordion Smooth Expand & Collapse) */
  .drawer-accordion-group {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
  }

  .drawer-accordion-btn {
    appearance: none;
    background: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 0.5rem;
    font-family: inherit;
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink);
    cursor: pointer;
  }

  .drawer-plus {
    display: inline-block;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ink);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .drawer-accordion-group.is-open .drawer-plus {
    transform: rotate(180deg);
  }

  .drawer-accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    opacity: 0;
    background: var(--bg-soft);
    border-radius: 8px;
    margin: 0;
    overflow: hidden;
  }

  .drawer-accordion-group.is-open .drawer-accordion-panel {
    grid-template-rows: 1fr;
    opacity: 1;
    margin: 0.2rem 0 0.8rem;
  }

  .drawer-accordion-panel-inner {
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .drawer-sublink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 1.2rem;
    font-size: 0.95rem;
    color: var(--ink-2);
    border-bottom: 1px dashed var(--border);
    transition: padding-left 0.2s ease, color 0.2s ease;
  }

  .drawer-sublink:last-child {
    border-bottom: none;
  }

  .drawer-sublink:hover {
    padding-left: 1.4rem;
    color: var(--ink);
  }

  .drawer-cta-wrap {
    margin-top: 1.4rem;
  }

  .drawer-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--white);
    padding: 0.95rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    border-radius: 8px;
    box-shadow: 3px 4px 12px rgba(28, 28, 28, 0.16);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .drawer-cta:hover {
    background: #000;
    transform: translateY(-2px);
  }

  /* 滿版入場交錯動畫 (Stagger Reveal) */
  .mobile-drawer.is-active .drawer-item-1 { animation: drawer-slide 0.35s 0.05s ease both; }
  .mobile-drawer.is-active .drawer-item-2 { animation: drawer-slide 0.35s 0.1s ease both; }
  .mobile-drawer.is-active .drawer-item-3 { animation: drawer-slide 0.35s 0.15s ease both; }
  .mobile-drawer.is-active .drawer-item-4 { animation: drawer-slide 0.35s 0.2s ease both; }
  .mobile-drawer.is-active .drawer-item-5 { animation: drawer-slide 0.35s 0.25s ease both; }
  .mobile-drawer.is-active .drawer-item-6 { animation: drawer-slide 0.35s 0.3s ease both; }
  .mobile-drawer.is-active .drawer-item-7 { animation: drawer-slide 0.35s 0.35s ease both; }

  @keyframes drawer-slide {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .site-header {
      position: static;
    }

    .header-main {
      border-bottom: 2px solid var(--ink);
      padding: 0.9rem 0;
    }

    .nav-toggle {
      display: flex;
    }

    .brand-name {
      font-size: 1.25rem;
    }

    .brand svg,
    .brand img {
      width: 46px;
      height: 46px;
    }

    .menubar-wrap {
      display: none;
    }
  }

  @media (max-width: 540px) {
    .topbar-left {
      display: none;
    }

    .topbar-inner {
      justify-content: flex-end;
    }
  }
</style>

<script>
  import { currentUser, logout } from '../scripts/auth';
  import { setLanguage, getCurrentLang, type Lang, applyTranslations } from '../scripts/i18n';

  // 滿版手機抽屜選單邏輯 (開閉皆有動畫)
  const toggle = document.querySelector('.nav-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const closeBtn = document.querySelector('.drawer-close-btn');

  function openDrawer() {
    drawer?.classList.remove('is-closing');
    drawer?.classList.add('is-active');
    drawer?.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.add('is-closing');
    drawer?.classList.remove('is-active');
    drawer?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => {
      drawer?.classList.remove('is-closing');
    }, 320);
  }

  toggle?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);

  // 手機版手風琴選單 (+ / -)
  const accordionGroups = document.querySelectorAll('.drawer-accordion-group');
  accordionGroups.forEach((group) => {
    const btn = group.querySelector('.drawer-accordion-btn');
    const plusIcon = group.querySelector('.drawer-plus');

    btn?.addEventListener('click', () => {
      const isOpen = group.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(isOpen));
      if (plusIcon) {
        plusIcon.textContent = isOpen ? '−' : '+';
      }
    });
  });

  // 點擊連結後自動關閉抽屜
  drawer?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      closeDrawer();
    });
  });

  // 語系切換處理
  document.querySelectorAll('.lang-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang') as Lang;
      if (lang) {
        setLanguage(lang);
      }
    });
  });

  // 初始化語系
  applyTranslations();

  // Topbar 使用者
  const userBox = document.getElementById('topbar-user');
  const userName = document.getElementById('topbar-username');
  const logoutBtn = document.getElementById('topbar-logout');

  function renderTopbarUser() {
    const user = currentUser();
    if (!user || !userBox || !userName) return;
    userName.textContent = user.displayName;
    userBox.hidden = false;
  }

  logoutBtn?.addEventListener('click', async () => {
    await logout();
    window.location.href = '/';
  });

  renderTopbarUser();
</script>
