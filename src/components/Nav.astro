---
import SheepLogo from './SheepLogo.astro';

const links = [
  { label: '羊-短網址', href: 'https://nsir.uk' },
  { label: '羊監視你', href: 'https://cctv.nsir.uk' },
  { label: '羊集章', href: 'https://badges.nsir.uk' },
  { label: '羊愛考試', href: 'https://1ztests.nsir.uk' },
];
---

<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-left">羊家入口網</span>
      <span class="topbar-right">
        <a href="/">首頁</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <a href="#news">最新消息</a>
      </span>
    </div>
  </div>

  <div class="header-main container">
    <a class="brand" href="/">
      <SheepLogo size={58} />
      <span class="brand-text">
        <span class="brand-name">羊家的入口</span>
        <span class="brand-en">SHEEP PORTAL</span>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="開啟選單"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="menubar-wrap" id="nav-menu">
    <nav class="menubar container" aria-label="主導覽">
      <a class="menu-link is-home" href="/">首頁</a>
      <a class="menu-link" href="#news">最新消息</a>
      {
        links.map((link) => (
          <a class="menu-link" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))
      }
      <a class="menu-link menu-cta" href="#">
        預約系統
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
  }

  .topbar {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 32px;
  }

  .topbar a {
    transition: color var(--t);
  }

  .topbar a:hover {
    color: var(--white);
  }

  .topbar-sep {
    margin: 0 0.5rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0 1.1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink);
  }

  .brand svg {
    filter: drop-shadow(0 4px 8px rgba(28, 28, 28, 0.2));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .brand-en {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .menubar-wrap {
    border-top: 1px solid var(--border);
    border-bottom: 2px solid var(--ink);
    background: var(--surface);
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 0;
    min-height: 48px;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 1.35rem;
    height: 48px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    border-right: 1px solid var(--border);
    transition: background var(--t), color var(--t);
  }

  .menu-link:first-child {
    border-left: none;
  }

  .menu-link:hover {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .is-home {
    color: var(--ink);
  }

  .menu-cta {
    margin-left: auto;
    border-right: none;
    background: var(--ink);
    color: var(--white);
  }

  .menu-cta:hover {
    background: #000;
    color: var(--white);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 10px;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform var(--t), opacity var(--t);
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .site-header {
      position: static;
    }

    .header-main {
      border-bottom: 2px solid var(--ink);
      padding: 0.9rem 0;
    }

    .nav-toggle {
      display: flex;
    }

    .brand-name {
      font-size: 1.25rem;
    }

    .brand svg {
      width: 46px;
      height: 46px;
    }

    .menu-link {
      display: none;
    }

    .menubar-wrap {
      display: none;
    }

    .menubar-wrap.open {
      display: block;
    }

    .menubar {
      flex-wrap: wrap;
      padding: 0.5rem 0;
      min-height: 0;
    }

    .menubar-wrap.open .menu-link {
      display: flex;
      width: 100%;
      height: auto;
      padding: 0.85rem 0.75rem;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .menubar-wrap.open .menu-cta {
      margin-left: 0;
      margin-top: 0.5rem;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .topbar-left {
      display: none;
    }

    .topbar-inner {
      justify-content: flex-end;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const wrap = document.querySelector('.menubar-wrap');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    wrap?.classList.toggle('open', !open);
  });

  wrap?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      wrap?.classList.remove('open');
    });
  });
</script>
