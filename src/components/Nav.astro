---
import SheepLogo from './SheepLogo.astro';

const navGroups = [
  {
    title: 'Ovis Tools',
    id: 'ovis-tools',
    items: [
      { label: 'NYTools', href: '/nytools/', external: false },
      { label: '羊監視你', href: '/cctv', external: false },
      { label: '羊集章', href: '/badges/', external: false },
      { label: '單字測驗', href: '/vocab/', external: false },
    ],
  },
  {
    title: '主要服務',
    id: 'main-services',
    items: [
      { label: '羊愛考試', href: 'https://1ztests.nsir.uk', external: true },
      { label: '羊-短網址', href: 'https://nsir.uk', external: true },
    ],
  },
];
---

<header class="site-header">
  <!-- 頂部黑條 (Topbar) -->
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-right">
        <a href="/">首頁</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <a href="#news">最新消息</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <a href="/vip/">VIP 專區</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <span class="topbar-user" id="topbar-user" hidden>
          <span id="topbar-username"></span>
          <button class="topbar-logout" id="topbar-logout" type="button">登出</button>
        </span>
      </span>
    </div>
  </div>

  <!-- 主品牌列 (Header Main) -->
  <div class="header-main container">
    <a class="brand" href="/">
      <SheepLogo size={58} />
      <span class="brand-text">
        <span class="brand-name">OviNas</span>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="切換選單"
    >
      <svg width="22" height="18" viewBox="0 0 22 18" fill="none" aria-hidden="true">
        <rect y="0" width="22" height="3" fill="#1c1c1c" />
        <rect y="7.5" width="22" height="3" fill="#1c1c1c" />
        <rect y="15" width="22" height="3" fill="#1c1c1c" />
      </svg>
    </button>
  </div>

  <!-- 白色選單條 (Menubar Wrap) -->
  <div class="menubar-wrap" id="nav-menu">
    <nav class="menubar container" aria-label="主導覽">
      <a class="nav-item is-home" href="/">首頁</a>

      {
        navGroups.map((group) => (
          <div class="nav-dropdown" data-group={group.id}>
            <button
              class="nav-dropdown-trigger"
              type="button"
              aria-expanded="false"
            >
              <span>{group.title}</span>
              <span class="desktop-caret" aria-hidden="true">▾</span>
              <span class="mobile-plus" aria-hidden="true">+</span>
            </button>
            <div class="nav-dropdown-menu">
              {group.items.map((item) => (
                <a
                  class="nav-sub-item"
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  <span>{item.label}</span>
                  {item.external && <span class="nav-ext" aria-hidden="true">↗</span>}
                </a>
              ))}
            </div>
          </div>
        ))
      }

      <a class="nav-item nav-cta" href="/reserve/">
        預約系統
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
  }

  /* 頂部黑條 */
  .topbar {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 32px;
  }

  .topbar a {
    transition: color var(--t);
  }

  .topbar a:hover {
    color: var(--white);
  }

  .topbar-sep {
    margin: 0 0.5rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .topbar-user {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .topbar-user[hidden] {
    display: none;
  }

  .topbar-logout {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--white);
    cursor: pointer;
  }

  .topbar-logout:hover {
    text-decoration: underline;
  }

  /* 主標題列 */
  .header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0 1.1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink);
  }

  .brand svg,
  .brand img {
    filter: drop-shadow(0 4px 8px rgba(28, 28, 28, 0.2));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: pointer;
  }

  /* 🖥️ 桌面版白色選單列 (Desktop Menubar) */
  .menubar-wrap {
    border-top: 1px solid var(--border);
    border-bottom: 2px solid var(--ink);
    background: var(--surface);
    position: relative;
  }

  .menubar {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    min-height: 48px;
    width: 100%;
  }

  /* 一般選單連結 */
  .nav-item {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 1.35rem;
    font-size: 0.92rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    border-right: 1px solid var(--border);
    white-space: nowrap;
    flex-shrink: 0;
    transition: background var(--t), color var(--t);
  }

  .nav-item:hover {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .nav-item.is-home {
    color: var(--ink);
  }

  /* 下拉群組容器 */
  .nav-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 48px;
    border-right: 1px solid var(--border);
    flex-shrink: 0;
  }

  .nav-dropdown-trigger {
    appearance: none;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    padding: 0 1.35rem;
    height: 100%;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--t), color var(--t);
  }

  .nav-dropdown:hover .nav-dropdown-trigger,
  .nav-dropdown:focus-within .nav-dropdown-trigger {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .desktop-caret {
    font-size: 0.72rem;
    transition: transform var(--t);
  }

  .nav-dropdown:hover .desktop-caret {
    transform: rotate(180deg);
  }

  .mobile-plus {
    display: none;
  }

  /* 下拉子選單面板 (Desktop) */
  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 175px;
    background: var(--surface);
    border: 1.5px solid var(--ink);
    box-shadow: 4px 4px 0px rgba(28, 28, 28, 0.12);
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
    z-index: 200;
  }

  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-sub-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.1rem;
    font-size: 0.88rem;
    color: var(--ink-2);
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    transition: background var(--t), color var(--t);
  }

  .nav-sub-item:last-child {
    border-bottom: none;
  }

  .nav-sub-item:hover {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .nav-ext {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  /* 右側 CTA 預約系統按鈕 */
  .nav-cta {
    margin-left: auto;
    border-right: none;
    font-weight: 500;
    background: var(--ink);
    color: var(--white);
  }

  .nav-cta:hover {
    background: #000;
    color: var(--white);
  }

  /* 📱 手機與平板版 (Mobile / Tablet < 900px) */
  @media (max-width: 900px) {
    .site-header {
      position: static;
    }

    .header-main {
      border-bottom: 2px solid var(--ink);
      padding: 0.9rem 0;
    }

    .nav-toggle {
      display: flex;
    }

    .brand-name {
      font-size: 1.25rem;
    }

    .brand svg,
    .brand img {
      width: 44px;
      height: 44px;
    }

    /* 手機版選單容器預設完全隱藏 */
    .menubar-wrap {
      display: none;
      border-top: none;
    }

    .menubar-wrap.is-open {
      display: block;
    }

    .menubar {
      flex-direction: column;
      align-items: stretch;
      padding: 0;
      min-height: 0;
    }

    .nav-item {
      width: 100%;
      height: auto;
      padding: 0.9rem 1rem;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .nav-dropdown {
      width: 100%;
      height: auto;
      flex-direction: column;
      align-items: stretch;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .nav-dropdown-trigger {
      width: 100%;
      height: auto;
      padding: 0.9rem 1rem;
      justify-content: space-between;
    }

    .desktop-caret {
      display: none;
    }

    .mobile-plus {
      display: inline-block;
      font-size: 1.3rem;
      font-weight: 600;
      line-height: 1;
      color: var(--ink);
      width: 24px;
      height: 24px;
      text-align: center;
    }

    /* 手機版折疊面板 */
    .nav-dropdown-menu {
      position: static;
      display: none;
      min-width: 0;
      box-shadow: none;
      border: none;
      border-top: 1px solid var(--border);
      background: var(--bg-soft);
      transform: none;
      opacity: 1;
      visibility: visible;
    }

    .nav-dropdown.expanded .nav-dropdown-menu {
      display: flex;
    }

    .nav-sub-item {
      padding: 0.85rem 1.6rem;
      border-bottom: 1px dashed var(--border);
    }

    .menubar-wrap.is-open .nav-cta {
      margin-left: 0;
      margin-top: 0.4rem;
      margin-bottom: 0.8rem;
      justify-content: center;
      border-radius: 4px;
    }
  }

  @media (max-width: 480px) {
    .topbar-inner {
      justify-content: flex-end;
    }
  }
</style>

<script>
  import { currentUser, logout } from '../scripts/auth';

  // 手機版漢堡開關
  const toggleBtn = document.querySelector('.nav-toggle');
  const menuWrap = document.querySelector('.menubar-wrap');

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    menuWrap?.classList.toggle('is-open', !isExpanded);
  });

  // 手機版手風琴 (+ / -)
  const dropdownContainers = document.querySelectorAll('.nav-dropdown');
  dropdownContainers.forEach((dropdown) => {
    const trigger = dropdown.querySelector('.nav-dropdown-trigger');
    const plusIcon = dropdown.querySelector('.mobile-plus');

    trigger?.addEventListener('click', (e) => {
      if (window.innerWidth <= 900) {
        e.preventDefault();
        const isExpanded = dropdown.classList.toggle('expanded');
        trigger.setAttribute('aria-expanded', String(isExpanded));
        if (plusIcon) {
          plusIcon.textContent = isExpanded ? '−' : '+';
        }
      }
    });
  });

  // 點擊子連結後自動收合
  menuWrap?.querySelectorAll('.nav-sub-item, .nav-item:not(.nav-dropdown-trigger)').forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 900) {
        toggleBtn?.setAttribute('aria-expanded', 'false');
        menuWrap?.classList.remove('is-open');
      }
    });
  });

  // Topbar 使用者狀態
  const userBox = document.getElementById('topbar-user');
  const userName = document.getElementById('topbar-username');
  const logoutBtn = document.getElementById('topbar-logout');

  function renderTopbarUser() {
    const user = currentUser();
    if (!user || !userBox || !userName) return;
    userName.textContent = user.displayName;
    userBox.hidden = false;
  }

  logoutBtn?.addEventListener('click', async () => {
    await logout();
    window.location.href = '/';
  });

  renderTopbarUser();
</script>
