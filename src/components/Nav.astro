---
import SheepLogo from './SheepLogo.astro';

const links = [
  { label: '羊-短網址', href: 'https://nsir.uk', external: true },
  { label: '羊監視你', href: '/cctv', external: false },
  { label: '羊愛考試', href: 'https://1ztests.nsir.uk', external: true },
];
---

<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-left">OviNas</span>
      <span class="topbar-right">
        <a href="/">首頁</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <a href="#news">最新消息</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <a href="/vip/">VIP 專區</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <span class="topbar-user" id="topbar-user" hidden>
          <span id="topbar-username"></span>
          <button class="topbar-logout" id="topbar-logout" type="button">登出</button>
        </span>
      </span>
    </div>
  </div>

  <div class="header-main container">
    <a class="brand" href="/">
      <SheepLogo size={58} />
      <span class="brand-text">
        <span class="brand-name">OviNas</span>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="開啟選單"
    >
      <svg width="22" height="18" viewBox="0 0 22 18" fill="none" aria-hidden="true">
        <rect y="0" width="22" height="3" fill="#1c1c1c" />
        <rect y="7.5" width="22" height="3" fill="#1c1c1c" />
        <rect y="15" width="22" height="3" fill="#1c1c1c" />
      </svg>
    </button>
  </div>

  <div class="menubar-wrap" id="nav-menu">
    <nav class="menubar container" aria-label="主導覽">
      <a class="menu-link is-home" href="/">首頁</a>
      {
        links.map((link) => (
          <a
            class="menu-link"
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="menu-link menu-cta" href="/reserve/">
        預約系統
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
  }

  .topbar {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 32px;
  }

  .topbar a {
    transition: color var(--t);
  }

  .topbar a:hover {
    color: var(--white);
  }

  .topbar-sep {
    margin: 0 0.5rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .topbar-user {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .topbar-user[hidden] {
    display: none;
  }

  .topbar-logout {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--white);
    cursor: pointer;
  }

  .topbar-logout:hover {
    text-decoration: underline;
  }

  .header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0 1.1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink);
  }

  .brand svg,
  .brand img {
    filter: drop-shadow(0 4px 8px rgba(28, 28, 28, 0.2));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .menubar-wrap {
    border-top: 1px solid var(--border);
    border-bottom: 2px solid var(--ink);
    background: var(--surface);
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 0;
    min-height: 48px;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 1.35rem;
    height: 48px;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    border-right: 1px solid var(--border);
    transition: background var(--t), color var(--t);
  }

  .menu-link:first-child {
    border-left: none;
  }

  .menu-link:hover {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .is-home {
    color: var(--ink);
  }

  .menu-cta {
    margin-left: auto;
    border-right: none;
    font-weight: 500;
    background: var(--ink);
    color: var(--white);
  }

  .menu-cta:hover {
    background: #000;
    color: var(--white);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .nav-toggle svg {
    display: block;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .site-header {
      position: static;
    }

    .header-main {
      border-bottom: 2px solid var(--ink);
      padding: 0.9rem 0;
    }

    .nav-toggle {
      display: flex;
    }

    .brand-name {
      font-size: 1.25rem;
    }

    .brand svg,
    .brand img {
      width: 46px;
      height: 46px;
    }

    .menu-link {
      display: none;
    }

    .menubar-wrap {
      display: none;
    }

    .menubar-wrap.open {
      display: block;
    }

    .menubar {
      flex-wrap: wrap;
      padding: 0.5rem 0;
      min-height: 0;
    }

    .menubar-wrap.open .menu-link {
      display: flex;
      width: 100%;
      height: auto;
      padding: 0.85rem 0.75rem;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .menubar-wrap.open .menu-cta {
      margin-left: 0;
      margin-top: 0.5rem;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .topbar-left {
      display: none;
    }

    .topbar-inner {
      justify-content: flex-end;
    }
  }
</style>

<script>
  import { currentUser, logout } from '../scripts/auth';

  const toggle = document.querySelector('.nav-toggle');
  const wrap = document.querySelector('.menubar-wrap');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    wrap?.classList.toggle('open', !open);
  });

  wrap?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      wrap?.classList.remove('open');
    });
  });

  const userBox = document.getElementById('topbar-user');
  const userName = document.getElementById('topbar-username');
  const logoutBtn = document.getElementById('topbar-logout');

  function renderTopbarUser() {
    const user = currentUser();
    if (!user || !userBox || !userName) return;
    userName.textContent = user.displayName;
    userBox.hidden = false;
  }

  logoutBtn?.addEventListener('click', async () => {
    await logout();
    window.location.href = '/';
  });

  renderTopbarUser();
</script>
