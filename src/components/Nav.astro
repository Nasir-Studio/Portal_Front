---
import SheepLogo from './SheepLogo.astro';

const navGroups = [
  {
    title: 'Ovis Tools',
    id: 'ovis-tools',
    items: [
      { label: 'NYTools', href: '/nytools/', external: false },
      { label: '羊監視你', href: '/cctv', external: false },
      { label: '羊集章', href: '/badges/', external: false },
      { label: '單字測驗', href: '/vocab/', external: false },
    ],
  },
  {
    title: '主要服務',
    id: 'main-services',
    items: [
      { label: '羊愛考試', href: 'https://1ztests.nsir.uk', external: true },
      { label: '羊-短網址', href: 'https://nsir.uk', external: true },
    ],
  },
];
---

<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-right">
        <a href="/">首頁</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <a href="#news">最新消息</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <a href="/vip/">VIP 專區</a>
        <span class="topbar-sep" aria-hidden="true">｜</span>
        <span class="topbar-user" id="topbar-user" hidden>
          <span id="topbar-username"></span>
          <button class="topbar-logout" id="topbar-logout" type="button">登出</button>
        </span>
      </span>
    </div>
  </div>

  <div class="header-main container">
    <a class="brand" href="/">
      <SheepLogo size={58} />
      <span class="brand-text">
        <span class="brand-name">OviNas</span>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="開啟選單"
    >
      <svg width="22" height="18" viewBox="0 0 22 18" fill="none" aria-hidden="true">
        <rect y="0" width="22" height="3" fill="#1c1c1c" />
        <rect y="7.5" width="22" height="3" fill="#1c1c1c" />
        <rect y="15" width="22" height="3" fill="#1c1c1c" />
      </svg>
    </button>
  </div>

  <div class="menubar-wrap" id="nav-menu">
    <nav class="menubar container" aria-label="主導覽">
      <a class="menu-link is-home" href="/">首頁</a>

      {
        navGroups.map((group) => (
          <div class="menu-dropdown-group" data-group={group.id}>
            <button
              class="menu-dropdown-btn"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span>{group.title}</span>
              <span class="arrow-desktop" aria-hidden="true">▾</span>
              <span class="toggle-mobile" aria-hidden="true">+</span>
            </button>
            <div class="dropdown-panel">
              {group.items.map((item) => (
                <a
                  class="dropdown-sublink"
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  <span>{item.label}</span>
                  {item.external && <span class="ext-icon" aria-hidden="true">↗</span>}
                </a>
              ))}
            </div>
          </div>
        ))
      }

      <a class="menu-link menu-cta" href="/reserve/">
        預約系統
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
  }

  .topbar {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 32px;
  }

  .topbar a {
    transition: color var(--t);
  }

  .topbar a:hover {
    color: var(--white);
  }

  .topbar-sep {
    margin: 0 0.5rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .topbar-user {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .topbar-user[hidden] {
    display: none;
  }

  .topbar-logout {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--white);
    cursor: pointer;
  }

  .topbar-logout:hover {
    text-decoration: underline;
  }

  .header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0 1.1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink);
  }

  .brand svg,
  .brand img {
    filter: drop-shadow(0 4px 8px rgba(28, 28, 28, 0.2));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .menubar-wrap {
    border-top: 1px solid var(--border);
    border-bottom: 2px solid var(--ink);
    background: var(--surface);
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 0;
    min-height: 48px;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 1.35rem;
    height: 48px;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    border-right: 1px solid var(--border);
    transition: background var(--t), color var(--t);
  }

  .menu-link:hover {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .is-home {
    color: var(--ink);
  }

  /* 下拉群組 (Desktop) */
  .menu-dropdown-group {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 48px;
    border-right: 1px solid var(--border);
  }

  .menu-dropdown-btn {
    appearance: none;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    padding: 0 1.35rem;
    height: 100%;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    transition: background var(--t), color var(--t);
  }

  .menu-dropdown-group:hover .menu-dropdown-btn,
  .menu-dropdown-group:focus-within .menu-dropdown-btn {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .arrow-desktop {
    font-size: 0.72rem;
    transition: transform var(--t);
  }

  .menu-dropdown-group:hover .arrow-desktop {
    transform: rotate(180deg);
  }

  .toggle-mobile {
    display: none;
  }

  .dropdown-panel {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 175px;
    background: var(--surface);
    border: 1.5px solid var(--ink);
    box-shadow: 4px 4px 0px rgba(28, 28, 28, 0.12);
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
    z-index: 100;
  }

  .menu-dropdown-group:hover .dropdown-panel,
  .menu-dropdown-group:focus-within .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-sublink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.1rem;
    font-size: 0.9rem;
    color: var(--ink-2);
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--border);
    transition: background var(--t), color var(--t);
  }

  .dropdown-sublink:last-child {
    border-bottom: none;
  }

  .dropdown-sublink:hover {
    background: var(--bg-soft);
    color: var(--ink);
  }

  .ext-icon {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .menu-cta {
    margin-left: auto;
    border-right: none;
    font-weight: 500;
    background: var(--ink);
    color: var(--white);
  }

  .menu-cta:hover {
    background: #000;
    color: var(--white);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .nav-toggle svg {
    display: block;
    flex-shrink: 0;
  }

  /* 📱 手機版選單 (含折疊展開 +/-) */
  @media (max-width: 900px) {
    .site-header {
      position: static;
    }

    .header-main {
      border-bottom: 2px solid var(--ink);
      padding: 0.9rem 0;
    }

    .nav-toggle {
      display: flex;
    }

    .brand-name {
      font-size: 1.25rem;
    }

    .brand svg,
    .brand img {
      width: 46px;
      height: 46px;
    }

    .menubar-wrap {
      display: none;
    }

    .menubar-wrap.open {
      display: block;
    }

    .menubar {
      flex-direction: column;
      align-items: stretch;
      padding: 0.5rem 0;
      min-height: 0;
    }

    .menu-link {
      width: 100%;
      height: auto;
      padding: 0.85rem 0.75rem;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .menu-dropdown-group {
      width: 100%;
      height: auto;
      flex-direction: column;
      align-items: stretch;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .menu-dropdown-btn {
      width: 100%;
      height: auto;
      padding: 0.85rem 0.75rem;
      justify-content: space-between;
    }

    .arrow-desktop {
      display: none;
    }

    .toggle-mobile {
      display: inline-block;
      font-size: 1.2rem;
      font-weight: 600;
      line-height: 1;
      color: var(--ink);
      width: 24px;
      height: 24px;
      text-align: center;
      transition: transform var(--t);
    }

    .dropdown-panel {
      position: static;
      display: none;
      min-width: 0;
      box-shadow: none;
      border: none;
      border-top: 1px solid var(--border);
      background: var(--bg-soft);
      transform: none;
      opacity: 1;
      visibility: visible;
    }

    .menu-dropdown-group.is-open .dropdown-panel {
      display: flex;
    }

    .dropdown-sublink {
      padding: 0.75rem 1.4rem;
      border-bottom: 1px dashed var(--border);
    }

    .menubar-wrap.open .menu-cta {
      margin-left: 0;
      margin-top: 0.5rem;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .topbar-inner {
      justify-content: flex-end;
    }
  }
</style>

<script>
  import { currentUser, logout } from '../scripts/auth';

  const toggle = document.querySelector('.nav-toggle');
  const wrap = document.querySelector('.menubar-wrap');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    wrap?.classList.toggle('open', !open);
  });

  // 手機版折疊展開 (+ / -)
  const dropdownGroups = document.querySelectorAll('.menu-dropdown-group');
  dropdownGroups.forEach((group) => {
    const btn = group.querySelector('.menu-dropdown-btn');
    const toggleIcon = group.querySelector('.toggle-mobile');

    btn?.addEventListener('click', (e) => {
      if (window.innerWidth <= 900) {
        e.preventDefault();
        const isOpen = group.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(isOpen));
        if (toggleIcon) {
          toggleIcon.textContent = isOpen ? '−' : '+';
        }
      }
    });
  });

  wrap?.querySelectorAll('.dropdown-sublink, .menu-link:not(.menu-dropdown-btn)').forEach((a) => {
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      wrap?.classList.remove('open');
    });
  });

  const userBox = document.getElementById('topbar-user');
  const userName = document.getElementById('topbar-username');
  const logoutBtn = document.getElementById('topbar-logout');

  function renderTopbarUser() {
    const user = currentUser();
    if (!user || !userBox || !userName) return;
    userName.textContent = user.displayName;
    userBox.hidden = false;
  }

  logoutBtn?.addEventListener('click', async () => {
    await logout();
    window.location.href = '/';
  });

  renderTopbarUser();
</script>
