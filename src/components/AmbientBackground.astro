---
---

<div class="ambient-bg" aria-hidden="true">
  <!-- 柔和呼吸流動光暈 (故事感氛圍) -->
  <div class="ambient-orb orb-1"></div>
  <div class="ambient-orb orb-2"></div>
  <div class="ambient-orb orb-3"></div>

  <!-- 手稿幾何微點座標格網 (日記本質感) -->
  <div class="ambient-grid"></div>

  <!-- 漂浮微光星塵粒子 -->
  <div class="ambient-dust dust-1"></div>
  <div class="ambient-dust dust-2"></div>
  <div class="ambient-dust dust-3"></div>
  <div class="ambient-dust dust-4"></div>
  <div class="ambient-dust dust-5"></div>
</div>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: var(--bg);
  }

  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.6;
    will-change: transform;
  }

  .orb-1 {
    top: -10%;
    left: -5%;
    width: 55vw;
    height: 55vw;
    max-width: 680px;
    max-height: 680px;
    background: radial-gradient(circle, rgba(243, 228, 196, 0.55) 0%, rgba(243, 228, 196, 0) 70%);
    animation: drift-1 26s ease-in-out infinite alternate;
  }

  .orb-2 {
    bottom: -15%;
    right: -8%;
    width: 60vw;
    height: 60vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(circle, rgba(218, 229, 244, 0.52) 0%, rgba(218, 229, 244, 0) 70%);
    animation: drift-2 32s ease-in-out infinite alternate;
  }

  .orb-3 {
    top: 40%;
    left: 45%;
    width: 45vw;
    height: 45vw;
    max-width: 550px;
    max-height: 550px;
    background: radial-gradient(circle, rgba(245, 234, 226, 0.48) 0%, rgba(245, 234, 226, 0) 70%);
    animation: drift-3 22s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(8vw, 12vh, 0) scale(1.15);
    }
    100% {
      transform: translate3d(14vw, 4vh, 0) scale(0.95);
    }
  }

  @keyframes drift-2 {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(-10vw, -14vh, 0) scale(1.12);
    }
    100% {
      transform: translate3d(-16vw, -6vh, 0) scale(0.9);
    }
  }

  @keyframes drift-3 {
    0% {
      transform: translate3d(0, 0, 0) scale(0.95);
      opacity: 0.35;
    }
    50% {
      transform: translate3d(-8vw, 10vh, 0) scale(1.1);
      opacity: 0.6;
    }
    100% {
      transform: translate3d(6vw, -8vh, 0) scale(1);
      opacity: 0.4;
    }
  }

  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(28, 28, 28, 0.055) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse at 50% 50%, black 40%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 40%, transparent 95%);
    opacity: 0.85;
  }

  /* 漂浮星塵 */
  .ambient-dust {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #deb86d;
    border-radius: 50%;
    box-shadow: 0 0 6px #deb86d;
    opacity: 0;
    will-change: transform, opacity;
  }

  .dust-1 {
    top: 20%;
    left: 15%;
    animation: float-dust 14s ease-in-out infinite 0s;
  }

  .dust-2 {
    top: 60%;
    left: 80%;
    animation: float-dust 18s ease-in-out infinite 3s;
  }

  .dust-3 {
    top: 75%;
    left: 25%;
    animation: float-dust 16s ease-in-out infinite 6s;
  }

  .dust-4 {
    top: 35%;
    left: 70%;
    animation: float-dust 20s ease-in-out infinite 9s;
  }

  .dust-5 {
    top: 85%;
    left: 55%;
    animation: float-dust 15s ease-in-out infinite 1.5s;
  }

  @keyframes float-dust {
    0% {
      transform: translate3d(0, 20px, 0) scale(0.6);
      opacity: 0;
    }
    30% {
      opacity: 0.75;
    }
    70% {
      opacity: 0.6;
    }
    100% {
      transform: translate3d(-20px, -60px, 0) scale(1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-orb,
    .ambient-dust {
      animation: none !important;
    }
  }
</style>
