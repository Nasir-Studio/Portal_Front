---
---

<div class="ambient-bg" aria-hidden="true">
  <!-- 📜 復古手稿細緻點陣 (Vintage Halftone / Drafting Matrix) -->
  <div class="ambient-grid"></div>

  <!-- 🖋️ 復古深色古典銅版畫與等高線波紋 (Vintage Dark Engraving Waves) -->
  <div class="engraving-wrap wrap-top">
    <svg class="engraving-svg wave-1" viewBox="0 0 1440 380" fill="none">
      <path
        d="M-50 160 C 260 280, 520 40, 890 170 C 1190 270, 1370 80, 1510 190"
        stroke="#1c1c1c"
        stroke-width="1.8"
        opacity="0.35"
      />
      <path
        d="M-50 180 C 260 300, 520 60, 890 190 C 1190 290, 1370 100, 1510 210"
        stroke="#1c1c1c"
        stroke-width="1.2"
        stroke-dasharray="6 6"
        opacity="0.25"
      />
      <path
        d="M-50 200 C 260 320, 520 80, 890 210 C 1190 310, 1370 120, 1510 230"
        stroke="#3d332a"
        stroke-width="1.4"
        opacity="0.28"
      />
      <path
        d="M-50 220 C 260 340, 520 100, 890 230 C 1190 330, 1370 140, 1510 250"
        stroke="#1c1c1c"
        stroke-width="0.8"
        stroke-dasharray="2 4"
        opacity="0.2"
      />
    </svg>
  </div>

  <div class="engraving-wrap wrap-bottom">
    <svg class="engraving-svg wave-2" viewBox="0 0 1440 380" fill="none">
      <path
        d="M-40 220 C 310 90, 620 310, 960 170 C 1260 50, 1390 260, 1500 140"
        stroke="#1c1c1c"
        stroke-width="1.8"
        opacity="0.32"
      />
      <path
        d="M-40 200 C 310 70, 620 290, 960 150 C 1260 30, 1390 240, 1500 120"
        stroke="#3d332a"
        stroke-width="1.2"
        stroke-dasharray="5 5"
        opacity="0.24"
      />
      <path
        d="M-40 180 C 310 50, 620 270, 960 130 C 1260 10, 1390 220, 1500 100"
        stroke="#1c1c1c"
        stroke-width="1.4"
        opacity="0.26"
      />
    </svg>
  </div>

  <!-- 🧭 復古古典對位印刷圓環與羅盤刻度 (Vintage Register & Compass Art) -->
  <div class="vintage-glyph glyph-right">
    <svg viewBox="0 0 240 240" width="220" height="220" fill="none">
      <!-- 外部刻度環 -->
      <circle cx="120" cy="120" r="105" stroke="#1c1c1c" stroke-width="1.5" stroke-dasharray="4 8" opacity="0.4" />
      <circle cx="120" cy="120" r="90" stroke="#3d332a" stroke-width="1.2" opacity="0.3" />
      <circle cx="120" cy="120" r="70" stroke="#1c1c1c" stroke-width="1" stroke-dasharray="8 4" opacity="0.25" />

      <!-- 十字對位標線 -->
      <line x1="120" y1="5" x2="120" y2="235" stroke="#1c1c1c" stroke-width="1" stroke-dasharray="4 4" opacity="0.35" />
      <line x1="5" y1="120" x2="235" y2="120" stroke="#1c1c1c" stroke-width="1" stroke-dasharray="4 4" opacity="0.35" />

      <!-- 復古核心圓點 -->
      <circle cx="120" cy="120" r="5" fill="#1c1c1c" opacity="0.6" />
      <circle cx="120" cy="15" r="3.5" fill="#1c1c1c" opacity="0.5" />
      <circle cx="225" cy="120" r="3.5" fill="#1c1c1c" opacity="0.5" />
      <circle cx="120" cy="225" r="3.5" fill="#1c1c1c" opacity="0.5" />
      <circle cx="15" cy="120" r="3.5" fill="#1c1c1c" opacity="0.5" />
    </svg>
  </div>

  <div class="vintage-glyph glyph-left">
    <svg viewBox="0 0 180 180" width="160" height="160" fill="none">
      <circle cx="90" cy="90" r="75" stroke="#1c1c1c" stroke-width="1.4" stroke-dasharray="6 6" opacity="0.32" />
      <circle cx="90" cy="90" r="50" stroke="#3d332a" stroke-width="1" opacity="0.22" />
      <circle cx="90" cy="90" r="28" stroke="#1c1c1c" stroke-width="1.2" stroke-dasharray="2 4" opacity="0.35" />
      <circle cx="90" cy="90" r="4" fill="#1c1c1c" opacity="0.5" />
    </svg>
  </div>

  <!-- ⌜ ⌝ 四周古典直角對位角標 (Corner Registration Marks) -->
  <div class="corner-mark top-left"></div>
  <div class="corner-mark top-right"></div>
  <div class="corner-mark bottom-left"></div>
  <div class="corner-mark bottom-right"></div>

  <!-- ❖ 深色復古菱形印記漂浮 (Vintage Diamond Floats) -->
  <div class="diamond-drift d1">❖</div>
  <div class="diamond-drift d2">❖</div>
  <div class="diamond-drift d3">❖</div>
</div>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: #ffffff;
  }

  /* 手稿點陣 */
  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(28, 28, 28, 0.08) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 95%);
    opacity: 0.85;
  }

  /* 🖋️ 復古銅版畫波紋 */
  .engraving-wrap {
    position: absolute;
    left: 0;
    right: 0;
    width: 100%;
    pointer-events: none;
  }

  .wrap-top {
    top: 4%;
    opacity: 0.9;
  }

  .wrap-bottom {
    bottom: 6%;
    opacity: 0.85;
  }

  .engraving-svg {
    width: 120%;
    height: auto;
    display: block;
    margin-left: -10%;
    will-change: transform;
  }

  .wave-1 {
    animation: wave-float-1 22s ease-in-out infinite alternate;
  }

  .wave-2 {
    animation: wave-float-2 26s ease-in-out infinite alternate;
  }

  @keyframes wave-float-1 {
    0% { transform: translate3d(0, 0, 0) scaleY(1); }
    50% { transform: translate3d(-3%, 16px, 0) scaleY(1.1); }
    100% { transform: translate3d(2%, -12px, 0) scaleY(0.95); }
  }

  @keyframes wave-float-2 {
    0% { transform: translate3d(0, 0, 0) scaleY(1); }
    50% { transform: translate3d(3%, -18px, 0) scaleY(1.12); }
    100% { transform: translate3d(-2%, 14px, 0) scaleY(0.92); }
  }

  /* 🧭 復古印刷刻度圓環 */
  .vintage-glyph {
    position: absolute;
    pointer-events: none;
    will-change: transform;
  }

  .glyph-right {
    top: 14%;
    right: 4%;
    animation: rotate-glyph-1 120s linear infinite, float-glyph-1 18s ease-in-out infinite alternate;
  }

  .glyph-left {
    bottom: 20%;
    left: 3%;
    animation: rotate-glyph-2 140s linear infinite reverse, float-glyph-2 22s ease-in-out infinite alternate;
  }

  @keyframes rotate-glyph-1 {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes rotate-glyph-2 {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes float-glyph-1 {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-15px, 20px, 0); }
  }

  @keyframes float-glyph-2 {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(18px, -24px, 0); }
  }

  /* ⌜ ⌝ 四周角標 */
  .corner-mark {
    position: absolute;
    width: 20px;
    height: 20px;
    border-color: rgba(28, 28, 28, 0.35);
    border-style: solid;
    pointer-events: none;
  }

  .top-left {
    top: 18px;
    left: 18px;
    border-width: 1.5px 0 0 1.5px;
  }

  .top-right {
    top: 18px;
    right: 18px;
    border-width: 1.5px 1.5px 0 0;
  }

  .bottom-left {
    bottom: 18px;
    left: 18px;
    border-width: 0 0 1.5px 1.5px;
  }

  .bottom-right {
    bottom: 18px;
    right: 18px;
    border-width: 0 1.5px 1.5px 0;
  }

  /* ❖ 漂浮深色菱形 */
  .diamond-drift {
    position: absolute;
    font-size: 11px;
    color: #1c1c1c;
    opacity: 0;
    will-change: transform, opacity;
    animation: float-diamond 12s ease-in-out infinite;
  }

  .d1 { top: 22%; left: 10%; animation-delay: 0s; }
  .d2 { top: 65%; left: 86%; animation-delay: 4s; }
  .d3 { top: 78%; left: 20%; animation-delay: 8s; }

  @keyframes float-diamond {
    0% { transform: scale(0.6) rotate(0deg); opacity: 0; }
    40% { opacity: 0.45; transform: scale(1.1) rotate(45deg); }
    80% { opacity: 0.35; transform: scale(0.9) rotate(90deg); }
    100% { transform: scale(0.6) rotate(135deg); opacity: 0; }
  }

  @media (max-width: 768px) {
    .vintage-glyph,
    .corner-mark {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .engraving-svg,
    .vintage-glyph,
    .diamond-drift {
      animation: none !important;
    }
  }
</style>
