<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: #ffffff;
  }

  /* 復古古籍紙質點陣 */
  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(28, 28, 28, 0.1) 1.2px, transparent 1.2px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at 50% 50%, black 60%, transparent 98%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 60%, transparent 98%);
    opacity: 0.9;
  }

  /* 📜 古典版畫通用圖層樣式 */
  .vintage-plate {
    position: absolute;
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 2px 8px rgba(28, 28, 28, 0.04));
  }

  /* 🏰 1. 城堡 (右上角) */
  .plate-castle {
    top: 2%;
    right: 2%;
    opacity: 0.88;
    animation: float-castle 26s ease-in-out infinite alternate;
  }

  @keyframes float-castle {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-15px, 18px, 0); }
  }

  /* 🎼 2. 音樂五線譜與琴身 (左上角) */
  .plate-music {
    top: 3%;
    left: 2%;
    opacity: 0.85;
    animation: float-music 22s ease-in-out infinite alternate;
  }

  @keyframes float-music {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(18px, 14px, 0); }
  }

  /* 📜 3. 作家羽毛筆、墨水瓶與古籍 (左下角) */
  .plate-writer {
    bottom: 3%;
    left: 2%;
    opacity: 0.9;
    animation: float-writer 24s ease-in-out infinite alternate;
  }

  @keyframes float-writer {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(14px, -18px, 0); }
  }

  /* 🏛️ 4. 希臘羅馬神殿 (右下角) */
  .plate-temple {
    bottom: 3%;
    right: 2%;
    opacity: 0.88;
    animation: float-temple 28s ease-in-out infinite alternate;
  }

  @keyframes float-temple {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-16px, -15px, 0); }
  }

  /* 🎶 漂浮音樂音符圖層 */
  .note-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .drifting-note {
    position: absolute;
    color: #1c1c1c;
    font-family: var(--font-serif), serif;
    line-height: 1;
    user-select: none;
    will-change: transform;
    opacity: 0.45;
    text-shadow: 0 3px 12px rgba(28, 28, 28, 0.08);
    transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease;
  }

  /* 𝄞 超大高音譜記號 (Treble Clefs - 大器藝術感) */
  .note-treble-1 {
    top: 55%;
    left: 11%;
    font-size: 84px;
    font-weight: 700;
    opacity: 0.52;
    animation: sway-note-1 16s ease-in-out infinite alternate;
  }

  .note-treble-2 {
    top: 22%;
    right: 14%;
    font-size: 72px;
    font-weight: 700;
    opacity: 0.48;
    animation: sway-note-2 19s ease-in-out infinite alternate;
  }

  /* 一般音符 (加大尺寸: 46px - 56px) */
  .note-1 {
    top: 15%;
    left: 18%;
    font-size: 48px;
    animation: sway-note-2 14s ease-in-out infinite alternate;
  }

  .note-2 {
    top: 36%;
    right: 22%;
    font-size: 54px;
    animation: sway-note-1 15s ease-in-out infinite alternate;
  }

  .note-3 {
    top: 75%;
    right: 16%;
    font-size: 56px;
    animation: sway-note-2 18s ease-in-out infinite alternate;
  }

  .note-4 {
    top: 46%;
    left: 88%;
    font-size: 32px;
    animation: sway-note-1 13s ease-in-out infinite alternate;
  }

  .note-5 {
    top: 18%;
    right: 38%;
    font-size: 50px;
    animation: sway-note-1 17s ease-in-out infinite alternate;
  }

  .note-6 {
    top: 80%;
    left: 36%;
    font-size: 52px;
    animation: sway-note-2 16s ease-in-out infinite alternate;
  }

  .note-7 {
    top: 42%;
    left: 6%;
    font-size: 46px;
    animation: sway-note-1 14s ease-in-out infinite alternate;
  }

  /* 自然優雅漫遊動畫 (Natural Ambient Drift) */
  @keyframes sway-note-1 {
    0% {
      transform: translate3d(0, 0, 0) rotate(-4deg);
    }
    50% {
      transform: translate3d(12px, -18px, 0) rotate(5deg);
    }
    100% {
      transform: translate3d(-10px, 16px, 0) rotate(-2deg);
    }
  }

  @keyframes sway-note-2 {
    0% {
      transform: translate3d(0, 0, 0) rotate(5deg);
    }
    50% {
      transform: translate3d(-14px, 20px, 0) rotate(-4deg);
    }
    100% {
      transform: translate3d(10px, -14px, 0) rotate(3deg);
    }
  }

  @media (max-width: 1024px) {
    .note-treble-1 { font-size: 64px; }
    .note-treble-2 { font-size: 56px; }
    .drifting-note { opacity: 0.35; }
  }

  @media (max-width: 768px) {
    .note-treble-1 { font-size: 52px; }
    .note-treble-2 { font-size: 44px; }
    .plate-castle,
    .plate-temple {
      display: none;
    }
    .plate-music,
    .plate-writer {
      opacity: 0.3;
      transform: scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vintage-plate,
    .drifting-note {
      animation: none !important;
    }
  }
</style>

<script>
  // 🎶 平滑優雅滾動視差微動 (Smooth Organic Parallax)
  const notes = document.querySelectorAll('.drifting-note');
  let currentScrollY = window.scrollY;
  let targetScrollY = window.scrollY;
  let isRunning = false;

  function updateNotesParallax() {
    // 柔和線性插值 (Smooth Lerp)
    currentScrollY += (targetScrollY - currentScrollY) * 0.08;

    notes.forEach((note, index) => {
      const el = note as HTMLElement;
      const speed = parseFloat(el.dataset.speed || '0.3');
      const dir = index % 2 === 0 ? 1 : -1;
      
      // 計算平滑柔和的垂直位移與輕微旋轉
      const offset = (currentScrollY * speed * 0.12) % 35;
      const rot = Math.sin(currentScrollY * 0.003 + index) * 6 * dir;
      
      el.style.transform = `translate3d(0, ${-offset}px, 0) rotate(${rot}deg)`;
    });

    if (Math.abs(targetScrollY - currentScrollY) > 0.2) {
      requestAnimationFrame(updateNotesParallax);
    } else {
      isRunning = false;
    }
  }

  window.addEventListener(
    'scroll',
    () => {
      targetScrollY = window.scrollY;
      if (!isRunning) {
        isRunning = true;
        requestAnimationFrame(updateNotesParallax);
      }
    },
    { passive: true }
  );
</script>
