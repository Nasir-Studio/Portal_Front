---
---

<div class="ambient-bg" aria-hidden="true">
  <!-- 📜 復古銅版紙質微點陣網 -->
  <div class="ambient-grid"></div>

  <!-- 🏰 1. 歐洲古典中世紀城堡與尖塔版畫 (Gothic & Medieval Castle Engraving - Top Right) -->
  <div class="vintage-plate plate-castle">
    <svg viewBox="0 0 420 320" width="380" height="290" fill="none">
      <!-- 城堡山崖基座與等高排線 (Castle Cliff & Hatching) -->
      <path d="M40 290 Q 120 270, 200 280 T 400 290" stroke="#1c1c1c" stroke-width="1.8" />
      <path d="M60 305 Q 160 285, 260 295 T 380 305" stroke="#1c1c1c" stroke-width="1.2" stroke-dasharray="3 3" />
      
      <!-- 主城塔樓 (Central Castle Keep & Spires) -->
      <g stroke="#1c1c1c" stroke-width="1.6" fill="#ffffff">
        <!-- 中央主尖塔 -->
        <polygon points="210,30 195,110 225,110" />
        <rect x="195" y="110" width="30" height="150" />
        <!-- 城垛 (Battlements) -->
        <path d="M190 110 H230 M193 110 V104 H200 V110 H206 V104 H213 V110 H220 V104 H227 V110" stroke-width="1.4" />
        
        <!-- 左翼尖塔 -->
        <polygon points="140,65 130,130 150,130" />
        <rect x="130" y="130" width="20" height="130" />
        <path d="M127 130 H153 M129 130 V125 H135 V130 H140 V125 H146 V130 H151 V125" stroke-width="1.2" />

        <!-- 右翼大鐘樓與圓頂 -->
        <polygon points="280,50 265,120 295,120" />
        <rect x="265" y="120" width="30" height="140" />
        <!-- 鐘樓鐘面 -->
        <circle cx="280" cy="145" r="7" stroke-width="1.2" />
        <line x1="280" y1="145" x2="280" y2="140" stroke-width="1" />
        <line x1="280" y1="145" x2="284" y2="145" stroke-width="1" />

        <!-- 連接城牆與拱門 (Connecting Ramparts & Archway) -->
        <rect x="150" y="180" width="45" height="80" />
        <rect x="225" y="180" width="40" height="80" />
        <!-- 拱形城門 -->
        <path d="M198 260 V225 C198 215, 222 215, 222 225 V260 Z" stroke-width="1.8" />
        <!-- 懸吊吊橋鏈 (Drawbridge Chains) -->
        <line x1="198" y1="225" x2="185" y2="260" stroke-dasharray="2 2" stroke-width="1" />
        <line x1="222" y1="225" x2="235" y2="260" stroke-dasharray="2 2" stroke-width="1" />
      </g>

      <!-- 哥德式窗花細部排線 (Gothic Windows & Shading Lines) -->
      <g stroke="#1c1c1c" stroke-width="1.2" opacity="0.8">
        <path d="M205 140 V155 C205 160, 215 160, 215 155 V140 Z" />
        <path d="M205 180 V195 C205 200, 215 200, 215 195 V180 Z" />
        <path d="M136 160 V175 C136 178, 144 178, 144 175 V160 Z" />
        <path d="M275 175 V190 C275 194, 285 194, 285 190 V175 Z" />
      </g>
    </svg>
  </div>

  <!-- 🎼 2. 巴洛克古典音樂五線譜與大提琴樂器 (Classical Music Staves & Cello - Top Left) -->
  <div class="vintage-plate plate-music">
    <svg viewBox="0 0 460 260" width="420" height="240" fill="none">
      <!-- 經典流動五線譜 (Curved Musical Staves) -->
      <g stroke="#1c1c1c" stroke-width="1.2" opacity="0.65">
        <path d="M10 60 Q 140 100, 280 40 T 450 70" />
        <path d="M10 70 Q 140 110, 280 50 T 450 80" />
        <path d="M10 80 Q 140 120, 280 60 T 450 90" />
        <path d="M10 90 Q 140 130, 280 70 T 450 100" />
        <path d="M10 100 Q 140 140, 280 80 T 450 110" />
      </g>

      <!-- 高音譜記號 (Treble Clef 𝄞) -->
      <path
        d="M65 125 C 60 110, 75 90, 80 75 C 85 60, 75 40, 68 40 C 60 40, 55 52, 60 65 C 65 78, 85 88, 80 110 C 75 130, 50 120, 50 105 C 50 92, 62 85, 70 95 M72 30 L72 135 C 72 148, 60 152, 55 145"
        stroke="#1c1c1c"
        stroke-width="2.2"
        stroke-linecap="round"
        fill="none"
      />

      <!-- 音符 (Musical Notes) -->
      <g fill="#1c1c1c" stroke="#1c1c1c">
        <!-- 音符 1 -->
        <ellipse cx="140" cy="98" rx="6" ry="4.5" transform="rotate(-20 140 98)" />
        <line x1="145" y1="96" x2="145" y2="55" stroke-width="1.8" />
        <path d="M145 55 Q 160 60, 165 72" stroke-width="1.8" fill="none" />

        <!-- 雙八分音符連槓 -->
        <ellipse cx="200" cy="78" rx="5.5" ry="4" transform="rotate(-20 200 78)" />
        <line x1="205" y1="76" x2="205" y2="35" stroke-width="1.8" />
        <ellipse cx="230" cy="68" rx="5.5" ry="4" transform="rotate(-20 230 68)" />
        <line x1="235" y1="66" x2="235" y2="25" stroke-width="1.8" />
        <polygon points="204,35 236,25 236,31 204,41" />

        <!-- 四分音符 -->
        <ellipse cx="320" cy="85" rx="6" ry="4.5" transform="rotate(-20 320 85)" />
        <line x1="325" y1="83" x2="325" y2="42" stroke-width="1.8" />
      </g>

      <!-- 巴洛克大提琴琴頭與 F 孔輪廓 (Cello / Violin Scroll & F-Hole) -->
      <g stroke="#1c1c1c" stroke-width="1.6" opacity="0.75">
        <!-- 經典 F 琴孔 -->
        <path d="M390 140 C 380 150, 385 165, 395 175 C 405 185, 400 200, 390 210" stroke-linecap="round" />
        <circle cx="388" cy="140" r="2.5" fill="#1c1c1c" />
        <circle cx="392" cy="210" r="2.5" fill="#1c1c1c" />
        <line x1="386" y1="175" x2="398" y2="175" stroke-width="1.4" />
      </g>
    </svg>
  </div>

  <!-- 📜 3. 古典作家羽毛筆、墨水瓶與羊皮紙古籍 (Writer's Quill, Ink & Antique Books - Bottom Left) -->
  <div class="vintage-plate plate-writer">
    <svg viewBox="0 0 380 280" width="340" height="250" fill="none">
      <!-- 堆疊的皮革古籍精裝書 (Stack of Antique Books) -->
      <g stroke="#1c1c1c" stroke-width="1.6" fill="#ffffff">
        <!-- 底層大書 -->
        <rect x="30" y="210" width="220" height="36" rx="2" />
        <line x1="45" y1="210" x2="45" y2="246" stroke-width="2" />
        <line x1="50" y1="210" x2="50" y2="246" stroke-width="1" />
        <!-- 書頁紋理排線 -->
        <line x1="240" y1="216" x2="248" y2="216" stroke-width="1" />
        <line x1="240" y1="224" x2="248" y2="224" stroke-width="1" />
        <line x1="240" y1="232" x2="248" y2="232" stroke-width="1" />
        <line x1="240" y1="240" x2="248" y2="240" stroke-width="1" />

        <!-- 中層書卷 -->
        <rect x="45" y="175" width="190" height="35" rx="2" />
        <line x1="60" y1="175" x2="60" y2="210" stroke-width="2" />
        <line x1="65" y1="175" x2="65" y2="210" stroke-width="1" />

        <!-- 頂層展開的手札羊皮紙 (Parchment Manuscript) -->
        <path d="M50 140 C 90 135, 140 145, 180 140 C 200 138, 220 145, 240 140 L230 175 L40 175 Z" />
        <!-- 手寫拉丁詩文排線 -->
        <line x1="65" y1="150" x2="160" y2="150" stroke="#1c1c1c" stroke-width="1" stroke-dasharray="5 3" opacity="0.7" />
        <line x1="65" y1="160" x2="180" y2="160" stroke="#1c1c1c" stroke-width="1" stroke-dasharray="4 2" opacity="0.7" />
      </g>

      <!-- 作家墨水瓶 (Antique Inkpot) -->
      <g stroke="#1c1c1c" stroke-width="1.6" fill="#ffffff">
        <rect x="255" y="195" width="45" height="50" rx="3" />
        <path d="M265 195 V185 H290 V195" stroke-width="1.8" />
        <circle cx="277" cy="220" r="10" stroke-width="1.2" />
        <!-- 墨水液面 -->
        <line x1="258" y1="228" x2="297" y2="228" stroke-dasharray="2 2" stroke-width="1" />
      </g>

      <!-- 復古鵝毛筆 (Vintage Feather Quill) -->
      <g stroke="#1c1c1c" stroke-width="1.6" fill="none">
        <!-- 羽毛筆梗與羽片曲線 -->
        <path
          d="M277 185 C 290 120, 330 60, 360 20 C 330 50, 310 90, 275 160"
          stroke-width="1.8"
          fill="#ffffff"
        />
        <!-- 羽毛細部紋理排線 -->
        <path d="M340 45 Q 355 55, 365 50" stroke-width="1" />
        <path d="M325 65 Q 345 78, 355 72" stroke-width="1" />
        <path d="M310 90 Q 330 105, 340 98" stroke-width="1" />
        <path d="M295 118 Q 315 132, 325 125" stroke-width="1" />
        <path d="M285 145 Q 300 155, 310 150" stroke-width="1" />
      </g>
    </svg>
  </div>

  <!-- 🏛️ 4. 希臘羅馬神殿廊柱與巴洛克茛苕葉浮雕 (Greco-Roman Temple & Acanthus - Bottom Right) -->
  <div class="vintage-plate plate-temple">
    <svg viewBox="0 0 360 300" width="320" height="270" fill="none">
      <!-- 希臘神殿三角山牆 (Pediment) -->
      <polygon points="180,30 50,95 310,95" stroke="#1c1c1c" stroke-width="2" fill="#ffffff" />
      <polygon points="180,45 75,90 285,90" stroke="#4a3728" stroke-width="1.2" />
      <!-- 山牆中央月桂浮雕 -->
      <circle cx="180" cy="72" r="8" stroke="#1c1c1c" stroke-width="1.2" />

      <!-- 柱頂橫樑 (Entablature) -->
      <rect x="40" y="95" width="280" height="18" stroke="#1c1c1c" stroke-width="1.8" fill="#ffffff" />
      <line x1="40" y1="104" x2="320" y2="104" stroke="#1c1c1c" stroke-width="1" stroke-dasharray="3 3" />

      <!-- 4 根科林斯古典立柱 (Corinthian Columns) -->
      <g stroke="#1c1c1c" stroke-width="1.4" fill="#ffffff">
        <!-- 柱 1 -->
        <rect x="65" y="113" width="24" height="150" />
        <line x1="73" y1="120" x2="73" y2="255" stroke-width="0.9" />
        <line x1="81" y1="120" x2="81" y2="255" stroke-width="0.9" />
        <!-- 柱 2 -->
        <rect x="125" y="113" width="24" height="150" />
        <line x1="133" y1="120" x2="133" y2="255" stroke-width="0.9" />
        <line x1="141" y1="120" x2="141" y2="255" stroke-width="0.9" />
        <!-- 柱 3 -->
        <rect x="210" y="113" width="24" height="150" />
        <line x1="218" y1="120" x2="218" y2="255" stroke-width="0.9" />
        <line x1="226" y1="120" x2="226" y2="255" stroke-width="0.9" />
        <!-- 柱 4 -->
        <rect x="270" y="113" width="24" height="150" />
        <line x1="278" y1="120" x2="278" y2="255" stroke-width="0.9" />
        <line x1="286" y1="120" x2="286" y2="255" stroke-width="0.9" />
      </g>

      <!-- 神殿台階基座 (Crepidoma Steps) -->
      <rect x="30" y="263" width="300" height="12" stroke="#1c1c1c" stroke-width="1.8" fill="#ffffff" />
      <rect x="20" y="275" width="320" height="12" stroke="#1c1c1c" stroke-width="2" fill="#ffffff" />
    </svg>
  </div>

  <!-- 🎶 漂浮音樂音符與手稿星芒 (Drifting Musical Notes & Stars) -->
  <div class="drifting-note note-1" data-speed="0.4">♪</div>
  <div class="drifting-note note-2" data-speed="0.6">♫</div>
  <div class="drifting-note note-3" data-speed="0.45">𝄞</div>
  <div class="drifting-note note-4" data-speed="0.55">𝄢</div>
  <div class="drifting-note note-5" data-speed="0.35">✦</div>
  <div class="drifting-note note-6" data-speed="0.5">♪</div>
  <div class="drifting-note note-7" data-speed="0.65">♫</div>
  <div class="drifting-note note-8" data-speed="0.42">♩</div>
</div>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: #ffffff;
  }

  /* 復古古籍紙質點陣 */
  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(28, 28, 28, 0.1) 1.2px, transparent 1.2px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at 50% 50%, black 60%, transparent 98%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 60%, transparent 98%);
    opacity: 0.9;
  }

  /* 📜 古典版畫通用圖層樣式 */
  .vintage-plate {
    position: absolute;
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 2px 8px rgba(28, 28, 28, 0.04));
  }

  /* 🏰 1. 城堡 (右上角) */
  .plate-castle {
    top: 2%;
    right: 2%;
    opacity: 0.88;
    animation: float-castle 26s ease-in-out infinite alternate;
  }

  @keyframes float-castle {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-15px, 18px, 0); }
  }

  /* 🎼 2. 音樂五線譜與琴身 (左上角) */
  .plate-music {
    top: 3%;
    left: 2%;
    opacity: 0.85;
    animation: float-music 22s ease-in-out infinite alternate;
  }

  @keyframes float-music {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(18px, 14px, 0); }
  }

  /* 📜 3. 作家羽毛筆、墨水瓶與古籍 (左下角) */
  .plate-writer {
    bottom: 3%;
    left: 2%;
    opacity: 0.9;
    animation: float-writer 24s ease-in-out infinite alternate;
  }

  @keyframes float-writer {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(14px, -18px, 0); }
  }

  /* 🏛️ 4. 希臘羅馬神殿 (右下角) */
  .plate-temple {
    bottom: 3%;
    right: 2%;
    opacity: 0.88;
    animation: float-temple 28s ease-in-out infinite alternate;
  }

  @keyframes float-temple {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-16px, -15px, 0); }
  }

  /* 🎶 漂浮與滾動跳動音樂符號 (加大尺寸與增強跳動) */
  .drifting-note {
    position: absolute;
    color: #1c1c1c;
    font-family: "Noto Serif TC", serif;
    line-height: 1;
    opacity: 0;
    will-change: transform, opacity;
    animation: drift-notes 12s ease-in-out infinite;
    transform: translate3d(0, var(--scroll-hop, 0px), 0) rotate(var(--scroll-rot, 0deg)) scale(var(--scroll-scale, 1));
    transition: transform 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.2s;
    user-select: none;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.05);
  }

  .drifting-note.is-jumping {
    opacity: 0.95 !important;
  }

  .note-1 { top: 18%; left: 16%; animation-delay: 0s; font-size: 34px; }
  .note-2 { top: 32%; right: 20%; animation-delay: 2.5s; font-size: 38px; }
  .note-3 { top: 65%; left: 14%; animation-delay: 5s; font-size: 46px; }
  .note-4 { top: 78%; right: 18%; animation-delay: 7.5s; font-size: 42px; }
  .note-5 { top: 48%; left: 86%; animation-delay: 9.5s; font-size: 26px; }
  .note-6 { top: 14%; right: 36%; animation-delay: 1.5s; font-size: 36px; }
  .note-7 { top: 72%; left: 40%; animation-delay: 4s; font-size: 38px; }
  .note-8 { top: 40%; left: 7%; animation-delay: 6.5s; font-size: 32px; }

  @keyframes drift-notes {
    0% { transform: translate3d(0, 20px, 0) scale(0.7); opacity: 0; }
    30% { opacity: 0.75; }
    70% { opacity: 0.6; }
    100% { transform: translate3d(15px, -45px, 0) scale(1.1); opacity: 0; }
  }

  @media (max-width: 1024px) {
    .plate-castle,
    .plate-music,
    .plate-writer,
    .plate-temple {
      opacity: 0.45;
      transform: scale(0.7);
    }
  }

  @media (max-width: 768px) {
    .plate-castle,
    .plate-temple {
      display: none;
    }
    .plate-music,
    .plate-writer {
      opacity: 0.35;
      transform: scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vintage-plate,
    .drifting-note {
      animation: none !important;
    }
  }
</style>

<script>
  const notes = document.querySelectorAll('.drifting-note');
  let lastScrollY = window.scrollY;
  let ticking = false;
  let resetTimeout: ReturnType<typeof setTimeout>;

  function onScroll() {
    const currentScrollY = window.scrollY;
    const scrollDelta = currentScrollY - lastScrollY;
    lastScrollY = currentScrollY;

    const jump = Math.max(-32, Math.min(32, scrollDelta * 0.55));

    notes.forEach((note, index) => {
      const el = note as HTMLElement;
      const speed = parseFloat(el.dataset.speed || '0.4');
      const dir = index % 2 === 0 ? 1 : -1;
      const yOffset = -jump * speed * 2.8;
      const rot = jump * dir * 1.4;
      const scale = 1 + Math.min(0.35, Math.abs(jump) * 0.018);

      el.style.setProperty('--scroll-hop', `${yOffset}px`);
      el.style.setProperty('--scroll-rot', `${rot}deg`);
      el.style.setProperty('--scroll-scale', `${scale}`);
      el.classList.add('is-jumping');
    });

    clearTimeout(resetTimeout);
    resetTimeout = setTimeout(() => {
      notes.forEach((note) => {
        const el = note as HTMLElement;
        el.style.setProperty('--scroll-hop', '0px');
        el.style.setProperty('--scroll-rot', '0deg');
        el.style.setProperty('--scroll-scale', '1');
        el.classList.remove('is-jumping');
      });
    }, 200);

    ticking = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    },
    { passive: true }
  );
</script>
