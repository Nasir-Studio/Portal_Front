---
---

<div class="ambient-bg" aria-hidden="true">
  <!-- 柔和呼吸流動光暈 (溫潤象牙金 + 晨曦微藍 + 柔粉) -->
  <div class="ambient-orb orb-1"></div>
  <div class="ambient-orb orb-2"></div>
  <div class="ambient-orb orb-3"></div>

  <!-- 手稿幾何微點座標格網 -->
  <div class="ambient-grid"></div>

  <!-- 🌊 慢速流動極簡絲帶波紋 (Flowing Topographic Waves) -->
  <div class="waves-wrap waves-top">
    <svg class="flow-wave wave-svg-1" viewBox="0 0 1440 380" fill="none">
      <path
        d="M-40 180 C 320 280, 540 60, 880 180 C 1180 280, 1360 100, 1500 200"
        stroke="#1c1c1c"
        stroke-width="1.2"
        stroke-dasharray="4 8"
        opacity="0.22"
      />
      <path
        d="M-60 140 C 280 240, 580 40, 920 150 C 1220 250, 1380 70, 1520 170"
        stroke="#deb86d"
        stroke-width="1.8"
        opacity="0.45"
      />
      <path
        d="M-20 220 C 360 310, 500 80, 840 210 C 1140 320, 1340 130, 1480 230"
        stroke="#1c1c1c"
        stroke-width="1"
        opacity="0.18"
      />
    </svg>
  </div>

  <div class="waves-wrap waves-bottom">
    <svg class="flow-wave wave-svg-2" viewBox="0 0 1440 380" fill="none">
      <path
        d="M-50 200 C 300 90, 600 290, 950 160 C 1250 50, 1390 240, 1500 130"
        stroke="#deb86d"
        stroke-width="1.6"
        stroke-dasharray="6 6"
        opacity="0.4"
      />
      <path
        d="M-30 240 C 340 130, 560 330, 910 200 C 1210 90, 1350 280, 1470 170"
        stroke="#1c1c1c"
        stroke-width="1.2"
        opacity="0.2"
      />
    </svg>
  </div>

  <!-- ⭕ 極簡幾何立體光影光環 (Floating Kinetic Rings) -->
  <div class="geometric-shape geo-ring-1">
    <svg viewBox="0 0 200 200" width="180" height="180" fill="none">
      <circle cx="100" cy="100" r="85" stroke="#deb86d" stroke-width="1.5" stroke-dasharray="8 6" opacity="0.55" />
      <circle cx="100" cy="100" r="65" stroke="#1c1c1c" stroke-width="1.2" opacity="0.25" />
      <circle cx="100" cy="15" r="4.5" fill="#deb86d" opacity="0.75" />
      <circle cx="185" cy="100" r="3.5" fill="#1c1c1c" opacity="0.4" />
    </svg>
  </div>

  <div class="geometric-shape geo-ring-2">
    <svg viewBox="0 0 180 180" width="140" height="140" fill="none">
      <circle cx="90" cy="90" r="75" stroke="#1c1c1c" stroke-width="1.4" stroke-dasharray="3 7" opacity="0.3" />
      <circle cx="90" cy="90" r="50" stroke="#deb86d" stroke-width="1.4" opacity="0.48" />
      <line x1="90" y1="5" x2="90" y2="175" stroke="#1c1c1c" stroke-width="1" stroke-dasharray="2 4" opacity="0.22" />
    </svg>
  </div>

  <!-- ✨ 微光星芒與星塵 -->
  <div class="sparkle sparkle-1">✦</div>
  <div class="sparkle sparkle-2">✦</div>
  <div class="sparkle sparkle-3">✦</div>
  <div class="ambient-dust dust-1"></div>
  <div class="ambient-dust dust-2"></div>
  <div class="ambient-dust dust-3"></div>
  <div class="ambient-dust dust-4"></div>
</div>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(75px);
    opacity: 0.65;
    will-change: transform;
  }

  .orb-1 {
    top: -10%;
    left: -5%;
    width: 55vw;
    height: 55vw;
    max-width: 680px;
    max-height: 680px;
    background: radial-gradient(circle, rgba(243, 228, 196, 0.65) 0%, rgba(243, 228, 196, 0) 70%);
    animation: drift-1 26s ease-in-out infinite alternate;
  }

  .orb-2 {
    bottom: -15%;
    right: -8%;
    width: 60vw;
    height: 60vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(circle, rgba(218, 229, 244, 0.6) 0%, rgba(218, 229, 244, 0) 70%);
    animation: drift-2 32s ease-in-out infinite alternate;
  }

  .orb-3 {
    top: 40%;
    left: 45%;
    width: 45vw;
    height: 45vw;
    max-width: 550px;
    max-height: 550px;
    background: radial-gradient(circle, rgba(245, 234, 226, 0.55) 0%, rgba(245, 234, 226, 0) 70%);
    animation: drift-3 22s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(8vw, 12vh, 0) scale(1.15); }
    100% { transform: translate3d(14vw, 4vh, 0) scale(0.95); }
  }

  @keyframes drift-2 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-10vw, -14vh, 0) scale(1.12); }
    100% { transform: translate3d(-16vw, -6vh, 0) scale(0.9); }
  }

  @keyframes drift-3 {
    0% { transform: translate3d(0, 0, 0) scale(0.95); opacity: 0.45; }
    50% { transform: translate3d(-8vw, 10vh, 0) scale(1.1); opacity: 0.7; }
    100% { transform: translate3d(6vw, -8vh, 0) scale(1); opacity: 0.5; }
  }

  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(28, 28, 28, 0.065) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 95%);
    opacity: 0.9;
  }

  /* 🌊 流動波紋絲帶 */
  .waves-wrap {
    position: absolute;
    left: 0;
    right: 0;
    width: 100%;
    pointer-events: none;
  }

  .waves-top {
    top: 5%;
    opacity: 0.85;
  }

  .waves-bottom {
    bottom: 8%;
    opacity: 0.75;
  }

  .flow-wave {
    width: 120%;
    height: auto;
    display: block;
    margin-left: -10%;
    will-change: transform;
  }

  .wave-svg-1 {
    animation: wave-float-1 20s ease-in-out infinite alternate;
  }

  .wave-svg-2 {
    animation: wave-float-2 25s ease-in-out infinite alternate;
  }

  @keyframes wave-float-1 {
    0% { transform: translate3d(0, 0, 0) scaleY(1); }
    50% { transform: translate3d(-3%, 15px, 0) scaleY(1.1); }
    100% { transform: translate3d(2%, -10px, 0) scaleY(0.95); }
  }

  @keyframes wave-float-2 {
    0% { transform: translate3d(0, 0, 0) scaleY(1); }
    50% { transform: translate3d(3%, -18px, 0) scaleY(1.15); }
    100% { transform: translate3d(-2%, 12px, 0) scaleY(0.9); }
  }

  /* ⭕ 極簡幾何立體光環 */
  .geometric-shape {
    position: absolute;
    pointer-events: none;
    will-change: transform;
  }

  .geo-ring-1 {
    top: 15%;
    right: 5%;
    animation: spin-ring-1 90s linear infinite, float-shape-1 16s ease-in-out infinite alternate;
  }

  .geo-ring-2 {
    bottom: 25%;
    left: 4%;
    animation: spin-ring-2 110s linear infinite reverse, float-shape-2 20s ease-in-out infinite alternate;
  }

  @keyframes spin-ring-1 {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes spin-ring-2 {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes float-shape-1 {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-15px, 25px, 0); }
  }

  @keyframes float-shape-2 {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(20px, -30px, 0); }
  }

  /* ✨ 閃爍星芒 */
  .sparkle {
    position: absolute;
    color: #deb86d;
    font-size: 13px;
    line-height: 1;
    opacity: 0;
    animation: twinkle 6s ease-in-out infinite;
  }

  .sparkle-1 { top: 18%; left: 8%; animation-delay: 0s; }
  .sparkle-2 { top: 68%; left: 88%; animation-delay: 2.5s; }
  .sparkle-3 { top: 82%; left: 18%; animation-delay: 4.2s; }

  @keyframes twinkle {
    0%, 100% { opacity: 0; transform: scale(0.6) rotate(0deg); }
    50% { opacity: 0.85; transform: scale(1.2) rotate(45deg); }
  }

  /* 漂浮星塵 */
  .ambient-dust {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #deb86d;
    border-radius: 50%;
    box-shadow: 0 0 6px #deb86d;
    opacity: 0;
    will-change: transform, opacity;
  }

  .dust-1 { top: 20%; left: 15%; animation: float-dust 14s ease-in-out infinite 0s; }
  .dust-2 { top: 60%; left: 80%; animation: float-dust 18s ease-in-out infinite 3s; }
  .dust-3 { top: 75%; left: 25%; animation: float-dust 16s ease-in-out infinite 6s; }
  .dust-4 { top: 35%; left: 70%; animation: float-dust 20s ease-in-out infinite 9s; }

  @keyframes float-dust {
    0% { transform: translate3d(0, 20px, 0) scale(0.6); opacity: 0; }
    30% { opacity: 0.85; }
    70% { opacity: 0.7; }
    100% { transform: translate3d(-20px, -60px, 0) scale(1); opacity: 0; }
  }

  @media (max-width: 768px) {
    .geometric-shape {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-orb,
    .ambient-dust,
    .flow-wave,
    .geometric-shape,
    .sparkle {
      animation: none !important;
    }
  }
</style>
