---
// 技術文章閘門：黑白色調、雙階段（登入 → 假付款 NT$3,000）解鎖面板
// 桌面「好看的特效頁面」runaway login + 3D credit card 整合版（monochrome）
---

<div class="tech-gate" id="tech-gate" aria-hidden="true">
  <div class="gate-modal" role="dialog" aria-modal="true" aria-labelledby="gate-title">
    <!-- ===== 階段一：登入（runaway 按鈕） ===== -->
    <section class="gate-stage" id="gate-login" data-stage="login">
      <h2 id="gate-title">技術文章專區</h2>

      <form id="gate-login-form" autocomplete="off" novalidate>
        <div class="form-group">
          <label for="gate-email">帳號</label>
          <div class="input-wrap">
            <span class="input-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <input type="text" id="gate-email" class="input-field" placeholder="輸入任何帳號" autocomplete="username" />
            <span class="status-icon" id="gate-email-check" hidden>✓</span>
          </div>
        </div>

        <div class="form-group">
          <label for="gate-password">密碼</label>
          <div class="input-wrap">
            <span class="input-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </span>
            <input type="password" id="gate-password" class="input-field" placeholder="輸入任何密碼" autocomplete="current-password" />
            <span class="status-icon" id="gate-pass-check" hidden>✓</span>
          </div>
        </div>

        <div class="dock-wrap">
          <div class="dock" id="gate-dock">
            <svg class="dock__band" width="100%" height="100%" aria-hidden="true">
              <path data-band-line d="M 0 0 L 0 0" />
            </svg>
            <span class="dock__socket" aria-hidden="true"></span>
            <button type="submit" class="gate-cta" id="gate-cta" aria-disabled="true">登入</button>
          </div>
        </div>

      </form>
    </section>

    <!-- ===== 階段二：付款（3D 信用卡，NT$3,000） ===== -->
    <section class="gate-stage" id="gate-payment" data-stage="payment" hidden>
      <div class="pay-grid">
        <div class="pay-left">
          <div class="card-slot" id="card-slot">
            <div class="glow-halo" id="glow-halo"></div>
            <div class="card-wrapper" id="card-wrapper">
              <!-- 正面 -->
              <div class="card-face card-face-front">
                <div class="card-top-row">
                  <div class="card-chip" aria-hidden="true"></div>
                  <div class="card-bank-name">OviNas Reserve</div>
                </div>
                <div class="card-number-display" id="display-card-number">•••• •••• •••• ••••</div>
                <div class="card-bottom-row">
                  <div>
                    <div class="card-field-label">持卡人</div>
                    <div class="card-field-val" id="display-cardholder">OVI NAS</div>
                  </div>
                  <div>
                    <div class="card-field-label">有效日期</div>
                    <div class="card-field-val" id="display-expiry">MM/YY</div>
                  </div>
                  <div class="card-brand-logo" id="display-brand">OVI</div>
                </div>
              </div>
              <!-- 背面 -->
              <div class="card-face card-face-back">
                <div class="card-mag-stripe" aria-hidden="true"></div>
                <div class="card-cvc-strip" id="display-cvc">•••</div>
                <div class="card-back-disclaimer">
                  此卡片由 OviNas 發行，僅供展示與測試使用。找到請寄回 OviNas 總部。
                </div>
              </div>
            </div>
          </div>

          <div class="status-screen" id="pay-status-screen">
            <div id="status-icon-holder"><div class="spinner-ring"></div></div>
            <div class="status-title" id="status-title">正在與銀行確認中…</div>
            <div class="status-desc" id="status-desc">模擬卡片 · 金額 NT$3,000</div>
            <button class="reset-demo-btn" id="reset-demo-btn" hidden>← 再試一次</button>
          </div>

          <div class="order-summary-box" id="order-summary-box">
            <h4>訂單明細</h4>
            <div class="order-line"><span>技術文章 VIP 一年方案</span><span>NT$3,000</span></div>
            <div class="order-line"><span>手續費</span><span style="font-weight:400">免手續費</span></div>
            <div class="order-line total"><span>總計</span><span>NT$3,000</span></div>
          </div>
        </div>

        <div class="pay-right">
          <div class="pay-steps"><span class="step-done">✓ 登入完成</span><span>—</span><span class="step-active">付款</span></div>
          <h3>付款資訊</h3>
          <p class="pay-subtitle">輸入卡片資訊完成付款。</p>

          <form id="gate-pay-form" novalidate>
            <div class="pay-form-group">
              <label for="cardholder-name">持卡人姓名</label>
              <input type="text" id="cardholder-name" class="pay-input" placeholder="OVI NAS" autocomplete="cc-name" />
            </div>
            <div class="pay-form-group">
              <label for="card-number">卡號</label>
              <input type="text" id="card-number" class="pay-input" placeholder="4242 4242 4242 4242" maxlength="19" autocomplete="cc-number" inputmode="numeric" />
            </div>
            <div class="inline-row">
              <div class="pay-form-group">
                <label for="expiry-date">有效日期</label>
                <input type="text" id="expiry-date" class="pay-input" placeholder="MM/YY" maxlength="5" autocomplete="cc-exp" inputmode="numeric" />
              </div>
              <div class="pay-form-group">
                <label for="cvc">CVC</label>
                <input type="text" id="cvc" class="pay-input" placeholder="•••" maxlength="4" autocomplete="cc-csc" inputmode="numeric" />
              </div>
            </div>

            <button type="submit" class="pay-submit-btn" id="pay-submit-btn">🔒 付款 NT$3,000 →</button>
          </form>
        </div>
      </div>
    </section>
  </div>
</div>

<style>
  /* ===== 整體閘門（內嵌卡片，不遮畫面） ===== */
  .tech-gate {
    display: none;
  }

  .tech-gate.is-open {
    display: block;
    animation: gate-in 0.35s var(--ease) both;
  }

  @keyframes gate-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .gate-modal {
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-soft);
  }

  .gate-stage {
    padding: 1.2rem 1.4rem 1.4rem;
  }

  /* ===== 登入階段（緊湊，約 5 篇文章高度） ===== */
  #gate-login {
    max-width: 480px;
    margin-inline: auto;
  }

  #gate-login h2 {
    font-family: var(--font-iansui);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 0.2rem;
  }

  .form-group {
    margin-bottom: 0.75rem;
  }

  .form-group label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-2);
    letter-spacing: 0.1em;
    margin-bottom: 0.3rem;
    font-family: var(--font-iansui);
  }

  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--ink-3);
    display: flex;
    pointer-events: none;
  }

  .input-field {
    width: 100%;
    height: 40px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 0 2.3rem;
    font-family: var(--font-iansui);
    font-size: 0.88rem;
    color: var(--ink);
    outline: none;
    transition: border-color var(--t), box-shadow var(--t), background var(--t);
  }

  .input-field::placeholder {
    color: var(--ink-3);
    font-family: var(--font-iansui);
  }

  .input-field:focus {
    border-color: var(--ink);
    background: var(--surface);
    box-shadow: 0 0 0 3px rgba(28, 28, 28, 0.08);
  }

  .input-field.is-valid {
    border-color: var(--ink);
  }

  .status-icon {
    position: absolute;
    right: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
  }

  /* Runaway 按鈕區 */
  .dock-wrap {
    margin-top: 1rem;
    position: relative;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dock {
    width: 100%;
    height: 46px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dock__band {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 1;
  }

  .dock__band path {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    fill: none;
    transition: stroke 0.3s ease;
  }

  .dock__socket {
    position: absolute;
    width: 100%;
    height: 46px;
    border: none;
    border-radius: 0;
    pointer-events: none;
    transition: background 0.3s ease;
  }

  .dock.is-docked .dock__socket {
    background: var(--bg-soft);
  }

  .gate-cta {
    position: absolute;
    width: 140px;
    height: 46px;
    background: var(--ink);
    color: var(--white);
    border: 1px solid var(--ink);
    border-radius: 0;
    font-family: var(--font-iansui);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    cursor: pointer;
    z-index: 2;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
    transform: translate3d(var(--x, 0px), var(--y, 0px), 0) rotate(var(--rot, 0deg));
    will-change: transform;
    user-select: none;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .gate-cta:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .dock.is-docked .gate-cta {
    background: var(--surface);
    color: var(--ink);
    border-color: var(--ink);
    box-shadow: 0 0 0 1px var(--ink), 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  /* ===== 付款階段（緊湊雙欄，不超出面板） ===== */
  .pay-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
    align-items: start;
  }

  @media (max-width: 560px) {
    .gate-stage {
      padding: 1rem;
    }
    .pay-grid {
      grid-template-columns: 1fr;
    }
  }

  .pay-left {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  /* 3D 卡片 */
  .card-slot {
    position: relative;
    width: 100%;
    aspect-ratio: 1.586 / 1;
    perspective: 1000px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glow-halo {
    position: absolute;
    inset: 10px;
    border-radius: 4px;
    background: transparent;
    pointer-events: none;
    transition: box-shadow 0.4s ease;
    z-index: 0;
  }

  .glow-halo.glow-ok {
    box-shadow: 0 0 24px 4px rgba(28, 28, 28, 0.35), 0 0 54px 16px rgba(28, 28, 28, 0.18);
  }

  .card-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: grab;
    z-index: 1;
  }

  .card-wrapper.is-flipped {
    transform: rotateY(180deg);
  }

  .card-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    padding: 1rem;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.18), 0 5px 15px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    user-select: none;
  }

  .card-face-front {
    background: linear-gradient(135deg, #ffffff 0%, #e6e6e6 55%, #cccccc 100%);
    color: #111111;
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-chip {
    width: 40px;
    height: 28px;
    background: linear-gradient(135deg, #d9d9d9, #a6a6a6);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    border: 1px solid #8c8c8c;
  }

  .card-chip::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(17, 17, 17, 0.4);
  }

  .card-bank-name {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .card-number-display {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #111111;
    margin: 0.5rem 0;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-bottom-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .card-field-label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #555555;
    text-transform: uppercase;
  }

  .card-field-val {
    font-family: var(--font-serif);
    font-size: 0.66rem;
    font-weight: 600;
    color: #111111;
  }

  .card-brand-logo {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-weight: 800;
    font-style: italic;
    color: #111111;
  }

  .card-face-back {
    background: linear-gradient(135deg, #888888 0%, #f0f0f0 100%);
    color: #111111;
    transform: rotateY(180deg);
    padding: 0;
  }

  .card-mag-stripe {
    width: 100%;
    height: 42px;
    background: #111111;
    margin-top: 1.2rem;
  }

  .card-cvc-strip {
    margin: 0.8rem 1.2rem;
    background: #ffffff;
    height: 34px;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 0.9rem;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-weight: 700;
    color: #111111;
    letter-spacing: 0.2em;
  }

  .card-back-disclaimer {
    padding: 0 1.2rem 1rem;
    font-size: 0.5rem;
    color: #444444;
    line-height: 1.4;
  }

  /* 訂單明細 */
  .order-summary-box {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 0.75rem 0.9rem;
  }

  .order-summary-box h4 {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 0.4rem;
  }

  .order-line {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--ink-2);
    margin-bottom: 0.3rem;
  }

  .order-line.total {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--ink);
    border-top: 1px solid var(--border-strong);
    padding-top: 0.4rem;
    margin-top: 0.4rem;
    margin-bottom: 0;
  }

  /* 狀態畫面 */
  .status-screen {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.8rem 0;
    gap: 0.2rem;
  }

  .gate-stage.is-paying .pay-grid {
    display: none;
  }

  .gate-stage.is-paying .status-screen {
    display: flex;
  }

  .spinner-ring {
    width: 28px;
    height: 28px;
    border: 3px solid var(--border-strong);
    border-top-color: var(--ink);
    border-radius: 50%;
    animation: gate-spin 0.8s linear infinite;
    margin-bottom: 0.6rem;
  }

  @keyframes gate-spin {
    to { transform: rotate(360deg); }
  }

  .success-check-circle {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    animation: gate-pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes gate-pop {
    from { transform: scale(0.4); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .status-title {
    font-family: var(--font-iansui);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .status-desc {
    font-size: 0.85rem;
    color: var(--ink-3);
    font-family: var(--font-iansui);
  }

  .reset-demo-btn {
    background: var(--bg-soft);
    border: 1px solid var(--border-strong);
    color: var(--ink-2);
    font-family: var(--font-iansui);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.35rem 1rem;
    border-radius: 0;
    cursor: pointer;
    transition: all var(--t);
    margin-top: 0.6rem;
  }

  .reset-demo-btn:hover {
    background: var(--ink);
    color: var(--white);
    border-color: var(--ink);
  }

  /* 付款表單 */
  .pay-right {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .pay-steps {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    font-size: 0.72rem;
    color: var(--ink-3);
    letter-spacing: 0.05em;
    font-family: var(--font-iansui);
  }

  .step-done {
    color: var(--ink-2);
    font-weight: 600;
  }

  .step-active {
    color: var(--ink);
    font-weight: 700;
  }

  .pay-right h3 {
    font-family: var(--font-iansui);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .pay-subtitle {
    font-size: 0.78rem;
    color: var(--ink-3);
    line-height: 1.5;
    font-family: var(--font-iansui);
  }

  .pay-form-group {
    margin-bottom: 0.6rem;
  }

  .pay-form-group label {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
    font-family: var(--font-iansui);
  }

  .pay-input {
    width: 100%;
    height: 38px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 0 0.75rem;
    font-family: var(--font-iansui);
    font-size: 0.85rem;
    color: var(--ink);
    outline: none;
    transition: border-color var(--t), box-shadow var(--t), background var(--t);
  }

  .pay-input::placeholder {
    font-family: var(--font-iansui);
  }

  .pay-input:focus {
    border-color: var(--ink);
    background: var(--surface);
    box-shadow: 0 0 0 3px rgba(28, 28, 28, 0.08);
  }

  .pay-input::placeholder {
    color: var(--ink-3);
  }

  .inline-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .pay-submit-btn {
    width: 100%;
    height: 44px;
    background: var(--ink);
    color: var(--white);
    border: 1px solid var(--ink);
    border-radius: 0;
    font-family: var(--font-iansui);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    cursor: pointer;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .pay-submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.35);
  }

  .pay-submit-btn:active {
    transform: translateY(0);
  }
</style>

<script>
  const gate = document.getElementById('tech-gate');
  const loginStage = document.getElementById('gate-login');
  const payStage = document.getElementById('gate-payment');
  const loginForm = document.getElementById('gate-login-form');
  const emailInput = document.getElementById('gate-email');
  const passwordInput = document.getElementById('gate-password');
  const emailCheck = document.getElementById('gate-email-check');
  const passCheck = document.getElementById('gate-pass-check');
  const dock = document.getElementById('gate-dock');
  const ctaBtn = document.getElementById('gate-cta');
  const bandLine = document.querySelector('[data-band-line]');

  // ===== Runaway 按鈕物理 =====
  let pos = { x: 0, y: 0, rot: 0 };
  let targetPos = { x: 0, y: 0, rot: 0 };
  let mouse = { x: -1000, y: -1000 };
  let validCount = 0;

  function validate() {
    const emailVal = emailInput.value.trim();
    const passVal = passwordInput.value.trim();

    // 不限格式：只要有輸入就算有效
    const emailValid = emailVal.length > 0;
    const passValid = passVal.length > 0;

    emailInput.classList.toggle('is-valid', emailValid);
    passwordInput.classList.toggle('is-valid', passValid);
    emailCheck.hidden = !emailValid;
    passCheck.hidden = !passValid;

    validCount = (emailValid ? 1 : 0) + (passValid ? 1 : 0);

    if (validCount === 2) {
      dock.classList.add('is-docked');
      targetPos.x = 0;
      targetPos.y = 0;
      targetPos.rot = 0;
    } else {
      dock.classList.remove('is-docked');
    }
  }

  emailInput.addEventListener('input', validate);
  passwordInput.addEventListener('input', validate);

  if (bandLine) {
    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    function drawBand() {
      if (!bandLine || !dock) return;
      const socketRect = dock.querySelector('.dock__socket').getBoundingClientRect();
      const startX = socketRect.width / 2;
      const startY = socketRect.height / 2;
      const endX = startX + pos.x;
      const endY = startY + pos.y;
      const ctrlX = (startX + endX) / 2;
      const ctrlY = (startY + endY) / 2 + pos.y * 0.2;

      if (pos.x ** 2 + pos.y ** 2 < 4) {
        bandLine.setAttribute('d', `M ${startX} ${startY} L ${startX} ${startY}`);
        bandLine.style.opacity = '0';
      } else {
        bandLine.setAttribute('d', `M ${startX} ${startY} Q ${ctrlX} ${ctrlY} ${endX} ${endY}`);
        bandLine.style.opacity = '1';
      }
    }

    function physics() {
      if (validCount < 2) {
        const socket = dock.querySelector('.dock__socket').getBoundingClientRect();
        const sx = socket.left + socket.width / 2;
        const sy = socket.top + socket.height / 2;
        const cx = sx + pos.x;
        const cy = sy + pos.y;
        const dx = cx - mouse.x;
        const dy = cy - mouse.y;
        const dist = Math.hypot(dx, dy);
        const threatRadius = validCount === 0 ? 130 : 65;

        if (dist < threatRadius && dist > 0) {
          const force = (threatRadius - dist) * (validCount === 0 ? 1.5 : 0.75);
          targetPos.x += (dx / dist) * force;
          targetPos.y += (dy / dist) * force;
          const maxDist = 150;
          targetPos.x = Math.max(-maxDist, Math.min(maxDist, targetPos.x));
          targetPos.y = Math.max(-50, Math.min(50, targetPos.y));
          targetPos.rot = (targetPos.x / maxDist) * 14;
        } else {
          targetPos.x *= 0.92;
          targetPos.y *= 0.92;
          targetPos.rot *= 0.9;
        }
      }

      const tension = 0.15;
      pos.x += (targetPos.x - pos.x) * tension;
      pos.y += (targetPos.y - pos.y) * tension;
      pos.rot += (targetPos.rot - pos.rot) * tension;

      ctaBtn.style.setProperty('--x', `${pos.x.toFixed(2)}px`);
      ctaBtn.style.setProperty('--y', `${pos.y.toFixed(2)}px`);
      ctaBtn.style.setProperty('--rot', `${pos.rot.toFixed(2)}deg`);

      drawBand();
      requestAnimationFrame(physics);
    }

    requestAnimationFrame(physics);
  }

  // ===== 登入提交 =====
  loginForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (validCount < 2) {
      targetPos.x += (Math.random() - 0.5) * 120;
      targetPos.y += (Math.random() - 0.5) * 80;
      return;
    }

    ctaBtn.textContent = '登入中…';
    ctaBtn.style.opacity = '0.75';

    setTimeout(() => {
      // 無論輸入什麼皆登入成功 → 切到付款階段
      loginStage.hidden = true;
      payStage.hidden = false;
      gate.querySelector('.gate-modal').scrollTop = 0;
      ctaBtn.textContent = '登入';
      ctaBtn.style.opacity = '1';
    }, 800);
  });

  // ===== 付款：3D 卡片互動 =====
  const cardSlot = document.getElementById('card-slot');
  const cardWrapper = document.getElementById('card-wrapper');
  const glowHalo = document.getElementById('glow-halo');
  const cardholderInput = document.getElementById('cardholder-name');
  const cardNumberInput = document.getElementById('card-number');
  const expiryInput = document.getElementById('expiry-date');
  const cvcInput = document.getElementById('cvc');
  const payForm = document.getElementById('gate-pay-form');

  const displayHolder = document.getElementById('display-cardholder');
  const displayNum = document.getElementById('display-card-number');
  const displayExpiry = document.getElementById('display-expiry');
  const displayBrand = document.getElementById('display-brand');
  const displayCvc = document.getElementById('display-cvc');

  const iconHolder = document.getElementById('status-icon-holder');
  const statusTitle = document.getElementById('status-title');
  const statusDesc = document.getElementById('status-desc');
  const resetDemoBtn = document.getElementById('reset-demo-btn');

  // 3D 傾斜
  if (cardSlot && cardWrapper) {
    cardSlot.addEventListener('mousemove', (e) => {
      if (cardWrapper.classList.contains('is-flipped')) return;
      const rect = cardSlot.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      const rotX = (y / (rect.height / 2)) * -16;
      const rotY = (x / (rect.width / 2)) * 16;
      cardWrapper.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg)`;
    });

    cardSlot.addEventListener('mouseleave', () => {
      if (!cardWrapper.classList.contains('is-flipped')) {
        cardWrapper.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
      }
    });
  }

  // CVC 聚焦翻面
  cvcInput.addEventListener('focus', () => {
    cardWrapper.classList.add('is-flipped');
    cardWrapper.style.transform = 'rotateY(180deg)';
  });

  [cardholderInput, cardNumberInput, expiryInput].forEach((input) => {
    if (!input) return;
    input.addEventListener('focus', () => {
      if (cardWrapper.classList.contains('is-flipped')) {
        cardWrapper.classList.remove('is-flipped');
        cardWrapper.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
      }
    });
  });

  // 即時顯示
  cardholderInput.addEventListener('input', (e) => {
    const val = e.target.value.toUpperCase();
    displayHolder.textContent = val || 'OVI NAS';
  });

  cardNumberInput.addEventListener('input', (e) => {
    let raw = e.target.value.replace(/\D/g, '');
    if (raw.length > 16) raw = raw.substring(0, 16);
    const formatted = raw.replace(/(\d{4})/g, '$1 ').trim();
    cardNumberInput.value = formatted;
    displayNum.textContent = formatted || '•••• •••• •••• ••••';
    displayBrand.textContent = /^4/.test(raw) ? 'VISA' : /^5[1-5]/.test(raw) ? 'MC' : raw.length >= 3 ? 'OVI' : 'OVI';
    glowHalo.classList.toggle('glow-ok', raw.length >= 13);
  });

  expiryInput.addEventListener('input', (e) => {
    let raw = e.target.value.replace(/\D/g, '');
    if (raw.length > 4) raw = raw.substring(0, 4);
    expiryInput.value = raw.length >= 3 ? `${raw.substring(0, 2)}/${raw.substring(2)}` : raw;
    displayExpiry.textContent = expiryInput.value || 'MM/YY';
  });

  cvcInput.addEventListener('input', (e) => {
    let raw = e.target.value.replace(/\D/g, '');
    if (raw.length > 4) raw = raw.substring(0, 4);
    cvcInput.value = raw;
    displayCvc.textContent = raw || '•••';
  });

  // ===== 付款提交（假的，必定成功） =====
  let autoUnlockTimer: ReturnType<typeof setTimeout> | null = null;

  payForm.addEventListener('submit', (e) => {
    e.preventDefault();
    payStage.classList.add('is-paying');

    iconHolder.innerHTML = '<div class="spinner-ring"></div>';
    statusTitle.textContent = '正在與銀行確認中…';
    statusDesc.textContent = '模擬卡片 · 金額 NT$3,000';
    resetDemoBtn.hidden = true;

    // 立即儲存已解鎖狀態
    localStorage.setItem('ovinas-tech-unlocked', '1');

    setTimeout(() => {
      iconHolder.innerHTML = '<div class="success-check-circle">✓</div>';
      statusTitle.textContent = '付款成功 NT$3,000';
      statusDesc.textContent = '技術文章 VIP 已開通，正在為您開啟文章…';
      resetDemoBtn.hidden = false;
      resetDemoBtn.textContent = '進入技術文章 →';

      // 0.5 秒後自動進入技術文章
      if (autoUnlockTimer) clearTimeout(autoUnlockTimer);
      autoUnlockTimer = setTimeout(() => {
        unlockAndEnter();
      }, 500);
    }, 600);
  });

  function unlockAndEnter() {
    if (autoUnlockTimer) {
      clearTimeout(autoUnlockTimer);
      autoUnlockTimer = null;
    }
    localStorage.setItem('ovinas-tech-unlocked', '1');
    closeGate();
    window.dispatchEvent(new CustomEvent('tech-gate:unlocked'));
  }

  // 付款成功後點擊立即進入
  resetDemoBtn.addEventListener('click', () => {
    unlockAndEnter();
  });

  function closeGate() {
    if (autoUnlockTimer) {
      clearTimeout(autoUnlockTimer);
      autoUnlockTimer = null;
    }
    gate.classList.remove('is-open');
    gate.setAttribute('aria-hidden', 'true');
    loginStage.hidden = false;
    payStage.hidden = true;
    payStage.classList.remove('is-paying');
    emailInput.value = '';
    passwordInput.value = '';
    ctaBtn.style.opacity = '1';
    ctaBtn.textContent = '登入';
    validate();
  }

  // ===== 對外開關：Announcements 呼叫 =====
  window.openTechGate = function () {
    gate.classList.add('is-open');
    gate.setAttribute('aria-hidden', 'false');
    setTimeout(() => emailInput.focus(), 400);
  };

  window.closeTechGate = closeGate;
</script>