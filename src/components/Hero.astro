---
import SheepLogo from './SheepLogo.astro';
---

<section class="hero">
  <div class="container hero-inner">
    <p class="hero-eyebrow">SHEEP FAMILY PORTAL</p>

    <div class="hero-sheep">
      <SheepLogo size={120} class="hero-sheep-img" />
    </div>

    <h1 class="hero-title">羊家的入口</h1>

    <p class="hero-tagline">溫柔的小羊們，在這裡團聚。<br class="br-sm" />請進。</p>

    <p class="hero-sub">
      監視 ・ 集章 ・ 考試 —— 三隻小羊，二十四小時為你站崗。
    </p>

    <div class="hero-actions">
      <a class="btn" href="https://nsir.uk" target="_blank" rel="noopener noreferrer">
        羊-短網址(nsir.uk)
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a class="btn btn--ghost" href="#services" aria-label="看看羊家服務">
        看看羊家服務
        <span class="arrow" aria-hidden="true">↓</span>
      </a>
    </div>

    <p class="hero-hint">把長長的網址，交給羊來變短。</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 5.5rem 0 6rem;
    overflow: hidden;
  }

  /* 背景的雲朵光暈 */
  .hero::before {
    content: '';
    position: absolute;
    top: -160px;
    left: 50%;
    transform: translateX(-50%);
    width: 720px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, var(--surface-2) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 2.2rem;
  }

  .hero-sheep {
    margin-bottom: 1.6rem;
    animation: floaty 5s ease-in-out infinite;
  }

  .hero-sheep-img {
    filter: drop-shadow(0 18px 30px rgba(28, 28, 28, 0.2));
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.25;
    margin-bottom: 1.1rem;
    animation: fadeUp 0.7s var(--ease) both;
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.6vw, 1.45rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    line-height: 2;
    margin-bottom: 0.9rem;
    animation: fadeUp 0.7s 0.08s var(--ease) both;
  }

  .hero-sub {
    font-size: 0.98rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    margin-bottom: 2.4rem;
    animation: fadeUp 0.7s 0.16s var(--ease) both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.8rem;
    animation: fadeUp 0.7s 0.24s var(--ease) both;
  }

  .hero-hint {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    animation: fadeUp 0.7s 0.32s var(--ease) both;
  }

  @media (max-width: 520px) {
    .hero {
      padding: 3.5rem 0 4.5rem;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
