---
import SheepLogo from './SheepLogo.astro';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title">羊家的入口</h1>
      <p class="hero-tagline">溫柔的小羊們，在這裡團聚。請進。</p>
      <p class="hero-sub">歡迎來到羊家入口，在這邊你可以選擇想要去瀏覽哪個服務</p>
      <div class="hero-actions">
        <a class="btn" href="https://nsir.uk" target="_blank" rel="noopener noreferrer">
          羊-短網址(nsir.uk)
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="btn btn--ghost" href="#services">
          看看羊家服務
          <span class="arrow" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <!-- 校徽區：羊在右側，不置中 -->
    <figure class="hero-figure">
      <SheepLogo size={190} class="hero-sheep" />
    </figure>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: 2.5rem;
    padding: 4.2rem 0 4.6rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--ink-2);
    margin-bottom: 0.7rem;
  }

  .hero-sub {
    font-size: 0.92rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    margin-bottom: 2.2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  /* --- 校徽區 --- */
  .hero-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    padding: 1.5rem 0;
  }

  .hero-sheep {
    filter: drop-shadow(0 16px 24px rgba(28, 28, 28, 0.22));
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 3.2rem 0 3.6rem;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-figure {
      order: -1;
    }

    .hero-sheep {
      width: 120px;
      height: 120px;
    }
  }
</style>
