---
import announcements from '../data/announcements';
---

<section class="module" id="news" aria-label="最新消息">
  <h2 class="module-title">
    <span class="news-head-left">
      <span class="news-square" aria-hidden="true"></span>
      最新消息
    </span>
    <span class="news-count">{announcements.length} 則公告</span>
  </h2>

  <div class="news-list">
    {
      announcements.map((item) => (
        <a class="news-item" href={`/news/${item.slug}/`}>
          <span class="news-item-title">{item.title}</span>
          <span class="news-date">{item.date}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  #news {
    scroll-margin-top: 175px;
  }

  .news-head-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .news-square {
    width: 8px;
    height: 8px;
    background: var(--ink);
  }

  .news-count {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    border: 1px solid var(--border-strong);
    padding: 0.1rem 0.55rem;
  }

  .news-item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.85rem 1.1rem;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .news-item:last-child {
    border-bottom: none;
  }

  .news-item:hover {
    background: var(--bg-soft);
  }

  .news-item-title {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .news-date {
    flex-shrink: 0;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    #news {
      scroll-margin-top: 0;
    }

    .news-item {
      gap: 0.7rem;
      padding: 0.8rem;
    }
  }
</style>
