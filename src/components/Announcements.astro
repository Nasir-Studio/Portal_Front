---
import announcements from '../data/announcements';
import posts from '../data/posts';
---

<section class="module" id="news" aria-label="最新消息">
  <h2 class="module-title">
    <span class="news-head-left">
      <span class="news-square" aria-hidden="true"></span>
      最新消息
    </span>
  </h2>

  <div class="news-tabs" role="tablist" aria-label="最新消息分類">
    <button
      class="news-tab is-active"
      id="tab-announce"
      role="tab"
      aria-selected="true"
      aria-controls="panel-announce"
      type="button"
    >
      最新消息
    </button>
    <button
      class="news-tab"
      id="tab-posts"
      role="tab"
      aria-selected="false"
      aria-controls="panel-posts"
      type="button"
    >
      其他文章
    </button>
  </div>

  <div class="news-panel is-active" id="panel-announce" role="tabpanel" aria-labelledby="tab-announce">
    <div class="news-list">
      {
        announcements.map((item) => (
          <a class="news-item" href={`/news/${item.slug}/`}>
            <span class="news-item-title">{item.title}</span>
            <span class="news-date">{item.date}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="news-panel" id="panel-posts" role="tabpanel" aria-labelledby="tab-posts" hidden>
    <div class="news-list">
      {
        posts.map((item) => (
          <a class="news-item" href={`/posts/${item.slug}/`}>
            <span class="news-item-title">
              {item.title}
              <span class="news-item-excerpt">{item.excerpt}</span>
            </span>
            <span class="news-date">{item.date}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  #news {
    scroll-margin-top: 175px;
  }

  .news-head-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .news-square {
    width: 8px;
    height: 8px;
    background: var(--ink);
    transform: rotate(45deg);
  }

  .news-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .news-tab {
    appearance: none;
    background: none;
    border: none;
    border-right: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--ink-3);
    padding: 0.6rem 1.2rem;
    cursor: pointer;
    transition: background var(--t), color var(--t);
    position: relative;
  }

  .news-tab:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .news-tab.is-active {
    color: var(--ink);
    background: var(--surface);
  }

  .news-tab.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--ink);
  }

  .news-list {
    display: flex;
    flex-direction: column;
  }

  .news-item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    min-width: 0;
    padding: 0.85rem 1.1rem;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .news-item:last-child {
    border-bottom: none;
  }

  .news-item:hover {
    background: var(--bg-soft);
  }

  .news-item-title {
    flex: 1;
    min-width: 0;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .news-item-excerpt {
    min-width: 0;
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .news-date {
    flex-shrink: 0;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    #news {
      scroll-margin-top: 0;
    }

    .news-item {
      gap: 0.7rem;
      padding: 0.8rem;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.news-tab');
  const panels = document.querySelectorAll<HTMLElement>('.news-panel');

  function activate(tab: HTMLButtonElement) {
    tabs.forEach((t) => {
      const active = t === tab;
      t.classList.toggle('is-active', active);
      t.setAttribute('aria-selected', String(active));
    });
    panels.forEach((p) => {
      const active = p.id === tab.getAttribute('aria-controls');
      p.classList.toggle('is-active', active);
      p.hidden = !active;
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activate(tab));
  });
</script>
