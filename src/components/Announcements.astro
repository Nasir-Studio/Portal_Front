---
import announcements from '../data/announcements';
import posts, { type Post } from '../data/posts';
import TechGate from './TechGate.astro';

const POSTS_PER_PAGE = 5;

function paginatePosts(list: Post[]): Post[][] {
  return list.reduce<Post[][]>((pages, post, index) => {
    const pageIndex = Math.floor(index / POSTS_PER_PAGE);
    if (!pages[pageIndex]) pages[pageIndex] = [];
    pages[pageIndex].push(post);
    return pages;
  }, []);
}

const generalPosts = posts.filter((post) => post.category === 'general');
const techPosts = posts.filter((post) => post.category === 'tech');
const generalPages = paginatePosts(generalPosts);
const techPages = paginatePosts(techPosts);
---

<section class="module" id="news" aria-label="最新消息">
  <h2 class="module-title">
    <span class="news-head-left">
      <span class="news-square" aria-hidden="true"></span>
      最新消息
    </span>
  </h2>

  <div class="news-tabs" role="tablist" aria-label="最新消息分類">
    <button
      class="news-tab is-active"
      id="tab-announce"
      role="tab"
      aria-selected="true"
      aria-controls="panel-announce"
      type="button"
    >
      最新消息
    </button>
    <button
      class="news-tab"
      id="tab-posts"
      role="tab"
      aria-selected="false"
      aria-controls="panel-posts"
      type="button"
    >
       其他文章
    </button>
    <button
      class="news-tab"
      id="tab-tech"
      role="tab"
      aria-selected="false"
      aria-controls="panel-tech"
      type="button"
    >
       技術文章
    </button>
  </div>

  <div class="news-panel is-active" id="panel-announce" role="tabpanel" aria-labelledby="tab-announce">
    <div class="news-list">
      {
        announcements.map((item) => (
          <a class="news-item" href={`/news/${item.slug}/`}>
            <span class="news-item-title">{item.title}</span>
            <span class="news-date">{item.date}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="news-panel" id="panel-posts" role="tabpanel" aria-labelledby="tab-posts" hidden>
    <div class="news-pages">
      {
        generalPages.map((pageItems, pageIndex) => (
          <div class="news-page" data-page={pageIndex} hidden={pageIndex !== 0}>
            {pageItems.map((item) => (
              <a class="news-item" href={`/posts/${item.slug}/`}>
                <span class="news-item-title">
                  {item.title}
                  <span class="news-item-excerpt">{item.excerpt}</span>
                </span>
                <span class="news-date">{item.date}</span>
              </a>
            ))}
          </div>
        ))
      }
    </div>
    {
      generalPages.length > 1 && (
        <div class="news-pager" aria-label="其他文章分頁">
          <button class="pager-btn pager-prev" type="button" disabled>← 上一頁</button>
          <span class="pager-indicator">1 / {generalPages.length}</span>
          <button class="pager-btn pager-next" type="button">下一頁 →</button>
        </div>
      )
    }
  </div>

  <div class="news-panel" id="panel-tech" role="tabpanel" aria-labelledby="tab-tech" hidden>
    <div class="news-pages" id="tech-pages">
      {
        techPages.map((pageItems, pageIndex) => (
          <div class="news-page" data-page={pageIndex} hidden={pageIndex !== 0}>
            {pageItems.map((item) => (
              <a class="news-item" href={`/posts/${item.slug}/`}>
                <span class="news-item-title">
                  {item.title}
                  <span class="news-item-excerpt">{item.excerpt}</span>
                </span>
                <span class="news-date">{item.date}</span>
              </a>
            ))}
          </div>
        ))
      }
    </div>
    {
      techPages.length > 1 && (
        <div class="news-pager" aria-label="技術文章分頁">
          <button class="pager-btn pager-prev" type="button" disabled>← 上一頁</button>
          <span class="pager-indicator">1 / {techPages.length}</span>
          <button class="pager-btn pager-next" type="button">下一頁 →</button>
        </div>
      )
    }
    <div class="tech-gate-wrap" id="tech-gate-wrap" hidden>
      <TechGate />
    </div>
  </div>
</section>

<style>
  #news {
    scroll-margin-top: 175px;
  }

  .news-head-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .news-square {
    width: 7px;
    height: 7px;
    background: #e5ccb1;
    transform: rotate(45deg);
  }

  .news-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .news-tab {
    appearance: none;
    background: none;
    border: none;
    border-right: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--ink-3);
    padding: 0.6rem 1.2rem;
    cursor: pointer;
    transition: background var(--t), color var(--t);
    position: relative;
  }

  .news-tab:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .news-tab.is-active {
    color: var(--ink);
    background: var(--surface);
    font-weight: 500;
  }

  .news-tab.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--ink);
  }

  .news-list {
    display: flex;
    flex-direction: column;
  }

  .news-item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    min-width: 0;
    padding: 0.85rem 1.1rem;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .news-item:last-child {
    border-bottom: none;
  }

  .news-item:hover {
    background: var(--bg-soft);
  }

  .news-item-title {
    flex: 1;
    min-width: 0;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .news-item-excerpt {
    min-width: 0;
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .news-date {
    flex-shrink: 0;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .news-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.7rem 1.1rem;
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .pager-btn {
    appearance: none;
    background: none;
    border: 1px solid var(--border-strong);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    transition: color var(--t), border-color var(--t), background var(--t);
  }

  .pager-btn:hover:not(:disabled) {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--surface);
  }

  .pager-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pager-indicator {
    font-size: 0.82rem;
    letter-spacing: 0.15em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .news-page[hidden] {
    display: none !important;
  }

  @media (max-width: 900px) {
    #news {
      scroll-margin-top: 0;
    }

    .news-item {
      gap: 0.7rem;
      padding: 0.8rem;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.news-tab');
  const panels = document.querySelectorAll<HTMLElement>('.news-panel');

  function activate(tab: HTMLButtonElement) {
    tabs.forEach((t) => {
      const active = t === tab;
      t.classList.toggle('is-active', active);
      t.setAttribute('aria-selected', String(active));
    });
    panels.forEach((p) => {
      const active = p.id === tab.getAttribute('aria-controls');
      p.classList.toggle('is-active', active);
      p.hidden = !active;
    });
  }

  const techPagesEl = document.getElementById('tech-pages');
  const techPagerEl = document.querySelector<HTMLElement>('#panel-tech .news-pager');
  const gateWrap = document.getElementById('tech-gate-wrap');

  function showTechGate() {
    if (!gateWrap) return;
    if (techPagesEl) {
      techPagesEl.hidden = true;
      techPagesEl.style.display = 'none';
    }
    if (techPagerEl) {
      techPagerEl.hidden = true;
      techPagerEl.style.display = 'none';
    }
    gateWrap.hidden = false;
    gateWrap.style.display = 'block';
    if (window.openTechGate) window.openTechGate();
  }

  function hideTechGate() {
    if (!gateWrap) return;
    gateWrap.hidden = true;
    gateWrap.style.display = 'none';
    if (techPagesEl) {
      techPagesEl.hidden = false;
      techPagesEl.removeAttribute('hidden');
      techPagesEl.style.display = '';
      const pages = techPagesEl.querySelectorAll<HTMLElement>('.news-page');
      pages.forEach((p, idx) => {
        if (idx === 0) {
          p.hidden = false;
          p.removeAttribute('hidden');
          p.style.display = '';
        } else {
          p.hidden = true;
          p.setAttribute('hidden', '');
          p.style.display = 'none';
        }
      });
    }
    if (techPagerEl) {
      techPagerEl.hidden = false;
      techPagerEl.removeAttribute('hidden');
      techPagerEl.style.display = 'flex';
      const prevBtn = techPagerEl.querySelector<HTMLButtonElement>('.pager-prev');
      const nextBtn = techPagerEl.querySelector<HTMLButtonElement>('.pager-next');
      const indicator = techPagerEl.querySelector<HTMLElement>('.pager-indicator');
      const totalPages = techPagesEl ? techPagesEl.querySelectorAll('.news-page').length : 1;
      if (prevBtn) prevBtn.disabled = true;
      if (nextBtn) nextBtn.disabled = totalPages <= 1;
      if (indicator) indicator.textContent = `1 / ${totalPages}`;
    }
    if (window.closeTechGate) window.closeTechGate();
  }

  if (localStorage.getItem('ovinas-tech-unlocked') === '1') {
    hideTechGate();
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      if (tab.id === 'tab-tech') {
        const unlocked = localStorage.getItem('ovinas-tech-unlocked') === '1';
        if (!unlocked) {
          activate(tab);
          showTechGate();
          return;
        } else {
          activate(tab);
          hideTechGate();
          return;
        }
      }
      activate(tab);
    });
  });

  window.addEventListener('tech-gate:unlocked', () => {
    const techTab = document.getElementById('tab-tech') as HTMLButtonElement;
    if (techTab) activate(techTab);
    hideTechGate();
  });

  panels.forEach((panel) => {
    const pageEls = Array.from(panel.querySelectorAll<HTMLElement>('.news-page'));
    const pager = panel.querySelector<HTMLElement>('.news-pager');
    if (!pager || pageEls.length <= 1) return;

    const prevBtn = pager.querySelector<HTMLButtonElement>('.pager-prev');
    const nextBtn = pager.querySelector<HTMLButtonElement>('.pager-next');
    const indicator = pager.querySelector<HTMLElement>('.pager-indicator');
    let currentPage = 0;

    function showPage(page: number) {
      currentPage = page;
      pageEls.forEach((el, i) => {
        if (i === page) {
          el.hidden = false;
          el.removeAttribute('hidden');
          el.style.display = '';
        } else {
          el.hidden = true;
          el.setAttribute('hidden', '');
          el.style.display = 'none';
        }
      });
      if (prevBtn) prevBtn.disabled = page === 0;
      if (nextBtn) nextBtn.disabled = page === pageEls.length - 1;
      if (indicator) indicator.textContent = `${page + 1} / ${pageEls.length}`;
    }

    prevBtn?.addEventListener('click', () => showPage(Math.max(0, currentPage - 1)));
    nextBtn?.addEventListener('click', () =>
      showPage(Math.min(pageEls.length - 1, currentPage + 1))
    );
  });
</script>
