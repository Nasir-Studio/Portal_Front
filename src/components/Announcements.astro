---
import announcements from '../data/announcements';
import posts, { type Post } from '../data/posts';

const POSTS_PER_PAGE = 5;
const postsPages = posts.reduce<Post[][]>((pages, post, index) => {
  const pageIndex = Math.floor(index / POSTS_PER_PAGE);
  if (!pages[pageIndex]) pages[pageIndex] = [];
  pages[pageIndex].push(post);
  return pages;
}, []);
---

<section class="module" id="news" aria-label="最新消息">
  <h2 class="module-title">
    <span class="news-head-left">
      <span class="news-square" aria-hidden="true"></span>
      最新消息
    </span>
  </h2>

  <div class="news-tabs" role="tablist" aria-label="最新消息分類">
    <button
      class="news-tab is-active"
      id="tab-announce"
      role="tab"
      aria-selected="true"
      aria-controls="panel-announce"
      type="button"
    >
      最新消息
    </button>
    <button
      class="news-tab"
      id="tab-posts"
      role="tab"
      aria-selected="false"
      aria-controls="panel-posts"
      type="button"
    >
       其他文章
    </button>
  </div>

  <div class="news-panel is-active" id="panel-announce" role="tabpanel" aria-labelledby="tab-announce">
    <div class="news-list">
      {
        announcements.map((item) => (
          <a class="news-item" href={`/news/${item.slug}/`}>
            <span class="news-item-title">{item.title}</span>
            <span class="news-date">{item.date}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="news-panel" id="panel-posts" role="tabpanel" aria-labelledby="tab-posts" hidden>
    <div class="news-pages">
      {
        postsPages.map((pageItems, pageIndex) => (
          <div class="news-page" data-page={pageIndex} hidden={pageIndex !== 0}>
            {pageItems.map((item) => (
              <a class="news-item" href={`/posts/${item.slug}/`}>
                <span class="news-item-title">
                  {item.title}
                  <span class="news-item-excerpt">{item.excerpt}</span>
                </span>
                <span class="news-date">{item.date}</span>
              </a>
            ))}
          </div>
        ))
      }
    </div>
    {
      postsPages.length > 1 && (
        <div class="news-pager" aria-label="其他文章分頁">
          <button class="pager-btn" id="posts-prev" type="button" disabled>← 上一頁</button>
          <span class="pager-indicator" id="posts-indicator">1 / {postsPages.length}</span>
          <button class="pager-btn" id="posts-next" type="button">下一頁 →</button>
        </div>
      )
    }
  </div>
</section>

<style>
  #news {
    scroll-margin-top: 175px;
  }

  .news-head-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .news-square {
    width: 8px;
    height: 8px;
    background: var(--ink);
    transform: rotate(45deg);
  }

  .news-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .news-tab {
    appearance: none;
    background: none;
    border: none;
    border-right: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--ink-3);
    padding: 0.6rem 1.2rem;
    cursor: pointer;
    transition: background var(--t), color var(--t);
    position: relative;
  }

  .news-tab:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .news-tab.is-active {
    color: var(--ink);
    background: var(--surface);
  }

  .news-tab.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--ink);
  }

  .news-list {
    display: flex;
    flex-direction: column;
  }

  .news-item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    min-width: 0;
    padding: 0.85rem 1.1rem;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .news-item:last-child {
    border-bottom: none;
  }

  .news-item:hover {
    background: var(--bg-soft);
  }

  .news-item-title {
    flex: 1;
    min-width: 0;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .news-item-excerpt {
    min-width: 0;
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .news-date {
    flex-shrink: 0;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .news-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.7rem 1.1rem;
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .pager-btn {
    appearance: none;
    background: none;
    border: 1px solid var(--border-strong);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    transition: color var(--t), border-color var(--t), background var(--t);
  }

  .pager-btn:hover:not(:disabled) {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--surface);
  }

  .pager-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pager-indicator {
    font-size: 0.82rem;
    letter-spacing: 0.15em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    #news {
      scroll-margin-top: 0;
    }

    .news-item {
      gap: 0.7rem;
      padding: 0.8rem;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.news-tab');
  const panels = document.querySelectorAll<HTMLElement>('.news-panel');

  function activate(tab: HTMLButtonElement) {
    tabs.forEach((t) => {
      const active = t === tab;
      t.classList.toggle('is-active', active);
      t.setAttribute('aria-selected', String(active));
    });
    panels.forEach((p) => {
      const active = p.id === tab.getAttribute('aria-controls');
      p.classList.toggle('is-active', active);
      p.hidden = !active;
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activate(tab));
  });

  // 其他文章分頁（每頁 5 篇）
  const pageEls = Array.from(document.querySelectorAll<HTMLElement>('.news-page'));
  const prevBtn = document.getElementById('posts-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('posts-next') as HTMLButtonElement | null;
  const indicator = document.getElementById('posts-indicator');
  let currentPage = 0;

  function showPage(page: number) {
    currentPage = page;
    pageEls.forEach((el, i) => {
      el.hidden = i !== page;
    });
    if (prevBtn) prevBtn.disabled = page === 0;
    if (nextBtn) nextBtn.disabled = page === pageEls.length - 1;
    if (indicator) indicator.textContent = `${page + 1} / ${pageEls.length}`;
  }

  if (pageEls.length > 1) {
    prevBtn?.addEventListener('click', () => showPage(Math.max(0, currentPage - 1)));
    nextBtn?.addEventListener('click', () =>
      showPage(Math.min(pageEls.length - 1, currentPage + 1))
    );
  }
</script>
