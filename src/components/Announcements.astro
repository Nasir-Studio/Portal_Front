---
import announcements from '../data/announcements';
---

<section class="news container" id="news" aria-label="最新消息">
  <div class="news-head">
    <span class="news-head-left">
      <span class="news-square" aria-hidden="true"></span>
      <span class="news-title">最新消息</span>
    </span>
    <span class="news-count">{announcements.length} 則公告</span>
  </div>

  <div class="news-list">
    {
      announcements.map((item) => (
        <a class="news-item" href={`/Portal_Front/news/${item.slug}/`}>
          <span class="news-item-title">{item.title}</span>
          <span class="news-date">{item.date}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .news {
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .news-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.3rem;
    background: var(--ink);
    color: var(--white);
  }

  .news-head-left {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .news-square {
    width: 8px;
    height: 8px;
    background: var(--white);
  }

  .news-title {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  .news-count {
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 0.12rem 0.6rem;
  }

  .news-list {
    border-top: 1px solid var(--border);
  }

  .news-item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.85rem 1.3rem;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .news-item:last-child {
    border-bottom: none;
  }

  .news-item:hover {
    background: var(--bg-soft);
  }

  .news-item-title {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .news-date {
    flex-shrink: 0;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
</style>
