---
const banners = [
  {
    title: 'OviNas',
    sub: '',
    tag: '',
    isMain: true,
  },
  {
    title: '羊監視你',
    sub: '即時監視影像',
    tag: 'LIVE CAMERA',
    isMain: false,
  },
  {
    title: '羊集章',
    sub: '集章活動紀錄',
    tag: 'BADGE COLLECTION',
    isMain: false,
  },
  {
    title: '羊愛考試',
    sub: '線上測驗系統',
    tag: 'ONLINE EXAM',
    isMain: false,
  },
];
---

<div class="banner container" aria-label="活動輪播">
  <div class="banner-viewport">
    <ul class="banner-track">
      {
        banners.map((b) => (
          <li class="banner-slide">
            <div class="banner-card">
              <div class="banner-card-inner">
                <img class="banner-logo" src="/logo.png" alt="Logo" width="90" height="90" loading="lazy" />
                <h2 class={`banner-title ${b.isMain ? 'is-main-title' : ''}`}>{b.title}</h2>
                {b.sub && <p class="banner-sub">{b.sub}</p>}
                {b.tag && <span class="banner-tag">{b.tag}</span>}
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <button class="banner-btn banner-prev" type="button" aria-label="上一張">‹</button>
    <button class="banner-btn banner-next" type="button" aria-label="下一張">›</button>

    <div class="banner-dots">
      {
        banners.map((_, i) => (
          <button class="banner-dot" type="button" aria-label={`第 ${i + 1} 張`} data-index={i}></button>
        ))
      }
    </div>
  </div>
</div>

<style is:global>
  .banner {
    padding: 1.6rem 0 0.4rem;
  }

  .banner-viewport {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #f5f4f1;
    user-select: none;
  }

  .banner-track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: transform 0.5s var(--ease);
  }

  .banner-slide {
    flex: 0 0 100%;
    margin: 0;
    padding: 0;
  }

  .banner-card {
    background: #f5f4f1;
    padding: 18px;
    height: 320px;
    box-sizing: border-box;
    display: flex;
  }

  .banner-card-inner {
    width: 100%;
    height: 100%;
    border: 2px solid #1c1c1c;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-sizing: border-box;
    padding: 1.4rem 1rem;
    gap: 0.35rem;
  }

  .banner-logo {
    width: 80px;
    height: 80px;
    object-fit: contain;
    margin-bottom: 0.35rem;
    display: block;
  }

  .banner-title {
    font-family: var(--font-serif);
    font-size: 2.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #1c1c1c;
    margin: 0;
    padding-left: 0.22em;
    line-height: 1.15;
  }

  .banner-title.is-main-title {
    font-size: 3.2rem;
    letter-spacing: 0.26em;
    padding-left: 0.26em;
  }

  .banner-sub {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    letter-spacing: 0.35em;
    color: #4c4b47;
    margin: 0;
    padding-left: 0.35em;
    font-weight: 500;
    line-height: 1.3;
  }

  .banner-tag {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.32em;
    color: #8b8983;
    padding-left: 0.32em;
    margin-top: 0.15rem;
  }

  .banner-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(28, 28, 28, 0.55);
    color: var(--white);
    font-size: 1.3rem;
    line-height: 1;
    border: none;
    cursor: pointer;
    transition: background var(--t);
    z-index: 2;
  }

  .banner-btn:hover {
    background: var(--ink);
  }

  .banner-prev {
    left: 0;
  }

  .banner-next {
    right: 0;
  }

  .banner-dots {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .banner-dot {
    width: 9px;
    height: 9px;
    border: 1px solid #1c1c1c;
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background var(--t);
  }

  .banner-dot.is-active {
    background: #1c1c1c;
  }

  @media (max-width: 700px) {
    .banner.container {
      width: 100%;
    }

    .banner {
      padding: 0.8rem 0 0.2rem;
    }

    .banner-card {
      height: 220px;
      padding: 10px;
    }

    .banner-card-inner {
      border-width: 1.5px;
      padding: 0.8rem 0.5rem;
      gap: 0.25rem;
    }

    .banner-logo {
      width: 52px;
      height: 52px;
      margin-bottom: 0.2rem;
    }

    .banner-title {
      font-size: 1.7rem;
      letter-spacing: 0.16em;
      padding-left: 0.16em;
    }

    .banner-title.is-main-title {
      font-size: 1.95rem;
      letter-spacing: 0.2em;
      padding-left: 0.2em;
    }

    .banner-sub {
      font-size: 0.88rem;
      letter-spacing: 0.22em;
      padding-left: 0.22em;
    }

    .banner-tag {
      font-size: 0.68rem;
      letter-spacing: 0.2em;
      padding-left: 0.2em;
    }

    .banner-btn {
      display: none;
    }

    .banner-dots {
      bottom: 14px;
      gap: 6px;
    }

    .banner-dot {
      width: 7px;
      height: 7px;
    }
  }

  @media (max-width: 400px) {
    .banner-card {
      height: 205px;
      padding: 8px;
    }

    .banner-logo {
      width: 46px;
      height: 46px;
    }

    .banner-title {
      font-size: 1.55rem;
    }

    .banner-title.is-main-title {
      font-size: 1.75rem;
    }

    .banner-sub {
      font-size: 0.82rem;
    }
  }
</style>

<script>
  const viewport = document.querySelector('.banner-viewport');
  if (viewport) {
    const track = viewport.querySelector('.banner-track');
    const dots = Array.from(viewport.querySelectorAll('.banner-dot'));
    const prevBtn = viewport.querySelector('.banner-prev');
    const nextBtn = viewport.querySelector('.banner-next');
    const total = dots.length;
    let index = 0;
    let timer = null;

    const goTo = (i) => {
      index = (i + total) % total;
      if (track) (track as HTMLElement).style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((d, j) => d.classList.toggle('is-active', j === index));
    };

    const play = () => {
      stop();
      timer = setInterval(() => goTo(index + 1), 4500);
    };

    const stop = () => {
      if (timer) clearInterval(timer);
    };

    nextBtn?.addEventListener('click', () => {
      goTo(index + 1);
      play();
    });

    prevBtn?.addEventListener('click', () => {
      goTo(index - 1);
      play();
    });

    dots.forEach((d, j) =>
      d.addEventListener('click', () => {
        goTo(j);
        play();
      })
    );

    viewport.addEventListener('mouseenter', stop);
    viewport.addEventListener('mouseleave', play);

    let touchStartX = 0;
    let touchEndX = 0;

    viewport.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = (e as TouchEvent).changedTouches[0].screenX;
        stop();
      },
      { passive: true }
    );

    viewport.addEventListener(
      'touchend',
      (e) => {
        touchEndX = (e as TouchEvent).changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 45) {
          if (diff > 0) goTo(index + 1);
          else goTo(index - 1);
        }
        play();
      },
      { passive: true }
    );

    goTo(0);
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      play();
    }
  }
</script>
