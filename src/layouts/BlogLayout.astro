  ];

  searchToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    searchDropdown?.classList.toggle('is-open');
    searchToggle.classList.toggle('is-active');
    if (searchDropdown?.classList.contains('is-open')) {
      searchInput?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!searchDropdown?.contains(e.target as Node) && !searchToggle?.contains(e.target as Node)) {
      searchDropdown?.classList.remove('is-open');
      searchToggle?.classList.remove('is-active');
    }
  });

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    if (!liveResults) return;

    if (q.length === 0) {
      liveResults.innerHTML = '';
      liveResults.classList.remove('has-results');
      return;
    }

    const matches = searchArticles.filter(a => 
      a.title.toLowerCase().includes(q) || 
      a.cat.toLowerCase().includes(q) || 
      a.excerpt.toLowerCase().includes(q)
    );

    if (matches.length > 0) {
      liveResults.innerHTML = matches.map(m => `
        <a href="/blog/posts/${m.slug}/" class="live-search-item">
          <div class="live-search-title">${m.title}</div>
          <div class="live-search-meta">${m.cat}</div>
        </a>
      `).join('');
      liveResults.classList.add('has-results');
    } else {
      liveResults.innerHTML = '<div class="live-search-empty">找不到符合的相關文章</div>';
      liveResults.classList.add('has-results');
    }
  });
