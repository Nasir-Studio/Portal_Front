const searchIndexJson = JSON.stringify(
  posts.map((p) => ({
    title: p.title,
    slug: p.slug,
    date: p.date,
    excerpt: p.excerpt,
    text: p.content.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').slice(0, 1500),
  }))
);
