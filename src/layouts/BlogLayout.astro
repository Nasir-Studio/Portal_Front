  // 4. Footer Google Form 聯絡表單發送
  const contactForm = document.getElementById('footerContactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('fcSubmitBtn') as HTMLButtonElement;
  const statusMsg = document.getElementById('fcStatus');

  const GOOGLE_FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeeWapjagLqPsg7i2y_TYhNq2xKW-nNFj6JywiqiDZ8Hkiheg/formResponse';

  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('fcName') as HTMLInputElement).value.trim();
      const email = (document.getElementById('fcEmail') as HTMLInputElement).value.trim();
      const msg = (document.getElementById('fcMsg') as HTMLTextAreaElement).value.trim();

      if (!name || !email || !msg) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '傳送中…';
      }

      try {
        const formData = new FormData();
        formData.append('entry.57084769', name);
        formData.append('entry.135399445', email);
        formData.append('entry.1753446536', msg);

        await fetch(GOOGLE_FORM_URL, {
          method: 'POST',
          mode: 'no-cors',
          body: formData,
        });

        if (statusMsg) {
          statusMsg.textContent = '✓ 訊息已成功送出！';
          statusMsg.className = 'footer-status-msg is-success';
        }

        contactForm.reset();

        setTimeout(() => {
          if (statusMsg) statusMsg.textContent = '';
        }, 4000);
      } catch (err) {
        if (statusMsg) {
          statusMsg.textContent = '✕ 傳送失敗，請稍後再試。';
          statusMsg.className = 'footer-status-msg is-error';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '送出訊息';
        }
      }
    });
  }

  // 5. 全站極速全文搜尋引擎 (Full-Text In-Memory Search Engine)
  const postsIndex = (window as any).__BLOG_SEARCH_INDEX__ || [];

  const searchToggle = document.getElementById('searchToggle');
  const searchModal = document.getElementById('searchModal');
  const searchInput = document.getElementById('globalSearchInput') as HTMLInputElement;
  const searchCloseBtn = document.getElementById('searchModalCloseBtn');
  const searchClearBtn = document.getElementById('searchClearBtn');
  const resultsContainer = document.getElementById('searchResultsList');
  const tagBtns = document.querySelectorAll('.search-tag-btn');

  let selectedIndex = -1;

  function openSearchModal(initialQuery = '') {
    if (!searchModal) return;
    searchModal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    if (searchInput) {
      if (initialQuery) searchInput.value = initialQuery;
      setTimeout(() => searchInput.focus(), 50);
      runSearch(searchInput.value);
    }
  }

  function closeSearchModal() {
    if (!searchModal) return;
    searchModal.classList.remove('is-open');
    document.body.style.overflow = '';
    selectedIndex = -1;
  }

  // 鍵盤快捷鍵 (⌘K / Ctrl+K & ESC)
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (searchModal?.classList.contains('is-open')) {
        closeSearchModal();
      } else {
        openSearchModal();
      }
    } else if (e.key === 'Escape' && searchModal?.classList.contains('is-open')) {
      e.preventDefault();
      closeSearchModal();
    }
  });

  searchToggle?.addEventListener('click', () => openSearchModal());
  searchCloseBtn?.addEventListener('click', closeSearchModal);
  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearchModal();
  });

  searchClearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      runSearch('');
    }
  });

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = btn.getAttribute('data-query') || '';
      openSearchModal(q);
    });
  });

  function escapeRegExp(string: string) {
    return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlightMatches(text: string, queryWords: string[]) {
    if (!queryWords.length) return text;
    const regex = new RegExp('(' + queryWords.map(escapeRegExp).join('|') + ')', 'gi');
    return text.replace(regex, '<mark class="search-hl">$1</mark>');
  }

  function extractSnippet(fullText: string, queryWords: string[]) {
    if (!queryWords.length) return fullText.slice(0, 110) + '…';
    const firstWord = queryWords[0].toLowerCase();
    const idx = fullText.toLowerCase().indexOf(firstWord);
    if (idx === -1) return fullText.slice(0, 110) + '…';

    const start = Math.max(0, idx - 35);
    const end = Math.min(fullText.length, idx + 85);
    let snippet = fullText.slice(start, end);
    if (start > 0) snippet = '…' + snippet;
    if (end < fullText.length) snippet = snippet + '…';
    return snippet;
  }

  function runSearch(rawQuery: string) {
    const q = rawQuery.trim();
    if (searchClearBtn) searchClearBtn.style.display = q ? 'block' : 'none';

    if (!resultsContainer) return;

    if (!q) {
      resultsContainer.innerHTML = '<div class="search-empty-state"><p>輸入關鍵字或點選上方標籤，立即全文檢索 12 篇深度技術專欄！</p></div>';
      selectedIndex = -1;
      return;
    }

    const queryWords = q.toLowerCase().split(/\s+/).filter(Boolean);

    // 計算關聯性分數 (Title: 15分, Excerpt: 6分, Content: 2分)
    const scoredResults = postsIndex.map((post: any) => {
      let score = 0;
      const lowerTitle = post.title.toLowerCase();
      const lowerExcerpt = post.excerpt.toLowerCase();
      const lowerText = post.text.toLowerCase();

      queryWords.forEach((word: string) => {
        if (lowerTitle.includes(word)) score += 15;
        if (lowerExcerpt.includes(word)) score += 6;
        if (lowerText.includes(word)) score += 2;
      });

      return { post, score };
    }).filter((item: any) => item.score > 0).sort((a: any, b: any) => b.score - a.score);

    if (scoredResults.length === 0) {
      resultsContainer.innerHTML = `<div class="search-empty-state"><p>找不到與「<strong style="color:#ff6b00;">${q}</strong>」相關的文章，試試其他關鍵字？</p></div>`;
      selectedIndex = -1;
      return;
    }

    selectedIndex = 0;
    resultsContainer.innerHTML = scoredResults.map(({ post }: any, idx: number) => {
      const highlightedTitle = highlightMatches(post.title, queryWords);
      const snippet = extractSnippet(post.text, queryWords);
      const highlightedSnippet = highlightMatches(snippet, queryWords);

      return `
        <a href="/posts/${post.slug}/" class="search-result-card ${idx === 0 ? 'is-selected' : ''}" data-index="${idx}">
          <div class="search-result-top">
            <div class="search-result-title">${highlightedTitle}</div>
            <span class="search-result-date">${post.date}</span>
          </div>
          <div class="search-result-snippet">${highlightedSnippet}</div>
        </a>
      `;
    }).join('');
  }

  searchInput?.addEventListener('input', () => {
    runSearch(searchInput.value);
  });

  // 鍵盤上下鍵與 Enter 導航
  searchInput?.addEventListener('keydown', (e) => {
    const cards = resultsContainer?.querySelectorAll('.search-result-card');
    if (!cards || cards.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedIndex = (selectedIndex + 1) % cards.length;
      updateCardSelection(cards);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedIndex = (selectedIndex - 1 + cards.length) % cards.length;
      updateCardSelection(cards);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (selectedIndex >= 0 && selectedIndex < cards.length) {
        (cards[selectedIndex] as HTMLElement).click();
      }
    }
  });

  function updateCardSelection(cards: NodeListOf<Element>) {
    cards.forEach((card, idx) => {
      if (idx === selectedIndex) {
        card.classList.add('is-selected');
        card.scrollIntoView({ block: 'nearest' });
      } else {
        card.classList.remove('is-selected');
      }
    });
  }
  
  // 🌐 底部 IP 查詢與彈窗互動邏輯 (nasircy 移植)
  (function() {
    var myIpData = null;
    var footerIpEl = document.getElementById('footerIpText');
    var openBtn = document.getElementById('openIpModalBtn');
    var modal = document.getElementById('ipLookupModal');
    var closeBtn = document.getElementById('closeIpModalBtn');
    var form = document.getElementById('ipSearchForm');
    var searchInput = document.getElementById('ipSearchInput');
    var searchStatus = document.getElementById('ipSearchStatus');
    var resultCard = document.getElementById('ipResultCard');

    function formatISP(org) {
      if (!org) return '未知供應商';
      var parts = org.split(' ');
      if (parts.length > 1 && parts[0].indexOf('AS') === 0) {
        parts.shift();
        return parts.join(' ');
      }
      return org;
    }

    function formatLoc(data) {
      return [data.city, data.region, data.country].filter(Boolean).join(', ') || '未知位置';
    }

    // 取得當前使用者 IP
    fetch('https://ipinfo.io/json')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data && data.ip) {
          myIpData = data;
          var isp = formatISP(data.org);
          if (isp.length > 16) isp = isp.substring(0, 16) + '…';
          if (footerIpEl) footerIpEl.textContent = 'IP：' + data.ip + ' ｜ ' + isp;

          var numEl = document.getElementById('myIpNum');
          var locEl = document.getElementById('myIpLoc');
          var ispEl = document.getElementById('myIpIsp');
          if (numEl) numEl.textContent = data.ip;
          if (locEl) locEl.textContent = formatLoc(data);
          if (ispEl) ispEl.textContent = formatISP(data.org);
        }
      })
      .catch(function() {
        if (footerIpEl) footerIpEl.textContent = '無法取得連線資訊';
      });

    if (openBtn && modal) {
      openBtn.addEventListener('click', function() {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      });
    }

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', function() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      });
    }

    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          modal.style.display = 'none';
          document.body.style.overflow = '';
        }
      });
    }

    if (form && searchInput) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var query = searchInput.value.trim();
        if (!query) return;

        searchStatus.textContent = '查詢中…';
        searchStatus.style.color = '#ff6b00';
        if (resultCard) resultCard.style.display = 'none';

        var isDomain = /[a-zA-Z]/.test(query);
        var targetIP = query;

        try {
          if (isDomain) {
            var dnsRes = await fetch('https://dns.google/resolve?name=' + encodeURIComponent(query) + '&type=A');
            var dnsData = await dnsRes.json();
            if (dnsData.Status === 0 && dnsData.Answer) {
              var aRec = dnsData.Answer.find(function(r) { return r.type === 1; });
              if (aRec) {
                targetIP = aRec.data;
              } else {
                throw new Error('找不到 A 紀錄');
              }
            } else {
              throw new Error('DNS 解析錯誤');
            }
          }

          var ipRes = await fetch('https://ipinfo.io/' + targetIP + '/json');
          if (ipRes.ok) {
            var data = await ipRes.json();
            searchStatus.textContent = '';
            if (resultCard) {
              resultCard.style.display = 'block';
              document.getElementById('ipResultTarget').textContent = isDomain ? query + '（' + data.ip + '）' : '查詢結果';
              document.getElementById('ipResultNum').textContent = data.ip;
              document.getElementById('ipResultLoc').textContent = formatLoc(data);
              document.getElementById('ipResultIsp').textContent = formatISP(data.org);
            }
          } else {
            throw new Error('無法取得 IP 資訊');
          }
        } catch(err) {
          searchStatus.style.color = '#ef4444';
          searchStatus.textContent = err.message || '查詢失敗，請檢查輸入';
        }
      });
    }
  })();

</script>
