---
const { title = 'OviNas 羊之誌 — 網站架設、系統資安與前端工程', description = '專注於網站架設、系統資安、前端工程與開源工具推薦。' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y3XYZ3RKPZ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-Y3XYZ3RKPZ');
  </script>
</head>
<body class="wp-theme-body">
  <!-- 頂部高質感深藍飾條 -->
  <div class="header-top-stripe"></div>

  <!-- 🔷 1. 獨立 WordPress 風格導覽列 (Main Header) -->
  <header id="main-header" class="main-header">
    <div class="container header-row">
      <!-- 經典 3D 浮動 Logo -->
      <div class="logo">
        <div class="img-wrap logo-img-wrap">
          <div class="bgs bgs1"></div>
          <div class="bgs bgs2"></div>
          <div class="bgs bgs3"></div>
          <div class="bgs bgs4"></div>
          <a class="bgs bgs5 logo-box-link" href="/blog/">
            <span class="logo-text">羊之<br>誌</span>
          </a>
        </div>
        <div class="logo-sub-title">
          <a href="/blog/" class="site-title-link">OviNas 羊之誌</a>
          <span class="site-desc-text">技術專欄 · 資安 · 架構 · 雲端實戰</span>
        </div>
      </div>

      <!-- 導覽選單與主站聯通 -->
      <div class="header-right">
        <nav class="main-menu" aria-label="部落格主選單">
          <ul>
            <li><a href="/blog/">首頁</a></li>
            <li><a href="/blog/#all-posts">全部文章</a></li>
            <li><a href="/posts/security-research-report/">系統資安</a></li>
            <li><a href="/posts/tech-notes-architecture/">架構筆記</a></li>
            <li><a href="/posts/front-end-design/">前端工程</a></li>
            <li><a href="/posts/github-open-source-tools/">開源精選</a></li>
            <li><a href="/vip/" class="nav-highlight-link">VIP 專區</a></li>
            <li><a href="/" class="back-portal-btn">← 回 Portal 首頁</a></li>
          </ul>
        </nav>

        <!-- 手機漢堡選單按鈕 -->
        <button id="mobileMenuToggle" class="mobile-toggle" aria-label="開啟選單">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <!-- 手機版下拉選單 -->
    <div id="mobileDropdown" class="mobile-dropdown-menu" hidden>
      <ul>
        <li><a href="/blog/">首頁</a></li>
        <li><a href="/blog/#all-posts">全部文章</a></li>
        <li><a href="/posts/security-research-report/">系統資安</a></li>
        <li><a href="/posts/tech-notes-architecture/">架構筆記</a></li>
        <li><a href="/posts/front-end-design/">前端工程</a></li>
        <li><a href="/posts/github-open-source-tools/">開源精選</a></li>
        <li><a href="/vip/">VIP 專區</a></li>
        <li><a href="/reserve/">預約服務</a></li>
        <li><a href="/badges/">證照專區</a></li>
        <li><a href="/cctv/">即時影像</a></li>
        <li><a href="/" class="back-portal-btn">← 回 Portal 首頁</a></li>
      </ul>
    </div>
  </header>

  <!-- 📖 2. 頁面主要內容插槽 (Main Content) -->
  <div class="blog-main-content">
    <slot />
  </div>

  <!-- 📜 3. 獨立 WordPress 風格頁尾 (Footer - 深度連結 Portal 主站體系) -->
  <footer class="wp-footer">
    <div class="container footer-grid">
      <!-- 左側：文章版權宣告 -->
      <div class="footer-col footer-about">
        <h2 class="footer-heading">文章版權宣告</h2>
        <div class="footer-text-body">
          <p>
            本站文章歡迎於非營利目的下合理引用，只需於引用處附上原文連結即可。謝謝對本站內容的認可。
          </p>
        </div>
      </div>

      <!-- 右側：網站導覽連結 -->
      <div class="footer-col footer-links">
        <h2 class="footer-heading">快速導覽</h2>
        <ul class="footer-nav-list">
          <li><a href="/blog/">部落格首頁</a></li>
          <li><a href="/blog/#all-posts">全部文章</a></li>
          <li><a href="https://github.com/Nasir-VM" target="_blank" rel="noopener">GitHub 專頁</a></li>
          <li><a href="/">返回 Portal 主站</a></li>
        </ul>
      </div>
    </div>

    <!-- 底部版權條 -->
    <div class="footer-bottom-bar">
      <div class="container bottom-bar-inner">
        <p class="copyright-text">© 2026 OviNas · All Rights Reserved.</p>
        <div class="bottom-links">
          <a href="/blog/">部落格</a>
          <span>·</span>
          <a href="/">主站首頁</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const dropdown = document.getElementById('mobileDropdown');
    if (toggleBtn && dropdown) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = dropdown.hidden;
        dropdown.hidden = !isHidden;
        toggleBtn.classList.toggle('is-active', isHidden);
      });
    }
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  body.wp-theme-body {
    margin: 0;
    padding: 0;
    font-family: "Lato", "Noto Sans TC", "PingFang TC", "Helvetica Neue", "SF Pro TC", "Helvetica", "Arial", "Microsoft JhengHei", sans-serif;
    color: #333333;
    background-color: #ffffff;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .header-top-stripe {
    height: 5px;
    background-color: #0062eb;
    width: 100%;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* 🔷 Header 樣式 */
  .main-header {
    background-color: #ffffff;
    border-bottom: 1px solid #e7e7e7;
    position: sticky;
    top: 0;
    z-index: 999;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 85px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* 3D 浮動方塊 Logo (.bgs1 ~ .bgs5) */
  .logo-img-wrap {
    position: relative;
    width: 52px;
    height: 52px;
    margin: 0;
  }

  .logo-box-link {
    width: 52px;
    height: 52px;
    background-color: #0062eb;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #ffffff;
    transition: all 0.2s ease;
  }

  .logo-text {
    font-size: 1.05rem;
    font-weight: 900;
    line-height: 1.1;
    text-align: center;
    color: #ffffff;
    letter-spacing: 1px;
  }

  .logo-img-wrap:hover .logo-box-link {
    background-color: #222222;
  }

  .logo-sub-title {
    display: flex;
    flex-direction: column;
  }

  .site-title-link {
    font-size: 1.3rem;
    font-weight: 900;
    color: #111111;
    text-decoration: none;
    letter-spacing: 0.5px;
  }

  .site-desc-text {
    font-size: 0.78rem;
    color: #888888;
    letter-spacing: 0.5px;
  }

  /* 導覽選單 */
  .header-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .main-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 1.3rem;
  }

  .main-menu a {
    color: #444444;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    transition: color 0.2s ease;
    padding: 8px 0;
  }

  .main-menu a:hover {
    color: #0062eb;
  }

  .nav-highlight-link {
    color: #0062eb !important;
    border-bottom: 2px solid #0062eb;
  }

  .back-portal-btn {
    background-color: #f3f4f6;
    color: #0062eb !important;
    padding: 6px 14px !important;
    border: 1px solid #e5e7eb;
    transition: all 0.2s ease;
  }

  .back-portal-btn:hover {
    background-color: #0062eb;
    color: #ffffff !important;
    border-color: #0062eb;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .mobile-toggle span {
    width: 24px;
    height: 3px;
    background-color: #222222;
    transition: all 0.2s ease;
  }

  .mobile-dropdown-menu {
    background-color: #ffffff;
    border-top: 1px solid #eeeeee;
    border-bottom: 2px solid #0062eb;
    padding: 1rem 1.5rem;
  }

  .mobile-dropdown-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .mobile-dropdown-menu a {
    color: #333333;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    display: block;
    padding: 6px 0;
  }

  /* 📜 3. Footer 樣式 (極簡經典深黑藍) */
  .wp-footer {
    background-color: #161a22;
    color: #cccccc;
    padding-top: 3rem;
    border-top: 5px solid #0062eb;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    padding-bottom: 2.5rem;
  }

  .footer-heading {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1rem;
    letter-spacing: 0.5px;
    border-bottom: 2px solid #282f3d;
    padding-bottom: 0.5rem;
  }

  .footer-text-body p {
    font-size: 0.88rem;
    line-height: 1.7;
    color: #94a3b8;
    margin: 0;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav-list a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.2s ease;
  }

  .footer-nav-list a:hover {
    color: #38bdf8;
  }

  .footer-bottom-bar {
    background-color: #0d1117;
    padding: 1.2rem 0;
    border-top: 1px solid #1e293b;
  }

  .bottom-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: #64748b;
  }

  .copyright-text {
    margin: 0;
  }

  .bottom-links {
    display: flex;
    gap: 0.8rem;
  }

  .bottom-links a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .bottom-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 960px) {
    .main-menu {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
    .bottom-bar-inner {
      flex-direction: column;
      gap: 0.6rem;
      text-align: center;
    }
  }
</style>