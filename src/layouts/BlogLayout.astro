    padding: 12px 14px;
  }

  /* 選單文字顏色採用經典柔和灰色 (#666666)，Hover 切換暖橙色 */
  .menu-item > a {
    color: #666666;
    text-decoration: none;
    font-size: 16px;
    font-weight: 400;
    transition: color 0.2s ease;
    display: flex;
