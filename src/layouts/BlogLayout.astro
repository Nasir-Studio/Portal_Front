import LiveChatWidget from '../components/LiveChatWidget.svelte';
import posts from '../data/posts';
import quotes from '../data/quotes';

const today = new Date();
const seed = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
const dailyQuote = quotes[seed % quotes.length];

const { title = 'OviNas — 網站架設、系統資安、筆記小分享', description = '專注於網站架設、系統資安、筆記小分享與開源工具推薦。' } = Astro.props;

const searchIndexJson = JSON.stringify(
  posts.map((p) => ({
    title: p.title,
    slug: p.slug,
    date: p.date,
    excerpt: p.excerpt,
    text: p.content.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').slice(0, 1500),
  }))
);
