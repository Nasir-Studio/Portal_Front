  }

  .mobile-menu-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mobile-menu-links li {
    border-bottom: 1px solid #f4f4f4;
  }

  
  /* 📱 行動版折疊子選單 Accordion 樣式 (極簡自然無橘色) */
  .mobile-has-sub {
    position: relative;
  }

  .mobile-sub-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
