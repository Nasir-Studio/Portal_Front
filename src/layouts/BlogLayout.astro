---
const { title = 'OviNas 羊之誌 — 網站架設、系統資安與前端工程', description = '專注於網站架設、系統資安、前端工程與開源工具推薦。' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&family=Noto+Sans+TC:wght@300;400;500;700;900&display=swap" rel="stylesheet" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y3XYZ3RKPZ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-Y3XYZ3RKPZ');
  </script>
</head>
<body class="wp-theme-body">
  <!-- 頂部高質感深藍飾條 -->
  <div class="header-top-stripe"></div>

  <!-- 🔷 1. 獨立 WordPress 風格導覽列 (Main Header) -->
  <header id="main-header" class="main-header">
    <div class="container header-row">
      <!-- 經典 3D 浮動 Logo -->
      <div class="logo">
        <div class="img-wrap logo-img-wrap">
          <div class="bgs bgs1"></div>
          <div class="bgs bgs2"></div>
          <div class="bgs bgs3"></div>
          <div class="bgs bgs4"></div>
          <a class="bgs bgs5 logo-link" href="/blog/">
            <span class="logo-text">羊之<br>誌</span>
          </a>
        </div>
        <div class="sub-txt">
          <a href="/blog/" class="logo-site-name">OviNas 羊之誌</a>
          <span class="logo-site-desc">網站架設 · 系統資安 · 前端工程</span>
        </div>
      </div>

      <!-- 右側主選單 -->
      <div class="header-right">
        <nav class="main-menu" aria-label="部落格主選單">
          <ul>
            <li><a href="/blog/">首頁</a></li>
            <li><a href="/blog/#all-posts">全部文章</a></li>
            <li><a href="/posts/security-research-report/">系統資安</a></li>
            <li><a href="/posts/tech-notes-architecture/">架構筆記</a></li>
            <li><a href="/posts/front-end-design/">前端工程</a></li>
            <li><a href="/posts/github-open-source-tools/">開源工具</a></li>
            <li class="nav-cta-btn"><a href="/">返回 Portal 主站</a></li>
          </ul>
        </nav>

        <!-- 手機漢堡按鈕 -->
        <button id="mobileMenuToggle" class="mobile-toggle" aria-label="開啟選單">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <!-- 手機版下拉選單 -->
    <div id="mobileDropdown" class="mobile-dropdown-menu" hidden>
      <ul>
        <li><a href="/blog/">首頁</a></li>
        <li><a href="/blog/#all-posts">全部文章</a></li>
        <li><a href="/posts/security-research-report/">系統資安</a></li>
        <li><a href="/posts/tech-notes-architecture/">架構筆記</a></li>
        <li><a href="/posts/front-end-design/">前端工程</a></li>
        <li><a href="/posts/github-open-source-tools/">開源工具</a></li>
        <li><a href="/">返回 Portal 主站</a></li>
      </ul>
    </div>
  </header>

  <!-- 📖 2. 頁面主要內容插槽 (Main Content) -->
  <div class="blog-main-content">
    <slot />
  </div>

  <!-- 📜 3. 獨立 WordPress 風格頁尾 (Footer - 深度連結 Portal 主站體系) -->
    <!-- 📜 3. 經典 WordPress 淺灰頁尾 + 亮藍底條 (.footer-content #eee + .bottom-bar #0062eb) -->
  <footer class="footer">
    <div class="footer-content">
      <div class="container footer-layout">
        <!-- 左側：文章版權宣告 -->
        <div class="footer-left">
          <h2>文章版權宣告</h2>
          <div class="content">
            <p>
              目前的部落格還在處理樣式中！
            </p>
            <h3>關注 OviNas 羊之誌</h3>
            <div class="social-links-row">
              <a href="https://github.com/Nasir-VM" target="_blank" rel="noopener" class="social-btn gh-btn">GitHub</a>
              <a href="/vip/" class="social-btn vip-btn">VIP 專區</a>
              <a href="/" class="social-btn portal-btn">Portal 首頁</a>
            </div>
          </div>
        </div>

        <!-- 中間：聯絡與主站服務 -->
        <div class="footer-center">
          <h2>站長聯絡與交流</h2>
          <div class="content">
            <p>技術交流、系統開發或資安諮詢請來信：</p>
            <p class="mail-p">
              ✉️ <a href="mailto:hi@nasirlin.net">hi@nasirlin.net</a>
            </p>
            <p>各類主站便民服務與工具，請隨時點選主站首頁入口導覽。</p>
          </div>
        </div>

        <!-- 右側：主題快速導覽標籤 (白底標籤按鈕) -->
        <div class="footer-right">
          <h2>主題快速導覽</h2>
          <div class="content tag-buttons-wrap">
            <a href="/blog/#all-posts">系統資安</a>
            <a href="/blog/#all-posts">巨型架構</a>
            <a href="/blog/#all-posts">前端工程</a>
            <a href="/blog/#all-posts">PWA應用</a>
            <a href="/blog/#all-posts">開源工具</a>
            <a href="/blog/#all-posts">代理爬蟲</a>
            <a href="/blog/#all-posts">自媒體</a>
            <a href="/blog/#all-posts">WordPress</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 底部皇家藍色版權條 -->
    <div class="bottom-bar">
      <div class="container bottom-bar-container">
        Copyright &copy; 2026 OviNas | 羊之誌 | <a href="/">回 Portal 首頁</a> | <a href="/blog/">部落格</a>
      </div>
    </div>
  </footer>

  <script>
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const dropdown = document.getElementById('mobileDropdown');
    if (toggleBtn && dropdown) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = dropdown.hidden;
        dropdown.hidden = !isHidden;
        toggleBtn.classList.toggle('is-active', isHidden);
      });
    }
  </script>
</body>
</html>

<style is:global>
    *, *::before, *::after {
    box-sizing: border-box;
  }

  html, body, button, input, optgroup, select, textarea {
    font-family: "Lato", "Noto Sans TC", "PingFang TC", "Helvetica Neue", "SF Pro TC", "Helvetica", "Arial", "Microsoft JhengHei", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: "Lato", "Noto Sans TC", "Helvetica Neue", "PingFang TC", "SF Pro TC", "Helvetica", "Arial", "Microsoft JhengHei", "Microsoft YaHei", sans-serif;
    font-weight: 700;
  }

  body.wp-theme-body {
    margin: 0;
    padding: 0;
    color: #333333;
    background-color: #ffffff;
    line-height: 1.6;
  }

  .header-top-stripe {
    height: 5px;
    background-color: #0062eb;
    width: 100%;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* 🔷 Header 樣式 (100% 還原經典自媒體比例) */
  .main-header {
    background-color: #ffffff;
    border-bottom: 1px solid #e7e7e7;
    position: sticky;
    top: 0;
    z-index: 999;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 90px;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  /* 3D 浮動方塊 Logo (.bgs1 ~ .bgs5) */
  .logo-img-wrap {
    position: relative;
    width: 60px;
    height: 60px;
    margin: 0;
    flex-shrink: 0;
  }

  .logo-link {
    width: 60px;
    height: 60px;
    background-color: #0062eb;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #ffffff;
    border-radius: 6px;
    transition: background-color 0.2s ease;
  }

  .logo-text {
    font-size: 1.1rem;
    font-weight: 900;
    line-height: 1.15;
    text-align: center;
    color: #ffffff;
    letter-spacing: 1px;
    font-family: "Noto Sans TC", sans-serif;
  }

  .logo-img-wrap:hover .logo-link {
    background-color: #222222;
  }

  .logo-img-wrap .bgs1 { border-right: 0.5rem solid #0062eb; }
  .logo-img-wrap .bgs2 { border-top: 0.5rem solid #0062eb; }
  .logo-img-wrap .bgs3, .logo-img-wrap .bgs4 { background: #0062eb; }

  .sub-txt {
    margin-left: 14px;
    display: flex;
    flex-direction: column;
  }

  .logo-site-name {
    font-size: 1.25rem;
    font-weight: 900;
    color: #111111;
    text-decoration: none;
    letter-spacing: 0.5px;
  }

  .logo-site-name:hover {
    color: #0062eb;
  }

  .logo-site-desc {
    font-size: 0.78rem;
    color: #888888;
    margin-top: 2px;
  }

  /* 導覽選單 */
  .header-right {
    display: flex;
    align-items: center;
  }

  .main-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }

  .main-menu a {
    color: #555555;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .main-menu a:hover {
    color: #ff6488;
  }

  /* 經典右側膠囊按鈕 (.nav-cta-btn) */
  .nav-cta-btn a {
    display: block;
    background-color: #0062eb;
    color: #ffffff !important;
    padding: 0 20px;
    height: 40px;
    line-height: 40px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.88rem;
    transition: all 0.25s ease;
  }

  .nav-cta-btn a:hover {
    background-color: #ff6488 !important;
    transform: translateY(-1px);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .mobile-toggle span {
    width: 24px;
    height: 3px;
    background-color: #222222;
    transition: all 0.2s ease;
  }

  .mobile-dropdown-menu {
    background-color: #ffffff;
    border-top: 1px solid #eeeeee;
    border-bottom: 2px solid #0062eb;
    padding: 1rem 1.5rem;
  }

  .mobile-dropdown-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .mobile-dropdown-menu a {
    color: #333333;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    display: block;
    padding: 6px 0;
  }
  
  /* 📜 3. Footer 樣式 (100% 依據經典自媒體 #eee 淺灰 + #0062eb 亮藍底條) */
  .footer {
    position: relative;
    font-size: 15px;
    margin-top: 3rem;
  }

  .footer .footer-content {
    background-color: #eeeeee;
    padding: 3.5em 0 3em;
    color: #444444;
  }

  .footer-layout {
    display: flex;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .footer .footer-left {
    width: 44%;
  }

  .footer .footer-center {
    width: 30%;
  }

  .footer .footer-right {
    width: 26%;
  }

  .footer-content h2 {
    border-left: 5px solid #0062eb;
    padding-left: 10px;
    margin-bottom: 0.6em;
    font-size: 1.15rem;
    font-weight: 800;
    color: #222222;
  }

  .footer-content h3 {
    margin: 1.2rem 0 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: #222222;
  }

  .footer-content .content {
    padding-left: 15px;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .footer-content p {
    margin: 0 0 0.8rem;
    color: #555555;
  }

  .footer-content a {
    color: #0062eb;
    text-decoration: none;
  }

  .footer-content a:hover {
    color: #ff6488;
  }

  .mail-p {
    font-weight: 700;
  }

  .social-links-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }

  .social-btn {
    display: inline-block;
    padding: 6px 14px;
    background-color: #ffffff;
    color: #0062eb !important;
    border: 1px solid #d1d5db;
    font-size: 0.84rem;
    font-weight: 700;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .social-btn:hover {
    background-color: #0062eb;
    color: #ffffff !important;
    border-color: #0062eb;
  }

  /* 白底方形標籤導覽 */
  .tag-buttons-wrap a {
    display: inline-block;
    background-color: #ffffff;
    padding: 4px 12px;
    margin: 0 6px 6px 0;
    color: #333333 !important;
    font-size: 0.84rem;
    border: 1px solid #e2e2e2;
    transition: all 0.2s ease;
  }

  .tag-buttons-wrap a:hover {
    background-color: #0062eb;
    color: #ffffff !important;
    border-color: #0062eb;
  }

  /* 底部亮藍底條 */
  .footer .bottom-bar {
    background-color: #0062eb;
    padding: 1.1rem 0;
    color: #ffffff;
    font-size: 0.86rem;
    text-align: left;
  }

  .bottom-bar-container {
    color: #ffffff;
  }

  .footer .bottom-bar a {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer .bottom-bar a:hover {
    color: #f7d002;
  }

  @media (max-width: 960px) {
    .main-menu {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .footer-layout {
      flex-direction: column;
      gap: 2rem;
    }
    .footer .footer-left,
    .footer .footer-center,
    .footer .footer-right {
      width: 100%;
    }
  }
</style>