---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AmbientBackground from '../components/AmbientBackground.astro';
import LiveChatWidget from '../components/LiveChatWidget.svelte';
import PageLoader from '../components/PageLoader.svelte';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OviNas',
  description = 'OviNas — 個人入口網站：羊監視你、羊集章、羊愛考試與羊-短網址服務。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
      <!-- 🚫 嚴格禁止所有搜尋引擎、爬蟲、Google 與 AI 模型抓取 -->
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate, noai, noimageai" />
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="google-extended" content="noindex" />
  <meta name="robots" content="noai, noimageai" />
  <meta name="bingbot" content="noindex, nofollow" />
    <meta name="theme-color" content="#fafaf8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="OviNas" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Noto+Serif+TC:wght@600;700&family=Noto+Sans+TC:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <PageLoader client:load />
    <AmbientBackground />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <LiveChatWidget client:load />
    <Footer />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' }).catch(function () {});
        });
      }
    </script>
  </body>
</html>
