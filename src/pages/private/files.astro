---
import FileManager from '../../components/files/FileManager.svelte';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>檔案管理</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- 🔐 Admin guard：非 admin 立即 redirect，不載入任何頁面內容 -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('sheep_portal_user');
          var user = raw ? JSON.parse(raw) : null;
          if (!user || user.role !== 'admin') {
            window.location.replace('/login/?redirect=' + encodeURIComponent(window.location.pathname));
          }
        } catch {
          window.location.replace('/login/');
        }
      })();
    </script>
    
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y3XYZ3RKPZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-Y3XYZ3RKPZ');
    </script>
    <style is:global>
      :root {
        --bg: #f5f5f4;
        --panel: #ffffff;
        --border: #e4e4e3;
        --text: #1c1917;
        --muted: #78716c;
        --accent: #2563eb;
        --accent-dark: #1d4ed8;
        --danger: #dc2626;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans TC', 'PingFang TC', sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
      }
      button {
        font: inherit;
        cursor: pointer;
      }
      input {
        font: inherit;
      }
    </style>
  </head>
  <body>
    <FileManager client:load />
    <script is:inline>
      var hc = new Image();
      hc.src = 'https://www.hitwebcounter.com/counter/counter.php?page=21514902&style=0001&nbdigits=8&type=page';
    </script>
  </body>
</html>
