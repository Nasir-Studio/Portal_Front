<script>
  // ⚡ 即時分類切換、搜尋與計數功能 (Dynamic Filtering & Real-time Counting)
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const filterTabs = document.querySelectorAll('.filter-tab');
  const postCards = document.querySelectorAll('.wp-post-card');
  const emptyNotice = document.getElementById('emptySearchNotice');
  const countDisplay = document.getElementById('postCountDisplay');
  const sectionTitle = document.getElementById('sectionTitle');

  let currentCategory = 'all';
  let currentSearchQuery = '';

  const categoryNames: Record<string, string> = {
    all: '精選文章',
    security: '系統資安文章',
    architecture: '架構雲端文章',
    design: '前端設計文章',
    tools: '開源工具文章',
    campus: '校園專案文章',
  };

  function updatePosts() {
    let visibleCount = 0;

    postCards.forEach((card) => {
      const el = card as HTMLElement;
      const cardCategory = el.getAttribute('data-cat') || '';
      const cardTitle = el.getAttribute('data-title') || '';
      const cardExcerpt = el.getAttribute('data-excerpt') || '';

      const matchCategory = currentCategory === 'all' || cardCategory === currentCategory;
      const matchSearch = currentSearchQuery === '' ||
        cardTitle.includes(currentSearchQuery) ||
        cardExcerpt.includes(currentSearchQuery);

      if (matchCategory && matchSearch) {
        el.style.display = 'flex';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    // 更新計數顯示
    if (countDisplay) {
      countDisplay.textContent = `顯示中: ${visibleCount} 篇`;
    }

    // 更新區塊標題
    if (sectionTitle) {
      sectionTitle.textContent = currentSearchQuery
        ? `搜尋結果: 「${currentSearchQuery}」`
        : (categoryNames[currentCategory] || '精選文章');
    }

    // 無結果提示
    if (emptyNotice) {
      emptyNotice.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  // 1. 分類標籤點擊事件
  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      currentCategory = tab.getAttribute('data-filter') || 'all';
      updatePosts();
    });
  });

  // 2. 搜尋框即時輸入
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      updatePosts();
    });
  }

  // 3. 標籤雲快速過濾
  document.querySelectorAll('.wp-tag-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const query = btn.getAttribute('data-search') || '';
      if (searchInput) {
        searchInput.value = query;
        currentSearchQuery = query.toLowerCase();
        updatePosts();
        document.getElementById('all-posts')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // 4. 卡片分類標籤點擊
  document.querySelectorAll('.cat-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = link.getAttribute('data-cat-target') || 'all';
      filterTabs.forEach((tab) => {
        if (tab.getAttribute('data-filter') === target) {
          (tab as HTMLElement).click();
          document.getElementById('all-posts')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  });
</script>
