---
import BlogLayout from '../../layouts/BlogLayout.astro';
import posts from '../../data/posts';

const allPosts = posts;
const featuredPost = posts[0];

function getPostCategory(post: typeof posts[0]) {
  if (post.slug.includes('security') || post.slug.includes('audit')) {
    return { name: '系統資安', slug: 'security' };
  }
  if (post.slug.includes('architecture') || post.slug.includes('pwa')) {
    return { name: '架構伺服器', slug: 'architecture' };
  }
  if (post.slug.includes('design') || post.slug.includes('front-end')) {
    return { name: '前端設計', slug: 'design' };
  }
  if (post.slug.includes('tool') || post.slug.includes('proxy') || post.slug.includes('github')) {
    return { name: '外掛工具', slug: 'tools' };
  }
  if (post.slug.includes('ntub') || post.slug.includes('exam')) {
    return { name: '專案實戰', slug: 'campus' };
  }
  return { name: 'WordPress', slug: 'general' };
}
---

<BlogLayout title="OviNas 羊之誌 — 網站架設、系統資安、前端工程與外掛推薦" description="專注於網站架設、系統資安、前端工程與開源工具推薦。">
  <div class="make9-page-wrapper">
    <div class="container">
      <!-- 🔷 1. 經典 Hero Header 區塊 (左側標題 + 右側 16:9 文青照片輪播焦點) -->
      <section class="content-hero-header">
        <div class="hero-left">
          <h1 class="hero-brand">OviNas 羊之誌</h1>
          <h2 class="hero-tagline">網站架設、系統資安、前端工程、外掛推薦</h2>
          <a href="/posts/" class="btn-about">瀏覽全部文章</a>
        </div>
        <div class="hero-right">
          <div class="slider-wrap-header">
            <div class="slider-one">
              <div class="img-wrap">
                <div class="bgs bgs1"></div>
                <div class="bgs bgs2"></div>
                <div class="bgs bgs3"></div>
                <div class="bgs bgs4"></div>
                <a class="bgs bgs5 hero-featured-card" href={`/posts/${featuredPost.slug}/`}>
                  <div class="featured-img-box">
                    <img src={`/banners/${featuredPost.slug}.jpg`} alt={featuredPost.title} class="featured-real-photo" />
                    <div class="slogan">
                      <div class="slogan-text">{featuredPost.title}</div>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 🔍 2. 分類導航列與即時搜尋欄 (即時動態計數) -->
      <section class="make9-nav-bar" id="all-posts">
        <div class="nav-pills-group" id="filterButtons">
          <button class="nav-pill is-active" data-cat="all" type="button">
            全部文章 <span class="pill-badge">({allPosts.length})</span>
          </button>
          <button class="nav-pill" data-cat="security" type="button">
            系統資安 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('security') || p.slug.includes('audit')).length})</span>
          </button>
          <button class="nav-pill" data-cat="architecture" type="button">
            架構伺服器 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('architecture') || p.slug.includes('pwa')).length})</span>
          </button>
          <button class="nav-pill" data-cat="design" type="button">
            前端設計 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('design') || p.slug.includes('front-end')).length})</span>
          </button>
          <button class="nav-pill" data-cat="tools" type="button">
            外掛工具 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('tool') || p.slug.includes('proxy') || p.slug.includes('github')).length})</span>
          </button>
          <button class="nav-pill" data-cat="campus" type="button">
            專案實戰 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('ntub') || p.slug.includes('exam')).length})</span>
          </button>
        </div>

        <div class="make9-search-box">
          <input
            id="make9Search"
            type="search"
            class="search-input-field"
            placeholder="輸入你想找的知識…"
            autocomplete="off"
          />
          <button class="search-btn-field" type="button" aria-label="搜尋文章">
            搜尋
          </button>
        </div>
      </section>

      <!-- 📰 3. 主內容區（左側文章卡片網格 + 右側標準側邊欄） -->
      <div class="content-area-top">
        <div class="left">
          <!-- 區塊標題條 (經典 post-area-head) -->
          <div class="post-area-head">
            <h2 class="post-area-title" id="currentSectionTitle">精選文章</h2>
            <a href="/posts/" class="cat-read-all" id="currentCountDisplay">共 {allPosts.length} 篇文章</a>
          </div>

          <!-- 2 欄式文章網格 (post-list col3) -->
          <div class="post-list col3" id="postGrid">
            {allPosts.map((post) => {
              const cat = getPostCategory(post);
              return (
                <article
                  class="make9-article-card"
                  data-cat={cat.slug}
                  data-title={post.title.toLowerCase()}
                  data-excerpt={post.excerpt.toLowerCase()}
                >
                  <!-- 🎨 經典 3D 幾何 Hover 浮起遮罩層 (bgs1 ~ bgs5 + 16:9 文青照片) -->
                  <div class="img-wrap">
                    <div class="bgs bgs1"></div>
                    <div class="bgs bgs2"></div>
                    <div class="bgs bgs3"></div>
                    <div class="bgs bgs4"></div>
                    <a class="bgs bgs5 card-thumb-box" href={`/posts/${post.slug}/`}>
                      <div class="card-thumb-photo-wrap">
                        <img src={`/banners/${post.slug}.jpg`} alt={post.title} class="card-photo" loading="lazy" />
                      </div>
                    </a>
                  </div>

                  <ul class="post-categories">
                    <li>
                      <a href="#" class="cat-tag-link" data-target-cat={cat.slug}>{cat.name}</a>
                    </li>
                  </ul>

                  <h3 class="post-title">
                    <a href={`/posts/${post.slug}/`}>{post.title}</a>
                  </h3>

                  <p class="post-excerpt">{post.excerpt}</p>

                  <div class="post-meta">
                    <span class="post-date">{post.date}</span>
                    <a href={`/posts/${post.slug}/`} class="read-more">閱讀更多</a>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- 查無結果提示 -->
          <div class="empty-results-box" id="emptyNotice" style="display: none;">
            <h3>查無相關文章！</h3>
            <p>請嘗試使用其他關鍵字搜尋，或點選上方「全部文章」。</p>
          </div>
        </div>

        <!-- 📌 右側經典側邊欄 (Sidebar) -->
        <aside class="right sidebar-right">
          <!-- 作者專欄 (Side Author Box) -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="100" height="100" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長專欄</span></h2>
            <p class="history">全端開發 · 巨型架構 · 系統資安</p>
            <p class="author-bio">
              專注於現代 Web 架構設計、高效能前端、系統資安滲透稽核與邊緣雲端技術。追求純粹細膩的排版美學。
            </p>
            <div class="side-btn-row">
              <a href="/vip/" class="btn-side-vip">加入 VIP 專區</a>
            </div>
          </div>

          <!-- 熱門排行側欄 (#popular-side: 75px 1:1 正方形真實文青照片微縮圖) -->
          <div class="popular-posts" id="popular-side">
            <h3 class="side-section-heading">熱門推薦文章</h3>
            <ul class="wpp-list">
              {allPosts.slice(0, 5).map((p, idx) => {
                const cat = getPostCategory(p);
                return (
                  <li class="wpp-item">
                    <a href={`/posts/${p.slug}/`} class="wpp-thumb-link">
                      <div class="wpp-thumbnail-box">
                        <img src={`/banners/${p.slug}.jpg`} alt={p.title} class="wpp-thumb-img" />
                      </div>
                    </a>
                    <div class="wpp-details">
                      <a href={`/posts/${p.slug}/`} class="wpp-post-title">
                        {p.title}
                      </a>
                      <span class="wpp-meta">{p.date} · {cat.name}</span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- 快速標籤探索 -->
          <div class="tag-widget-box">
            <h3 class="side-section-heading">熱門主題標籤</h3>
            <div class="make9-tag-cloud">
              <button class="tag-link-pill" data-kw="資安" type="button">系統資安</button>
              <button class="tag-link-pill" data-kw="架構" type="button">巨型架構</button>
              <button class="tag-link-pill" data-kw="pwa" type="button">PWA</button>
              <button class="tag-link-pill" data-kw="設計" type="button">前端設計</button>
              <button class="tag-link-pill" data-kw="代理" type="button">代理爬蟲</button>
              <button class="tag-link-pill" data-kw="北商" type="button">北商學程</button>
              <button class="tag-link-pill" data-kw="github" type="button">開源精選</button>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
  .make9-page-wrapper {
    background-color: #ffffff;
    padding: 1.5rem 0 5rem;
  }

  /* 🔷 1. 經典 Hero 區塊 */
  .content-hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2.5rem;
    padding: 2.5rem 0 2.8rem;
    border-bottom: 1px solid #e7e7e7;
    margin-bottom: 2rem;
  }

  .content-hero-header .hero-left {
    flex: 0 0 38%;
  }

  .hero-brand {
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.2;
    color: #222222;
    margin: 0 0 0.8rem;
    letter-spacing: 1px;
  }

  .hero-tagline {
    font-size: 1.05rem;
    font-weight: 400;
    color: #666666;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .btn-about {
    display: inline-block;
    background-color: #ff6b00;
    color: #ffffff;
    padding: 11px 26px;
    font-size: 0.95rem;
    font-weight: 400;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-about:hover {
    background-color: #ea580c;
  }

  .content-hero-header .hero-right {
    flex: 0 0 58%;
  }

  .slider-wrap-header {
    width: 100%;
    position: relative;
  }

  .featured-img-box {
    position: relative;
    width: 100%;
    height: 300px;
    background-color: #000000;
    overflow: hidden;
  }

  .featured-real-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .img-wrap:hover .featured-real-photo {
    transform: scale(1.03);
  }

  .slogan {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(5px);
    padding: 12px 20px;
    box-sizing: border-box;
    transition: background-color 0.2s ease;
  }

  .img-wrap:hover .slogan {
    background-color: rgba(255, 107, 0, 0.88);
  }

  .slogan-text {
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 🎨 3D 幾何 Hover 浮動陰影層 (.bgs1 ~ .bgs5) */
  .img-wrap {
    position: relative;
    width: 100%;
    margin-bottom: 0.8rem;
  }

  .bgs {
    transition: transform 0.15s ease;
  }

  .bgs1 {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-top: 0.6rem solid rgba(0, 0, 0, 0);
    border-bottom: 0.6rem solid rgba(0, 0, 0, 0);
    border-right: 0.6rem solid #ff6b00;
    transform-origin: left center;
    transform: translateY(-0.6rem) scale(0);
  }

  .bgs2 {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 0;
    height: 0;
    border-left: 0.6rem solid rgba(0, 0, 0, 0);
    border-right: 0.6rem solid rgba(0, 0, 0, 0);
    border-top: 0.6rem solid #ff6b00;
    transform-origin: center bottom;
    transform: translateX(0.6rem) scale(0);
  }

  .bgs3 {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    background: #ff6b00;
    transform-origin: 0px 100%;
    width: 0.6rem;
    transform: scaleX(0);
  }

  .bgs4 {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ff6b00;
    transform-origin: 0px 100%;
    height: 0.6rem;
    transform: scaleY(0);
  }

  a.bgs5 {
    display: block;
    text-decoration: none;
  }

  .img-wrap:hover .bgs1 {
    transform: translateY(-0.6rem) scale(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs2 {
    transform: translateX(0.6rem) scale(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs3 {
    transform: scaleX(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs4 {
    transform: scaleY(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover a.bgs5 {
    transform: translate3d(0.6rem, -0.6rem, 0px);
    transition-delay: 70ms;
  }

  article:nth-child(2n) .img-wrap .bgs1 { border-right: 0.6rem solid #f59e0b; }
  article:nth-child(2n) .img-wrap .bgs2 { border-top: 0.6rem solid #f59e0b; }
  article:nth-child(2n) .img-wrap .bgs3,
  article:nth-child(2n) .img-wrap .bgs4 { background: #f59e0b; }

  article:nth-child(3n) .img-wrap .bgs1 { border-right: 0.6rem solid #ff6b00; }
  article:nth-child(3n) .img-wrap .bgs2 { border-top: 0.6rem solid #ff6b00; }
  article:nth-child(3n) .img-wrap .bgs3,
  article:nth-child(3n) .img-wrap .bgs4 { background: #ff6b00; }

  /* 🔍 2. 分類導航與搜尋列 */
  .make9-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.2rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid #e7e7e7;
  }

  .nav-pills-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .nav-pill {
    background-color: #f3f4f6;
    color: #555555;
    border: none;
    padding: 7px 15px;
    font-size: 0.88rem;
    font-weight: 400;
    cursor: pointer;
    border-radius: 0;
    transition: all 0.2s ease;
  }

  .nav-pill:hover {
    background-color: #e5e7eb;
    color: #111111;
  }

  .nav-pill.is-active {
    background-color: #ff6b00;
    color: #ffffff;
  }

  .pill-badge {
    font-size: 0.78rem;
    opacity: 0.85;
  }

  .make9-search-box {
    display: flex;
    align-items: center;
    flex: 0 0 320px;
  }

  .search-input-field {
    width: 100%;
    padding: 8px 12px;
    font-size: 0.88rem;
    border: 1px solid #d1d5db;
    border-right: none;
    outline: none;
    border-radius: 0;
    background: #ffffff;
  }

  .search-input-field:focus {
    border-color: #ff6b00;
  }

  .search-btn-field {
    background-color: #ff6b00;
    color: #ffffff;
    border: 1px solid #ff6b00;
    padding: 8px 18px;
    font-size: 0.88rem;
    font-weight: 400;
    cursor: pointer;
    border-radius: 0;
    transition: background-color 0.2s ease;
  }

  .search-btn-field:hover {
    background-color: #ea580c;
  }

  /* 📰 3. 主內容與側邊欄排版 (content-area-top) */
  .content-area-top {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
  }

  .content-area-top .left {
    flex: 0 0 calc(70% - 1.5rem);
  }

  .content-area-top .right.sidebar-right {
    flex: 0 0 calc(30% - 1.5rem);
  }

  .post-area-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    border-bottom: 3px solid #eeeeee;
    transition: border-bottom 0.2s ease;
  }

  .post-area-head:hover {
    border-bottom: 3px solid #ff6b00;
  }

  .post-area-title {
    background-color: #ff6b00;
    color: #ffffff;
    display: inline-block;
    padding: 10px 22px;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 1px;
    margin: 0;
  }

  .cat-read-all {
    display: block;
    color: #555555;
    background-color: #eeeeee;
    font-size: 0.86rem;
    font-weight: 400;
    padding: 10px 18px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .post-area-head:hover .cat-read-all {
    background-color: #ff6b00;
    color: #ffffff;
  }

  /* 2 欄式文章網格 (post-list col3) */
  .post-list.col3 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.2rem;
  }

  .make9-article-card {
    background: #ffffff;
    border-bottom: 1px solid #e7e7e7;
    padding-bottom: 1.8rem;
    display: flex;
    flex-direction: column;
  }

  .card-thumb-photo-wrap {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: #f0f0f0;
  }

  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .img-wrap:hover .card-photo {
    transform: scale(1.04);
  }

  /* 文章標籤與文字 */
  .post-categories {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0.4rem;
    display: flex;
  }

  .post-categories li {
    background-color: #ff6b00;
    padding: 2px 8px;
    border-radius: 3px;
  }

  .cat-tag-link {
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 400;
    text-decoration: none;
  }

  .post-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.38;
    margin: 6px 0 8px;
  }

  .post-title a {
    color: #333333;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: #ff6b00;
  }

  .post-excerpt {
    font-size: 0.86rem;
    line-height: 1.6;
    color: #666666;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    font-weight: 400;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    font-size: 0.82rem;
    color: #999999;
  }

  .read-more {
    background-color: #ff6b00;
    color: #ffffff;
    padding: 5px 18px;
    font-size: 0.82rem;
    font-weight: 400;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .read-more:hover {
    background-color: #3bce89;
    color: #ffffff;
  }

  /* 📌 側邊欄樣式 */
  .side-author-box {
    text-align: center;
    margin-bottom: 2.5rem;
    border: 1px solid #e7e7e7;
    padding: 2rem 1.5rem;
  }

  .side-author-box .photo {
    border-radius: 50%;
    overflow: hidden;
    width: 90px;
    height: 90px;
    margin: 0 auto 1.2rem;
    border: 3px solid #ff6b00;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .side-author-box h2 {
    margin-bottom: 0.3rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #222222;
  }

  .side-author-box h2 .eng-name {
    font-size: 0.88rem;
    color: #999999;
    font-weight: 400;
  }

  .side-author-box .history {
    color: #ff6b00;
    font-size: 0.82rem;
    font-weight: 400;
    margin: 0 0 0.8rem;
  }

  .side-author-box .author-bio {
    font-size: 0.84rem;
    line-height: 1.6;
    color: #666666;
    margin: 0 0 1.2rem;
    font-weight: 400;
  }

  .btn-side-vip {
    display: block;
    background-color: #ff6b00;
    color: #ffffff;
    padding: 8px 0;
    font-size: 0.86rem;
    font-weight: 400;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-side-vip:hover {
    background-color: #ea580c;
  }

  /* 熱門推薦文章 (#popular-side) */
  .popular-posts {
    margin-bottom: 2.5rem;
    padding: 10px 0;
    border-top: 4px solid #222222;
  }

  .side-section-heading {
    font-size: 1.05rem;
