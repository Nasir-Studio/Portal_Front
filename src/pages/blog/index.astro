---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/posts';

// 分類與文章整理
const allPosts = posts;
const featuredPost = posts[0]; // 第一篇作為置頂焦點

// 各分類文章過濾
const securityPosts = posts.filter(p => p.slug.includes('security') || p.slug.includes('audit'));
const archPosts = posts.filter(p => p.slug.includes('architecture') || p.slug.includes('pwa'));
const designPosts = posts.filter(p => p.slug.includes('design') || p.slug.includes('front-end'));
const toolsPosts = posts.filter(p => p.slug.includes('tool') || p.slug.includes('proxy') || p.slug.includes('github'));
const campusPosts = posts.filter(p => p.slug.includes('ntub') || p.slug.includes('exam'));

function getCategoryInfo(post: typeof posts[0]) {
  if (post.slug.includes('security') || post.slug.includes('audit')) {
    return { name: '系統資安', slug: 'security', color: '#0062eb' };
  }
  if (post.slug.includes('architecture') || post.slug.includes('pwa')) {
    return { name: '架構雲端', slug: 'architecture', color: '#0062eb' };
  }
  if (post.slug.includes('design') || post.slug.includes('front-end')) {
    return { name: '前端設計', slug: 'design', color: '#0062eb' };
  }
  if (post.slug.includes('tool') || post.slug.includes('proxy') || post.slug.includes('github')) {
    return { name: '開源工具', slug: 'tools', color: '#0062eb' };
  }
  if (post.slug.includes('ntub') || post.slug.includes('exam')) {
    return { name: '校園專案', slug: 'campus', color: '#0062eb' };
  }
  return { name: '技術筆記', slug: 'general', color: '#0062eb' };
}
---

<BaseLayout title="部落格 ｜ OviNas 羊之誌 — 網站架設、系統資安與前端工程">
  <div class="wp-blog-wrapper">
    <!-- 頂部高對比裝飾藍條 -->
    <div class="wp-top-stripe"></div>

    <div class="wp-container">
      <!-- 🔷 1. 經典 Hero 區塊 (左大標 + 右大型精選輪播圖) -->
      <section class="content-hero-header">
        <div class="hero-left">
          <div class="hero-brand-tag">
            <span class="tag-square">■</span>
            <span>WordPress 風格專欄 · 羊之誌</span>
          </div>
          <h1 class="hero-main-title">OviNas<br>羊之誌</h1>
          <h2 class="hero-sub-title">網站架設、系統資安、前端工程、開源工具</h2>
          <div class="hero-cta-wrap">
            <a href="#all-posts" class="wp-btn wp-btn-blue">瀏覽全部文章</a>
            <a href="/vip/" class="wp-btn wp-btn-dark">VIP 專區</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="slider-wrap-header">
            <div class="slider-one">
              <a href={`/posts/${featuredPost.slug}/`}>
                <div class="featured-img-container">
                  <div class="visual-badge">★ 本期頭條推薦</div>
                  <div class="geometric-decorations">
                    <span class="geo-corner top-left"></span>
                    <span class="geo-corner bottom-right"></span>
                  </div>
                  <!-- 半透明毛玻璃文字底條 (Classic WordPress Overlay) -->
                  <div class="slider-caption-overlay">
                    <span class="caption-cat">系統資安</span>
                    <h3 class="caption-title">{featuredPost.title}</h3>
                    <p class="caption-desc">{featuredPost.excerpt}</p>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 🔍 2. 分類導航列與即時搜尋欄 (即時動態計數) -->
      <section class="filter-search-bar" id="all-posts">
        <div class="cat-pill-group" id="categoryFilter">
          <button class="filter-tab is-active" data-filter="all" type="button">
            全部文章 <span class="filter-count">({allPosts.length})</span>
          </button>
          <button class="filter-tab" data-filter="security" type="button">
            系統資安 <span class="filter-count">({securityPosts.length})</span>
          </button>
          <button class="filter-tab" data-filter="architecture" type="button">
            架構雲端 <span class="filter-count">({archPosts.length})</span>
          </button>
          <button class="filter-tab" data-filter="design" type="button">
            前端設計 <span class="filter-count">({designPosts.length})</span>
          </button>
          <button class="filter-tab" data-filter="tools" type="button">
            開源工具 <span class="filter-count">({toolsPosts.length})</span>
          </button>
          <button class="filter-tab" data-filter="campus" type="button">
            校園專案 <span class="filter-count">({campusPosts.length})</span>
          </button>
        </div>

        <div class="search-box-wrap">
          <input
            id="searchInput"
            type="search"
            class="wp-search-input"
            placeholder="輸入你想找的知識或關鍵字…"
            autocomplete="off"
          />
          <button class="wp-search-btn" type="button" aria-label="搜尋">
            搜尋
          </button>
        </div>
      </section>

      <!-- 📰 3. 主內容區（左側文章卡片列表 + 右側標準側欄） -->
      <div class="main-content-layout">
        <!-- 左側主版面 (70% 寬度) -->
        <main class="content-left">
          <!-- 區塊 1: 最新發布文章 (3 欄式 方形卡片網格) -->
          <div class="post-area-head">
            <h2 class="post-area-title" id="sectionTitle">精選文章</h2>
            <span class="cat-read-all" id="postCountDisplay">顯示中: {allPosts.length} 篇</span>
          </div>

          <div class="post-list col3" id="postListContainer">
            {allPosts.map((post, idx) => {
              const cat = getCategoryInfo(post);
              return (
                <article
                  class="wp-post-card"
                  data-cat={cat.slug}
                  data-title={post.title.toLowerCase()}
                  data-excerpt={post.excerpt.toLowerCase()}
                >
                  <div class="img-wrap">
                    <!-- 方形俐落幾何裝飾層 -->
                    <div class="bgs bgs-accent"></div>
                    <a class="card-thumb-link" href={`/posts/${post.slug}/`}>
                      <div class="card-thumb-visual" data-theme={cat.slug}>
                        <span class="card-index-num">#{idx < 9 ? `0${idx + 1}` : idx + 1}</span>
                        <div class="card-thumb-overlay">
                          <span class="read-prompt">點擊閱讀</span>
                        </div>
                      </div>
                    </a>
                  </div>

                  <div class="card-text-content">
                    <ul class="post-categories">
                      <li><a href="#" class="cat-link" data-cat-target={cat.slug}>{cat.name}</a></li>
                    </ul>

                    <h3 class="post-title">
                      <a href={`/posts/${post.slug}/`}>{post.title}</a>
                    </h3>

                    <p class="post-excerpt">{post.excerpt}</p>

                    <div class="post-meta-footer">
                      <span class="post-date">{post.date}</span>
                      <a href={`/posts/${post.slug}/`} class="post-read-more">詳細內容 »</a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <div class="wp-empty-search" id="emptySearchNotice" style="display: none;">
            <div class="empty-icon">🔍</div>
            <h3>抱歉，找不到符合條件的文章！</h3>
            <p>請嘗試使用其他關鍵字，或點選上方「全部文章」重新檢視。</p>
          </div>
        </main>

        <!-- 📌 右側經典側邊欄 (30% 寬度) -->
        <aside class="content-sidebar">
          <!-- 作者介紹框 (Side Author Box) -->
          <div class="side-widget side-author-box">
            <div class="author-photo-wrap">
              <img class="author-photo" src="/sheep-hd.png" alt="OviNas" width="110" height="110" />
            </div>
            <h3 class="author-name">
              OviNas <span class="eng-name">/ 站長專欄</span>
            </h3>
            <p class="author-desc">
              專注於全端系統開發、現代化網站架設、資安滲透防護與效能優化。喜愛探索各類提升生產力的開源工具與極致設計。
            </p>
            <div class="author-btn-wrap">
              <a href="/vip/" class="wp-btn wp-btn-blue-sm">加入 VIP 會員</a>
            </div>
          </div>

          <!-- 熱門文章排行 (Popular Posts with Ranked Numbers) -->
          <div class="side-widget popular-widget" id="popular-side">
            <h3 class="side-widget-title">
              <span class="title-square">■</span> 本站熱門排行
            </h3>
            <ul class="wpp-list">
              {allPosts.slice(0, 5).map((p, idx) => {
                const cat = getCategoryInfo(p);
                return (
                  <li class="wpp-item">
                    <span class={`wpp-rank-badge rank-${idx + 1}`}>{idx + 1}</span>
                    <div class="wpp-info">
                      <a href={`/posts/${p.slug}/`} class="wpp-post-title">
                        {p.title}
                      </a>
                      <span class="wpp-date">{p.date} · {cat.name}</span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- 熱門標籤雲 (Tag Cloud) -->
          <div class="side-widget tag-cloud-widget">
            <h3 class="side-widget-title">
              <span class="title-square">■</span> 熱門標籤探索
            </h3>
            <div class="wp-tag-cloud">
              <button class="wp-tag-btn" data-search="資安" type="button"># 系統資安</button>
              <button class="wp-tag-btn" data-search="架構" type="button"># 巨型架構</button>
              <button class="wp-tag-btn" data-search="pwa" type="button"># PWA 應用</button>
              <button class="wp-tag-btn" data-search="設計" type="button"># 前端設計</button>
              <button class="wp-tag-btn" data-search="代理" type="button"># 代理清單</button>
              <button class="wp-tag-btn" data-search="北商" type="button"># 北商學程</button>
              <button class="wp-tag-btn" data-search="github" type="button"># 開源精選</button>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 🌟 全局容器與經典 WordPress 配色 */
  .wp-blog-wrapper {
    background-color: #ffffff;
    min-height: 100vh;
    padding-bottom: 5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #333333;
  }

  /* 頂部藍色標誌線條 */
  .wp-top-stripe {
    height: 5px;
    background: #0062eb;
    width: 100%;
  }

  .wp-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* 🔷 1. 經典 Hero 區塊 (Split Hero) */
  .content-hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2.5rem;
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid #e7e7e7;
    margin-bottom: 2rem;
  }

  .hero-left {
    flex: 0 0 38%;
  }

  .hero-brand-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #0062eb;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 1px;
    margin-bottom: 0.8rem;
  }

  .tag-square {
    font-size: 0.75rem;
  }

  .hero-main-title {
    font-size: 2.8rem;
    font-weight: 900;
    line-height: 1.15;
    color: #111111;
    margin: 0 0 0.8rem;
    letter-spacing: 2px;
  }

  .hero-sub-title {
    font-size: 1.05rem;
    font-weight: 400;
    color: #666666;
    line-height: 1.6;
    margin: 0 0 1.8rem;
  }

  .hero-cta-wrap {
    display: flex;
    gap: 0.8rem;
  }

  .wp-btn {
    display: inline-block;
    padding: 12px 24px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border-radius: 0px;
    transition: all 0.2s ease;
  }

  .wp-btn-blue {
    background-color: #0062eb;
    color: #ffffff;
    border: 1px solid #0062eb;
  }

  .wp-btn-blue:hover {
    background-color: #0047bb;
    color: #ffffff;
  }

  .wp-btn-dark {
    background-color: #222222;
    color: #ffffff;
    border: 1px solid #222222;
  }

  .wp-btn-dark:hover {
    background-color: #0062eb;
    border-color: #0062eb;
    color: #ffffff;
  }

  .hero-right {
    flex: 0 0 58%;
  }

  .slider-wrap-header {
    width: 100%;
    position: relative;
  }

  .featured-img-container {
    position: relative;
    width: 100%;
    height: 310px;
    background: linear-gradient(135deg, #111827 0%, #1f2937 50%, #111827 100%);
    border-radius: 0px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .visual-badge {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    background-color: #0062eb;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 6px 14px;
    letter-spacing: 1px;
    z-index: 2;
  }

  /* 幾何四角 (Square geometric corners) */
  .geo-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: #f7d002;
    border-style: solid;
    pointer-events: none;
  }

  .geo-corner.top-left {
    top: 10px;
    right: 10px;
    border-width: 3px 3px 0 0;
  }

  .geo-corner.bottom-right {
    bottom: 10px;
    right: 10px;
    border-width: 0 3px 3px 0;
  }

  /* 半透明毛玻璃文字底條 */
  .slider-caption-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(10px);
    padding: 1.2rem 1.6rem;
    color: #ffffff;
    box-sizing: border-box;
    transition: background-color 0.25s ease;
  }

  .featured-img-container:hover .slider-caption-overlay {
    background-color: rgba(0, 98, 235, 0.85);
  }

  .caption-cat {
    display: inline-block;
    color: #f7d002;
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .caption-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 0.4rem;
    color: #ffffff;
  }

  .caption-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #dddddd;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 🔍 2. 篩選與搜尋列 */
  .filter-search-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.2rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid #e7e7e7;
  }

  .cat-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-tab {
    background-color: #f3f4f6;
    color: #4b5563;
    border: none;
    padding: 8px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 0px;
    transition: all 0.2s ease;
  }

  .filter-tab:hover {
    background-color: #e5e7eb;
    color: #111827;
  }

  .filter-tab.is-active {
    background-color: #0062eb;
    color: #ffffff;
  }

  .filter-count {
    font-size: 0.78rem;
    opacity: 0.85;
  }

  .search-box-wrap {
    display: flex;
    align-items: center;
    flex: 0 0 320px;
  }

  .wp-search-input {
    width: 100%;
    padding: 9px 12px;
    font-size: 0.88rem;
    border: 1px solid #d1d5db;
    border-right: none;
    outline: none;
    border-radius: 0px;
    background: #ffffff;
  }

  .wp-search-input:focus {
    border-color: #0062eb;
  }

  .wp-search-btn {
    background-color: #0062eb;
    color: #ffffff;
    border: 1px solid #0062eb;
    padding: 9px 18px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    border-radius: 0px;
    transition: background-color 0.2s ease;
  }

  .wp-search-btn:hover {
    background-color: #0047bb;
  }

  /* 📰 3. 主內容與側欄排版 */
  .main-content-layout {
    display: flex;
    justify-content: space-between;
    gap: 2.8rem;
  }

  .content-left {
    flex: 0 0 calc(70% - 1.4rem);
  }

  .content-sidebar {
    flex: 0 0 calc(30% - 1.4rem);
  }

  /* 標題欄條 (Classic post-area-head) */
  .post-area-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    border-bottom: 3px solid #eeeeee;
    transition: border-bottom 0.2s ease;
  }

  .post-area-head:hover {
    border-bottom: 3px solid #f7d002;
  }

  .post-area-title {
    background-color: #0062eb;
    color: #ffffff;
    display: inline-block;
    padding: 12px 24px;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin: 0;
  }

  .cat-read-all {
    display: block;
    color: #4b5563;
    background-color: #eeeeee;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 12px 20px;
    transition: background-color 0.2s ease;
  }

  .post-area-head:hover .cat-read-all {
    background-color: #f7d002;
    color: #111111;
  }

  /* 3 欄方形卡片網格 (post-list col3) */
  .post-list.col3 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .wp-post-card {
    background: #ffffff;
    border-bottom: 2px solid #f3f4f6;
    padding-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease;
  }

  .wp-post-card:hover {
    transform: translateY(-3px);
  }

  .img-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .card-thumb-link {
    display: block;
  }

  .card-thumb-visual {
    width: 100%;
    height: 180px;
    background: #222222;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0px;
    transition: background-color 0.3s ease;
  }

  .card-thumb-visual[data-theme="security"] { background: linear-gradient(135deg, #1e293b, #0f172a); }
  .card-thumb-visual[data-theme="architecture"] { background: linear-gradient(135deg, #0369a1, #0c4a6e); }
  .card-thumb-visual[data-theme="design"] { background: linear-gradient(135deg, #701a75, #4a044e); }
  .card-thumb-visual[data-theme="tools"] { background: linear-gradient(135deg, #15803d, #14532d); }
  .card-thumb-visual[data-theme="campus"] { background: linear-gradient(135deg, #b45309, #78350f); }

  .card-index-num {
    font-size: 3.5rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.18);
    letter-spacing: 2px;
  }

  .card-thumb-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 98, 235, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .wp-post-card:hover .card-thumb-overlay {
    opacity: 1;
  }

  .read-prompt {
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 1px;
    border: 2px solid #ffffff;
    padding: 6px 16px;
  }

  /* 文章內文 */
  .card-text-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-categories {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    display: flex;
    gap: 0.4rem;
  }

  .cat-link {
    color: #0062eb;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cat-link:hover {
    color: #0047bb;
    text-decoration: underline;
  }

  .post-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 0.6rem;
  }

  .post-title a {
    color: #222222;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: #0062eb;
  }

  .post-excerpt {
    font-size: 0.86rem;
    line-height: 1.6;
    color: #666666;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .post-meta-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: #999999;
    border-top: 1px solid #eeeeee;
    padding-top: 0.75rem;
  }

  .post-read-more {
    color: #0062eb;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-read-more:hover {
    color: #0047bb;
  }

  /* 📌 側邊欄樣式 */
  .side-widget {
