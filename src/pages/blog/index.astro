---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/posts';

const allPosts = posts;
const featuredPost = posts[0];

function getPostCategory(post: typeof posts[0]) {
  if (post.slug.includes('security') || post.slug.includes('audit')) {
    return { name: '系統資安', slug: 'security', color: '#0062eb' };
  }
  if (post.slug.includes('architecture') || post.slug.includes('pwa')) {
    return { name: '架構伺服器', slug: 'architecture', color: '#0062eb' };
  }
  if (post.slug.includes('design') || post.slug.includes('front-end')) {
    return { name: '前端設計', slug: 'design', color: '#0062eb' };
  }
  if (post.slug.includes('tool') || post.slug.includes('proxy') || post.slug.includes('github')) {
    return { name: '外掛工具', slug: 'tools', color: '#0062eb' };
  }
  if (post.slug.includes('ntub') || post.slug.includes('exam')) {
    return { name: '專案實戰', slug: 'campus', color: '#0062eb' };
  }
  return { name: 'WordPress', slug: 'general', color: '#0062eb' };
}
---

<BaseLayout title="部落格 ｜ OviNas 羊之誌 — 網站架設、系統資安、前端設計與外掛推薦">
  <div class="make9-page-wrapper">
    <!-- 頂部高質感深藍飾條 -->
    <div class="top-color-stripe"></div>

    <div class="make9-container">
      <!-- 🔷 1. 經典 Hero Header 區塊 (左側大標 + 右側置頂 3D 浮動焦點) -->
      <section class="content-hero-header">
        <div class="left">
          <h1 class="hero-brand">OviNas 羊之誌</h1>
          <h2 class="hero-tagline">網站架設、系統資安、前端工程</h2>
          <a href="/vip/" class="btn-about">關於 OviNas</a>
        </div>
        <div class="right">
          <div class="slider-wrap-header">
            <div class="slider-one">
              <div class="img-wrap">
                <div class="bgs bgs1"></div>
                <div class="bgs bgs2"></div>
                <div class="bgs bgs3"></div>
                <div class="bgs bgs4"></div>
                <a class="bgs bgs5 hero-featured-card" href={`/posts/${featuredPost.slug}/`}>
                  <div class="featured-bg-canvas">
                    <span class="hero-corner-badge">★ 本月熱門精選</span>
                    <div class="hero-graphic-icon">🛡️</div>
                    <div class="slogan">
                      <div class="slogan-text">{featuredPost.title}</div>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 🔍 2. 分類導航列與即時搜尋欄 (支援即時計算篇數) -->
      <section class="make9-nav-bar" id="categoryNav">
        <div class="nav-pills-group" id="filterButtons">
          <button class="nav-pill is-active" data-cat="all" type="button">
            全部文章 <span class="pill-badge" id="count-all">({allPosts.length})</span>
          </button>
          <button class="nav-pill" data-cat="security" type="button">
            系統資安 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('security') || p.slug.includes('audit')).length})</span>
          </button>
          <button class="nav-pill" data-cat="architecture" type="button">
            架構伺服器 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('architecture') || p.slug.includes('pwa')).length})</span>
          </button>
          <button class="nav-pill" data-cat="design" type="button">
            前端設計 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('design') || p.slug.includes('front-end')).length})</span>
          </button>
          <button class="nav-pill" data-cat="tools" type="button">
            外掛工具 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('tool') || p.slug.includes('proxy') || p.slug.includes('github')).length})</span>
          </button>
          <button class="nav-pill" data-cat="campus" type="button">
            專案實戰 <span class="pill-badge">({allPosts.filter(p => p.slug.includes('ntub') || p.slug.includes('exam')).length})</span>
          </button>
        </div>

        <div class="make9-search-box">
          <input
            id="make9Search"
            type="search"
            class="search-input-field"
            placeholder="輸入你想找的知識…"
            autocomplete="off"
          />
          <button class="search-btn-field" type="button" aria-label="搜尋文章">
            搜尋
          </button>
        </div>
      </section>

      <!-- 📰 3. 主內容區（左側文章卡片列表 + 右側標準側邊欄） -->
      <div class="content-area-top">
        <div class="left">
          <!-- 區塊標題條 (經典 post-area-head 帶黃色 hover 變色) -->
          <div class="post-area-head">
            <h2 class="post-area-title" id="currentSectionTitle">精選文章</h2>
            <a href="#categoryNav" class="cat-read-all" id="currentCountDisplay">共 {allPosts.length} 篇文章</a>
          </div>

          <!-- 3 欄式文章網格 (post-list col3) -->
          <div class="post-list col3" id="postGrid">
            {allPosts.map((post, idx) => {
              const cat = getPostCategory(post);
              return (
                <article
                  class="make9-article-card"
                  data-cat={cat.slug}
                  data-title={post.title.toLowerCase()}
                  data-excerpt={post.excerpt.toLowerCase()}
                >
                  <!-- 🎨 經典 3D 幾何 Hover 浮起遮罩層 (bgs1 ~ bgs5) -->
                  <div class="img-wrap">
                    <div class="bgs bgs1"></div>
                    <div class="bgs bgs2"></div>
                    <div class="bgs bgs3"></div>
                    <div class="bgs bgs4"></div>
                    <a class="bgs bgs5 card-thumb-box" href={`/posts/${post.slug}/`}>
                      <div class="card-thumb-bg" data-cat-theme={cat.slug}>
                        <span class="card-num-watermark">#{idx < 9 ? `0${idx + 1}` : idx + 1}</span>
                        <div class="card-hover-mask">
                          <span class="mask-read-text">閱讀文章</span>
                        </div>
                      </div>
                    </a>
                  </div>

                  <ul class="post-categories">
                    <li>
                      <a href="#" class="cat-tag-link" data-target-cat={cat.slug}>{cat.name}</a>
                    </li>
                  </ul>

                  <h3 class="post-title">
                    <a href={`/posts/${post.slug}/`}>{post.title}</a>
                  </h3>

                  <p class="post-excerpt">{post.excerpt}</p>

                  <div class="post-meta">
                    <span class="post-date">{post.date}</span>
                    <a href={`/posts/${post.slug}/`} class="read-more">閱讀更多</a>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- 查無結果 -->
          <div class="empty-results-box" id="emptyNotice" style="display: none;">
            <div class="empty-icon-sheep">🐑</div>
            <h3>查無相關文章！</h3>
            <p>請嘗試使用其他關鍵字搜尋，或點選上方「全部文章」。</p>
          </div>
        </div>

        <!-- 📌 右側經典側邊欄 (Sidebar) -->
        <aside class="right sidebar-right">
          <!-- 作者專欄 (Side Author Box) -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="140" height="140" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長專欄</span></h2>
            <p class="history">全端開發 · 系統架構 · 資安防護</p>
            <p class="author-bio">
              專注於現代 Web 架構設計、高效能前端、系統資安稽核與 Cloudflare 邊緣技術。追求極致細膩的介面質感。
            </p>
            <div class="side-btn-row">
              <a href="/vip/" class="btn-side-vip">加入 VIP 專區</a>
            </div>
          </div>

          <!-- 熱門排行側欄 (#popular-side) -->
          <div class="popular-posts" id="popular-side">
            <h3 class="side-section-heading">熱門推薦文章</h3>
            <ul class="wpp-list">
              {allPosts.slice(0, 5).map((p, idx) => {
                const cat = getPostCategory(p);
                return (
                  <li class="wpp-item">
                    <span class={`wpp-rank rank-${idx + 1}`}>{idx + 1}</span>
                    <div class="wpp-details">
                      <a href={`/posts/${p.slug}/`} class="wpp-post-title">
                        {p.title}
                      </a>
                      <span class="wpp-meta">{p.date} · {cat.name}</span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- 快速標籤探索 -->
          <div class="tag-widget-box">
            <h3 class="side-section-heading">熱門主題標籤</h3>
            <div class="make9-tag-cloud">
              <button class="tag-link-pill" data-kw="資安" type="button">系統資安</button>
              <button class="tag-link-pill" data-kw="架構" type="button">巨型架構</button>
              <button class="tag-link-pill" data-kw="pwa" type="button">PWA</button>
              <button class="tag-link-pill" data-kw="設計" type="button">前端設計</button>
              <button class="tag-link-pill" data-kw="代理" type="button">代理爬蟲</button>
              <button class="tag-link-pill" data-kw="北商" type="button">北商學程</button>
              <button class="tag-link-pill" data-kw="github" type="button">開源精選</button>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 🌟 全局字型與排版架構 (100% 還原經典風格) */
  .make9-page-wrapper {
    background-color: #ffffff;
    min-height: 100vh;
    padding-bottom: 5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #333333;
  }

  .top-color-stripe {
    height: 5px;
    background: #0062eb;
    width: 100%;
  }

  .make9-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  /* 🔷 1. 經典 Hero 區塊 (content-hero-header) */
  .content-hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2.5rem;
    padding: 3.5rem 0 2.8rem;
    border-bottom: 1px solid #e7e7e7;
    margin-bottom: 2rem;
  }

  .content-hero-header .left {
    flex: 0 0 38%;
  }

  .hero-brand {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.15;
    color: #111111;
    margin: 0 0 0.8rem;
    letter-spacing: 2px;
  }

  .hero-tagline {
    font-size: 1.15rem;
    font-weight: 400;
    color: #666666;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .btn-about {
    display: inline-block;
    background-color: #0062eb;
    color: #ffffff;
    padding: 12px 28px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-about:hover {
    background-color: #0047bb;
  }

  .content-hero-header .right {
    flex: 0 0 58%;
  }

  .slider-wrap-header {
    width: 100%;
    position: relative;
  }

  .featured-bg-canvas {
    position: relative;
    width: 100%;
    height: 300px;
    background: linear-gradient(135deg, #111827 0%, #1e293b 50%, #0f172a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-corner-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: #0062eb;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 5px 12px;
    z-index: 2;
  }

  .hero-graphic-icon {
    font-size: 5.5rem;
    opacity: 0.2;
  }

  .slogan {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    padding: 12px 20px;
    box-sizing: border-box;
    transition: background-color 0.2s ease;
  }

  .img-wrap:hover .slogan {
    background-color: rgba(0, 98, 235, 0.85);
  }

  .slogan-text {
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 🎨 經典 3D 幾何 Hover 浮動陰影層 (.bgs1 ~ .bgs5) */
  .img-wrap {
    position: relative;
    width: 100%;
    margin-bottom: 0.8rem;
  }

  .bgs {
    transition: transform 0.15s ease;
  }

  .bgs1 {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-top: 0.6rem solid rgba(0, 0, 0, 0);
    border-bottom: 0.6rem solid rgba(0, 0, 0, 0);
    border-right: 0.6rem solid #ff6488;
    transform-origin: left center;
    transform: translateY(-0.6rem) scale(0);
  }

  .bgs2 {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 0;
    height: 0;
    border-left: 0.6rem solid rgba(0, 0, 0, 0);
    border-right: 0.6rem solid rgba(0, 0, 0, 0);
    border-top: 0.6rem solid #ff6488;
    transform-origin: center bottom;
    transform: translateX(0.6rem) scale(0);
  }

  .bgs3 {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    background: #ff6488;
    transform-origin: 0px 100%;
    width: 0.6rem;
    transform: scaleX(0);
  }

  .bgs4 {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ff6488;
    transform-origin: 0px 100%;
    height: 0.6rem;
    transform: scaleY(0);
  }

  a.bgs5 {
    display: block;
    text-decoration: none;
  }

  .img-wrap:hover .bgs1 {
    transform: translateY(-0.6rem) scale(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs2 {
    transform: translateX(0.6rem) scale(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs3 {
    transform: scaleX(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs4 {
    transform: scaleY(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover a.bgs5 {
    transform: translate3d(0.6rem, -0.6rem, 0px);
    transition-delay: 70ms;
  }

  /* 隔項彩色跳色 (2n 黃色, 3n 藍色, 1n 粉色) */
  article:nth-child(2n) .img-wrap .bgs1 { border-right: 0.6rem solid #f7d002; }
  article:nth-child(2n) .img-wrap .bgs2 { border-top: 0.6rem solid #f7d002; }
  article:nth-child(2n) .img-wrap .bgs3,
  article:nth-child(2n) .img-wrap .bgs4 { background: #f7d002; }

  article:nth-child(3n) .img-wrap .bgs1 { border-right: 0.6rem solid #0062eb; }
  article:nth-child(3n) .img-wrap .bgs2 { border-top: 0.6rem solid #0062eb; }
  article:nth-child(3n) .img-wrap .bgs3,
  article:nth-child(3n) .img-wrap .bgs4 { background: #0062eb; }

  /* 🔍 2. 分類導航與搜尋列 */
  .make9-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.2rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid #e7e7e7;
  }

  .nav-pills-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .nav-pill {
    background-color: #f3f4f6;
    color: #4b5563;
    border: none;
    padding: 8px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 0;
    transition: all 0.2s ease;
  }

  .nav-pill:hover {
    background-color: #e5e7eb;
    color: #111827;
  }

  .nav-pill.is-active {
    background-color: #0062eb;
    color: #ffffff;
  }

  .pill-badge {
    font-size: 0.78rem;
    opacity: 0.85;
  }

  .make9-search-box {
    display: flex;
    align-items: center;
    flex: 0 0 320px;
  }

  .search-input-field {
    width: 100%;
    padding: 9px 12px;
    font-size: 0.88rem;
    border: 1px solid #d1d5db;
    border-right: none;
    outline: none;
    border-radius: 0;
    background: #ffffff;
  }

  .search-input-field:focus {
    border-color: #0062eb;
  }

  .search-btn-field {
    background-color: #0062eb;
    color: #ffffff;
    border: 1px solid #0062eb;
    padding: 9px 18px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    border-radius: 0;
    transition: background-color 0.2s ease;
  }

  .search-btn-field:hover {
    background-color: #0047bb;
  }

  /* 📰 3. 主內容與側邊欄排版 (content-area-top) */
  .content-area-top {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
  }

  .content-area-top .left {
    flex: 0 0 calc(70% - 1.5rem);
  }

  .content-area-top .right.sidebar-right {
    flex: 0 0 calc(30% - 1.5rem);
  }

  /* 分類區塊大標籤條 (post-area-head) */
  .post-area-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    border-bottom: 3px solid #eeeeee;
    transition: border-bottom 0.2s ease;
  }

  .post-area-head:hover {
    border-bottom: 3px solid #f7d002;
  }

  .post-area-title {
    background-color: #0062eb;
    color: #ffffff;
    display: inline-block;
    padding: 12px 24px;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin: 0;
  }

  .cat-read-all {
    display: block;
    color: #4b5563;
    background-color: #eeeeee;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 12px 20px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .post-area-head:hover .cat-read-all {
    background-color: #f7d002;
    color: #111111;
  }

  /* 3 欄式文章網格 (post-list col3) */
  .post-list.col3 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.2rem;
  }

  .make9-article-card {
    background: #ffffff;
    border-bottom: 1px solid #e7e7e7;
    padding-bottom: 2rem;
    display: flex;
    flex-direction: column;
  }

  .card-thumb-bg {
    width: 100%;
    height: 180px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #1f2937;
  }

  .card-thumb-bg[data-cat-theme="security"] { background: linear-gradient(135deg, #1e293b, #0f172a); }
  .card-thumb-bg[data-cat-theme="architecture"] { background: linear-gradient(135deg, #0369a1, #0c4a6e); }
  .card-thumb-bg[data-cat-theme="design"] { background: linear-gradient(135deg, #701a75, #4a044e); }
  .card-thumb-bg[data-cat-theme="tools"] { background: linear-gradient(135deg, #15803d, #14532d); }
  .card-thumb-bg[data-cat-theme="campus"] { background: linear-gradient(135deg, #b45309, #78350f); }

  .card-num-watermark {
    font-size: 3.5rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.18);
    letter-spacing: 2px;
  }

  .card-hover-mask {
    position: absolute;
    inset: 0;
    background: rgba(0, 98, 235, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .img-wrap:hover .card-hover-mask {
    opacity: 1;
  }

  .mask-read-text {
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 1px;
    border: 2px solid #ffffff;
    padding: 6px 16px;
  }

  /* 文章標籤與文字 */
  .post-categories {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0.4rem;
    display: flex;
  }

  .post-categories li {
    background-color: #0062eb;
    padding: 2px 10px;
    border-radius: 4px;
  }

  .cat-tag-link {
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .post-title {
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 8px 0 10px;
  }

  .post-title a {
    color: #222222;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: #0062eb;
  }

  .post-excerpt {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #666666;
    margin: 0 0 1.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .post-date {
    font-size: 0.82rem;
    color: #999999;
  }

