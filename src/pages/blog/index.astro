---
import quotes from '../../data/quotes';
import badges from '../../data/badges';

const today = new Date();
const seed = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
const dailyQuote = quotes[seed % quotes.length];



import BlogLayout from '../../layouts/BlogLayout.astro';
import posts from '../../data/posts';

const allPosts = posts;
const featuredPost = posts[0];

// 1. 技術文章 (首頁頂部雙欄列表：最新 4 篇)
const techPosts = posts.slice(0, 4);

// 2. 編輯精選 (3 篇經典深度代表作)
const editorPicks = [
  posts.find(p => p.slug === 'security-research-report') || posts[0],
  posts.find(p => p.slug === 'tech-notes-architecture') || posts[1],
  posts.find(p => p.slug === 'github-open-source-tools') || posts[2],
];

// 3. 主題閱讀 分類數據
const topicCategories = [
  {
    id: 'sec',
    name: '系統資安',
    posts: posts.filter(p => p.slug.includes('security') || p.slug.includes('audit')),
    listPosts: [
      { title: 'CVSS v4.0 漏洞滲透分級實務評估指南', slug: 'security-research-report' },
      { title: 'OWASP Top 10 與 CWE 身分證編號對照手冊', slug: 'security-research-report' },
      { title: '全端架構常見九大攻擊手法特徵防禦矩陣', slug: 'security-research-report' },
      { title: '結構化風險日誌標準規範與 AI Agent 反擊', slug: 'security-research-report' },
    ],
  },
  {
    id: 'arch',
    name: '網站架設',
    posts: posts.filter(p => p.slug.includes('architecture') || p.slug.includes('pwa') || p.slug.includes('windows')),
    listPosts: [
      { title: '現代企業級全端 Web 架構規範實踐', slug: 'tech-notes-architecture' },
      { title: 'Cloudflare Pages 與 Edge Functions 邊緣部署實務', slug: 'cf-pages-pwa-webpush' },
      { title: 'PWA WebPush 離線推播與 Service Worker 快取機制', slug: 'cf-pages-pwa-webpush' },
      { title: '全端架構效能調校與極簡開發工作流實踐', slug: 'tech-notes-architecture' },
    ],
  },
  {
    id: 'fe',
    name: '前端工程',
    posts: posts.filter(p => p.slug.includes('design') || p.slug.includes('front-end') || p.slug.includes('presentation')),
    listPosts: [
      { title: '從零打造高質感自媒體部落格排版美學', slug: 'github-open-source-tools' },
      { title: '響應式 RWD 佈局與貝茲曲線動畫實踐', slug: 'github-open-source-tools' },
      { title: '簡報邏輯與工程師介面視覺傳達技巧', slug: 'presentation-design-logic' },
      { title: 'TypeScript 與 Astro 現代靜態站點極速構建', slug: 'github-open-source-tools' },
    ],
  },
  {
    id: 'tools',
    name: '開源工具',
    posts: posts.filter(p => p.slug.includes('tool') || p.slug.includes('proxy') || p.slug.includes('github') || p.slug.includes('ig')),
    listPosts: [
      { title: '精選 GitHub 開發者神器與高效率工具箱', slug: 'github-open-source-tools' },
      { title: '代理伺服器 Proxy 與多環境工具箱解析', slug: 'github-open-source-tools' },
      { title: 'Instagram 訊息收回管理與 API 實作探討', slug: 'ig-unsend-tool' },
      { title: 'AI 歷屆考古題索引與智慧讀書計畫系統', slug: 'ai-planner-past-exam-info' },
    ],
  },
];

function getPostCategory(post: typeof posts[0]) {
  if (post.slug.includes('security') || post.slug.includes('audit')) return { name: '系統資安', slug: 'security' };
  if (post.slug.includes('architecture') || post.slug.includes('pwa')) return { name: '架構伺服器', slug: 'architecture' };
  if (post.slug.includes('design') || post.slug.includes('front-end')) return { name: '前端設計', slug: 'design' };
  if (post.slug.includes('tool') || post.slug.includes('proxy') || post.slug.includes('github')) return { name: '外掛工具', slug: 'tools' };
  return { name: '技術筆記', slug: 'tech' };
}


---
<BlogLayout title="OviNas — 網站架設、系統資安、筆記小分享與外掛推薦" description="專注於網站架設、系統資安、筆記小分享與開源工具推薦。">
  <div class="main-content">
    <div class="container">
      <!-- 🔷 1. 經典 Hero Header 區塊 (左側 30% 關於作者/站點 + 右側 70% 核心推廣 Banner) -->
      <section class="content-hero-header">
        <div class="left">
          <h3>OviNas</h3>
          <h2>網站架設、系統資安、筆記小分享</h2>
          <a href="/blog/about/" class="btn-about-hero">關於 OviNas</a>
        </div>
        <div class="right">
          <div class="slider-wrap-header">
            <div class="slider-one">
              <div class="img-wrap">
                <div class="bgs bgs1"></div>
                <div class="bgs bgs2"></div>
                <div class="bgs bgs3"></div>
                <div class="bgs bgs4"></div>
                <a class="bgs bgs5 hero-featured-link" href="/blog/posts/" title="點擊探索 OviNas 全站專欄文章">
                  <div class="featured-img-container">
                    <img src="/banners/hero-promo-v3.jpg" alt="OviNas 網站架設與系統資安實戰" class="featured-main-img" />
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

            <!-- 📰 2. 頂部主要文章區 (左側 70%「技術文章」雙欄網格 + 右側 30% 側邊欄) -->
      <div class="content-area-top">
        <div class="left">
          <!-- 「技術文章」標題條 (.post-area-head) -->
          <div class="post-area-head">
            <h2 class="post-area-title">技術文章</h2>
            <a href="/blog/posts/" class="cat-read-all">查看全部文章</a>
          </div>

          <!-- 2 欄式文章網格 (.post-list.col2) -->
          <div class="post-list col2">
            {techPosts.map((post) => {
              const cat = getPostCategory(post);
              return (
                <article class="post-card">
                  <!-- 🎨 經典 3D 浮動 Hover 縮圖 (.img-wrap + .bgs1 ~ .bgs5) -->
                  <div class="img-wrap">
                    <div class="bgs bgs1"></div>
                    <div class="bgs bgs2"></div>
                    <div class="bgs bgs3"></div>
                    <div class="bgs bgs4"></div>
                    <a class="bgs bgs5 card-thumb-link" href={`/blog/posts/${post.slug}/`}>
                      <div class="card-img-box">
                        <img src={`/banners/${post.slug}.jpg`} alt={post.title} class="card-img" loading="lazy" />
                      </div>
                    </a>
                  </div>

                  <!-- 分類標籤 -->
                  <ul class="post-categories">
                    <li><a href="/blog/posts/">{cat.name}</a></li>
                  </ul>

                  <!-- 文章標題 -->
                  <h3 class="post-title">
                    <a href={`/blog/posts/${post.slug}/`}>{post.title}</a>
                  </h3>

                  <!-- 摘要 -->
                  <p class="post-excerpt">{post.excerpt}</p>

                  <!-- 閱讀更多按鈕 -->
                  <a href={`/blog/posts/${post.slug}/`} class="read-more">閱讀更多</a>
                </article>
              );
            })}
          </div>

          <!-- 📅 站長行事曆 (Google Calendar - 完美平衡左右欄位高度) -->
          <div class="blog-calendar-section">
            <div class="post-area-head" style="margin-top: 2.2rem;">
              <h2 class="post-area-title">站長行事曆</h2>
              <span class="cal-sub-label">這裡可以看到站長的行程，以利方便預約時間</span>
            </div>
            <div class="blog-cal-frame">
              <iframe
                src="https://calendar.google.com/calendar/embed?src=bb049ab126a644ff77ce9a3dd0ad5c2aa0b1bd0272dd636a38dcfbabdd5aa7aa%40group.calendar.google.com&ctz=Asia%2FTaipei"
                title="OviNas 站長行事曆"
                loading="lazy"
                frameborder="0"
                scrolling="no"
              ></iframe>
            </div>
          </div>
        </div>

          <!-- 📌 右側經典側邊欄 (Sidebar: 30% 寬度) -->
        <aside class="right sidebar-right">
          <!-- 站長專欄 -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長專欄</span></h2>
            <p class="history">網站架設 · 系統資安 · 筆記小分享</p>
            <div class="author-bio">
              <p>
                從小對資訊抱有熱忱，從 Google 查詢時代轉向 AI 世代，面對學習與獲取資訊方式的改變，我始終一直持續 Update 我的資訊專業能力。時代轉變，像是 DOS 轉變成 Windows 一樣，很多東西懂需要重新學，這個資訊爆炸的世代，我不僅具備傳統電腦維修與程式設計能力，更擅長利用資訊解決企業的【痛點】。
              </p>
              <p>
                許多企業目前仍以人工方式處理專業技術工作，而我喜歡發揮想像力，將流程與資訊系統整合，讓原本緩慢的效率獲得大幅提升！
              </p>
            </div>
            <div class="side-btn-row">
              <a href="#" class="btn-side-vip">更多</a>
            </div>
          </div>

          <!-- 🏅 資格認證 (Badges - 純淨展示，無多餘超連結) -->
          <div class="side-popular-box side-badges-box" style="margin-top: 2rem;">
            <h2 class="side-badges-title">資格認證</h2>
            <ul class="side-badges-list">
              {badges.map((b) => (
                <li class="side-badge-item">
                  <div class="side-badge-link" title={b.name}>
                    <img src={b.img} alt={b.name} class="side-badge-img" loading="lazy" />
                    <span class="side-badge-name">{b.name}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>

        </aside>
      </div>

            <!-- ⭐ 3. 經典「編輯精選」區塊 (.index-recommend-area) -->
      <section class="index-recommend-area">
        <div class="recommend-head-row">
          <div class="author-photo">
            <img src="/sheep-hd.png" alt="OviNas" width="70" height="70" />
          </div>
          <h2 class="recommend-title">編輯精選</h2>
        </div>
        <p class="recommend-desc">這裡挑了幾篇我自己寫得最深入、細節也最完整的實戰筆記，推薦給你慢慢看！</p>

        <!-- 3 欄式精選文章卡片 -->
        <div class="recommend-posts-grid">
          {editorPicks.map((post) => {
            const cat = getPostCategory(post);
            return (
              <article class="recommend-col-card">
                <div class="onebox">
                  <ul class="post-categories">
                    <li><a href="/blog/posts/">{cat.name}</a></li>
                  </ul>
                  <div class="img-wrap">
                    <div class="bgs bgs1"></div>
                    <div class="bgs bgs2"></div>
                    <div class="bgs bgs3"></div>
                    <div class="bgs bgs4"></div>
                    <a class="bgs bgs5 recommend-thumb-link" href={`/blog/posts/${post.slug}/`}>
                      <div class="recommend-img-box">
                        <img src={`/banners/${post.slug}.jpg`} alt={post.title} class="recommend-img" loading="lazy" />
                      </div>
                    </a>
                  </div>
                  <h3 class="post-title">
                    <a href={`/blog/posts/${post.slug}/`}>{post.title}</a>
                  </h3>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- 📑 4. 主題閱讀區塊 (.content-area-cats-read) -->
      <div class="content-area-cats-read">
        <h2 class="post-area-title2">主題閱讀</h2>

        <!-- 主題分類切換 Tab (灰色背景 + 暖橙色 Active) -->
        <div class="cat-tabs-wrap">
          <ul class="cat-tabs" id="topicTabs">
            {topicCategories.map((cat, idx) => (
              <li class={`cat-tab-btn ${idx === 0 ? 'active' : ''}`} data-target={cat.id}>
                {cat.name}
              </li>
            ))}
          </ul>
        </div>

        <!-- 各主題展示 (.switch-content: 70% .pic-area + 30% .list-area) -->
        <div class="topic-contents-wrapper">
          {topicCategories.map((cat, idx) => (
            <div class={`switch-content ${idx === 0 ? 'active' : ''}`} id={`topic-${cat.id}`}>
              <!-- 左側圖片區域 (70% 寬度) -->
              <div class="pic-area">
                <!-- 左側主圖 (64% 寬度) -->
                {cat.posts[0] && (
                  <div class="pic-left">
                    <div class="img-wrap">
                      <div class="bgs bgs1"></div>
                      <div class="bgs bgs2"></div>
                      <div class="bgs bgs3"></div>
                      <div class="bgs bgs4"></div>
                      <a class="bgs bgs5" href={`/blog/posts/${cat.posts[0].slug}/`}>
                        <img src={`/banners/${cat.posts[0].slug}.jpg`} alt={cat.posts[0].title} class="topic-cover-img" />
                      </a>
                    </div>
                  </div>
                )}

                <!-- 右側雙副圖 (30% 寬度) -->
                <div class="pic-right">
                  {cat.posts.slice(1, 3).map((subPost) => (
                    <div class="img-wrap">
                      <div class="bgs bgs1"></div>
                      <div class="bgs bgs2"></div>
                      <div class="bgs bgs3"></div>
                      <div class="bgs bgs4"></div>
                      <a class="bgs bgs5" href={`/blog/posts/${subPost.slug}/`}>
                        <img src={`/banners/${subPost.slug}.jpg`} alt={subPost.title} class="topic-cover-img" />
                      </a>
                    </div>
                  ))}
                </div>
              </div>

              <!-- 右側文字清單區域 (30% 寬度) -->
              <div class="list-area">
                <ul>
                  {cat.listPosts.map((item) => (
                    <li>
                      <a href={`/blog/posts/${item.slug}/`}>{item.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
  .main-content {
    background-color: #ffffff;
    padding: 1.5rem 0 5rem;
  }

  /* 🔷 1. 經典 Hero Header 區塊 (30% 左灰盒 + 70% 右大圖) */
    /* 🐑 關於 OviNas 彈窗樣式 (.about-modal-backdrop) */
  .btn-about-hero {
    margin-top: 24px;
    color: #222222;
    background: transparent;
    display: inline-block;
    border: 2px solid #222222;
    padding: 0.4em 1.3em;
    font-size: 15.5px;
    font-weight: 500;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .btn-about-hero:hover {
    background-color: #151d22;
    border-color: #151d22;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .about-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
    animation: modalFadeIn 0.2s ease;
  }

  .about-modal-backdrop.is-open {
    display: flex;
  }

  .about-modal-box {
    width: 520px;
    max-width: 100%;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);
    padding: 2.5rem 2.2rem 2rem;
    position: relative;
    animation: modalSlideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalSlideUp {
    from { opacity: 0; transform: translateY(20px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .about-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: #f1f5f9;
    border: none;
    color: #64748b;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .about-modal-close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .about-modal-top {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .about-modal-avatar {
    width: 80px;
    height: 80px;
    margin: 0 auto 12px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(255, 107, 0, 0.25);
    border: 3px solid #ff6b00;
  }

  .about-modal-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-modal-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 4px;
  }

  .about-modal-name .eng-sub {
    font-size: 0.95rem;
    color: #ff6b00;
    font-weight: 500;
  }

  .about-modal-slogan {
    font-size: 0.9rem;
    color: #64748b;
    margin: 0;
  }

  .about-modal-body p {
    font-size: 0.94rem;
    color: #475569;
    line-height: 1.7;
    margin: 0 0 0.9rem;
    text-align: justify;
  }

  .about-skills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 1.2rem;
    justify-content: center;
  }

  .skill-pill {
    background: #fff7ed;
    color: #ea580c;
    border: 1px solid #ffedd5;
    font-size: 12px;
    padding: 3px 10px;
    border-radius: 12px;
    font-weight: 500;
  }

  .about-modal-footer {
    display: flex;
    gap: 12px;
    margin-top: 1.8rem;
    padding-top: 1.2rem;
    border-top: 1px solid #f1f5f9;
  }

  .btn-modal-gh {
    flex: 1;
    text-align: center;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 9px 0;
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-modal-gh:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .btn-modal-articles {
    flex: 1;
    text-align: center;
    background: #ff6b00;
    color: #ffffff;
    border: none;
    padding: 9px 0;
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .btn-modal-articles:hover {
    background: #ea580c;
  }

  .content-hero-header {
    display: flex;
    margin: 0 auto 2.5rem;
    height: 340px;
  }

  .content-hero-header .left {
    width: 30%;
    background-color: #eeeeee;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    box-sizing: border-box;
  }

  .content-hero-header .left h3 {
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 12px;
    color: #222222;
  }

  .content-hero-header .left h2 {
    font-size: 15px;
    font-weight: 400;
    color: #666666;
    margin: 0;
    line-height: 1.5;
  }

  .content-hero-header .left a {
    margin-top: 24px;
    color: #222222;
    display: inline-block;
    border: 2px solid #222222;
    padding: 0.35em 1.2em;
    font-size: 16px;
    font-weight: 500;
    border-radius: 3px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .content-hero-header .left a:hover {
    background-color: #151d22;
    border-color: #151d22;
    color: #ffffff;
  }

  .content-hero-header .right {
    width: 70%;
    height: 100%;
  }

  .slider-wrap-header {
    width: 100%;
    height: 100%;
  }

  .slider-one {
    width: 100%;
    height: 100%;
  }

  .hero-featured-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .featured-img-container {
    position: relative;
    width: 100%;
    height: 340px;
    background-color: #111111;
    overflow: hidden;
  }

  .featured-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .img-wrap:hover .featured-main-img {
    transform: scale(1.03);
  }

  .slogan {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    text-align: center;
    pointer-events: none;
  }

  .slogan-text {
    display: inline-block;
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0.65);
    color: #ffffff;
    letter-spacing: 2px;
    padding: 10px 24px;
    font-weight: 500;
    line-height: 1.4;
    max-width: 90%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 🎨 3D 幾何 Hover 浮動陰影層 (.bgs1 ~ .bgs5) */
  .img-wrap {
    position: relative;
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .bgs {
    transition: transform 0.15s ease;
  }

  .bgs1 {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-top: 0.6rem solid rgba(0, 0, 0, 0);
    border-bottom: 0.6rem solid rgba(0, 0, 0, 0);
    border-right: 0.6rem solid #ff6b00;
    transform-origin: left center;
    transform: translateY(-0.6rem) scale(0);
  }

  .bgs2 {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 0;
    height: 0;
    border-left: 0.6rem solid rgba(0, 0, 0, 0);
    border-right: 0.6rem solid rgba(0, 0, 0, 0);
    border-top: 0.6rem solid #ff6b00;
    transform-origin: center bottom;
    transform: translateX(0.6rem) scale(0);
  }

  .bgs3 {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    background: #ff6b00;
    transform-origin: 0px 100%;
    width: 0.6rem;
    transform: scaleX(0);
  }

  .bgs4 {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ff6b00;
    transform-origin: 0px 100%;
    height: 0.6rem;
    transform: scaleY(0);
  }

  a.bgs5 {
    display: block;
    text-decoration: none;
  }

  .img-wrap:hover .bgs1 {
    transform: translateY(-0.6rem) scale(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs2 {
    transform: translateX(0.6rem) scale(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs3 {
    transform: scaleX(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs4 {
    transform: scaleY(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover a.bgs5 {
    transform: translate3d(0.6rem, -0.6rem, 0px);
    transition-delay: 70ms;
  }

  article:nth-child(2n) .img-wrap .bgs1 { border-right: 0.6rem solid #f59e0b; }
  article:nth-child(2n) .img-wrap .bgs2 { border-top: 0.6rem solid #f59e0b; }
  article:nth-child(2n) .img-wrap .bgs3,
  article:nth-child(2n) .img-wrap .bgs4 { background: #f59e0b; }

  article:nth-child(3n) .img-wrap .bgs1 { border-right: 0.6rem solid #ff6b00; }
  article:nth-child(3n) .img-wrap .bgs2 { border-top: 0.6rem solid #ff6b00; }
  article:nth-child(3n) .img-wrap .bgs3,
  article:nth-child(3n) .img-wrap .bgs4 { background: #ff6b00; }

