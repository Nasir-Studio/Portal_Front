---
import BlogLayout from '../../layouts/BlogLayout.astro';
import posts from '../../data/posts';

const allPosts = posts;
const featuredPost = posts[0];

// 1. 技術文章 (首頁頂部雙欄列表：最新 4 篇)
const techPosts = posts.slice(0, 4);

// 2. 編輯精選 (3 篇經典深度代表作)
const editorPicks = [
  posts.find(p => p.slug === 'security-research-report') || posts[0],
  posts.find(p => p.slug === 'tech-notes-architecture') || posts[1],
  posts.find(p => p.slug === 'front-end-design') || posts[2],
];

// 3. 主題閱讀 分類數據
const topicCategories = [
  {
    id: 'sec',
    name: '系統資安',
    posts: posts.filter(p => p.slug.includes('security') || p.slug.includes('audit')),
  },
  {
    id: 'arch',
    name: '巨型架構',
    posts: posts.filter(p => p.slug.includes('architecture') || p.slug.includes('pwa') || p.slug.includes('windows')),
  },
  {
    id: 'fe',
    name: '前端工程',
    posts: posts.filter(p => p.slug.includes('design') || p.slug.includes('front-end') || p.slug.includes('presentation')),
  },
  {
    id: 'tools',
    name: '開源工具',
    posts: posts.filter(p => p.slug.includes('tool') || p.slug.includes('proxy') || p.slug.includes('github') || p.slug.includes('ig')),
  },
  {
    id: 'campus',
    name: '專案實戰',
    posts: posts.filter(p => p.slug.includes('ntub') || p.slug.includes('exam')),
  },
];

function getPostCategory(post: typeof posts[0]) {
  if (post.slug.includes('security') || post.slug.includes('audit')) return { name: '系統資安', slug: 'security' };
  if (post.slug.includes('architecture') || post.slug.includes('pwa')) return { name: '架構伺服器', slug: 'architecture' };
  if (post.slug.includes('design') || post.slug.includes('front-end')) return { name: '前端設計', slug: 'design' };
  if (post.slug.includes('tool') || post.slug.includes('proxy') || post.slug.includes('github')) return { name: '外掛工具', slug: 'tools' };
  return { name: '技術筆記', slug: 'tech' };
}
---

<BlogLayout title="OviNas 羊之誌 — 網站架設、系統資安、前端工程與外掛推薦" description="專注於網站架設、系統資安、前端工程與開源工具推薦。">
  <div class="main-content">
    <div class="container">
      <!-- 🔷 1. 經典 Hero Header 區塊 (左側 30% 灰色資訊方塊 + 右側 70% 16:9 焦點大圖) -->
      <section class="content-hero-header">
        <div class="left">
          <h3>OviNas 羊之誌</h3>
          <h2>網站架設、系統資安、前端工程</h2>
          <a href="/posts/">查看全部文章</a>
        </div>
        <div class="right">
          <div class="slider-wrap-header">
            <div class="slider-one">
              <div class="img-wrap">
                <div class="bgs bgs1"></div>
                <div class="bgs bgs2"></div>
                <div class="bgs bgs3"></div>
                <div class="bgs bgs4"></div>
                <a class="bgs bgs5 hero-featured-link" href={`/posts/${featuredPost.slug}/`}>
                  <div class="featured-img-container">
                    <img src={`/banners/${featuredPost.slug}.jpg`} alt={featuredPost.title} class="featured-main-img" />
                    <div class="slogan">
                      <span class="slogan-text">{featuredPost.title}</span>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 📰 2. 頂部主要文章區 (左側 70%「技術文章」雙欄網格 + 右側 30% 側邊欄) -->
      <div class="content-area-top">
        <div class="left">
          <!-- 「技術文章」標題條 (.post-area-head) -->
          <div class="post-area-head">
            <h2 class="post-area-title">技術文章</h2>
            <a href="/posts/" class="cat-read-all">查看全部文章</a>
          </div>

          <!-- 2 欄式文章網格 (.post-list.col2) -->
          <div class="post-list col2">
            {techPosts.map((post) => {
              const cat = getPostCategory(post);
              return (
                <article class="post-card">
                  <!-- 🎨 經典 3D 浮動 Hover 縮圖 (.img-wrap + .bgs1 ~ .bgs5) -->
                  <div class="img-wrap">
                    <div class="bgs bgs1"></div>
                    <div class="bgs bgs2"></div>
                    <div class="bgs bgs3"></div>
                    <div class="bgs bgs4"></div>
                    <a class="bgs bgs5 card-thumb-link" href={`/posts/${post.slug}/`}>
                      <div class="card-img-box">
                        <img src={`/banners/${post.slug}.jpg`} alt={post.title} class="card-img" loading="lazy" />
                      </div>
                    </a>
                  </div>

                  <!-- 分類標籤 -->
                  <ul class="post-categories">
                    <li><a href="/posts/">{cat.name}</a></li>
                  </ul>

                  <!-- 文章標題 -->
                  <h3 class="post-title">
                    <a href={`/posts/${post.slug}/`}>{post.title}</a>
                  </h3>

                  <!-- 摘要 -->
                  <p class="post-excerpt">{post.excerpt}</p>

                  <!-- 閱讀更多按鈕 -->
                  <a href={`/posts/${post.slug}/`} class="read-more">閱讀更多</a>
                </article>
              );
            })}
          </div>
        </div>

        <!-- 📌 右側經典側邊欄 (Sidebar: 30% 寬度) -->
        <aside class="right sidebar-right">
          <!-- 站長專欄 -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長專欄</span></h2>
            <p class="history">全端開發 · 巨型架構 · 系統資安</p>
            <p class="author-bio">
              專注於現代 Web 架構設計、高效能前端、系統資安滲透稽核與邊緣雲端技術。追求純粹細膩的排版美學。
            </p>
            <div class="side-btn-row">
              <a href="/vip/" class="btn-side-vip">加入 VIP 專區</a>
            </div>
          </div>

          <!-- 熱門推薦文章 (#popular-side: 75px 1:1 正方形真實文青照片微縮圖) -->
          <div class="popular-posts" id="popular-side">
            <h3 class="side-section-heading">熱門推薦文章</h3>
            <ul class="wpp-list">
              {allPosts.slice(0, 5).map((p, idx) => (
                <li class="wpp-item">
                  <a href={`/posts/${p.slug}/`} class="wpp-thumb-link">
                    <div class="wpp-thumbnail-box">
                      <img src={`/banners/${p.slug}.jpg`} alt={p.title} class="wpp-thumb-img" />
                    </div>
                  </a>
                  <div class="wpp-details">
                    <a href={`/posts/${p.slug}/`} class="wpp-post-title">
                      {p.title}
                    </a>
                    <span class="wpp-meta">{p.date}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>

      <!-- ⭐ 3. 經典「編輯精選」區塊 (.index-recommend-area) -->
      <section class="index-recommend-area">
        <div class="recommend-head-row">
          <div class="author-photo">
            <img src="/sheep-hd.png" alt="OviNas" width="70" height="70" />
          </div>
          <h2 class="recommend-title">編輯精選</h2>
        </div>
        <p class="recommend-desc">這些文章在深度與架構解析上，都有優異的表現！是好酒沈甕底的經典之作。</p>

        <!-- 3 欄式精選文章卡片 -->
        <div class="recommend-posts-grid">
          {editorPicks.map((post) => {
            const cat = getPostCategory(post);
            return (
              <article class="recommend-col-card">
                <div class="onebox">
                  <ul class="post-categories">
                    <li><a href="/posts/">{cat.name}</a></li>
                  </ul>
                  <div class="img-wrap">
                    <div class="bgs bgs1"></div>
                    <div class="bgs bgs2"></div>
                    <div class="bgs bgs3"></div>
                    <div class="bgs bgs4"></div>
                    <a class="bgs bgs5 recommend-thumb-link" href={`/posts/${post.slug}/`}>
                      <div class="recommend-img-box">
                        <img src={`/banners/${post.slug}.jpg`} alt={post.title} class="recommend-img" loading="lazy" />
                      </div>
                    </a>
                  </div>
                  <h3 class="post-title">
                    <a href={`/posts/${post.slug}/`}>{post.title}</a>
                  </h3>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- 📑 4. 經典「主題閱讀」區塊 (.content-area-cats-read) -->
      <section class="content-area-cats-read">
        <h2 class="post-area-title2">主題閱讀</h2>

        <!-- 主題分類切換 Tab -->
        <div class="cat-tabs-wrap">
          <ul class="cat-tabs" id="topicTabs">
            {topicCategories.map((cat, idx) => (
              <li class={`cat-tab-btn ${idx === 0 ? 'active' : ''}`} data-target={cat.id}>
                {cat.name}
              </li>
            ))}
          </ul>
        </div>

        <!-- 各主題圖文內容展示 (.switch-content) -->
        <div class="topic-contents-wrapper">
          {topicCategories.map((cat, idx) => (
            <div class={`switch-content ${idx === 0 ? 'active' : ''}`} id={`topic-${cat.id}`}>
              <div class="pic-area">
                <!-- 左側主大圖 (64% 寬度) -->
                {cat.posts[0] && (
                  <div class="pic-left">
                    <div class="img-wrap">
                      <div class="bgs bgs1"></div>
                      <div class="bgs bgs2"></div>
                      <div class="bgs bgs3"></div>
                      <div class="bgs bgs4"></div>
                      <a class="bgs bgs5" href={`/posts/${cat.posts[0].slug}/`}>
                        <div class="pic-main-img-box">
                          <img src={`/banners/${cat.posts[0].slug}.jpg`} alt={cat.posts[0].title} class="topic-main-photo" />
                          <div class="topic-img-title-overlay">
                            <span>{cat.posts[0].title}</span>
                          </div>
                        </div>
                      </a>
                    </div>
                  </div>
                )}

                <!-- 右側雙副圖 (33% 寬度) -->
                <div class="pic-right">
                  {cat.posts.slice(1, 3).map((subPost) => (
                    <div class="img-wrap sub-topic-wrap">
                      <div class="bgs bgs1"></div>
                      <div class="bgs bgs2"></div>
                      <div class="bgs bgs3"></div>
                      <div class="bgs bgs4"></div>
                      <a class="bgs bgs5" href={`/posts/${subPost.slug}/`}>
                        <div class="pic-sub-img-box">
                          <img src={`/banners/${subPost.slug}.jpg`} alt={subPost.title} class="topic-sub-photo" />
                          <div class="topic-sub-title-overlay">
                            <span>{subPost.title}</span>
                          </div>
                        </div>
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BlogLayout>

<style>
  .main-content {
    background-color: #ffffff;
    padding: 1.5rem 0 5rem;
  }

  /* 🔷 1. 經典 Hero Header 區塊 (30% 左灰盒 + 70% 右大圖) */
  .content-hero-header {
    display: flex;
    margin: 0 auto 2.5rem;
    height: 340px;
  }

  .content-hero-header .left {
    width: 30%;
    background-color: #eeeeee;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    box-sizing: border-box;
  }

  .content-hero-header .left h3 {
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 12px;
    color: #222222;
  }

  .content-hero-header .left h2 {
    font-size: 15px;
    font-weight: 400;
    color: #666666;
    margin: 0;
    line-height: 1.5;
  }

  .content-hero-header .left a {
    margin-top: 24px;
    color: #222222;
    display: inline-block;
    border: 2px solid #222222;
    padding: 0.35em 1.2em;
    font-size: 16px;
    font-weight: 500;
    border-radius: 3px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .content-hero-header .left a:hover {
    background-color: #151d22;
    border-color: #151d22;
    color: #ffffff;
  }

  .content-hero-header .right {
    width: 70%;
    height: 100%;
  }

  .slider-wrap-header {
    width: 100%;
    height: 100%;
  }

  .slider-one {
    width: 100%;
    height: 100%;
  }

  .hero-featured-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .featured-img-container {
    position: relative;
    width: 100%;
    height: 340px;
    background-color: #111111;
    overflow: hidden;
  }

  .featured-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .img-wrap:hover .featured-main-img {
    transform: scale(1.03);
  }

  .slogan {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    text-align: center;
    pointer-events: none;
  }

  .slogan-text {
    display: inline-block;
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0.65);
    color: #ffffff;
    letter-spacing: 2px;
    padding: 10px 24px;
    font-weight: 500;
    line-height: 1.4;
    max-width: 90%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 🎨 3D 幾何 Hover 浮動陰影層 (.bgs1 ~ .bgs5) */
  .img-wrap {
    position: relative;
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .bgs {
    transition: transform 0.15s ease;
  }

  .bgs1 {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-top: 0.6rem solid rgba(0, 0, 0, 0);
    border-bottom: 0.6rem solid rgba(0, 0, 0, 0);
    border-right: 0.6rem solid #ff6b00;
    transform-origin: left center;
    transform: translateY(-0.6rem) scale(0);
  }

  .bgs2 {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 0;
    height: 0;
    border-left: 0.6rem solid rgba(0, 0, 0, 0);
    border-right: 0.6rem solid rgba(0, 0, 0, 0);
    border-top: 0.6rem solid #ff6b00;
    transform-origin: center bottom;
    transform: translateX(0.6rem) scale(0);
  }

  .bgs3 {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    background: #ff6b00;
    transform-origin: 0px 100%;
    width: 0.6rem;
    transform: scaleX(0);
  }

  .bgs4 {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ff6b00;
    transform-origin: 0px 100%;
    height: 0.6rem;
    transform: scaleY(0);
  }

  a.bgs5 {
    display: block;
    text-decoration: none;
  }

  .img-wrap:hover .bgs1 {
    transform: translateY(-0.6rem) scale(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs2 {
    transform: translateX(0.6rem) scale(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs3 {
    transform: scaleX(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover .bgs4 {
    transform: scaleY(1);
    transition-delay: 70ms;
  }

  .img-wrap:hover a.bgs5 {
    transform: translate3d(0.6rem, -0.6rem, 0px);
    transition-delay: 70ms;
  }

  article:nth-child(2n) .img-wrap .bgs1 { border-right: 0.6rem solid #f59e0b; }
  article:nth-child(2n) .img-wrap .bgs2 { border-top: 0.6rem solid #f59e0b; }
  article:nth-child(2n) .img-wrap .bgs3,
  article:nth-child(2n) .img-wrap .bgs4 { background: #f59e0b; }

  article:nth-child(3n) .img-wrap .bgs1 { border-right: 0.6rem solid #ff6b00; }
  article:nth-child(3n) .img-wrap .bgs2 { border-top: 0.6rem solid #ff6b00; }
  article:nth-child(3n) .img-wrap .bgs3,
  article:nth-child(3n) .img-wrap .bgs4 { background: #ff6b00; }

  /* 📰 2. 主內容區 (.content-area-top) */
  .content-area-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4rem;
  }

  .content-area-top .left {
    width: 68%;
    padding-right: 3%;
  }

  .content-area-top .right.sidebar-right {
    width: 28%;
  }

  /* 標題條 (.post-area-head) */
  .post-area-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    border-bottom: 3px solid #eeeeee;
    transition: border-bottom 0.2s ease;
  }

  .post-area-head:hover {
    border-bottom: 3px solid #f59e0b;
  }

  .post-area-title {
    background-color: #ff6b00;
    color: #ffffff;
    display: inline-block;
    padding: 10px 22px;
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }

  .cat-read-all {
    display: block;
    color: #333333;
    background-color: #eeeeee;
    font-size: 15px;
    font-weight: 400;
    padding: 10px 20px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cat-read-all:hover {
    background-color: #f59e0b;
    color: #111111;
  }

  /* 2 欄式文章網格 (.post-list.col2) */
  .post-list.col2 {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .post-card {
    width: 48%;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .card-img-box {
    width: 100%;
    height: 190px;
    overflow: hidden;
    background: #f0f0f0;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .img-wrap:hover .card-img {
    transform: scale(1.04);
  }

  .post-categories {
    list-style: none;
    padding: 8px 0 4px;
    margin: 0;
    color: #999999;
    font-size: 13px;
  }

  .post-categories li {
    display: inline-block;
  }

  .post-categories li a {
    color: #ff6b00;
    text-decoration: none;
    font-weight: 400;
  }

  .post-title {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
    margin: 4px 0 8px;
  }

  .post-title a {
    color: #333333;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: #ff6b00;
  }

  .post-excerpt {
    font-size: 14px;
    line-height: 1.6;
    color: #666666;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 400;
  }

  .read-more {
    display: inline-block;
    align-self: flex-start;
    background-color: #ff6b00;
    color: #ffffff !important;
    padding: 6px 28px;
    font-size: 13px;
    font-weight: 400;
    text-decoration: none;
    margin-top: auto;
    transition: all 0.2s ease;
  }

  .read-more:hover {
    background-color: #3bce89;
  }

  /* ⭐ 3. 經典「編輯精選」區塊樣式 (.index-recommend-area) */
  .index-recommend-area {
    margin-bottom: 4.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid #eeeeee;
    border-bottom: 1px solid #eeeeee;
  }

  .recommend-head-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .recommend-head-row .author-photo {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #ff6b00;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .recommend-head-row .author-photo img {
    width: 55px;
    height: 55px;
    object-fit: contain;
  }

  .recommend-title {
    font-size: 26px;
    font-weight: 700;
    color: #222222;
    margin: 0;
  }

  .recommend-desc {
    color: #666666;
    font-size: 15px;
    margin: 0 0 2rem;
    font-weight: 400;
  }

  .recommend-posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .recommend-col-card .onebox {
    width: 100%;
  }

  .recommend-col-card ul.post-categories {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
  }

  .recommend-col-card ul.post-categories li {
    background-color: #ff6b00;
    padding: 2px 10px;
    border-radius: 3px;
  }

  .recommend-col-card ul.post-categories li a {
    color: #ffffff;
    font-size: 12px;
    text-decoration: none;
  }

  .recommend-img-box {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: #f0f0f0;
