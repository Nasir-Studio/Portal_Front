<script>
  // 🔍 即時搜尋與分類標籤篩選腳本
  const searchInput = document.getElementById('blogSearchInput') as HTMLInputElement;
  const categoryTabs = document.querySelectorAll('.cat-tab');
  const postCards = document.querySelectorAll('.post-card');
  const noResults = document.getElementById('noResults');
  const countBadge = document.getElementById('postCountBadge');

  let activeCategory = 'all';
  let searchQuery = '';

  function filterPosts() {
    let visibleCount = 0;

    postCards.forEach((card) => {
      const el = card as HTMLElement;
      const cardCategory = el.dataset.category || '';
      const cardTitle = el.dataset.title || '';
      const cardExcerpt = el.dataset.excerpt || '';

      const matchesCat = activeCategory === 'all' || cardCategory === activeCategory;
      const matchesSearch = searchQuery === '' ||
        cardTitle.includes(searchQuery) ||
        cardExcerpt.includes(searchQuery);

      if (matchesCat && matchesSearch) {
        el.style.display = 'flex';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (countBadge) {
      countBadge.textContent = `共 ${visibleCount} 篇精選文章`;
    }

    if (noResults) {
      noResults.hidden = visibleCount > 0;
    }
  }

  // 分類切換
  categoryTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      categoryTabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      activeCategory = tab.getAttribute('data-category') || 'all';
      filterPosts();
    });
  });

  // 即時搜尋
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterPosts();
    });
  }

  // 點擊標籤雲快速過濾
  document.querySelectorAll('.tag-pill').forEach((pill) => {
    pill.addEventListener('click', (e) => {
      e.preventDefault();
      const tag = pill.getAttribute('data-tag') || '';
      if (searchInput) {
        searchInput.value = tag;
        searchQuery = tag.toLowerCase();
        filterPosts();
        searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });
</script>
