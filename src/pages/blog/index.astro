<script>
  // ⚡ 即時分類切換、搜尋與計數功能 (Real-time Filtering & Counting)
  const searchInput = document.getElementById('make9Search') as HTMLInputElement;
  const filterTabs = document.querySelectorAll('.nav-pill');
  const postCards = document.querySelectorAll('.make9-article-card');
  const emptyNotice = document.getElementById('emptyNotice');
  const countDisplay = document.getElementById('currentCountDisplay');
  const sectionTitle = document.getElementById('currentSectionTitle');

  let currentCategory = 'all';
  let currentSearchQuery = '';

  const categoryNames: Record<string, string> = {
    all: '精選文章',
    security: '系統資安文章',
    architecture: '架構伺服器文章',
    design: '前端設計文章',
    tools: '外掛工具文章',
    campus: '專案實戰文章',
  };

  function updatePosts() {
    let visibleCount = 0;

    postCards.forEach((card) => {
      const el = card as HTMLElement;
      const cardCategory = el.getAttribute('data-cat') || '';
      const cardTitle = el.getAttribute('data-title') || '';
      const cardExcerpt = el.getAttribute('data-excerpt') || '';

      const matchCategory = currentCategory === 'all' || cardCategory === currentCategory;
      const matchSearch = currentSearchQuery === '' ||
        cardTitle.includes(currentSearchQuery) ||
        cardExcerpt.includes(currentSearchQuery);

      if (matchCategory && matchSearch) {
        el.style.display = 'flex';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (countDisplay) {
      countDisplay.textContent = `共 ${visibleCount} 篇文章`;
    }

    if (sectionTitle) {
      sectionTitle.textContent = currentSearchQuery
        ? `搜尋結果: 「${currentSearchQuery}」`
        : (categoryNames[currentCategory] || '精選文章');
    }

    if (emptyNotice) {
      emptyNotice.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  // 1. 分類按鈕點擊
  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      currentCategory = tab.getAttribute('data-cat') || 'all';
      updatePosts();
    });
  });

  // 2. 搜尋框輸入
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      updatePosts();
    });
  }

  // 3. 標籤點擊
  document.querySelectorAll('.tag-link-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      const kw = btn.getAttribute('data-kw') || '';
      if (searchInput) {
        searchInput.value = kw;
        currentSearchQuery = kw.toLowerCase();
        updatePosts();
        document.getElementById('categoryNav')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // 4. 卡片分類標籤點擊
  document.querySelectorAll('.cat-tag-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = link.getAttribute('data-target-cat') || 'all';
      filterTabs.forEach((tab) => {
        if (tab.getAttribute('data-cat') === target) {
          (tab as HTMLElement).click();
          document.getElementById('categoryNav')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  });
</script>
