---
import BlogLayout from '../../layouts/BlogLayout.astro';
import badges from '../../data/badges';
---

<BlogLayout
  title="關於 OviNas — 網站架設、系統資安、筆記小分享"
  description="從小對資訊抱有熱忱，專注於現代 Web 架構設計、系統資安滲透稽核、企業痛點流程自動化與實用開源工具分享。"
>
  <div class="main-content">
    <div class="container about-page-layout">
      <!-- 麵包屑導航 -->
      <nav class="breadcrumbs" aria-label="麵包屑導航">
        <a href="/blog/">首頁</a>
        <span class="sep">/</span>
        <span class="current">關於 OviNas</span>
      </nav>

      <!-- 關於頁面主卡片 -->
      <article class="about-card-wrap">
        <!-- 頂部頭像與基本資訊 -->
        <div class="about-header-section">
          <div class="about-avatar-box">
            <img src="/sheep-hd.png" alt="OviNas" width="110" height="110" class="about-avatar-img" />
          </div>
          <h1 class="about-main-title">OviNas <span class="about-sub-title">/ 站長專欄</span></h1>
          <p class="about-slogan">網站架設 · 系統資安 · 筆記小分享</p>
        </div>

        <!-- 自我介紹故事內文 -->
        <div class="about-content-body">
          <h2 class="about-section-h2">站長簡介</h2>
          <div class="about-text-paragraphs">
            <p>
              從小對資訊抱有熱忱，從 Google 查詢時代轉向 AI 世代，面對學習與獲取資訊方式的改變，我始終一直持續 Update 我的資訊專業能力。時代轉變，像是 DOS 轉變成 Windows 一樣，很多東西懂需要重新學，這個資訊爆炸的世代，我不僅具備傳統電腦維修與程式設計能力，更擅長利用資訊解決企業的【痛點】。
            </p>
            <p>
              許多企業目前仍以人工方式處理專業技術工作，而我喜歡發揮想像力，將流程與資訊系統整合，讓原本緩慢的效率獲得大幅提升！
            </p>
          </div>

          

                    <!-- 🏅 專業資格認證區塊 (Badges & Certifications - 經典立體徽章網格) -->
          <h2 class="about-section-h2">專業資格認證</h2>
          <div class="about-badges-container">
            <ul class="about-badge-grid">
              {badges.map((b) => (
                <li class="about-badge-item">
                  <a href={b.url} target="_blank" rel="noopener noreferrer" class="about-badge-link" title={`${b.name} (點擊驗證 Credly 證書)`}>
                    <div class="about-badge-img-box">
                      <img src={b.img} alt={b.name} class="about-badge-img" loading="lazy" />
                    </div>
                    <p class="about-badge-name">{b.name}</p>
                  </a>
                </li>
              ))}
            </ul>
            <div class="about-badge-more-wrap">
              <a href="https://nasirlin.net" target="_blank" rel="noopener noreferrer" class="about-badge-more-btn">
                查看更多資格認證 ↗
              </a>
            </div>
          </div>

          <!-- 社群關注與文章探索 -->
          <div class="about-actions-row">
            <a href="https://github.com/nasircy" target="_blank" rel="noopener" class="btn-about-gh">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              關注 GitHub @nasircy
            </a>
            <a href="/blog/posts/" class="btn-about-posts">探索所有專欄文章 »</a>
          </div>

          <!-- 內建聯絡表單 (Google Form) -->
          <div class="about-contact-box">
            <h3 class="contact-box-title">有任何技術問題或合作想法？直接聯絡我</h3>
            <p class="contact-box-desc">歡迎填寫下方表單與我交流，我會盡快回覆您！</p>
            <form class="about-contact-form" id="aboutPageContactForm">
              <div class="form-row-2">
                <div class="form-field">
                  <label for="apName">姓名 / 稱呼 *</label>
                  <input type="text" id="apName" name="entry.57084769" placeholder="您的姓名或暱稱" required class="form-input" />
                </div>
                <div class="form-field">
                  <label for="apEmail">電子郵件 *</label>
                  <input type="email" id="apEmail" name="entry.135399445" placeholder="example@email.com" required class="form-input" />
                </div>
              </div>
              <div class="form-field">
                <label for="apMsg">訊息內容 *</label>
                <textarea id="apMsg" name="entry.1753446536" placeholder="請輸入您想討論的架構、資安或交流事項…" rows="3" required class="form-input form-textarea"></textarea>
              </div>
              <div class="form-submit-row">
                <button type="submit" id="apSubmitBtn" class="btn-about-submit">送出訊息</button>
                <span id="apStatus" class="about-form-status"></span>
              </div>
            </form>
          </div>
        </div>
      </article>
    </div>
  </div>
</BlogLayout>

<style>
  .about-page-layout {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.2rem 1.2rem 4.5rem;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 13.5px;
    color: #888888;
    margin-bottom: 2rem;
  }

  .breadcrumbs a {
    color: #555555;
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: #ff6b00;
  }

  .about-card-wrap {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 3rem 2.8rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .about-header-section {
    text-align: center;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 2.2rem;
    margin-bottom: 2.5rem;
  }

  .about-avatar-box {
    width: 96px;
    height: 96px;
    margin: 0 auto 1.2rem;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(255, 107, 0, 0.2);
    border: 3px solid #ff6b00;
  }

  .about-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-main-title {
    font-size: 2rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 6px;
  }

  .about-sub-title {
    font-size: 1.1rem;
    font-weight: 500;
    color: #ff6b00;
  }

  .about-slogan {
    font-size: 15px;
    color: #64748b;
    margin: 0;
    font-weight: 400;
  }

  .about-section-h2 {
    font-size: 1.3rem;
    font-weight: 600;
    color: #1e293b;
    margin: 2.2rem 0 1.2rem;
    padding-left: 12px;
    border-left: 4px solid #ff6b00;
  }

  .about-text-paragraphs p {
    font-size: 15.5px;
    color: #475569;
    line-height: 1.8;
    margin: 0 0 1.2rem;
  }

  

    /* 🏅 關於頁面資格認證樣式 (經典多徽章展示網格) */
  .about-badges-container {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 2rem 1.5rem 1.5rem;
    margin: 1.5rem 0 2.5rem;
  }

  .about-badge-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem 1.2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about-badge-item {
    text-align: center;
  }

  .about-badge-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    height: 100%;
    transition: all 0.2s ease;
  }

  .about-badge-img-box {
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .about-badge-img {
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), filter 0.25s ease;
  }

  .about-badge-link:hover .about-badge-img {
    transform: translateY(-4px) scale(1.08);
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.2));
  }

  .about-badge-name {
    font-size: 12.5px;
    font-weight: 500;
    color: #334155;
    line-height: 1.45;
    margin: 0;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }

  .about-badge-link:hover .about-badge-name {
    color: #ff6b00;
  }

  .about-badge-more-wrap {
    margin-top: 1.8rem;
    padding-top: 1.2rem;
    border-top: 1px solid #e2e8f0;
    text-align: center;
  }

    .about-badge-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
    padding: 6px 12px;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .about-badge-more-btn:hover {
    color: #ff6b00;
    background: transparent;
    text-decoration: underline;
  }

  .about-actions-row {
    display: flex;
    gap: 14px;
    margin: 2.5rem 0;
  }

  .btn-about-gh {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #0f172a;
    color: #ffffff;
    text-decoration: none;
    padding: 12px 0;
    border-radius: 6px;
    font-size: 14.5px;
    font-weight: 500;
    transition: background 0.2s;
  }

  .btn-about-gh:hover {
    background: #1e293b;
  }

  .btn-about-posts {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ff6b00;
    color: #ffffff;
    text-decoration: none;
    padding: 12px 0;
    border-radius: 6px;
    font-size: 14.5px;
    font-weight: 500;
    transition: background 0.2s;
  }

  .btn-about-posts:hover {
    background: #ea580c;
  }

  /* 聯絡表單區塊 */
  .about-contact-box {
    background: #fafbfc;
    border: 1px solid #e5e7eb;
    border-top: 4px solid #10b981;
    border-radius: 6px;
    padding: 2rem 2.2rem;
    margin-top: 3rem;
  }

  .contact-box-title {
    font-size: 18px;
    font-weight: 500;
    color: #1e293b;
    margin: 0 0 6px;
  }

  .contact-box-desc {
    font-size: 13.5px;
    color: #64748b;
    margin: 0 0 1.5rem;
  }

  .about-contact-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form-row-2 {
    display: flex;
    gap: 16px;
  }

  .form-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field label {
    font-size: 13px;
    color: #475569;
  }

  .form-input {
    width: 100%;
    background: #ffffff;
    border: 1px solid #d1d5db;
    padding: 9px 12px;
    font-size: 14px;
    color: #1e293b;
    border-radius: 4px;
    outline: none;
    box-sizing: border-box;
    font-family: inherit;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    border-color: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.15);
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
    line-height: 1.5;
  }

  .form-submit-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-about-submit {
    background: #10b981;
    color: #ffffff;
    border: none;
    padding: 10px 26px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-about-submit:hover {
    background: #059669;
  }

  .about-form-status {
    font-size: 13px;
    font-weight: 500;
  }

  .about-form-status.is-success {
    color: #16a34a;
  }

  .about-form-status.is-error {
    color: #dc2626;
  }

  @media (max-width: 680px) {
    .about-badge-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.2rem 0.8rem;
    }
    .about-card-wrap {
      padding: 2rem 1.4rem;
    }
    
      /* 🏅 關於頁面資格認證樣式 (經典多徽章展示網格) */
  .about-badges-container {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 2rem 1.5rem 1.5rem;
    margin: 1.5rem 0 2.5rem;
  }

  .about-badge-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem 1.2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about-badge-item {
    text-align: center;
  }

  .about-badge-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    height: 100%;
    transition: all 0.2s ease;
  }

  .about-badge-img-box {
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .about-badge-img {
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.12));
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), filter 0.25s ease;
  }

  .about-badge-link:hover .about-badge-img {
    transform: translateY(-4px) scale(1.08);
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.2));
  }

  .about-badge-name {
    font-size: 12.5px;
    font-weight: 500;
    color: #334155;
    line-height: 1.45;
    margin: 0;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }

  .about-badge-link:hover .about-badge-name {
    color: #ff6b00;
  }

  .about-badge-more-wrap {
    margin-top: 1.8rem;
    padding-top: 1.2rem;
    border-top: 1px solid #e2e8f0;
    text-align: center;
  }

    .about-badge-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
    padding: 6px 12px;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .about-badge-more-btn:hover {
    color: #ff6b00;
    background: transparent;
    text-decoration: underline;
  }

  .about-actions-row {
      flex-direction: column;
    }
    .form-row-2 {
      flex-direction: column;
    }
  }
</style>

<script>
  // ✉️ 關於頁面 Google Form 聯絡送出邏輯
  const form = document.getElementById('aboutPageContactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('apSubmitBtn') as HTMLButtonElement;
  const statusBox = document.getElementById('apStatus');

  const FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeeWapjagLqPsg7i2y_TYhNq2xKW-nNFj6JywiqiDZ8Hkiheg/formResponse';

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('apName') as HTMLInputElement).value.trim();
      const email = (document.getElementById('apEmail') as HTMLInputElement).value.trim();
      const msg = (document.getElementById('apMsg') as HTMLTextAreaElement).value.trim();

      if (!name || !email || !msg) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '傳送中…';
      }

      try {
        const formData = new FormData();
        formData.append('entry.57084769', name);
        formData.append('entry.135399445', email);
        formData.append('entry.1753446536', msg);

        await fetch(FORM_URL, {
          method: 'POST',
          mode: 'no-cors',
          body: formData,
        });

        if (statusBox) {
          statusBox.textContent = '✓ 訊息已成功送出，感謝您的聯繫！';
          statusBox.className = 'about-form-status is-success';
        }

        form.reset();

        setTimeout(() => {
          if (statusBox) statusBox.textContent = '';
        }, 5000);
      } catch (err) {
        if (statusBox) {
          statusBox.textContent = '✕ 傳送失敗，請稍後再試。';
          statusBox.className = 'about-form-status is-error';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '送出訊息';
        }
      }
    });
  }
</script>
