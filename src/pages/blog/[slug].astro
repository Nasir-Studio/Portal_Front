---
import BlogLayout from '../../layouts/BlogLayout.astro';
import posts from '../../data/posts';

export function getStaticPaths() {
  return posts.map((item, index) => {
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;
    const relatedPosts = posts.filter(p => p.slug !== item.slug).slice(0, 3);
    return {
      params: { slug: item.slug },
      props: { item, prevPost, nextPost, relatedPosts },
    };
  });
}

const { item, prevPost, nextPost, relatedPosts } = Astro.props;

function getCategoryName(category: string, slug: string) {
  if (slug.includes('security') || slug.includes('audit')) return '系統資安';
  if (slug.includes('architecture') || slug.includes('pwa')) return '架構伺服器';
  if (slug.includes('design') || slug.includes('front-end')) return '前端設計';
  if (slug.includes('tool') || slug.includes('proxy') || slug.includes('github')) return '外掛工具';
  if (slug.includes('ntub') || slug.includes('exam')) return '專案實戰';
  return 'WordPress教學';
}

const catName = getCategoryName(item.category, item.slug);
---

<BlogLayout title={`${item.title} ｜ OviNas 羊之誌`} description={item.excerpt}>
  <div class="make9-single-post-wrapper">
    <div class="container">
      <div class="single-layout-grid">
        <!-- 📖 左側主文章區域 (72% 寬度) -->
        <main class="single-main-left">
          <!-- 麵包屑導航 -->
          <nav class="breadcrumbs" aria-label="麵包屑">
            <a href="/blog/">首頁</a>
            <span class="sep">/</span>
            <a href="/blog/#all-posts">{catName}</a>
            <span class="sep">/</span>
            <span class="current">{item.title}</span>
          </nav>

          <!-- 文章標題與 Meta -->
          <header class="single-header">
            <div class="post-cat-badge">{catName}</div>
            <h1 class="single-title">{item.title}</h1>
            <div class="single-meta-row">
              <span class="meta-item"><i class="meta-icon">👤</i> OviNas</span>
              <span class="meta-item"><i class="meta-icon">📅</i> {item.date}</span>
              <span class="meta-item"><i class="meta-icon">⏱️</i> 8 分鐘閱讀</span>
            </div>
          </header>

          <!-- 經典 3D 浮動主圖 -->
          <div class="img-wrap single-hero-img-wrap">
            <div class="bgs bgs1"></div>
            <div class="bgs bgs2"></div>
            <div class="bgs bgs3"></div>
            <div class="bgs bgs4"></div>
            <div class="bgs bgs5 single-cover-canvas">
              <div class="cover-center-badge">
                <span class="cover-topic-tag">{catName} 專題深入</span>
                <h2 class="cover-heading">{item.title}</h2>
              </div>
            </div>
          </div>

          <!-- 📑 目錄索引區塊 (Table of Contents - Classic #toc_container) -->
          <div id="toc_container" class="toc-box">
            <p class="toc_title">📑 內容索引</p>
            <ul class="toc_list" id="tocList">
              <!-- JS 動態生成目錄 -->
            </ul>
          </div>

          <!-- 文章內文主體 -->
          <article class="single-article-content" id="articleBody" set:html={item.content}></article>

          <!-- 底部作者專欄卡片 -->
          <div class="post-bottom-author-box">
            <div class="author-avatar-col">
              <img src="/sheep-hd.png" alt="OviNas" width="80" height="80" />
            </div>
            <div class="author-info-col">
              <h3 class="author-title">關於作者：OviNas</h3>
              <p class="author-desc-p">
                全端工程師與資安研究愛好者，專注於現代 Web 架構、系統資安滲透稽核與高質感前端互動。如果這篇文章對你有幫助，歡迎分享或加入 VIP 專區！
              </p>
            </div>
          </div>

          <!-- 上一篇 / 下一篇導航 (prev-next-article) -->
          <nav class="prev-next-article" aria-label="前後文章">
            {prevPost ? (
              <a href={`/blog/${prevPost.slug}/`} class="prev-link">
                <span class="pn-label">« 上一篇文章</span>
                <span class="pn-title">{prevPost.title}</span>
              </a>
            ) : <div class="pn-empty"></div>}

            {nextPost ? (
              <a href={`/blog/${nextPost.slug}/`} class="next-link">
                <span class="pn-label">下一篇文章 »</span>
                <span class="pn-title">{nextPost.title}</span>
              </a>
            ) : <div class="pn-empty"></div>}
          </nav>

          <!-- 相關推薦文章 (Related Posts) -->
          <div class="related-posts-section">
            <h3 class="related-heading">推薦相關文章</h3>
            <div class="related-grid">
              {relatedPosts.map((r, idx) => (
                <article class="related-card">
                  <div class="img-wrap">
                    <div class="bgs bgs1"></div>
                    <div class="bgs bgs2"></div>
                    <div class="bgs bgs3"></div>
                    <div class="bgs bgs4"></div>
                    <a class="bgs bgs5 related-thumb" href={`/blog/${r.slug}/`}>
                      <div class="related-thumb-bg">#{idx + 1}</div>
                    </a>
                  </div>
                  <h4 class="related-title">
                    <a href={`/blog/${r.slug}/`}>{r.title}</a>
                  </h4>
                  <span class="related-date">{r.date}</span>
                </article>
              ))}
            </div>
          </div>
        </main>

        <!-- 📌 右側側欄 (28% 寬度) -->
        <aside class="single-sidebar-right">
          <!-- 站長專欄 -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="100" height="100" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長</span></h2>
            <p class="history">全端開發 · 系統架構 · 資安防護</p>
            <div class="side-btn-row">
              <a href="/vip/" class="btn-side-vip">加入 VIP 會員</a>
            </div>
          </div>

          <!-- 熱門排行側欄 (#popular-side) -->
          <div class="popular-posts" id="popular-side">
            <h3 class="side-section-heading">熱門推薦文章</h3>
            <ul class="wpp-list">
              {posts.slice(0, 5).map((p, idx) => (
                <li class="wpp-item">
                  <span class={`wpp-rank rank-${idx + 1}`}>{idx + 1}</span>
                  <div class="wpp-details">
                    <a href={`/blog/${p.slug}/`} class="wpp-post-title">
                      {p.title}
                    </a>
                    <span class="wpp-meta">{p.date}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
  .make9-single-post-wrapper {
    background-color: #ffffff;
    padding: 2rem 0 5rem;
  }

  .single-layout-grid {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
  }

  .single-main-left {
    flex: 0 0 calc(72% - 1.5rem);
    max-width: 820px;
  }

  .single-sidebar-right {
    flex: 0 0 calc(28% - 1.5rem);
  }

  /* 麵包屑 */
  .breadcrumbs {
    font-size: 0.86rem;
    color: #888888;
    margin-bottom: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumbs a {
    color: #555555;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #0062eb;
    text-decoration: underline;
  }

  .breadcrumbs .sep {
    color: #cccccc;
  }

  .breadcrumbs .current {
    color: #222222;
    font-weight: 700;
  }

  /* 文章標題區 */
  .single-header {
    margin-bottom: 2rem;
  }

  .post-cat-badge {
    display: inline-block;
    background-color: #0062eb;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 3px 12px;
    margin-bottom: 0.8rem;
  }

  .single-title {
    font-size: 2.2rem;
    font-weight: 900;
    line-height: 1.3;
    color: #111111;
    margin: 0 0 1rem;
    letter-spacing: 0.5px;
  }

  .single-meta-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 0.86rem;
    color: #888888;
    border-bottom: 1px solid #eeeeee;
    padding-bottom: 1.2rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* 主圖 3D 浮動 */
  .single-hero-img-wrap {
    margin: 2rem 0;
  }

  .single-cover-canvas {
    height: 320px;
    background: linear-gradient(135deg, #111827, #1f2937, #0f172a);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
    text-align: center;
  }

  .cover-topic-tag {
    display: inline-block;
    color: #f7d002;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 1px;
    margin-bottom: 0.6rem;
  }

  .cover-heading {
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.35;
    margin: 0;
    max-width: 650px;
  }

  /* 📑 Table of Contents (#toc_container) */
  .toc-box {
    background: #f9f9f9;
    border: 1px solid #e7e7e7;
    border-left: 4px solid #0062eb;
    padding: 1.2rem 1.6rem;
    margin: 2rem 0 2.5rem;
  }

  .toc_title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #111111;
    margin: 0 0 0.8rem;
  }

  .toc_list {
    list-style: none;
    padding-left: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .toc_list a {
    color: #0062eb;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .toc_list a:hover {
    color: #0047bb;
    text-decoration: underline;
  }

  /* 📖 文章排版美學 (Gutenberg Content Styling) */
  .single-article-content {
    font-size: 1.08rem;
    line-height: 1.85;
    color: #222222;
  }

  .single-article-content h2 {
    font-size: 1.55rem;
    font-weight: 800;
    color: #111111;
    margin: 2.8rem 0 1.2rem;
    padding-left: 14px;
    border-left: 5px solid #0062eb;
    letter-spacing: 0.5px;
  }

  .single-article-content h3 {
    font-size: 1.28rem;
    font-weight: 700;
    color: #222222;
    margin: 2rem 0 1rem;
  }

  .single-article-content p {
    margin: 0 0 1.4rem;
  }

  .single-article-content ul,
  .single-article-content ol {
    margin: 0 0 1.6rem;
    padding-left: 1.8rem;
  }

  .single-article-content li {
    margin-bottom: 0.6rem;
  }

  .single-article-content code {
    background-color: #f3f4f6;
    color: #c0392b;
    padding: 2px 6px;
    font-size: 0.9em;
    font-family: monospace;
  }

  .single-article-content pre {
    background-color: #1a1a1a;
    color: #e5e7eb;
    padding: 1.2rem 1.5rem;
    overflow-x: auto;
    border-left: 4px solid #0062eb;
    margin: 1.5rem 0;
  }

  .single-article-content pre code {
    background: none;
    color: inherit;
    padding: 0;
  }

  /* 提示框與重點框 */
  .single-article-content .post-intro,
  .single-article-content blockquote {
    background-color: #f4f8ff;
    border-left: 4px solid #0062eb;
    padding: 1.2rem 1.5rem;
    margin: 1.8rem 0;
    color: #334155;
    font-size: 1rem;
  }

  /* 底部作者卡 */
  .post-bottom-author-box {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 1.5rem;
    margin: 3.5rem 0 2rem;
  }

  .author-avatar-col img {
    border-radius: 50%;
    border: 3px solid #0062eb;
    object-fit: contain;
    background: #ffffff;
  }

  .author-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #111111;
    margin: 0 0 0.4rem;
  }

  .author-desc-p {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  /* 上一篇 / 下一篇導航 */
  .prev-next-article {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 2rem 0 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid #e7e7e7;
    border-bottom: 1px solid #e7e7e7;
  }

  .prev-link, .next-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    max-width: 48%;
  }

  .pn-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #0062eb;
  }

  .pn-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #222222;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .prev-link:hover .pn-title,
  .next-link:hover .pn-title {
    color: #0062eb;
  }

  .next-link {
    text-align: right;
    margin-left: auto;
  }

  /* 推薦相關文章 */
  .related-posts-section {
    margin-top: 3rem;
  }

  .related-heading {
    font-size: 1.25rem;
    font-weight: 800;
    color: #111111;
    margin: 0 0 1.5rem;
    border-left: 4px solid #0062eb;
    padding-left: 10px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .related-thumb {
    display: block;
    text-decoration: none;
  }

  .related-thumb-bg {
    height: 120px;
    background: #1e293b;
    color: rgba(255, 255, 255, 0.2);
    font-size: 2.5rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .related-title {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0.6rem 0 0.3rem;
  }

  .related-title a {
    color: #222222;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .related-title a:hover {
    color: #0062eb;
  }

  .related-date {
    font-size: 0.76rem;
    color: #999999;
  }

  @media (max-width: 1024px) {
    .single-layout-grid {
      flex-direction: column;
    }
    .single-main-left, .single-sidebar-right {
      flex: 0 0 100%;
      max-width: 100%;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // 自動解析內文 H2 生成 Table of Contents
  const articleBody = document.getElementById('articleBody');
  const tocList = document.getElementById('tocList');

  if (articleBody && tocList) {
    const headings = articleBody.querySelectorAll('h2');
    headings.forEach((h, idx) => {
      const id = `section-${idx + 1}`;
      h.id = id;

      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = `${idx + 1}. ${h.textContent}`;
      li.appendChild(a);
      tocList.appendChild(li);
    });

    if (headings.length === 0) {
      document.getElementById('toc_container')?.remove();
    }
  }
</script>
