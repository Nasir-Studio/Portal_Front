<script>
  const filterTabs = document.querySelectorAll('.filter-tab');
  const loopArticles = document.querySelectorAll('.loop-article');
  const emptyNotice = document.getElementById('emptyNotice');
  const catNameEl = document.getElementById('archiveCatName');
  const slugNameEl = document.getElementById('archiveSlugName');

  const catMeta: Record<string, { name: string; slug: string }> = {
    all: { name: '全部文章', slug: ' ALL POSTS ' },
    security: { name: '系統資安', slug: ' SECURITY ' },
    architecture: { name: '架構伺服器', slug: ' ARCHITECTURE ' },
    design: { name: '前端設計', slug: ' FRONT-END DESIGN ' },
    tools: { name: '外掛工具', slug: ' TOOLS ' },
    campus: { name: '專案實戰', slug: ' PROJECTS ' },
  };

  let currentCategory = 'all';

  function filterPosts() {
    let visibleCount = 0;

    loopArticles.forEach((article) => {
      const el = article as HTMLElement;
      const cardCategory = el.getAttribute('data-cat') || '';
      const match = currentCategory === 'all' || cardCategory === currentCategory;

      if (match) {
        el.style.display = 'block';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (catNameEl && slugNameEl) {
      const meta = catMeta[currentCategory] || catMeta.all;
      catNameEl.textContent = meta.name;
      slugNameEl.textContent = meta.slug;
    }

    if (emptyNotice) {
      emptyNotice.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      currentCategory = tab.getAttribute('data-cat') || 'all';
      filterPosts();
    });
  });

  document.querySelectorAll('.cat-filter-click').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = link.getAttribute('data-target-cat') || 'all';
      filterTabs.forEach((tab) => {
        if (tab.getAttribute('data-cat') === target) {
          (tab as HTMLElement).click();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });
  });

  document.querySelectorAll('.tag-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      const kw = btn.getAttribute('data-kw') || '';
      if (kw === '資安') (document.querySelector('[data-cat="security"]') as HTMLElement)?.click();
      else if (kw === '架構' || kw === 'pwa') (document.querySelector('[data-cat="architecture"]') as HTMLElement)?.click();
      else if (kw === '設計') (document.querySelector('[data-cat="design"]') as HTMLElement)?.click();
      else if (kw === '代理' || kw === 'github') (document.querySelector('[data-cat="tools"]') as HTMLElement)?.click();
      else if (kw === '北商') (document.querySelector('[data-cat="campus"]') as HTMLElement)?.click();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>


<script>
  // 🔍 文章列表即時搜尋篩選器
  const params = new URLSearchParams(window.location.search);
  const q = params.get('q')?.trim().toLowerCase() || '';
  const searchInput = document.getElementById('archiveSearchInput') as HTMLInputElement;
  const postCards = document.querySelectorAll('.loop-article');
  const countText = document.getElementById('searchCountText');

  function filterPosts(query: string) {
    let visibleCount = 0;
    postCards.forEach((card) => {
      const title = card.querySelector('.post-title')?.textContent?.toLowerCase() || '';
      const excerpt = card.querySelector('.post-excerpt')?.textContent?.toLowerCase() || '';
      const cat = card.querySelector('.post-categories')?.textContent?.toLowerCase() || '';

      if (!query || title.includes(query) || excerpt.includes(query) || cat.includes(query)) {
        (card as HTMLElement).style.display = '';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (countText) {
      if (query) {
        countText.textContent = `搜尋「${query}」共找到 ${visibleCount} 篇相關文章`;
        countText.style.display = 'block';
      } else {
        countText.style.display = 'none';
      }
    }
  }

  if (searchInput) {
    if (q) {
      searchInput.value = q;
      filterPosts(q);
    }

    searchInput.addEventListener('input', () => {
      filterPosts(searchInput.value.trim().toLowerCase());
    });
  }
</script>
