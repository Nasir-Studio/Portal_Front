---
import quotes from '../../../data/quotes';
import badges from '../../../data/badges';

const today = new Date();
const seed = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
const dailyQuote = quotes[seed % quotes.length];



import BlogLayout from '../../../layouts/BlogLayout.astro';
import posts from '../../../data/posts';

const allPosts = posts;

function getPostCategory(post: typeof posts[0]) {
  if (post.slug.includes('security') || post.slug.includes('audit')) {
    return { name: '系統資安', slug: 'security' };
  }
  if (post.slug.includes('architecture') || post.slug.includes('pwa')) {
    return { name: '架構伺服器', slug: 'architecture' };
  }
  if (post.slug.includes('design') || post.slug.includes('front-end')) {
    return { name: '前端設計', slug: 'design' };
  }
  if (post.slug.includes('tool') || post.slug.includes('proxy') || post.slug.includes('github')) {
    return { name: '外掛工具', slug: 'tools' };
  }
  if (post.slug.includes('ntub') || post.slug.includes('exam')) {
    return { name: '專案實戰', slug: 'campus' };
  }
  return { name: 'WordPress架站', slug: 'general' };
}


---
<BlogLayout title="全部文章列表 ｜ OviNas" description="網站架設、系統資安、筆記小分享、架構伺服器與外掛推薦文章列表。">
  <div class="main-content">
    <div class="container single-page-area">
      <!-- 📖 左側主列表區域 (main.left: 68% 寬度，右側 1px 分隔線) -->
      <main class="left">
        <!-- 經典麵包屑導航 (Breadcrumbs) -->
        <div class="breadcrumbs">
          <a href="/blog/" class="home">首頁</a>
          <span class="sep">&gt;</span>
          <span class="current-crumb">全部文章列表</span>
        </div>

        <!-- 經典列表標題 (archive-title: 大分類名稱 + 英文大寫 + 文章列表) -->
        <h1 class="archive-title">
          <span class="cat-name" id="archiveCatName">全部文章</span>
          <span class="slug-name" id="archiveSlugName"> ALL POSTS </span>
          <span class="title-suffix">文章列表</span>
        </h1>

        <!-- 🔍 分類切換按鈕組 -->
        <div class="archive-filter-bar">
          <button class="filter-tab is-active" data-cat="all" type="button">全部 ({allPosts.length})</button>
          <button class="filter-tab" data-cat="security" type="button">系統資安 ({allPosts.filter(p => p.slug.includes('security') || p.slug.includes('audit')).length})</button>
          <button class="filter-tab" data-cat="architecture" type="button">架構伺服器 ({allPosts.filter(p => p.slug.includes('architecture') || p.slug.includes('pwa')).length})</button>
          <button class="filter-tab" data-cat="design" type="button">前端設計 ({allPosts.filter(p => p.slug.includes('design') || p.slug.includes('front-end')).length})</button>
          <button class="filter-tab" data-cat="tools" type="button">外掛工具 ({allPosts.filter(p => p.slug.includes('tool') || p.slug.includes('proxy') || p.slug.includes('github')).length})</button>
          <button class="filter-tab" data-cat="campus" type="button">專案實戰 ({allPosts.filter(p => p.slug.includes('ntub') || p.slug.includes('exam')).length})</button>
        </div>

        <!-- 📰 經典 WordPress 單欄文章流 (.post-list-loop article) -->
        <div class="post-list-loop" id="postLoop">
          {allPosts.map((post) => {
            const cat = getPostCategory(post);
            return (
              <article
                class="loop-article"
                data-cat={cat.slug}
                data-title={post.title.toLowerCase()}
                data-excerpt={post.excerpt.toLowerCase()}
              >
                <!-- 1. 16:9 文青真實照片橫幅縮圖 (.img-wrap) -->
                <div class="img-wrap loop-img-wrap">
                  <a href={`/blog/posts/${post.slug}/`}>
                    <img
                      src={`/banners/${post.slug}.jpg`}
                      alt={post.title}
                      class="attachment-post-loop"
                      loading="lazy"
                    />
                  </a>
                </div>

                <!-- 2. 文章 Meta 資訊列 (.post-meta: BY 作者 | 日期 | 分類) -->
                <div class="post-meta">
                  <div class="post-author">
                    BY <a href="/blog/">OviNas</a>
                  </div>
                  <p class="meta-sep">|</p>
                  <div class="post-date">
                    <span class="meta-icon">🕒</span> {post.date}
                  </div>
                  <p class="meta-sep">|</p>
                  <ul class="post-categories">
                    <li><a href="#" class="cat-filter-click" data-target-cat={cat.slug}>{cat.name}</a></li>
                  </ul>
                </div>

                <!-- 3. 文章大標題 (.post-title) -->
                <h3 class="post-title">
                  <a href={`/blog/posts/${post.slug}/`}>{post.title}</a>
                </h3>

                <!-- 4. 文章內文摘要 (.post-excerpt) -->
                <p class="post-excerpt">{post.excerpt}</p>

                <!-- 5. 繼續閱讀按鈕 (.read-more) -->
                <div class="read-more-wrap">
                  <a href={`/blog/posts/${post.slug}/`} class="read-more">繼續閱讀</a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- 查無結果提示 -->
        <div class="empty-results-box" id="emptyNotice" style="display: none;">
          <h3>查無相關文章！</h3>
          <p>請點選上方「全部」以瀏覽所有文章。</p>
        </div>
      </main>

      <!-- 📌 右側經典側邊欄 (Sidebar: 28% 寬度) -->
      <aside class="right sidebar-right">
        <!-- 站長專欄 -->
        <div class="side-author-box">
          <div class="photo">
            <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
          </div>
          <h2>OviNas <span class="eng-name">/ 站長專欄</span></h2>
          <p class="history">網站架設 · 系統資安 · 筆記小分享</p>
          <div class="author-bio">
              <p>
                從小對資訊抱有熱忱，從 Google 查詢時代轉向 AI 世代，面對學習與獲取資訊方式的改變，我始終一直持續 Update 我的資訊專業能力。時代轉變，像是 DOS 轉變成 Windows 一樣，很多東西懂需要重新學，這個資訊爆炸的世代，我不僅具備傳統電腦維修與程式設計能力，更擅長利用資訊解決企業的【痛點】。
              </p>
              <p>
                許多企業目前仍以人工方式處理專業技術工作，而我喜歡發揮想像力，將流程與資訊系統整合，讓原本緩慢的效率獲得大幅提升！
              </p>
            </div>
          <div class="side-btn-row">
            <a href="#" class="btn-side-vip">更多</a>
          </div>
        </div>

          <!-- 🏅 資格認證 (Badges - 純淨展示，無多餘超連結) -->
          <div class="side-popular-box side-badges-box" style="margin-top: 2rem;">
            <h2 class="side-badges-title">資格認證</h2>
            <ul class="side-badges-list">
              {badges.map((b) => (
                <li class="side-badge-item">
                  <div class="side-badge-link" title={b.name}>
                    <img src={b.img} alt={b.name} class="side-badge-img" loading="lazy" />
                    <span class="side-badge-name">{b.name}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
      </aside>
    </div>
  </div>
</BlogLayout>

