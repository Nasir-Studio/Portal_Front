---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/posts';

export function getStaticPaths() {
  return posts.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const backLink = '/#news';
---

<BaseLayout title={`${item.title} ｜ OviNas`}>
  <article class="article container">
    <nav class="article-nav" aria-label="麵包屑">
      <a href="/">首頁</a>
      <span aria-hidden="true">／</span>
      <a href={backLink}>其他文章</a>
    </nav>

    <header class="article-header">
      <h1 class="article-title">{item.title}</h1>
      <p class="article-meta">羊家日記 ・ {item.date}</p>
    </header>

    <div class="article-body" set:html={item.content}></div>

    <div class="article-foot">
      <a class="article-back" href={backLink}>← 回其他文章</a>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .article {
    background: var(--surface);
    border: 1px solid var(--border);
    margin-top: 2.4rem;
    margin-bottom: 3.5rem;
    padding-bottom: 2.4rem;
  }

  .article-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.6rem;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .article-nav a {
    transition: color var(--t);
  }

  .article-nav a:hover {
    color: var(--ink);
  }

  .article-header {
    padding: 2.2rem 1.6rem 1.3rem;
    border-bottom: 1px dashed var(--border);
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.4;
    margin-bottom: 0.9rem;
  }

  .article-meta {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }

  .article-body {
    padding: 1.7rem 1.6rem;
  }

  .article-body p {
    font-size: 1rem;
    letter-spacing: 0.04em;
    line-height: 2.1;
    color: var(--ink-2);
    margin-bottom: 1.2rem;
  }

  .article-body .post-intro {
    font-size: 1.05rem;
    font-style: italic;
    color: var(--ink-3);
    border-left: 3px solid var(--ink);
    padding-left: 1rem;
    margin-bottom: 1.5rem;
  }

  .article-body .post-outro {
    margin-top: 2rem;
    font-weight: 500;
    color: var(--ink);
  }

  .article-body h2 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    margin: 2rem 0 0.8rem;
    color: var(--ink);
  }

  .article-body h3 {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin: 1.8rem 0 0.7rem;
    color: var(--ink);
  }

  .article-body img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    display: block;
    margin: 1.2rem auto;
  }

  .article-body code {
    font-family: monospace;
    font-size: 0.92em;
    background: var(--bg-soft);
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border);
  }

  .article-body ul {
    margin-bottom: 1.2rem;
    padding-left: 1.4rem;
  }

  .article-body li {
    font-size: 0.95rem;
    line-height: 2;
    color: var(--ink-2);
    margin-bottom: 0.4rem;
    overflow-wrap: anywhere;
  }

  .article-body a {
    color: var(--ink);
    border-bottom: 1px solid var(--border-strong);
    transition: border-color var(--t), color var(--t);
  }

  .article-body a:hover {
    border-color: var(--ink);
  }

  .article-body .audit-dl {
    display: inline-block;
    background: var(--ink);
    color: var(--white);
    padding: 0.65rem 1.4rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.05em;
    border: none;
    transition: background var(--t);
  }

  .article-body .audit-dl:hover {
    background: var(--ink-2);
    border: none;
    color: var(--white);
  }

  .article-body .audit-note {
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .article-body .audit-tip {
    color: var(--ink-3);
    font-style: italic;
  }

  .article-foot {
    padding: 1.6rem 1.6rem 0;
  }

  .article-back {
    display: inline-block;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--ink-3);
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border-strong);
    transition: color var(--t), border-color var(--t);
  }

  .article-back:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
</style>
