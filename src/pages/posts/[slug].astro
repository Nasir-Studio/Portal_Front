    text-decoration: none;
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .wpp-post-title:hover {
    color: #0062eb;
  }

  .wpp-meta {
    font-size: 0.76rem;
    color: #999999;
  }

  @media (max-width: 960px) {
    .single-page-area {
      flex-direction: column;
    }
    .single-page-area main.left,
    .single-page-area .right.sidebar-right {
      width: 100%;
      border-right: none;
      padding-right: 0;
    }
    .form-row-inputs {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // 1. 自動解析內文 H2 生成 Table of Contents
  const articleBody = document.getElementById('articleBody');
  const tocList = document.getElementById('tocList');

  if (articleBody && tocList) {
    const headings = articleBody.querySelectorAll('h2');
    headings.forEach((h, idx) => {
      const id = `section-${idx + 1}`;
      h.id = id;

      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = `${idx + 1}. ${h.textContent}`;
      li.appendChild(a);
      tocList.appendChild(li);
    });

    if (headings.length === 0) {
      document.getElementById('toc_container')?.remove();
    }
  }

  // 2. 乾淨真實留言機制 (支援本地真實即時留言)
  const commentForm = document.getElementById('commentForm') as HTMLFormElement;
  const commentList = document.getElementById('commentList');
  const noCommentNotice = document.getElementById('noCommentNotice');
  const feedback = document.getElementById('feedbackMsg');
  const countBadge = document.getElementById('commentCountBadge');

  const storageKey = `comments_${window.location.pathname}`;

  function loadComments() {
    try {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return;
      const items = JSON.parse(raw);
      if (Array.isArray(items) && items.length > 0 && commentList) {
        if (noCommentNotice) noCommentNotice.style.display = 'none';
        items.forEach(c => {
          renderComment(c.author, c.content, c.time);
        });
        if (countBadge) countBadge.textContent = `(${items.length})`;
      }
    } catch (err) {}
  }

  function renderComment(author: string, content: string, time: string) {
    const newComment = document.createElement('div');
    newComment.className = 'comment-body';
    newComment.innerHTML = `
      <div class="comment-avatar">
        <div class="avatar-letter">${author.charAt(0).toUpperCase()}</div>
      </div>
      <div class="comment-content-wrap">
        <div class="comment-meta">
          <span class="comment-author">${author}</span>
          <span class="comment-time">${time}</span>
        </div>
        <div class="comment-text">${content}</div>
      </div>
    `;
    commentList?.appendChild(newComment);
  }

  if (commentForm && commentList) {
    loadComments();

    commentForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const author = (document.getElementById('authorName') as HTMLInputElement).value.trim();
      const content = (document.getElementById('commentContent') as HTMLTextAreaElement).value.trim();

      if (!author || !content) return;

      if (noCommentNotice) noCommentNotice.style.display = 'none';

      renderComment(author, content, '剛剛');

      // 存入 localStorage
      try {
        const raw = localStorage.getItem(storageKey) || '[]';
        const items = JSON.parse(raw);
        items.push({ author, content, time: '剛剛' });
        localStorage.setItem(storageKey, JSON.stringify(items));
        if (countBadge) countBadge.textContent = `(${items.length})`;
      } catch (err) {}

      (document.getElementById('commentContent') as HTMLTextAreaElement).value = '';

      if (feedback) {
        feedback.textContent = '✓ 留言發表成功！';
        feedback.style.display = 'inline-block';
        setTimeout(() => { feedback.style.display = 'none'; }, 3000);
      }
    });
  }
</script>
