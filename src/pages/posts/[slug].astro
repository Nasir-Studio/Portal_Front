---
import BlogLayout from '../../layouts/BlogLayout.astro';
import posts from '../../data/posts';

export function getStaticPaths() {
  return posts.map((item, index) => {
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;
    const relatedPosts = posts.filter(p => p.slug !== item.slug).slice(0, 3);
    return {
      params: { slug: item.slug },
      props: { item, prevPost, nextPost, relatedPosts },
    };
  });
}

const { item, prevPost, nextPost, relatedPosts } = Astro.props;

function getCategoryName(category: string, slug: string) {
  if (slug.includes('security') || slug.includes('audit')) return '系統資安';
  if (slug.includes('architecture') || slug.includes('pwa')) return '架構伺服器';
  if (slug.includes('design') || slug.includes('front-end')) return '前端設計';
  if (slug.includes('tool') || slug.includes('proxy') || slug.includes('github')) return '外掛工具';
  if (slug.includes('ntub') || slug.includes('exam')) return '專案實戰';
  return 'WordPress教學';
}

const catName = getCategoryName(item.category, item.slug);
---

<BlogLayout title={`${item.title} ｜ OviNas 羊之誌`} description={item.excerpt}>
  <div class="make9-single-post-wrapper">
    <div class="container">
      <div class="single-layout-grid">
        <!-- 📖 左側主文章區域 (72% 寬度) -->
        <main class="single-main-left">
          <!-- 麵包屑導航 -->
          <nav class="breadcrumbs" aria-label="麵包屑">
            <a href="/blog/">部落格首頁</a>
            <span class="sep">/</span>
            <a href="/blog/#all-posts">{catName}</a>
            <span class="sep">/</span>
            <span class="current">{item.title}</span>
          </nav>

          <!-- 文章標題與 Meta -->
          <header class="single-header">
            <div class="post-cat-badge">{catName}</div>
            <h1 class="single-title">{item.title}</h1>
            <div class="single-meta-row">
              <span class="meta-item"><i class="meta-icon">👤</i> OviNas 站長</span>
              <span class="meta-item"><i class="meta-icon">📅</i> {item.date}</span>
              <span class="meta-item"><i class="meta-icon">⏱️</i> 8 分鐘精讀</span>
              <a href="#comments" class="meta-item meta-comment-jump"><i class="meta-icon">💬</i> <span id="metaCommentCount">2 則迴響</span></a>
            </div>
          </header>

          <!-- 經典 3D 浮動主圖 -->
          <div class="img-wrap single-hero-img-wrap">
            <div class="bgs bgs1"></div>
            <div class="bgs bgs2"></div>
            <div class="bgs bgs3"></div>
            <div class="bgs bgs4"></div>
            <div class="bgs bgs5 single-cover-canvas">
              <div class="cover-center-badge">
                <span class="cover-topic-tag">{catName} 深度專題</span>
                <h2 class="cover-heading">{item.title}</h2>
              </div>
            </div>
          </div>

          <!-- 📑 目錄索引區塊 (Table of Contents - Classic #toc_container) -->
          <div id="toc_container" class="toc-box">
            <p class="toc_title">📑 內容索引</p>
            <ul class="toc_list" id="tocList">
              <!-- JS 自動生成目錄 -->
            </ul>
          </div>

          <!-- 文章內文主體 -->
          <article class="single-article-content" id="articleBody" set:html={item.content}></article>

          <!-- 底部作者專欄卡片 -->
          <div class="post-bottom-author-box">
            <div class="author-avatar-col">
              <img src="/sheep-hd.png" alt="OviNas" width="80" height="80" />
            </div>
            <div class="author-info-col">
              <h3 class="author-title">關於作者：OviNas</h3>
              <p class="author-desc-p">
                專注於現代 Web 架構設計、系統資安防護與高質感前端開發。如果這篇文章對你有幫助，歡迎在下方留言交流或加入主站 VIP 專區！
              </p>
            </div>
          </div>

          <!-- 上一篇 / 下一篇導航 (prev-next-article) -->
          <nav class="prev-next-article" aria-label="前後文章">
            {prevPost ? (
              <a href={`/blog/${prevPost.slug}/`} class="prev-link">
                <span class="pn-label">« 上一篇文章</span>
                <span class="pn-title">{prevPost.title}</span>
              </a>
            ) : <div class="pn-empty"></div>}

            {nextPost ? (
              <a href={`/blog/${nextPost.slug}/`} class="next-link">
                <span class="pn-label">下一篇文章 »</span>
                <span class="pn-title">{nextPost.title}</span>
              </a>
            ) : <div class="pn-empty"></div>}
          </nav>

          <!-- 💬 4. 經典 WordPress 風格留言板專區 (#comments & #respond) -->
          <section class="comments-area" id="comments">
            <div class="comments-section-header">
              <h3 class="comments-title">
                <span class="title-icon">💬</span> 讀者迴響與討論
                <span class="comments-count-pill" id="commentCountBadge">(2 則)</span>
              </h3>
            </div>

            <!-- 現有留言清單 (Comment List) -->
            <div class="commentlist" id="commentList">
              <!-- 範例留言 1 -->
              <div class="comment-body">
                <div class="comment-avatar-wrap">
                  <div class="default-avatar">羊</div>
                </div>
                <div class="comment-main-content">
                  <div class="comment-meta-bar">
                    <span class="comment-author-name">Alex Lin</span>
                    <span class="comment-user-badge">訪客</span>
                    <span class="comment-time">2 天前</span>
                  </div>
                  <div class="comment-text">
                    這篇架構分析與資安防護拆解得非常清晰，特別是 Cloudflare 與邊緣緩存的實戰設定，收穫良多！
                  </div>
                  <div class="comment-reply-btn">
                    <button type="button" class="btn-reply-action" data-reply-to="Alex Lin">回覆</button>
                  </div>
                </div>
              </div>

              <!-- 範例留言 2: 站長回覆 -->
              <div class="comment-body is-author-reply">
                <div class="comment-avatar-wrap">
                  <img src="/sheep-hd.png" alt="OviNas" class="author-avatar-img" width="44" height="44" />
                </div>
                <div class="comment-main-content">
                  <div class="comment-meta-bar">
                    <span class="comment-author-name">OviNas</span>
                    <span class="comment-user-badge is-admin">站長</span>
                    <span class="comment-time">1 天前</span>
                  </div>
                  <div class="comment-text">
                    很高興對你有幫助！後續還會更新一系列防護技巧與工具，歡迎隨時交流討論！
                  </div>
                  <div class="comment-reply-btn">
                    <button type="button" class="btn-reply-action" data-reply-to="OviNas">回覆</button>
                  </div>
                </div>
              </div>
            </div>

            <!-- 發表迴響表單 (#respond) -->
            <div class="comment-respond" id="respond">
              <h3 class="reply-title">
                <span class="title-square">■</span> 發表您的看法與迴響
              </h3>
              <p class="comment-notes">電子郵件地址不會被公開發布。必填欄位已標記 <span class="required">*</span></p>

              <form id="commentForm" class="comment-form">
                <div class="form-row form-grid-3">
                  <div class="form-group">
                    <label for="authorName">稱呼 <span class="required">*</span></label>
                    <input id="authorName" type="text" class="wp-input" placeholder="你的暱稱" required />
                  </div>
                  <div class="form-group">
                    <label for="authorEmail">電子郵件 <span class="required">*</span></label>
                    <input id="authorEmail" type="email" class="wp-input" placeholder="you@example.com" required />
                  </div>
                  <div class="form-group">
                    <label for="authorUrl">個人網站 (選填)</label>
                    <input id="authorUrl" type="url" class="wp-input" placeholder="https://" />
                  </div>
                </div>

                <div class="form-group form-comment-box">
                  <label for="commentContent">留言內容 <span class="required">*</span></label>
                  <textarea id="commentContent" rows="5" class="wp-textarea" placeholder="寫下你的看法、問題或心得…" required></textarea>
                </div>

                <div class="form-group form-checkbox-row">
                  <label class="checkbox-label">
                    <input type="checkbox" id="saveInfoCheck" checked />
                    <span>在瀏覽器中記住我的稱呼與電子郵件，以便下次發表留言時自動帶入</span>
                  </label>
                </div>

                <div class="form-submit-row">
                  <button type="submit" class="wp-submit-btn">發表留言 »</button>
                  <span id="commentFeedback" class="comment-feedback" style="display: none;"></span>
                </div>
              </form>
            </div>
          </section>

          <!-- 推薦相關文章 (Related Posts) -->
          <div class="related-posts-section">
            <h3 class="related-heading">推薦相關文章</h3>
            <div class="related-grid">
              {relatedPosts.map((r, idx) => (
                <article class="related-card">
                  <div class="img-wrap">
                    <div class="bgs bgs1"></div>
                    <div class="bgs bgs2"></div>
                    <div class="bgs bgs3"></div>
                    <div class="bgs bgs4"></div>
                    <a class="bgs bgs5 related-thumb" href={`/blog/${r.slug}/`}>
                      <div class="related-thumb-bg">#{idx + 1}</div>
                    </a>
                  </div>
                  <h4 class="related-title">
                    <a href={`/blog/${r.slug}/`}>{r.title}</a>
                  </h4>
                  <span class="related-date">{r.date}</span>
                </article>
              ))}
            </div>
          </div>
        </main>

        <!-- 📌 右側側欄 (28% 寬度) -->
        <aside class="single-sidebar-right">
          <!-- 站長專欄 -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="100" height="100" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長</span></h2>
            <p class="history">全端開發 · 系統架構 · 資安防護</p>
            <div class="side-btn-row">
              <a href="/vip/" class="btn-side-vip">加入 VIP 會員</a>
            </div>
          </div>

          <!-- 熱門排行側欄 (#popular-side) -->
          <div class="popular-posts" id="popular-side">
            <h3 class="side-section-heading">熱門推薦文章</h3>
            <ul class="wpp-list">
              {posts.slice(0, 5).map((p, idx) => (
                <li class="wpp-item">
                  <span class={`wpp-rank rank-${idx + 1}`}>{idx + 1}</span>
                  <div class="wpp-details">
                    <a href={`/blog/${p.slug}/`} class="wpp-post-title">
                      {p.title}
                    </a>
                    <span class="wpp-meta">{p.date}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
