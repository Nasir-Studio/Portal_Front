    color: #111111;
    margin: 0 0 0.4rem;
  }

  .author-desc-p {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  /* 上一篇 / 下一篇導航 */
