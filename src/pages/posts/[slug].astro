---
import BlogLayout from '../../layouts/BlogLayout.astro';
import posts from '../../data/posts';

export function getStaticPaths() {
  return posts.map((item, index) => {
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;
    const relatedPosts = posts.filter(p => p.slug !== item.slug).slice(0, 3);
    return {
      params: { slug: item.slug },
      props: { item, prevPost, nextPost, relatedPosts },
    };
  });
}

const { item, prevPost, nextPost, relatedPosts } = Astro.props;

function getCategoryInfo(slug: string) {
  if (slug.includes('security') || slug.includes('audit')) return { name: '系統資安', parent: '資訊安全' };
  if (slug.includes('architecture') || slug.includes('pwa')) return { name: '架構伺服器', parent: '技術架構' };
  if (slug.includes('design') || slug.includes('front-end')) return { name: '前端設計', parent: '前端工程' };
  if (slug.includes('tool') || slug.includes('proxy') || slug.includes('github')) return { name: '外掛工具', parent: '開源工具' };
  if (slug.includes('ntub') || slug.includes('exam')) return { name: '專案實戰', parent: '校園專案' };
  return { name: 'WordPress教學', parent: '架站日誌' };
}

const cat = getCategoryInfo(item.slug);
---

<BlogLayout title={`${item.title} ｜ OviNas 羊之誌`} description={item.excerpt}>
  <div class="main-content forsingle">
    <div class="container single-page-area">
      <!-- 📖 左側主文章區域 (68% 寬度，右側 1px 分隔線) -->
      <main class="left">
        <!-- 經典麵包屑導航 (Breadcrumbs) -->
        <div class="breadcrumbs">
          <a href="/blog/" class="home">首頁</a>
          <span class="sep">&gt;</span>
          <a href="/blog/#all-posts" class="taxonomy-cat">{cat.parent}</a>
          <span class="sep">&gt;</span>
          <a href="/blog/#all-posts" class="taxonomy-subcat">{cat.name}</a>
          <span class="sep">&gt;</span>
          <span class="current-post-name">{item.title}</span>
        </div>

        <article>
          <!-- 文章大標題 (h1) -->
          <h1 class="single-post-h1">{item.title}</h1>

          <!-- 文章 Meta 資訊欄 (.post-meta) -->
          <div class="post-meta">
            <div class="post-author">
              By <a href="/vip/">OviNas 站長</a>
            </div>
            <div class="post-date">
              <span class="meta-icon">🕒</span> {item.date}
            </div>
            <div class="post-date-modified">
              <span class="meta-icon">✏️</span> 最後更新：{item.date}
            </div>
            <div class="meta-divider">|</div>
            <ul class="post-categories">
              <li><a href="/blog/#all-posts">{cat.name}</a></li>
            </ul>
          </div>

          <!-- 經典 16:9 主圖展示 (.img-wrap + .bgs1~.bgs5) -->
          <div class="img-wrap single-hero-img-wrap">
            <div class="bgs bgs1"></div>
            <div class="bgs bgs2"></div>
            <div class="bgs bgs3"></div>
            <div class="bgs bgs4"></div>
            <div class="bgs bgs5 single-cover-canvas">
              <div class="cover-center-badge">
                <span class="cover-topic-tag">{cat.name} · 精選實戰</span>
                <h2 class="cover-heading">{item.title}</h2>
              </div>
            </div>
          </div>

          <!-- 📑 內容索引目錄 (Table of Contents - Classic #toc_container) -->
          <div id="toc_container" class="no_bullets toc_numbered toc_title_center">
            <p class="toc_title">內容索引</p>
            <ul class="toc_list" id="tocList">
              <!-- JS 動態生成 -->
            </ul>
          </div>

          <!-- 文章內文排版 (綠色鏈結 #3bce89 + 藍色左粗條 H2 + 柔灰提示框) -->
          <div class="post-content" id="articleBody" set:html={item.content}></div>

          <!-- 底部作者專欄卡片 (Side Author Box) -->
          <div class="side-author-box post-footer-author">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="100" height="100" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長專欄</span></h2>
            <p class="history">全端開發 · 巨型架構 · 系統資安</p>
            <p class="author-bio">
              專注於現代 Web 架構設計、高效能前端、系統資安滲透稽核與邊緣雲端部署。如果這篇文章對你有啟發，歡迎留言討論！
            </p>
          </div>

          <!-- 上一篇 / 下一篇導航 (prev-next-article) -->
          <div class="prev-next-article">
            {prevPost ? (
              <a href={`/blog/${prevPost.slug}/`} class="pn-item prev">
                <span class="pn-dir">« 上一篇文章</span>
                <span class="pn-text">{prevPost.title}</span>
              </a>
            ) : <div class="pn-empty"></div>}

            {nextPost ? (
              <a href={`/blog/${nextPost.slug}/`} class="pn-item next">
                <span class="pn-dir">下一篇文章 »</span>
                <span class="pn-text">{nextPost.title}</span>
              </a>
            ) : <div class="pn-empty"></div>}
          </div>

          <!-- 💬 留言與迴響專區 (#comments & #respond - 純淨真實無假留言) -->
          <div class="comments-area" id="comments">
            <div class="comments-head-row">
              <h3 class="comments-heading">
                讀者迴響 <span class="comments-count" id="commentCountBadge">(0)</span>
              </h3>
            </div>

            <!-- 動態真實留言清單 (預設無假留言，發表後即時儲存於本機) -->
            <div class="commentlist" id="commentList">
              <div class="no-comment-wrap" id="noCommentNotice">
                <p class="no-comment-text">目前尚無迴響，歡迎留下你的想法與心得！</p>
              </div>
            </div>

            <!-- 發表留言表單 (#respond) -->
            <div class="comment-respond" id="respond">
              <h3 class="reply-title">留下迴響</h3>
              <p class="comment-notes">電子郵件地址不會被公開。必填欄位標記為 <span class="required">*</span></p>

              <form id="commentForm" class="comment-form">
                <div class="form-row-inputs">
                  <div class="input-col">
                    <label for="authorName">稱呼 <span class="required">*</span></label>
                    <input id="authorName" type="text" class="input-style" placeholder="暱稱" required />
                  </div>
                  <div class="input-col">
                    <label for="authorEmail">電子郵件 <span class="required">*</span></label>
                    <input id="authorEmail" type="email" class="input-style" placeholder="電子信箱 (不公開)" required />
                  </div>
                </div>

                <div class="input-col textarea-col">
                  <label for="commentContent">留言內容 <span class="required">*</span></label>
                  <textarea id="commentContent" rows="4" class="input-style" placeholder="寫下你的留言或問題…" required></textarea>
                </div>

                <div class="submit-col">
                  <button type="submit" class="btn-submit-comment">發表留言</button>
                  <span id="feedbackMsg" class="feedback-msg" style="display:none;"></span>
                </div>
              </form>
            </div>
          </div>
        </article>
      </main>

      <!-- 📌 右側側邊欄 (28% 寬度) -->
      <aside class="right sidebar-right">
        <!-- 站長專欄 -->
        <div class="side-author-box">
          <div class="photo">
            <img src="/sheep-hd.png" alt="OviNas" width="120" height="120" />
          </div>
          <h2>OviNas <span class="eng-name">/ 站長</span></h2>
          <p class="history">全端開發 · 巨型架構 · 系統資安</p>
          <div class="side-btn-wrap">
            <a href="/vip/" class="btn-vip">加入 VIP 專區</a>
          </div>
        </div>

        <!-- 熱門排行側欄 (#popular-side: 75px 正方形微縮圖) -->
        <div class="popular-posts" id="popular-side">
          <h3 class="popular-title">熱門推薦文章</h3>
          <ul class="wpp-list">
            {posts.slice(0, 5).map((p, idx) => (
              <li class="wpp-item">
                <a href={`/blog/${p.slug}/`} class="wpp-thumb-link">
                  <div class="wpp-thumbnail-box">
                    <span class={`wpp-rank-badge rank-${idx + 1}`}>{idx + 1}</span>
                    <span class="wpp-thumb-symbol">#0{idx + 1}</span>
                  </div>
                </a>
                <div class="wpp-details">
                  <a href={`/blog/${p.slug}/`} class="wpp-post-title">
                    {p.title}
                  </a>
                  <span class="wpp-meta">{p.date}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BlogLayout>

