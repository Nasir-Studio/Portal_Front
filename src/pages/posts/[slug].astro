---
import BlogLayout from '../../layouts/BlogLayout.astro';
import posts from '../../data/posts';

export function getStaticPaths() {
  return posts.map((item, index) => {
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;
    const relatedPosts = posts.filter(p => p.slug !== item.slug).slice(0, 3);
    return {
      params: { slug: item.slug },
      props: { item, prevPost, nextPost, relatedPosts },
    };
  });
}

const { item, prevPost, nextPost, relatedPosts } = Astro.props;

function getCategoryInfo(slug: string) {
  if (slug.includes('security') || slug.includes('audit')) return { name: '系統資安', parent: '資訊安全' };
  if (slug.includes('architecture') || slug.includes('pwa')) return { name: '架構伺服器', parent: '技術架構' };
  if (slug.includes('design') || slug.includes('front-end')) return { name: '前端設計', parent: '前端工程' };
  if (slug.includes('tool') || slug.includes('proxy') || slug.includes('github')) return { name: '外掛工具', parent: '開源工具' };
  if (slug.includes('ntub') || slug.includes('exam')) return { name: '專案實戰', parent: '校園專案' };
  return { name: 'WordPress教學', parent: '架站日誌' };
}

const cat = getCategoryInfo(item.slug);
---

<BlogLayout title={`${item.title} ｜ OviNas`} description={item.excerpt}>
  <div class="main-content forsingle">
    <div class="container single-page-area">
      <!-- 📖 左側主文章區域 (68% 寬度，右側 1px 分隔線) -->
      <main class="left">
        <!-- 經典麵包屑導航 (Breadcrumbs) -->
        <div class="breadcrumbs">
          <a href="/blog/" class="home">首頁</a>
          <span class="sep">&gt;</span>
          <a href="/blog/posts/" class="taxonomy-cat">{cat.parent}</a>
          <span class="sep">&gt;</span>
          <a href="/blog/posts/" class="taxonomy-subcat">{cat.name}</a>
          <span class="sep">&gt;</span>
          <span class="current-post-name">{item.title}</span>
        </div>

        <article>
          <!-- 文章大標題 (h1) -->
          <h1 class="single-post-h1">{item.title}</h1>

          <!-- 文章 Meta 資訊欄 (.post-meta) -->
          <div class="post-meta">
            <div class="post-author">
              By <a href="/blog/">OviNas 站長</a>
            </div>
            <div class="post-date">
              {item.date}
            </div>
            <div class="post-date-modified">
              最後更新：{item.date}
            </div>
            <div class="meta-divider">|</div>
            <ul class="post-categories">
              <li><a href="/blog/posts/">{cat.name}</a></li>
            </ul>
          </div>

          <!-- 經典 16:9 文青照片大圖展示 (.img-wrap + .bgs1~.bgs5) -->
          <div class="img-wrap single-hero-img-wrap">
            <div class="bgs bgs1"></div>
            <div class="bgs bgs2"></div>
            <div class="bgs bgs3"></div>
            <div class="bgs bgs4"></div>
            <div class="bgs bgs5 single-cover-box">
              <img src={`/banners/${item.slug}.jpg`} alt={item.title} class="single-cover-photo" />
            </div>
          </div>

          <!-- 📑 內容索引目錄 (Table of Contents - Classic #toc_container) -->
          <div id="toc_container" class="no_bullets toc_numbered toc_title_center">
            <p class="toc_title">內容索引</p>
            <ul class="toc_list" id="tocList">
              <!-- JS 動態生成 -->
            </ul>
          </div>

          <!-- 文章內文排版 (綠色鏈結 #3bce89 + 橘色左粗條 H2 + 柔灰提示框 + 表格) -->
          <div class="post-content" id="articleBody" set:html={item.content}></div>

          <!-- 底部作者專欄卡片 (Side Author Box) -->
          <div class="side-author-box post-footer-author">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長專欄</span></h2>
            <p class="history">網站架設 · 系統資安 · 筆記小分享</p>
            <div class="author-bio">
              <p>
                從小對資訊抱有熱忱，從 Google 查詢時代轉向 AI 世代，面對學習與獲取資訊方式的改變，我始終一直持續 Update 我的資訊專業能力。時代轉變，像是 DOS 轉變成 Windows 一樣，很多東西懂需要重新學，這個資訊爆炸的世代，我不僅具備傳統電腦維修與程式設計能力，更擅長利用資訊解決企業的【痛點】。
              </p>
              <p>
                許多企業目前仍以人工方式處理專業技術工作，而我喜歡發揮想像力，將流程與資訊系統整合，讓原本緩慢的效率獲得大幅提升！
              </p>
            </div>
          </div>

                    <!-- ✉️ 每一篇文章底部的 Google Form 聯絡表單 (正式 entry 串接) -->
          <div class="article-contact-section">
            <h3 class="article-contact-title">聯絡站長 / 技術交流</h3>
            <p class="article-contact-desc">
              有任何架構疑問、系統資安諮詢或合作交流想法？歡迎填寫下方表單直接與我聯繫！
            </p>
            <form class="article-contact-form" id="articleContactForm">
              <div class="form-row-2">
                <div class="form-field">
                  <label for="acName">姓名 / 稱呼 *</label>
                  <input
                    type="text"
                    id="acName"
                    name="entry.57084769"
                    placeholder="您的姓名或暱稱"
                    required
                    class="form-input"
                  />
                </div>
                <div class="form-field">
                  <label for="acEmail">電子郵件 *</label>
                  <input
                    type="email"
                    id="acEmail"
                    name="entry.135399445"
                    placeholder="your-email@example.com"
                    required
                    class="form-input"
                  />
                </div>
              </div>
              <div class="form-field">
                <label for="acMsg">聯絡內容 / 諮詢訊息 *</label>
                <textarea
                  id="acMsg"
                  name="entry.1753446536"
                  placeholder="請輸入您想詢問或交流的內容…"
                  rows="3"
                  required
                  class="form-input form-textarea"
                ></textarea>
              </div>
              <div class="form-submit-row">
                <button type="submit" id="acSubmitBtn" class="btn-article-submit">送出訊息</button>
                <span id="acStatus" class="article-form-status"></span>
              </div>
            </form>
          </div>

          <!-- 上一篇 / 下一篇導航 (prev-next-article) -->
          <div class="prev-next-article">
            {prevPost ? (
              <a href={`/blog/posts/${prevPost.slug}/`} class="pn-item prev">
                <span class="pn-dir">« 上一篇文章</span>
                <span class="pn-text">{prevPost.title}</span>
              </a>
            ) : <div class="pn-empty"></div>}

            {nextPost ? (
              <a href={`/blog/posts/${nextPost.slug}/`} class="pn-item next">
                <span class="pn-dir">下一篇文章 »</span>
                <span class="pn-text">{nextPost.title}</span>
              </a>
            ) : <div class="pn-empty"></div>}
          </div>
        </article>
      </main>

      <!-- 📌 右側側邊欄 (28% 寬度) -->
      <aside class="right sidebar-right">
        <!-- 站長專欄 -->
        <div class="side-author-box">
          <div class="photo">
            <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
          </div>
          <h2>OviNas <span class="eng-name">/ 站長</span></h2>
          <p class="history">網站架設 · 系統資安 · 筆記小分享</p>
          <div class="side-btn-wrap">
            <a href="#" class="btn-vip">更多</a>
          </div>
        </div>

        <!-- 熱門排行側欄 (#popular-side: 75px 1:1 正方形文青照片微縮圖) -->
        <div class="popular-posts" id="popular-side">
          <h3 class="popular-title">熱門推薦文章</h3>
          <ul class="wpp-list">
            {posts.slice(0, 5).map((p, idx) => (
              <li class="wpp-item">
                <a href={`/blog/posts/${p.slug}/`} class="wpp-thumb-link">
                  <div class="wpp-thumbnail-box">
                    <img src={`/banners/${p.slug}.jpg`} alt={p.title} class="wpp-thumb-img" />
                  </div>
                </a>
                <div class="wpp-details">
                  <a href={`/blog/posts/${p.slug}/`} class="wpp-post-title">
                    {p.title}
                  </a>
                  <span class="wpp-meta">{p.date}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BlogLayout>

