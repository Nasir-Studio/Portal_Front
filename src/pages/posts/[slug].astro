<script>
  // 1. 自動解析內文 H2 生成 Table of Contents
  const articleBody = document.getElementById('articleBody');
  const tocList = document.getElementById('tocList');

  if (articleBody && tocList) {
    const headings = articleBody.querySelectorAll('h2');
    headings.forEach((h, idx) => {
      const id = `section-${idx + 1}`;
      h.id = id;

      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = `${idx + 1}. ${h.textContent}`;
      li.appendChild(a);
      tocList.appendChild(li);
    });

    if (headings.length === 0) {
      document.getElementById('toc_container')?.remove();
    }
  }

  // 2. 互動式留言板邏輯 (Interactive Comment System)
  const commentForm = document.getElementById('commentForm') as HTMLFormElement;
  const commentList = document.getElementById('commentList');
  const feedback = document.getElementById('commentFeedback');
  const countBadge = document.getElementById('commentCountBadge');
  const metaCount = document.getElementById('metaCommentCount');

  // 回覆功能
  document.querySelectorAll('.btn-reply-action').forEach(btn => {
    btn.addEventListener('click', () => {
      const replyTo = btn.getAttribute('data-reply-to');
      const textarea = document.getElementById('commentContent') as HTMLTextAreaElement;
      if (textarea && replyTo) {
        textarea.value = `@${replyTo} `;
        textarea.focus();
        document.getElementById('respond')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // 提交留言
  if (commentForm && commentList) {
    commentForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const author = (document.getElementById('authorName') as HTMLInputElement).value.trim();
      const content = (document.getElementById('commentContent') as HTMLTextAreaElement).value.trim();

      if (!author || !content) return;

      const newComment = document.createElement('div');
      newComment.className = 'comment-body';
      newComment.innerHTML = `
        <div class="comment-avatar-wrap">
          <div class="default-avatar">${author.charAt(0).toUpperCase()}</div>
        </div>
        <div class="comment-main-content">
          <div class="comment-meta-bar">
            <span class="comment-author-name">${author}</span>
            <span class="comment-user-badge">訪客</span>
            <span class="comment-time">剛剛</span>
          </div>
          <div class="comment-text">${content}</div>
        </div>
      `;

      commentList.appendChild(newComment);

      // 清空文字框並提示
      (document.getElementById('commentContent') as HTMLTextAreaElement).value = '';
      if (feedback) {
        feedback.textContent = '✓ 留言發表成功！謝謝您的分享與迴響。';
        feedback.style.display = 'inline-block';
        setTimeout(() => { feedback.style.display = 'none'; }, 4000);
      }

      // 更新留言篇數
      const total = commentList.querySelectorAll('.comment-body').length;
      if (countBadge) countBadge.textContent = `(${total} 則)`;
      if (metaCount) metaCount.textContent = `${total} 則迴響`;

      newComment.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>
