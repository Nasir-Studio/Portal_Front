---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="問題專區 — OviNas">
  <div class="container" id="page-shell" hidden>
    <h1 class="page-title">問題專區</h1>
    <p class="page-sub">提出問題或回報狀況，我們會儘快回覆</p>

    <div class="view-list" id="view-list">
      <div class="view-head">
        <span class="view-head-title" id="view-head-title">我的工單</span>
        <div class="view-head-actions">
          <button class="btn btn--sm" id="new-ticket-btn" type="button">開新工單</button>
        </div>
      </div>

      <div class="new-ticket-wrap" id="new-ticket-wrap" hidden>
        <form class="new-ticket-form" id="new-ticket-form">
          <label class="field">
            <span class="field-label">主旨</span>
            <input id="nt-subject" type="text" name="subject" maxlength="120" required />
          </label>
          <label class="field">
            <span class="field-label">內容</span>
            <textarea id="nt-body" name="body" rows="5" maxlength="4000" required></textarea>
          </label>
          <div class="upload-row">
            <label class="upload-label" for="nt-files">
              選擇圖片（最多 10 張）
              <input id="nt-files" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
            </label>
            <span class="upload-msg" id="nt-files-msg"></span>
          </div>
          <p class="form-msg err" id="nt-msg" hidden></p>
          <div class="book-actions">
            <button class="btn" type="submit">送出</button>
            <button class="btn btn--ghost" id="nt-cancel" type="button">取消</button>
          </div>
        </form>
      </div>

      <div class="ticket-list" id="ticket-list">
        <p class="slot-empty">載入中…</p>
      </div>
    </div>

    <div class="view-detail" id="view-detail" hidden>
      <a class="back-link" href="/tickets/" id="back-link">← 返回工單列表</a>
      <div class="detail-card" id="detail-card">
        <p class="slot-empty">載入中…</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .page-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    padding: 3rem 0 0.4rem;
  }

  .page-sub {
    margin-bottom: 1.6rem;
    font-size: 0.9rem;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }

  .view-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .view-head-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .view-head-actions {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .btn--sm {
    padding: 0.55rem 1.1rem;
    font-size: 0.88rem;
  }

  .btn--ghost {
    background: var(--surface);
    color: var(--ink);
  }

  .btn--ghost:hover {
    background: var(--bg-soft);
    color: var(--ink);
    border-color: var(--ink);
  }

  .new-ticket-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--ink);
    margin-bottom: 1.2rem;
    animation: module-in 0.3s var(--ease) both;
  }

  .new-ticket-form {
    padding: 1.2rem 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-label {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }

  .new-ticket-form input,
  .new-ticket-form textarea {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 0;
    color: var(--ink);
    resize: vertical;
  }

  .new-ticket-form input:focus,
  .new-ticket-form textarea:focus {
    outline: 2px solid var(--ink);
    outline-offset: 0;
    border-color: var(--ink);
  }

  .book-actions {
    display: flex;
    gap: 0.7rem;
    align-items: center;
  }

  .form-msg {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .form-msg.err {
    color: #a33;
  }

  .ticket-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .slot-empty {
    color: var(--ink-3);
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    text-align: center;
    padding: 1.6rem 0;
  }

  .ticket-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: border-color var(--t), box-shadow var(--t);
  }

  .ticket-row:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-soft);
  }

  .ticket-row-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .ticket-row-subject {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .ticket-row-meta {
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .status-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid;
    white-space: nowrap;
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .status-open {
    color: #4a6d8c;
    border-color: #b8c9d8;
    background: #eef3f7;
  }

  .status-replied {
    color: #3f6e4f;
    border-color: #bfd3c5;
    background: #eef5f0;
  }

  .status-closed {
    color: #8b8983;
    border-color: #d8d7d2;
    background: #f1f0ee;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: var(--ink-2);
    letter-spacing: 0.06em;
    transition: color var(--t);
  }

  .back-link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .detail-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--ink);
    margin-bottom: 1.4rem;
  }

  .detail-head {
    padding: 1.2rem 1.3rem 1rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1rem;
    flex-wrap: wrap;
  }

  .detail-subject {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .detail-meta {
    font-size: 0.8rem;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .detail-body {
    padding: 1.1rem 1.3rem;
    font-size: 0.95rem;
    color: var(--ink);
    white-space: pre-wrap;
    line-height: 1.9;
  }

  .detail-images {
    padding: 0 1.3rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .detail-images img {
    max-width: 100%;
    max-height: 220px;
    object-fit: cover;
    border: 1px solid var(--border);
    cursor: zoom-in;
  }

  .reply-list {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding: 0.6rem 0;
  }

  .reply-item {
    padding: 0.9rem 1.3rem;
  }

  .reply-item + .reply-item {
    border-top: 1px solid var(--border);
  }

  .reply-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .reply-author {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .reply-author.admin {
    color: #4a6d8c;
  }

  .reply-time {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .reply-body {
    font-size: 0.93rem;
    white-space: pre-wrap;
    line-height: 1.85;
  }

  .detail-actions {
    padding: 1.1rem 1.3rem 1.3rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .reply-form {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .reply-form textarea {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 0;
    color: var(--ink);
    resize: vertical;
    min-height: 72px;
  }

  .reply-form textarea:focus {
    outline: 2px solid var(--ink);
    outline-offset: 0;
    border-color: var(--ink);
  }

  .upload-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .upload-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--border-strong);
    border-radius: 0;
    cursor: pointer;
    user-select: none;
    transition: background var(--t), border-color var(--t);
  }

  .upload-label:hover {
    background: var(--bg-soft);
    border-color: var(--ink);
  }

  .upload-label input[type='file'] {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .upload-msg {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .upload-msg.err {
    color: #a33;
  }
</style>

<script>
  import { api, ApiError } from '../../scripts/api';
  import { currentUser, requireAuth } from '../../scripts/auth';
  import { connectTicketSocket } from '../../scripts/ticket-socket';

  // 未登入立即跳走，不顯示任何頁面內容
  requireAuth('/tickets/');
  const shell = document.getElementById('page-shell');
  if (shell) shell.hidden = false;

  type TicketSummary = {
    id: number;
    subject: string;
    status: 'open' | 'replied' | 'closed';
    createdAt: number;
  };

  type Reply = {
    id: number;
    authorRole: 'admin' | 'member';
    authorId: number | null;
    body: string;
    createdAt: number;
  };

  type TicketImage = {
    id: number;
    url: string;
    createdAt: number;
  };

  type TicketDetail = {
    id: number;
    subject: string;
    body: string;
    status: 'open' | 'replied' | 'closed';
    createdAt: number;
    replies: Reply[];
    images: TicketImage[];
  };

  const TZ = 'Asia/Taipei';
  const user = currentUser();

  const viewList = document.querySelector('#view-list');
  const viewDetail = document.querySelector('#view-detail');
  const ticketList = document.querySelector('#ticket-list');
  const detailCard = document.querySelector('#detail-card');
  const newTicketWrap = document.querySelector('#new-ticket-wrap');
  const newTicketBtn = document.querySelector('#new-ticket-btn');

  let currentTicketId: number | null = null;
  let viewName: 'list' | 'detail' = 'list';

  const STATUS_LABEL: Record<TicketSummary['status'], string> = {
    open: '待處理',
    replied: '已回覆',
    closed: '已關閉',
  };

  function fmtDate(ts: number): string {
    return new Intl.DateTimeFormat('zh-TW', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).format(ts * 1000);
  }

  function badge(status: TicketSummary['status']): HTMLSpanElement {
    const el = document.createElement('span');
    el.className = `status-badge status-${status}`;
    el.textContent = STATUS_LABEL[status];
    return el;
  }

  // requireLogin 已由 requireAuth() 在 script 頂部統一處理

  function showView(name: 'list' | 'detail'): void {
    viewName = name;
    if (viewList !== null) viewList.hidden = name !== 'list';
    if (viewDetail !== null) viewDetail.hidden = name !== 'detail';
    window.scrollTo({ top: 0, behavior: 'instant' });
  }

  async function loadList(): Promise<void> {
    if (user === null || ticketList === null) return;
    const hasContent = ticketList.querySelector('.ticket-row') !== null;
    if (!hasContent) ticketList.innerHTML = '<p class="slot-empty">載入中…</p>';
    try {
      const data = await api<{ tickets: TicketSummary[] }>('/tickets', { auth: true });
      renderList(data.tickets);
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) {
        window.location.href = '/login/';
        return;
      }
      if (!hasContent) ticketList.innerHTML = '<p class="slot-empty">無法載入工單，請稍後再試</p>';
    }
  }

  function renderList(tickets: TicketSummary[]): void {
    if (ticketList === null) return;
    if (tickets.length === 0) {
      ticketList.innerHTML = '<p class="slot-empty">尚無工單，點「開新工單」開始</p>';
      return;
    }
    ticketList.replaceChildren(
      ...tickets.map((t) => {
        const row = document.createElement('article');
        row.className = 'ticket-row';
        row.tabIndex = 0;
        row.setAttribute('role', 'button');
        row.addEventListener('click', () => openDetail(t.id));
        row.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') openDetail(t.id);
        });

        const info = document.createElement('div');
        info.className = 'ticket-row-info';
        const subject = document.createElement('span');
        subject.className = 'ticket-row-subject';
        subject.textContent = t.subject;
        const meta = document.createElement('span');
        meta.className = 'ticket-row-meta';
        meta.textContent = `#${t.id} · ${fmtDate(t.createdAt)}`;
        info.append(subject, meta);

        row.append(info, badge(t.status));
        return row;
      }),
    );
  }

  async function openDetail(id: number, updateHistory = true): Promise<void> {
    currentTicketId = id;
    showView('detail');
    if (detailCard === null) return;
    const hasContent = detailCard.querySelector('.detail-subject') !== null;
    if (!hasContent) detailCard.innerHTML = '<p class="slot-empty">載入中…</p>';
    if (updateHistory) window.history.pushState({}, '', `/tickets/?id=${id}`);
    try {
      const data = await api<{ ticket: TicketDetail }>(`/tickets/${id}`, { auth: true });
      renderDetail(data.ticket);
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) {
        window.location.href = '/login/';
        return;
      }
      if (!hasContent) detailCard.innerHTML = '<p class="slot-empty">無法載入工單</p>';
    }
  }

  function renderDetail(ticket: TicketDetail): void {
    if (detailCard === null) return;

    const head = document.createElement('div');
    head.className = 'detail-head';
    const subject = document.createElement('h2');
    subject.className = 'detail-subject';
    subject.textContent = ticket.subject;
    const meta = document.createElement('span');
    meta.className = 'detail-meta';
    meta.textContent = `#${ticket.id} · ${fmtDate(ticket.createdAt)}`;
    head.append(subject, badge(ticket.status), meta);

    const body = document.createElement('p');
    body.className = 'detail-body';
    body.textContent = ticket.body;

    const images = document.createElement('div');
    images.className = 'detail-images';
    for (const img of ticket.images) {
      const el = document.createElement('img');
      el.alt = `附件 ${img.id}`;
      el.src = img.url;
      el.addEventListener('click', () => window.open(img.url, '_blank'));
      images.append(el);
    }

    const replies = document.createElement('div');
    replies.className = 'reply-list';
    if (ticket.replies.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'slot-empty';
      empty.textContent = '尚無回覆';
      replies.append(empty);
    } else {
      for (const r of ticket.replies) {
        const item = document.createElement('div');
        item.className = 'reply-item';
        const rHead = document.createElement('div');
        rHead.className = 'reply-head';
        const author = document.createElement('span');
        author.className = `reply-author${r.authorRole === 'admin' ? ' admin' : ''}`;
        author.textContent =
          r.authorRole === 'admin' ? '管理員' : user !== null && r.authorId === user.id ? '我' : '會員';
        const time = document.createElement('span');
        time.className = 'reply-time';
        time.textContent = fmtDate(r.createdAt);
        rHead.append(author, time);
        const rBody = document.createElement('p');
        rBody.className = 'reply-body';
        rBody.textContent = r.body;
        item.append(rHead, rBody);
        replies.append(item);
      }
    }

    const actions = document.createElement('div');
    actions.className = 'detail-actions';

    
    const replyForm = document.createElement('form');
    replyForm.className = 'reply-form';
    const replyTextarea = document.createElement('textarea');
    replyTextarea.placeholder = '輸入回覆內容…';
    replyTextarea.rows = 3;
    const replyActions = document.createElement('div');
    replyActions.className = 'book-actions';
    const replySubmit = document.createElement('button');
    replySubmit.type = 'submit';
    replySubmit.className = 'btn';
    replySubmit.textContent = '送出回覆';
    const replyMsg = document.createElement('span');
    replyMsg.className = 'form-msg';
    replyActions.append(replySubmit, replyMsg);
    replyForm.append(replyTextarea, replyActions);
    replyForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const text = replyTextarea.value.trim();
      if (text.length === 0) return;
      replySubmit.disabled = true;
      replyMsg.textContent = '';
      try {
        await api<{ reply: { id: number } }>(`/tickets/${ticket.id}/replies`, {
          method: 'POST',
          body: { body: text },
          auth: true,
        });
        await openDetail(ticket.id);
      } catch {
        replyMsg.textContent = '送出失敗，請稍後再試';
        replyMsg.className = 'form-msg err';
        replySubmit.disabled = false;
      }
    });
    actions.append(replyForm);

    
    const uploadRow = document.createElement('div');
    uploadRow.className = 'upload-row';
    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.multiple = true;
    fileInput.accept = 'image/jpeg,image/png,image/webp,image/gif';
    fileInput.id = `upload-${ticket.id}`;
    const uploadLabel = document.createElement('label');
    uploadLabel.className = 'upload-label';
    uploadLabel.htmlFor = fileInput.id;
    uploadLabel.textContent = '＋ 附加圖片';
    uploadLabel.append(fileInput);
    const uploadMsg = document.createElement('span');
    uploadMsg.className = 'upload-msg';
    fileInput.addEventListener('change', async () => {
      const files = Array.from(fileInput.files ?? []);
      fileInput.value = '';
      if (files.length === 0) return;
      if (files.length > 10) {
        uploadMsg.textContent = '一次最多上傳 10 張圖片';
        uploadMsg.className = 'upload-msg err';
        return;
      }
      for (const f of files) {
        if (f.size > 10 * 1024 * 1024) {
          uploadMsg.textContent = '每張圖片需小於 10MB';
          uploadMsg.className = 'upload-msg err';
          return;
        }
      }
      uploadMsg.textContent = `上傳中（${files.length} 張）…`;
      uploadMsg.className = 'upload-msg';
      const formData = new FormData();
      for (const f of files) formData.append('file', f);
      try {
        await api<{ images: { id: number; url: string }[] }>(`/tickets/${ticket.id}/images`, {
          method: 'POST',
          formData,
          auth: true,
        });
        await openDetail(ticket.id);
      } catch (err) {
        if (err instanceof ApiError) {
          if (err.code === 'unsupported_image_type') uploadMsg.textContent = '僅支援 JPEG / PNG / WebP / GIF';
          else if (err.code === 'image_too_large') uploadMsg.textContent = '每張圖片需小於 10MB';
          else if (err.code === 'too_many_files') uploadMsg.textContent = '一次最多上傳 10 張圖片';
          else uploadMsg.textContent = '上傳失敗，請稍後再試';
        } else {
          uploadMsg.textContent = '上傳失敗';
        }
        uploadMsg.className = 'upload-msg err';
      }
    });
    uploadRow.append(uploadLabel, uploadMsg);
    actions.append(uploadRow);

    detailCard.replaceChildren(head, body, images, replies, actions);
  }

  
  newTicketBtn?.addEventListener('click', () => {
    if (newTicketWrap === null) return;
    newTicketWrap.hidden = !newTicketWrap.hidden;
  });

  document.querySelector('#nt-cancel')?.addEventListener('click', () => {
    if (newTicketWrap !== null) newTicketWrap.hidden = true;
  });

  document.querySelector('#new-ticket-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const subjectInput = document.querySelector('#nt-subject') as HTMLInputElement;
    const bodyInput = document.querySelector('#nt-body') as HTMLTextAreaElement;
    const msg = document.querySelector('#nt-msg') as HTMLParagraphElement;
    const submitBtn = event.submitter as HTMLButtonElement;
    const subject = subjectInput.value.trim();
    const body = bodyInput.value.trim();
    if (subject.length === 0 || body.length === 0) {
      msg.textContent = '請填寫主旨與內容';
      msg.hidden = false;
      return;
    }
    submitBtn.disabled = true;
    msg.hidden = true;
    const filesInput = document.querySelector('#nt-files') as HTMLInputElement | null;
    const filesMsg = document.querySelector('#nt-files-msg') as HTMLSpanElement | null;
    const files = filesInput !== null ? Array.from(filesInput.files ?? []) : [];
    if (files.length > 10) {
      msg.textContent = '一次最多上傳 10 張圖片';
      msg.hidden = false;
      submitBtn.disabled = false;
      return;
    }
    for (const f of files) {
      if (f.size > 10 * 1024 * 1024) {
        msg.textContent = '每張圖片需小於 10MB';
        msg.hidden = false;
        submitBtn.disabled = false;
        return;
      }
    }
    try {
      const data = await api<{ ticket: { id: number } }>('/tickets', {
        method: 'POST',
        body: { subject, body },
        auth: true,
      });
      if (files.length > 0) {
        if (filesMsg !== null) filesMsg.textContent = `上傳圖片（${files.length} 張）…`;
        const formData = new FormData();
        for (const f of files) formData.append('file', f);
        try {
          await api<{ images: { id: number; url: string }[] }>(`/tickets/${data.ticket.id}/images`, {
            method: 'POST',
            formData,
            auth: true,
          });
        } catch (uploadErr) {
          if (filesMsg !== null) {
            filesMsg.textContent =
              uploadErr instanceof ApiError && uploadErr.code === 'unsupported_image_type'
                ? '僅支援 JPEG / PNG / WebP / GIF'
                : '圖片上傳失敗，工單已建立';
            filesMsg.className = 'upload-msg err';
          }
        }
      }
      if (newTicketWrap !== null) newTicketWrap.hidden = true;
      await openDetail(data.ticket.id);
    } catch (err) {
      msg.textContent = err instanceof ApiError ? err.message : '送出失敗';
      msg.hidden = false;
      submitBtn.disabled = false;
    }
  });

  
  window.addEventListener('popstate', () => {
    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    if (id !== null) {
      const n = Number(id);
      if (Number.isInteger(n) && n > 0) void openDetail(n);
    } else {
      currentTicketId = null;
      showView('list');
      void loadList();
    }
  });

  
  const params = new URLSearchParams(window.location.search);
  const id = params.get('id');
  // user 一定存在（requireAuth() 在頂部已保證）
  if (id !== null && Number.isInteger(Number(id)) && Number(id) > 0) {
    void openDetail(Number(id));
  } else {
    showView('list');
    void loadList();
  }

  
  
  if (user !== null) {
    let refreshTimer: ReturnType<typeof setTimeout> | null = null;
    const refreshView = (): void => {
      if (refreshTimer !== null) clearTimeout(refreshTimer);
      refreshTimer = setTimeout(() => {
        refreshTimer = null;
        if (viewName === 'list') {
          void loadList();
        } else if (viewName === 'detail' && currentTicketId !== null) {
          void openDetail(currentTicketId, false);
        }
      }, 400);
    };
    connectTicketSocket((event) => {
      if (event.event === 'deleted') {
        if (viewName === 'detail' && currentTicketId === event.ticketId) {
          currentTicketId = null;
          showView('list');
          void loadList();
        } else if (viewName === 'list') {
          refreshView();
        }
        return;
      }
      if (viewName === 'detail' && currentTicketId === event.ticketId) {
        refreshView();
      } else if (viewName === 'list') {
        refreshView();
      }
    });
  }
</script>
