---
import quotes from '../../data/quotes';
import badges from '../../data/badges';
import BlogLayout from '../../layouts/BlogLayout.astro';
import announcements from '../../data/announcements';
import posts from '../../data/posts';

const today = new Date();
const seed = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
const dailyQuote = quotes[seed % quotes.length];

export function getStaticPaths() {
  return announcements.map((item, index) => {
    const prevPost = index > 0 ? announcements[index - 1] : null;
    const nextPost = index < announcements.length - 1 ? announcements[index + 1] : null;
    return {
      params: { slug: item.slug },
      props: { item, prevPost, nextPost },
    };
  });
}

const { item, prevPost, nextPost } = Astro.props;
---
<BlogLayout title={`${item.title} ｜ OviNas`} description={item.summary || "OviNas 站務公告與創站日記隨筆"}>
  <div class="main-content forsingle">
    <div class="container single-page-area">
      <!-- 📖 左側主文章區域 (68% 寬度，右側 1px 分隔線) -->
      <main class="left">
        <!-- 經典麵包屑導航 (Breadcrumbs) -->
        <div class="breadcrumbs">
          <a href="/" class="home">首頁</a>
          <span class="sep">&gt;</span>
          <a href="/#news" class="taxonomy-cat">站務消息</a>
          <span class="sep">&gt;</span>
          <a href="/#news" class="taxonomy-subcat">公告隨筆</a>
          <span class="sep">&gt;</span>
          <span class="current-post-name">{item.title}</span>
        </div>

        <article>
          <!-- 文章大標題 (h1) -->
          <h1 class="single-post-h1">{item.title}</h1>

          <!-- 文章 Meta 資訊欄 (.post-meta) -->
          <div class="post-meta">
            <div class="post-author">
              By <a href="/about/">OviNas 站長</a>
            </div>
            <div class="post-date">
              {item.date}
            </div>
            <div class="post-date-modified">
              最後更新：{item.date}
            </div>
            <div class="meta-divider">|</div>
            <ul class="post-categories">
              <li><a href="/#news">站務公告</a></li>
            </ul>
          </div>

          <!-- 經典 16:9 文青照片大圖展示 (.img-wrap + .bgs1~.bgs5) -->
          <div class="img-wrap single-hero-img-wrap">
            <div class="bgs bgs1"></div>
            <div class="bgs bgs2"></div>
            <div class="bgs bgs3"></div>
            <div class="bgs bgs4"></div>
            <div class="bgs bgs5 single-cover-box">
              <img src="/banners/hero-promo-v3.jpg?v=20260820light" alt={item.title} class="single-cover-photo" />
            </div>
          </div>

          <!-- 📑 內容索引目錄 (Table of Contents - Classic #toc_container) -->
          <div id="toc_container" class="no_bullets toc_numbered toc_title_center">
            <p class="toc_title">內容索引</p>
            <ul class="toc_list" id="tocList">
              <!-- JS 動態生成 -->
            </ul>
          </div>

          <!-- 文章內文排版 -->
          <div class="post-content" id="articleBody">
            <h2 id="section-diary">創站隨筆與大學生活</h2>
            <p>
              決定用這個網站來記錄自己的每一天，像是一本專屬的日記本與技術筆記。
            </p>
            <p>
              也即將要邁入大三了，我覺得大學生活也即將過半了，在大學的這兩年下來，除了一方面是自己搬出來臺北北漂住，然後生存，課業方面，當然有擅長的跟非常不擅長的（像是數學 XD）而日常生活中除了讀書，我也覺得北部很有趣，在大學期間這兩年去了蠻多地方，也體驗蠻多事物，但偶爾也是會思考，我大學到底做了什麼，有沒有把時間效率最大化。
            </p>
            <p>
              這個日記本，我覺得我會把無論是我的小專案、還是我的心情還是我的一些正在學習的東西，放上來，並且督促自己！讓自己越來越進步，不要讓大學生活渾渾噩噩跑掉了！
            </p>

            <h2 id="section-origin">為什麼叫做 OviNas？</h2>
            <p>
              那為什麼叫做 <strong>OviNas</strong> 呢？這個名字的由來：因為我的綽號叫小羊（<strong>Ovis</strong> 是羊的拉丁文），結合我的名字 <strong>Nasir</strong>，組合成 <strong>OviNas</strong> XDXD
            </p>
            <p>
              這個也是 Nasir 我的第一篇開頭！歡迎各位來到我的個人天地與技術筆記本，讓我們一起持續學習與進步！
            </p>
          </div>

          <!-- 底部作者專欄卡片 (Side Author Box) -->
          <div class="side-author-box post-footer-author">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
            </div>
            <h2>Nasir <span class="eng-name">/ OviNas 站長專欄</span></h2>
            <p class="history">網站架設 · 系統資安 · 筆記小分享</p>
            <div class="author-bio">
              <p>
                從小對資訊抱有熱忱，從 Google 查詢時代轉向 AI 世代，面對學習與獲取資訊方式的改變，我始終一直持續 Update 我的資訊專業能力。時代轉變，像是 DOS 轉變成 Windows 一樣，很多東西懂需要重新學，這個資訊爆炸的世代，我不僅具備傳統電腦維修與程式設計能力，更擅長利用資訊解決企業的【痛點】。
              </p>
              <p>
                許多企業目前仍以人工方式處理專業技術工作，而我喜歡發揮想像力，將流程與資訊系統整合，讓原本緩慢的效率獲得大幅提升！
              </p>
            </div>
          </div>

          <!-- ✉️ 文章底部的 Google Form 聯絡表單 -->
          <div class="article-contact-section">
            <h3 class="article-contact-title">聯絡站長 / 技術交流</h3>
            <p class="article-contact-desc">
              有任何架構疑問、系統資安諮詢或合作交流想法？歡迎填寫下方表單直接與我聯繫！
            </p>
            <form class="article-contact-form" id="articleContactForm">
              <div class="form-row-2">
                <div class="form-field">
                  <label for="acName">姓名 / 稱呼 *</label>
                  <input
                    type="text"
                    id="acName"
                    name="entry.57084769"
                    placeholder="您的姓名或暱稱"
                    required
                    class="form-input"
                  />
                </div>
                <div class="form-field">
                  <label for="acEmail">電子郵件 *</label>
                  <input
                    type="email"
                    id="acEmail"
                    name="entry.135399445"
                    placeholder="your-email@example.com"
                    required
                    class="form-input"
                  />
                </div>
              </div>
              <div class="form-field">
                <label for="acMsg">聯絡內容 / 諮詢訊息 *</label>
                <textarea
                  id="acMsg"
                  name="entry.1753446536"
                  placeholder="請輸入您想詢問或交流的內容…"
                  rows="3"
                  required
                  class="form-input form-textarea"
                ></textarea>
              </div>
              <div class="form-submit-row">
                <button type="submit" id="acSubmitBtn" class="btn-article-submit">送出訊息</button>
                <span id="acStatus" class="article-form-status"></span>
              </div>
            </form>
          </div>

          <!-- 上一篇 / 下一篇導航 (prev-next-article) -->
          <div class="prev-next-article">
            {prevPost ? (
              <a href={`/news/${prevPost.slug}/`} class="pn-item prev">
                <span class="pn-dir">« 上一篇公告</span>
                <span class="pn-text">{prevPost.title}</span>
              </a>
            ) : (
              <a href="/" class="pn-item prev">
                <span class="pn-dir">« 返回首頁</span>
                <span class="pn-text">OviNas 首頁專欄</span>
              </a>
            )}

            {nextPost ? (
              <a href={`/news/${nextPost.slug}/`} class="pn-item next">
                <span class="pn-dir">下一篇公告 »</span>
                <span class="pn-text">{nextPost.title}</span>
              </a>
            ) : (
              <a href="/posts/tech-notes-architecture/" class="pn-item next">
                <span class="pn-dir">推薦技術專欄 »</span>
                <span class="pn-text">【技術文章】技術筆記本</span>
              </a>
            )}
          </div>
        </article>
      </main>

      <!-- 📌 右側側邊欄 (28% 寬度) -->
      <aside class="right sidebar-right">
        <!-- 站長專欄 -->
        <div class="side-author-box">
          <div class="photo">
            <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
          </div>
          <h2>OviNas <span class="eng-name">/ 站長</span></h2>
          <p class="history">網站架設 · 系統資安 · 筆記小分享</p>
          <div class="side-btn-wrap">
            <a href="/about/" class="btn-vip">更多</a>
          </div>
        </div>

        <!-- 🏅 資格認證 (Badges - 純淨展示，無多餘超連結) -->
        <div class="side-badges-box" style="margin-top: 2rem;">
          <h2 class="side-badges-title">資格認證</h2>
          <ul class="side-badges-list">
            {badges.map((b) => (
              <li class="side-badge-item">
                <div class="side-badge-link" title={b.name}>
                  <img src={b.img} alt={b.name} class="side-badge-img" loading="lazy" />
                  <span class="side-badge-name">{b.name}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- 熱門排行側欄 (#popular-side: 75px 1:1 正方形文青照片微縮圖) -->
        <div class="popular-posts" id="popular-side" style="margin-top: 2rem;">
          <h3 class="side-section-heading">熱門推薦文章</h3>
          <ul class="wpp-list">
            {posts.slice(0, 3).map((p) => (
              <li class="wpp-item">
                <a href={`/posts/${p.slug}/`} class="wpp-thumb-link">
                  <div class="wpp-thumbnail-box">
                    <img src={`/banners/${p.slug}.jpg?v=20260820light`} alt={p.title} class="wpp-thumb-img" />
                  </div>
                </a>
                <div class="wpp-details">
                  <a href={`/posts/${p.slug}/`} class="wpp-post-title">
                    {p.title}
                  </a>
                  <span class="wpp-meta">{p.date}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BlogLayout>

