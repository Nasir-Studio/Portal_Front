---
import BaseLayout from '../../layouts/BaseLayout.astro';
import announcements from '../../data/announcements';

export function getStaticPaths() {
  return announcements.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const number = announcements.findIndex((a) => a.slug === item.slug) + 1;
const backLink = '/#news';
---

<BaseLayout title={`${item.title} ｜ OviNas`}>
  <article class="article container">
    <nav class="article-nav" aria-label="麵包屑">
      <a href="/">首頁</a>
      <span aria-hidden="true">／</span>
      <a href={backLink}>最新消息</a>
    </nav>

    <header class="article-header">
      <h1 class="article-title">{item.title}</h1>
      <p class="article-meta">公告第 {number} 號 / {item.date}</p>
    </header>

    <div class="article-body">
      {item.content.split('\n\n').map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <div class="article-foot">
      <a class="article-back" href={backLink}>← 回最新消息</a>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    background: var(--surface);
    border: 1px solid var(--border);
    margin-top: 2.4rem;
    margin-bottom: 3.5rem;
    padding-bottom: 2.4rem;
  }

  .article-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.6rem;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .article-nav a {
    transition: color var(--t);
  }

  .article-nav a:hover {
    color: var(--ink);
  }

  .article-header {
    padding: 2.2rem 1.6rem 1.3rem;
    border-bottom: 1px dashed var(--border);
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.4;
    margin-bottom: 0.9rem;
  }

  .article-meta {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }

  .article-body {
    padding: 1.7rem 1.6rem;
  }

  .article-body p {
    font-size: 1rem;
    letter-spacing: 0.04em;
    line-height: 2.1;
    color: var(--ink-2);
  }

  .article-foot {
    padding: 1.6rem 1.6rem 0;
  }

  .article-back {
    display: inline-block;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--ink-3);
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border-strong);
    transition: color var(--t), border-color var(--t);
  }

  .article-back:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
</style>
