<script>
  // 🔒 技術文章專用門禁解鎖控制
  const currentSlug = window.location.pathname;
  if (currentSlug.includes('tech-notes-architecture')) {
    const articleBodyEl = document.getElementById('articleBody');
    const tocContainerEl = document.getElementById('toc_container');
    const gateWrapEl = document.getElementById('tech-gate-wrap');

    function applyTechGate() {
      const unlocked = localStorage.getItem('ovinas-tech-unlocked') === '1';
      if (!unlocked) {
        if (articleBodyEl) articleBodyEl.style.display = 'none';
        if (tocContainerEl) tocContainerEl.style.display = 'none';
        if (gateWrapEl) {
          gateWrapEl.style.display = 'block';
          if (window.openTechGate) window.openTechGate();
        }
      } else {
        if (articleBodyEl) articleBodyEl.style.display = 'block';
        if (tocContainerEl) tocContainerEl.style.display = 'block';
        if (gateWrapEl) {
          gateWrapEl.style.display = 'none';
          if (window.closeTechGate) window.closeTechGate();
        }
      }
    }

    applyTechGate();

    window.addEventListener('tech-gate:unlocked', () => {
      applyTechGate();
    });
  }

  const articleBody = document.getElementById('articleBody');
  const tocList = document.getElementById('tocList');

  if (articleBody && tocList) {
    const headings = articleBody.querySelectorAll('h2');
    headings.forEach((h, idx) => {
      const id = `section-${idx + 1}`;
      h.id = id;

      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = `${idx + 1}. ${h.textContent}`;
      li.appendChild(a);
      tocList.appendChild(li);
    });

    if (headings.length === 0) {
      document.getElementById('toc_container')?.remove();
    }
  }

  // ✉️ 文章底部 Google Form 送出邏輯
  const acForm = document.getElementById('articleContactForm') as HTMLFormElement;
  const acSubmitBtn = document.getElementById('acSubmitBtn') as HTMLButtonElement;
  const acStatus = document.getElementById('acStatus');

  const GOOGLE_FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeeWapjagLqPsg7i2y_TYhNq2xKW-nNFj6JywiqiDZ8Hkiheg/formResponse';

  if (acForm) {
    acForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('acName') as HTMLInputElement).value.trim();
      const email = (document.getElementById('acEmail') as HTMLInputElement).value.trim();
      const msg = (document.getElementById('acMsg') as HTMLTextAreaElement).value.trim();

      if (!name || !email || !msg) return;

      if (acSubmitBtn) {
        acSubmitBtn.disabled = true;
        acSubmitBtn.textContent = '傳送中…';
      }

      try {
        const formData = new FormData();
        formData.append('entry.57084769', name);
        formData.append('entry.135399445', email);
        formData.append('entry.1753446536', msg);

        await fetch(GOOGLE_FORM_URL, {
          method: 'POST',
          mode: 'no-cors',
          body: formData,
        });

        if (acStatus) {
          acStatus.textContent = '✓ 訊息已成功送出，感謝您的聯繫！';
          acStatus.className = 'article-form-status is-success';
        }

        acForm.reset();

        setTimeout(() => {
          if (acStatus) acStatus.textContent = '';
        }, 5000);
      } catch (err) {
        if (acStatus) {
          acStatus.textContent = '✕ 傳送失敗，請稍後再試。';
          acStatus.className = 'article-form-status is-error';
        }
      } finally {
        if (acSubmitBtn) {
          acSubmitBtn.disabled = false;
          acSubmitBtn.textContent = '送出訊息';
        }
      }
    });
  }
</script>


