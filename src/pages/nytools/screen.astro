---
import BlogLayout from '../../layouts/BlogLayout.astro';
---

<style is:global>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-3);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .tools-app {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: 0 14px 44px -20px rgba(28, 28, 28, 0.28);
    margin-top: 2.4rem;
    margin-bottom: 3.5rem;
    overflow: hidden;
  }

  .tools-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.6rem;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  .tools-nav a {
    color: var(--ink);
    border-bottom: 1px solid var(--border-strong);
    transition: border-color var(--t), color var(--t);
    text-decoration: none;
  }

  .tools-nav a:hover {
    border-color: var(--ink);
  }

  .tools-nav-sep {
    color: var(--ink-3);
  }

  .tools-nav-current {
    color: var(--ink-3);
  }

  .tools-body {
    padding: 2.2rem 1.8rem;
  }

  .page-header {
    margin-bottom: 2rem;
    animation: fadeIn 0.5s ease-out;
  }

  .page-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    margin-bottom: 1.1rem;
  }

  .page-badge svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-screen {
    background: #f4efff;
    color: #6d46d4;
  }

  .page-header h1 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-serif);
  }

  .page-header p {
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  .features {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
    animation: fadeIn 0.5s ease-out 0.15s both;
  }

  .features h3 {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .features h3::before {
    content: '';
    width: 3px;
    height: 1em;
    background: var(--ink);
    border-radius: 1px;
    flex-shrink: 0;
  }

  .features ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .features li {
    padding: 0.5rem 0;
    font-size: 0.85rem;
    color: var(--ink-3);
    line-height: 1.6;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .features li::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--ink);
    border-radius: 50%;
    margin-top: 0.45rem;
    flex-shrink: 0;
  }

  .how-to-use {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
    animation: fadeIn 0.5s ease-out 0.2s both;
  }

  .how-to-use h3 {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .how-to-use h3::before {
    content: '';
    width: 3px;
    height: 1em;
    background: var(--ink);
    border-radius: 1px;
    flex-shrink: 0;
  }

  .how-to-use ol {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    line-height: 1.8;
  }

  .note {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
    animation: fadeIn 0.5s ease-out 0.25s both;
  }

  .note h3 {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .note h3::before {
    content: '';
    width: 3px;
    height: 1em;
    background: var(--ink);
    border-radius: 1px;
    flex-shrink: 0;
  }

  .note p {
    font-size: 0.85rem;
    color: var(--ink-3);
    line-height: 1.7;
    margin: 0 0 0.5rem 0;
  }

  .note p:last-child {
    margin-bottom: 0;
  }

  .mode-selector {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    animation: fadeIn 0.5s ease-out 0.1s both;
  }

  .mode-btn {
    flex: 1;
    padding: 1.5rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
    font-family: var(--font-sans);
    box-shadow: 0 4px 18px -16px rgba(28, 28, 28, 0.18);
    position: relative;
  }

  .mode-btn:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -18px rgba(28, 28, 28, 0.28);
  }

  .mode-btn.active {
    border-color: var(--ink);
    background: var(--bg-soft);
  }

  .mode-btn.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--ink);
    border-radius: 2px 2px 0 0;
  }

  .mode-btn h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    margin: 0 0 0.3rem 0;
  }

  .mode-btn p {
    font-size: 0.8rem;
    color: var(--ink-3);
    margin: 0;
  }

  .screen-area {
    display: none;
    animation: fadeIn 0.4s ease-out;
  }

  .screen-area.visible {
    display: block;
  }

  .status-bar {
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 16px -14px rgba(28, 28, 28, 0.18);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .status-dot.connected {
    background: var(--ink);
  }

  .room-setup {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.2rem 2rem;
    text-align: center;
    margin-bottom: 1.5rem;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
  }

  .room-setup p {
    color: var(--ink-3);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .room-setup .code {
    font-family: monospace;
    font-size: 2rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.2em;
    user-select: all;
    margin-bottom: 1rem;
  }

  .room-setup .copy-btn {
    padding: 0.5rem 1.5rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    color: var(--ink-3);
    transition: all 0.2s;
  }

  .room-setup .copy-btn:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .room-join {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.2rem 2rem;
    text-align: center;
    margin-bottom: 1.5rem;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
  }

  .room-join p {
    color: var(--ink-3);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .room-join input {
    width: 220px;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: monospace;
    font-size: 1.5rem;
    text-align: center;
    letter-spacing: 0.15em;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .room-join input:focus {
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgba(28, 28, 28, 0.08);
  }

  .room-join button {
    display: block;
    margin: 1rem auto 0;
    padding: 0.75rem 2rem;
    background: var(--ink);
    color: white;
    border: none;
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
  }

  .room-join button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .video-container {
    position: relative;
    background: #111;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1rem;
    min-height: 300px;
    display: none;
    box-shadow: 0 10px 32px -18px rgba(28, 28, 28, 0.4);
  }

  .video-container.visible {
    display: block;
  }

  .video-container video {
    width: 100%;
    display: block;
  }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(28, 28, 28, 0.3);
    color: white;
    font-size: 1.1rem;
  }

  .video-overlay.hidden {
    display: none;
  }

  .controls {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .controls button {
    padding: 0.75rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .controls button:hover {
    border-color: var(--ink);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .controls button.active {
    background: var(--ink);
    color: white;
    border-color: var(--ink);
  }

  .waiting {
    text-align: center;
    padding: 3rem;
    color: var(--ink-3);
    font-size: 0.95rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
  }

  .waiting .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border);
    border-top-color: var(--ink);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 1rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 640px) {
    .tools-app {
      margin-top: 1.2rem;
      margin-bottom: 2.5rem;
    }

    .tools-nav {
      padding: 0.8rem 1rem;
    }

    .tools-body {
      padding: 1.2rem 0.9rem;
    }

    .mode-selector {
      flex-direction: column;
      gap: 0.7rem;
    }

    .mode-btn {
      padding: 1.1rem 1rem;
    }
  }
</style>

<BlogLayout title="NY Screen ｜ OviNas" description="免安裝、免登入、免配對碼，開網頁就能無線投影。">
  <div class="main-content">
  <div class="container">
    <div class="tools-app">
      <nav class="tools-nav" aria-label="麵包屑">
        <a href="/blog/">首頁</a>
        <span class="tools-nav-sep" aria-hidden="true">/</span>
        <a href="/nytools/">NYTools</a>
        <span class="tools-nav-sep" aria-hidden="true">/</span>
        <span class="tools-nav-current" aria-current="page">NY Screen</span>
      </nav>
      <div class="tools-body">
        <div class="page-header">
          <span class="page-badge icon-screen">
            <svg viewBox="0 0 24 24">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
              <line x1="8" y1="21" x2="16" y2="21" />
              <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
          </span>
          <h1>NY Screen</h1>
          <p>投影神器 — 免安裝免登入，開網頁即用</p>
        </div>

        <div id="modeSelect" class="mode-selector">
          <button class="mode-btn" data-mode="receiver">
            <h3>接收端</h3>
            <p>開設房間，等待投影</p>
          </button>
          <button class="mode-btn" data-mode="sender">
            <h3>發送端</h3>
            <p>連線房間，開始投影</p>
          </button>
        </div>

        <div id="screenArea" class="screen-area">
          <div class="status-bar">
            <span class="status-dot" id="statusDot"></span>
            <span id="statusText">未連線</span>
          </div>

          <div id="receiverSetup" class="room-setup" style="display:none;">
            <p>將此代碼分享給發送端</p>
            <div class="code" id="roomCode"></div>
            <button class="copy-btn" id="copyCode">複製連結</button>
          </div>

          <div id="senderSetup" class="room-join" style="display:none;">
            <p>輸入接收端提供的房間代碼</p>
            <input type="text" id="codeField" maxlength="6" placeholder="000000" />
            <button id="joinRoom">連線房間</button>
          </div>

          <div id="receiverView" class="waiting" style="display:none;">
            <div class="spinner"></div>
            <p>等待發送端連線...</p>
          </div>

          <div id="senderView" style="display:none;">
            <div class="controls">
              <button id="startShare">開始投影</button>
              <button id="stopShare" style="display:none;">停止投影</button>
              <button id="fullscreenBtn">全螢幕</button>
            </div>
          </div>

          <div id="videoContainer" class="video-container">
            <video id="remoteVideo" autoplay playsinline></video>
            <div class="video-overlay" id="videoOverlay">等待畫面...</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
</BlogLayout>

<script is:inline src="https://unpkg.com/peerjs/dist/peerjs.min.js"></script>
<script is:inline>
(function() {
  var peer = null;
  var conn = null;
  var mediaConn = null;
  var role = null;
  var roomCode = '';
  var localStream = null;

  var modeSelect = document.getElementById('modeSelect');
  var screenArea = document.getElementById('screenArea');
  var statusDot = document.getElementById('statusDot');
  var statusText = document.getElementById('statusText');
  var receiverSetup = document.getElementById('receiverSetup');
  var senderSetup = document.getElementById('senderSetup');
  var receiverView = document.getElementById('receiverView');
  var senderView = document.getElementById('senderView');
  var videoContainer = document.getElementById('videoContainer');
  var remoteVideo = document.getElementById('remoteVideo');
  var videoOverlay = document.getElementById('videoOverlay');

  function genCode() {
    return String(Math.floor(100000 + Math.random() * 900000));
  }

  function setStatus(connected, text) {
    statusDot.className = 'status-dot' + (connected ? ' connected' : '');
    statusText.textContent = text;
  }

  document.querySelectorAll('.mode-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      role = this.dataset.mode;
      modeSelect.style.display = 'none';
      screenArea.classList.add('visible');

      if (role === 'receiver') {
        roomCode = genCode();
        document.getElementById('roomCode').textContent = roomCode;
        receiverSetup.style.display = 'block';
        startReceiver();
      } else {
        senderSetup.style.display = 'block';
      }
    });
  });

  document.getElementById('copyCode').addEventListener('click', function() {
    var url = window.location.origin + '/nytools/screen?room=' + roomCode;
    navigator.clipboard.writeText(url);
    this.textContent = '已複製連結！';
    setTimeout(function() {
      document.getElementById('copyCode').textContent = '複製連結';
    }, 1500);
  });

  document.getElementById('joinRoom').addEventListener('click', function() {
    var code = document.getElementById('codeField').value.trim();
    if (code.length !== 6) return;
    roomCode = code;
    startSender();
  });

  function startReceiver() {
    peer = new Peer('nyscreen_recv_' + roomCode);

    peer.on('connection', function(c) {
      conn = c;
      setStatus(true, '發送端已連線');
      receiverSetup.style.display = 'none';
      receiverView.style.display = 'none';
      videoContainer.classList.add('visible');
    });

    peer.on('call', function(call) {
      call.answer();
      call.on('stream', function(stream) {
        remoteVideo.srcObject = stream;
        videoOverlay.classList.add('hidden');
        setStatus(true, '接收中');
      });
      call.on('close', function() {
        remoteVideo.srcObject = null;
        videoOverlay.classList.remove('hidden');
        videoOverlay.textContent = '投影已結束';
        setStatus(false, '投影已結束');
      });
    });

    peer.on('error', function(err) {
      if (err && err.type === 'unavailable-id') {
        setStatus(false, '此房間代碼已被占用，請重新整理換一組');
      } else {
        console.error('Peer error:', err);
      }
    });
  }

  function startSender() {
    peer = new Peer('nyscreen_send_' + Math.random().toString(36).substr(2, 8));

    peer.on('open', function() {
      conn = peer.connect('nyscreen_recv_' + roomCode, { reliable: true });

      conn.on('open', function() {
        setStatus(true, '已連線至接收端');
        senderSetup.style.display = 'none';
        senderView.style.display = 'block';
        videoContainer.classList.add('visible');
      });

      conn.on('close', function() {
        setStatus(false, '接收端已斷線');
      });

      conn.on('error', function(err) {
        setStatus(false, '找不到接收端，請確認對方已開啟接收房間');
      });
    });
  }

  document.getElementById('startShare').addEventListener('click', async function() {
    try {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) {
        setStatus(false, '此瀏覽器不支援螢幕分享，請改用 Chrome / Edge');
        return;
      }
      localStream = await navigator.mediaDevices.getDisplayMedia({ video: true });
      document.getElementById('startShare').style.display = 'none';
      document.getElementById('stopShare').style.display = 'inline-flex';
      videoOverlay.classList.add('hidden');

      localStream.getVideoTracks()[0].onended = function() {
        stopSharing();
      };

      if (conn && conn.open) {
        mediaConn = peer.call('nyscreen_recv_' + roomCode, localStream);
        mediaConn.on('error', function(err) {
          if (err && err.type === 'peer-unavailable') {
            setStatus(false, '接收端已離線，請確認對方頁面仍開著');
          } else {
            setStatus(false, '投影連線失敗，請重試');
          }
          stopSharing();
        });
        mediaConn.on('close', function() {
          stopSharing();
        });
      } else {
        setStatus(false, '尚未連線至接收端，請先連線房間');
      }
    } catch (e) {
      if (e && e.name === 'NotAllowedError') {
        setStatus(false, '你拒絕了螢幕分享權限，請按「開始投影」重新允許');
      } else if (e && e.name === 'NotFoundError') {
        setStatus(false, '找不到可分享的畫面');
      } else {
        setStatus(false, '螢幕分享啟動失敗，請重試');
      }
    }
  });

  document.getElementById('stopShare').addEventListener('click', stopSharing);

  function stopSharing() {
    if (mediaConn) {
      mediaConn.close();
      mediaConn = null;
    }
    if (localStream) {
      localStream.getTracks().forEach(function(t) { t.stop(); });
      localStream = null;
    }
    document.getElementById('startShare').style.display = 'inline-flex';
    document.getElementById('stopShare').style.display = 'none';
    videoOverlay.classList.remove('hidden');
    videoOverlay.textContent = '投影已停止';
  }

  document.getElementById('fullscreenBtn').addEventListener('click', function() {
    if (remoteVideo.requestFullscreen) {
      remoteVideo.requestFullscreen();
    }
  });

  var params = new URLSearchParams(window.location.search);
  var joinRoom = params.get('room');
  if (joinRoom) {
    document.getElementById('codeField').value = joinRoom;
    modeSelect.querySelector('[data-mode="sender"]').click();
    setTimeout(function() {
      document.getElementById('joinRoom').click();
    }, 500);
  }
})();
</script>