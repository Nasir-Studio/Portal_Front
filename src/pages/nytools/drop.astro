---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<style is:global>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-3);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .tools-app {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: 0 14px 44px -20px rgba(28, 28, 28, 0.28);
    margin-top: 2.4rem;
    margin-bottom: 3.5rem;
    overflow: hidden;
  }

  .tools-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.6rem;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  .tools-nav a {
    color: var(--ink);
    border-bottom: 1px solid var(--border-strong);
    transition: border-color var(--t), color var(--t);
    text-decoration: none;
  }

  .tools-nav a:hover {
    border-color: var(--ink);
  }

  .tools-nav-sep {
    color: var(--ink-3);
  }

  .tools-nav-current {
    color: var(--ink-3);
  }

  .tools-body {
    padding: 2.2rem 1.8rem;
  }

  .page-header {
    margin-bottom: 2rem;
    animation: fadeIn 0.5s ease-out;
  }

  .page-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    margin-bottom: 1.1rem;
  }

  .page-badge svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-drop {
    background: #eef4ff;
    color: #0a63d6;
  }

  .page-header h1 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-serif);
  }

  .page-header p {
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  .features {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
    animation: fadeIn 0.5s ease-out 0.15s both;
  }

  .features h3 {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .features h3::before {
    content: '';
    width: 3px;
    height: 1em;
    background: #0a63d6;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .features ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .features li {
    padding: 0.5rem 0;
    font-size: 0.85rem;
    color: var(--ink-3);
    line-height: 1.6;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .features li::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #0a63d6;
    border-radius: 50%;
    margin-top: 0.45rem;
    flex-shrink: 0;
  }

  .how-to-use {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
    animation: fadeIn 0.5s ease-out 0.2s both;
  }

  .how-to-use h3 {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .how-to-use h3::before {
    content: '';
    width: 3px;
    height: 1em;
    background: #0a63d6;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .how-to-use ol {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    line-height: 1.8;
  }

  .mode-selector {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    animation: fadeIn 0.5s ease-out 0.1s both;
  }

  .mode-btn {
    flex: 1;
    padding: 1.5rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
    font-family: var(--font-sans);
    box-shadow: 0 4px 18px -16px rgba(28, 28, 28, 0.18);
    position: relative;
  }

  .mode-btn:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -18px rgba(28, 28, 28, 0.28);
  }

  .mode-btn.active {
    border-color: #0a63d6;
    background: linear-gradient(180deg, #f5f9ff 0%, var(--surface) 65%);
  }

  .mode-btn.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: #0a63d6;
    border-radius: 3px 3px 0 0;
  }

  .mode-btn h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    margin: 0 0 0.3rem 0;
  }

  .mode-btn p {
    font-size: 0.8rem;
    color: var(--ink-3);
    margin: 0;
  }

  .transfer-area {
    display: none;
    animation: fadeIn 0.4s ease-out;
  }

  .transfer-area.visible {
    display: block;
  }

  .code-display {
    text-align: center;
    padding: 2.2rem 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    margin-bottom: 1.5rem;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
  }

  .code-display p {
    color: var(--ink-3);
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }

  .code-display .code {
    font-family: monospace;
    font-size: 2.5rem;
    font-weight: 700;
    color: #0a63d6;
    letter-spacing: 0.2em;
    user-select: all;
  }

  .code-display .copy-btn {
    margin-top: 1rem;
    padding: 0.5rem 1.5rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    color: var(--ink-3);
    transition: all 0.2s;
  }

  .code-display .copy-btn:hover {
    border-color: #0a63d6;
    color: #0a63d6;
  }

  .code-input {
    text-align: center;
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    margin-bottom: 1.5rem;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
  }

  .code-input p {
    color: var(--ink-3);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .code-input input {
    width: 220px;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: monospace;
    font-size: 1.5rem;
    text-align: center;
    letter-spacing: 0.15em;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .code-input input:focus {
    border-color: #0a63d6;
    box-shadow: 0 0 0 3px rgba(10, 99, 214, 0.12);
  }

  .code-input button {
    display: block;
    margin: 1rem auto 0;
    padding: 0.75rem 2rem;
    background: var(--ink);
    color: white;
    border: none;
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
  }

  .code-input button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .drop-zone {
    border: 2px dashed var(--border-strong);
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
    background: var(--surface);
    transition: all 0.25s;
    margin-bottom: 1.5rem;
    cursor: pointer;
  }

  .drop-zone:hover,
  .drop-zone.dragover {
    border-color: #0a63d6;
    background: #f5f9ff;
  }

  .drop-zone p {
    color: var(--ink-3);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .drop-zone .hint {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .drop-zone input[type="file"] {
    display: none;
  }

  .progress-container {
    display: none;
    margin-bottom: 1.5rem;
  }

  .progress-container.visible {
    display: block;
  }

  .progress-bar-bg {
    height: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #0a63d6, #4d94e8);
    border-radius: 999px;
    transition: width 0.3s ease;
    width: 0%;
  }

  .progress-text {
    font-size: 0.85rem;
    color: var(--ink-3);
    text-align: center;
  }

  .status-bar {
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 16px -14px rgba(28, 28, 28, 0.18);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .status-dot.connected {
    background: #0a63d6;
  }

  .file-list {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.5rem 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 4px 18px -16px rgba(28, 28, 28, 0.18);
  }

  .file-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid var(--border);
  }

  .file-item:last-child {
    border-bottom: none;
  }

  .file-item .name {
    font-size: 0.9rem;
  }

  .file-item .size {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .received-files {
    margin-top: 1rem;
  }

  .received-file {
    display: inline-block;
    padding: 0.45rem 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    margin: 0.25rem;
    font-size: 0.85rem;
    color: var(--ink);
    text-decoration: none;
    transition: all 0.2s;
  }

  .received-file:hover {
    border-color: #0a63d6;
    color: #0a63d6;
    background: #f5f9ff;
  }

  @media (max-width: 640px) {
    .tools-app {
      margin-top: 1.2rem;
      margin-bottom: 2.5rem;
    }

    .tools-nav {
      padding: 0.8rem 1rem;
    }

    .tools-body {
      padding: 1.2rem 0.9rem;
    }

    .mode-selector {
      flex-direction: column;
      gap: 0.7rem;
    }

    .mode-btn {
      padding: 1.1rem 1rem;
    }

    .drop-zone {
      padding: 2rem 1rem;
    }
  }
</style>

<BaseLayout title="NY DROP ｜ OviNas">
  <div class="container">
    <div class="tools-app">
      <nav class="tools-nav" aria-label="麵包屑">
        <a href="/">首頁</a>
        <span class="tools-nav-sep" aria-hidden="true">/</span>
        <a href="/nytools">NYTools</a>
        <span class="tools-nav-sep" aria-hidden="true">/</span>
        <span class="tools-nav-current" aria-current="page">NY DROP</span>
      </nav>
      <div class="tools-body">
        <div class="page-header">
          <span class="page-badge icon-drop">
            <svg viewBox="0 0 24 24">
              <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
            </svg>
          </span>
          <h1>NY DROP</h1>
          <p>P2P 檔案傳輸 — 6 位數代碼配對，點對點直接傳送</p>
        </div>

        <div id="modeSelect" class="mode-selector">
          <button class="mode-btn" data-mode="sender">
            <h3>建立房間</h3>
            <p>產生代碼，等待對方加入</p>
          </button>
          <button class="mode-btn" data-mode="receiver">
            <h3>加入房間</h3>
            <p>輸入代碼，連線傳送</p>
          </button>
        </div>

        <div id="transferArea" class="transfer-area">
          <div class="status-bar">
            <span class="status-dot" id="statusDot"></span>
            <span id="statusText">未連線</span>
          </div>

          <div id="codeDisplay" class="code-display" style="display:none;">
            <p>將此代碼分享給對方</p>
            <div class="code" id="roomCode"></div>
            <button class="copy-btn" id="copyCode">複製代碼</button>
          </div>

          <div id="codeInput" class="code-input" style="display:none;">
            <p>輸入對方提供的 6 位數代碼</p>
            <input type="text" id="codeField" maxlength="6" placeholder="000000" />
            <button id="connectBtn">連線</button>
          </div>

          <div id="dropZone" class="drop-zone" style="display:none;">
            <p>拖曳檔案到這裡，或點擊選擇檔案</p>
            <p class="hint">支援任何檔案格式</p>
            <input type="file" id="fileInput" multiple />
          </div>

          <div id="progressContainer" class="progress-container">
            <div class="progress-bar-bg">
              <div class="progress-bar" id="progressBar"></div>
            </div>
            <div class="progress-text" id="progressText">0%</div>
          </div>

          <div id="fileList" class="file-list" style="display:none;"></div>

          <div id="receivedFiles" class="received-files"></div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline src="https://unpkg.com/peerjs/dist/peerjs.min.js"></script>
<script is:inline>
(function() {
  var peer = null;
  var conn = null;
  var role = null;
  var roomCode = '';

  var modeSelect = document.getElementById('modeSelect');
  var transferArea = document.getElementById('transferArea');
  var statusDot = document.getElementById('statusDot');
  var statusText = document.getElementById('statusText');
  var codeDisplay = document.getElementById('codeDisplay');
  var codeInput = document.getElementById('codeInput');
  var dropZone = document.getElementById('dropZone');
  var fileInput = document.getElementById('fileInput');
  var progressContainer = document.getElementById('progressContainer');
  var progressBar = document.getElementById('progressBar');
  var progressText = document.getElementById('progressText');
  var fileList = document.getElementById('fileList');
  var receivedFiles = document.getElementById('receivedFiles');

  function genCode() {
    return String(Math.floor(100000 + Math.random() * 900000));
  }

  function setStatus(connected, text) {
    statusDot.className = 'status-dot' + (connected ? ' connected' : '');
    statusText.textContent = text;
  }

  function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }

  document.querySelectorAll('.mode-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      role = this.dataset.mode;
      modeSelect.style.display = 'none';
      transferArea.classList.add('visible');

      if (role === 'sender') {
        roomCode = genCode();
        document.getElementById('roomCode').textContent = roomCode;
        codeDisplay.style.display = 'block';
        startSender();
      } else {
        codeInput.style.display = 'block';
      }
    });
  });

  document.getElementById('copyCode').addEventListener('click', function() {
    navigator.clipboard.writeText(roomCode);
    this.textContent = '已複製！';
    setTimeout(function() {
      document.getElementById('copyCode').textContent = '複製代碼';
    }, 1500);
  });

  document.getElementById('connectBtn').addEventListener('click', function() {
    var code = document.getElementById('codeField').value.trim();
    if (code.length !== 6) return;
    roomCode = code;
    startReceiver();
  });

  function startSender() {
    peer = new Peer('nydrop_' + roomCode);

    peer.on('connection', function(c) {
      conn = c;
      conn.on('open', function() {
        setStatus(true, '對方已連線');
        codeDisplay.style.display = 'none';
        dropZone.style.display = 'block';
      });
      conn.on('close', function() {
        setStatus(false, '對方已斷線');
      });
    });
  }

  function startReceiver() {
    peer = new Peer('nydrop_' + Math.random().toString(36).substr(2, 8));

    peer.on('open', function() {
      conn = peer.connect('nydrop_' + roomCode, { reliable: true });
      conn.on('open', function() {
        setStatus(true, '已連線');
        codeInput.style.display = 'none';
        dropZone.style.display = 'block';
      });
      conn.on('data', function(data) {
        if (data.type === 'file') {
          receiveFile(data);
        }
      });
      conn.on('close', function() {
        setStatus(false, '連線中斷');
      });
    });
  }

  dropZone.addEventListener('click', function() {
    fileInput.click();
  });

  dropZone.addEventListener('dragover', function(e) {
    e.preventDefault();
    this.classList.add('dragover');
  });

  dropZone.addEventListener('dragleave', function() {
    this.classList.remove('dragover');
  });

  dropZone.addEventListener('drop', function(e) {
    e.preventDefault();
    this.classList.remove('dragover');
    sendFiles(e.dataTransfer.files);
  });

  fileInput.addEventListener('change', function() {
    sendFiles(this.files);
  });

  function sendFiles(files) {
    if (!conn || !conn.open) return;

    fileList.style.display = 'block';
    fileList.innerHTML = '';

    var total = files.length;
    var sent = 0;

    Array.from(files).forEach(function(file) {
      var item = document.createElement('div');
      item.className = 'file-item';
      item.innerHTML = '<span class="name">' + file.name + '</span><span class="size">' + formatSize(file.size) + '</span>';
      fileList.appendChild(item);

      var reader = new FileReader();
      reader.onload = function(e) {
        conn.send({
          type: 'file',
          name: file.name,
          size: file.size,
          data: e.target.result
        });
        sent++;
        var pct = Math.round((sent / total) * 100);
        progressContainer.classList.add('visible');
        progressBar.style.width = pct + '%';
        progressText.textContent = pct + '% — ' + sent + '/' + total + ' 個檔案';

        if (sent === total) {
          progressText.textContent = '全部傳送完成！';
        }
      };
      reader.readAsArrayBuffer(file);
    });
  }

  function receiveFile(data) {
    var blob = new Blob([data.data]);
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = data.name;
    a.className = 'received-file';
    a.textContent = data.name + ' (' + formatSize(data.size) + ')';
    a.click();
    receivedFiles.appendChild(a);
  }
})();
</script>