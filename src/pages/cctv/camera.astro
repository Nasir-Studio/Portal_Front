---
import BaseLayout from '../../cctv/layouts/BaseLayout.astro';
const base = '/cctv';
---

<BaseLayout title="攝影機">
  <div class="cam-full" id="camFull">
    <div class="cam-full-header">
      <a href={`${base}/`} class="back" id="backBtn">&larr; 返回</a>
      <div class="cam-full-info">
        <div class="cam-full-name" id="camName">載入中...</div>
        <div class="cam-full-city" id="camCity"></div>
      </div>
    </div>
    <div class="cam-full-preview" id="camPreview">
      <span class="cam-live">LIVE</span>
    </div>
    <div class="cam-full-meta" id="camMeta"></div>
  </div>

  <style is:inline>
    .cam-full { max-width: 960px; margin: 0 auto; }
    .cam-full-header {
      display: flex; align-items: center; gap: 1rem;
      margin-bottom: 1rem;
    }
    .cam-full-header .back {
      font-size: 0.78rem; color: var(--text-dim);
      text-decoration: none; flex-shrink: 0;
    }
    .cam-full-header .back:hover { color: var(--accent); }
    .cam-full-info { min-width: 0; }
    .cam-full-name {
      font-size: 1rem; font-weight: 500; color: var(--text);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cam-full-city { font-size: 0.75rem; color: var(--text-dim); margin-top: 2px; }
    .cam-full-preview {
      width: 100%; aspect-ratio: 16/9;
      background: #1a1a1a; position: relative; overflow: hidden;
      border: 1px solid var(--border);
    }
    .cam-full-preview video,
    .cam-full-preview img {
      width: 100%; height: 100%; object-fit: contain;
      display: block; background: #1a1a1a;
    }
    .cam-full-preview .cam-nosig {
      display: flex; align-items: center; justify-content: center;
      height: 100%; color: #888;
      font-size: 0.75rem; letter-spacing: 0.15em;
      font-family: var(--font-mono); flex-direction: column; gap: 0.5rem;
    }
    .cam-full-preview .cam-nosig svg { opacity: 0.4; }
    .cam-full-preview .cam-live {
      position: absolute; top: 12px; left: 12px; z-index: 2;
      background: rgba(255,255,255,0.88); backdrop-filter: blur(4px);
      padding: 3px 10px; font-size: 0.6rem; letter-spacing: 0.15em;
      color: var(--red); font-family: var(--font-mono); font-weight: 500;
    }
    .cam-full-meta {
      padding: 1rem 0; font-size: 0.75rem; color: var(--text-dim);
      display: flex; gap: 1.5rem; flex-wrap: wrap;
    }
    .cam-full-meta span { display: inline-flex; align-items: center; gap: 4px; }
  </style>

  <script is:inline src="https://cdn.jsdelivr.net/npm/hls.js@1"></script>
  <script is:inline>
    var BASE = '/cctv';
    document.addEventListener('DOMContentLoaded', function() {
      var camName = document.getElementById('camName');
      var camCity = document.getElementById('camCity');
      var camPreview = document.getElementById('camPreview');
      var camMeta = document.getElementById('camMeta');
      var backBtn = document.getElementById('backBtn');

      var cctvSvg = '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>';

      function showNoSignal(parent) {
        var d = document.createElement('div');
        d.className = 'cam-nosig';
        d.innerHTML = cctvSvg + '<span>NO SIGNAL</span>';
        parent.appendChild(d);
      }

      function isIOS() {
        return /iPad|iPhone|iPod/.test(navigator.userAgent) ||
               (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      }
      var IOS = isIOS();

      function loadCamera(camId) {
        fetch(BASE + '/cameras_thumb.json')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            var cam = data.find(function(c) { return String(c.id) === String(camId); });
            if (!cam) {
              camName.textContent = '找不到這台攝影機';
              return;
            }

            document.title = cam.name + ' | 羊在偷看你';
            camName.textContent = cam.name || '未命名';
            camCity.textContent = [cam.city, cam.region].filter(Boolean).join(' · ');

            var url = cam.url || '';
            var isHls = cam.type === 'hls' || url.indexOf('.m3u8') !== -1;
            var isYt = url.indexOf('youtube') !== -1 || url.indexOf('ytimg') !== -1;
            var isThb = url.indexOf('.thb.gov.tw') !== -1;

            if (isYt) {
              
              var ytId = (url.match(/\/vi\/([^/]+)\//) || [])[1] || '';
              if (!ytId) { showNoSignal(camPreview); }
              else {
                var iframe = document.createElement('iframe');
                iframe.width = '100%';
                iframe.height = '100%';
                iframe.src = 'https://www.youtube.com/embed/' + ytId + '?autoplay=1&mute=1';
                iframe.frameBorder = '0';
                iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                iframe.allowFullscreen = true;
                iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
                camPreview.appendChild(iframe);
              }
            } else if (isHls) {
              var video = document.createElement('video');
              video.muted = true;
              video.autoplay = true;
              video.loop = true;
              video.playsInline = true;
              video.controls = true;
              camPreview.appendChild(video);

              if (typeof Hls !== 'undefined' && Hls.isSupported()) {
                var hls = new Hls({ enableWorker: true, lowLatencyMode: false, maxBufferLength: 10, startFragPrefetch: true, maxMaxBufferLength: 30 });
                hls.loadSource(url);
                hls.attachMedia(video);
                hls.on(Hls.Events.MANIFEST_PARSED, function() { video.play().catch(function(){}); });
                var hlsRetries = 0;
                var MAX_HLS_RETRIES = 3;
                hls.on(Hls.Events.ERROR, function(e, data) {
                  if (data.fatal) {
                    hlsRetries++;
                    if (hlsRetries <= MAX_HLS_RETRIES) {
                      
                      setTimeout(function() {
                        try { hls.startLoad(); } catch(e) {}
                      }, 2000);
                    } else {
                      hls.destroy(); showNoSignal(camPreview); video.remove();
                    }
                  }
                });
              } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                video.src = url;
                video.play().catch(function(){});
              } else {
                showNoSignal(camPreview);
              }
            } else if (IOS && isThb) {
              
              var snapImg = document.createElement('img');
              snapImg.alt = cam.name || '';
              snapImg.style.cssText = 'width:100%;height:100%;object-fit:contain;display:block;background:#1a1a1a';
              var snapBase = url + '/snapshot';
              var tick = function() {
                if (!snapImg.isConnected) { clearInterval(snapImg._timer); return; }
                snapImg.src = snapBase + '?_=' + Date.now();
              };
              snapImg.onerror = function() { clearInterval(snapImg._timer); snapImg.remove(); showNoSignal(camPreview); };
              tick();
              snapImg._timer = setInterval(tick, 3000);
              camPreview.appendChild(snapImg);
            } else {
              var liveImg = document.createElement('img');
              liveImg.alt = cam.name || '';
              liveImg.style.cssText = 'width:100%;height:100%;object-fit:contain;display:block;background:#1a1a1a';
              
              
              liveImg.onerror = function() { liveImg.remove(); showNoSignal(camPreview); };
              liveImg.src = url;
              camPreview.appendChild(liveImg);
            }

            var metaHtml = '';
            if (cam.region) metaHtml += '<span>📍 ' + cam.region + '</span>';
            if (cam.city && cam.city !== cam.region) metaHtml += '<span>🏘️ ' + cam.city + '</span>';
            if (cam.url) metaHtml += '<span>🔗 ' + cam.url.replace(/https?:\/\//, '').substring(0, 40) + '</span>';
            camMeta.innerHTML = metaHtml;
          });
      }

      function init() {
        var hash = window.location.hash.replace('#', '');
        if (hash) {
          loadCamera(hash);
        } else {
          camName.textContent = '攝影機 ID 無效';
        }
      }

      init();
    });
  </script>
</BaseLayout>
