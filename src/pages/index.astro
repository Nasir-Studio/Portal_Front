---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Announcements from '../components/Announcements.astro';
import QuoteOfTheDay from '../components/QuoteOfTheDay.svelte';
import ContactForm from '../components/ContactForm.svelte';

const services = [
  { name: 'NYTools', desc: '點對點傳檔、Wi-Fi 互傳、投影', href: '/nytools/', external: false, icon: '/icon素材/icon素材-2.png' },
  { name: '單字測驗', desc: '英文單字測驗', href: '/vocab/', external: false, icon: '/icon素材/icon素材-2.png' },
  { name: '羊監視你', desc: '即時監視影像', href: '/cctv', external: false, icon: '/icon素材/icon素材-2.png' },
  { name: '羊集章', desc: '集章活動紀錄', href: '/badges/', external: false, icon: '/icon素材/icon素材-2.png' },
  { name: '羊愛考試', desc: '線上測驗系統', href: 'https://1ztests.nsir.uk', external: true, icon: '/service-1ztests.png' },
  { name: '羊-短網址', desc: '網址縮短服務', href: 'https://nsir.uk', external: true, icon: '/service-nsir.jpg' },
];

const badges = [
  {
    img: '/certs/adobe-creativity-with-ai.png',
    name: 'Adobe × Pearson：Creativity with AI',
    url: 'https://www.credly.com/badges/dc78c48f-1fbb-4eac-afbf-b25e13ef7e1b/public_url',
  },
  {
    img: '/certs/genai-foundations.png',
    name: 'Generative AI Foundations',
    url: 'https://www.credly.com/badges/04543121-d04c-45ee-bb2d-b499752a10ae/public_url',
  },
  {
    img: '/certs/adobe-video-design.png',
    name: 'Adobe 影片設計專業認證',
    url: 'https://www.credly.com/badges/fa17ef56-fbd4-4f47-b7ae-ed9adc6755bf/public_url',
  },
  {
    img: '/certs/cisco-ccst.png',
    name: 'Cisco CCST 網路安全',
    url: 'https://www.credly.com/badges/28f42e0c-29a2-442a-a670-c9db938f638a/public_url',
  },
  {
    img: '/certs/adobe-premiere.png',
    name: 'Adobe Premiere 數位影音',
    url: 'https://www.credly.com/badges/3e176af8-edca-411e-8e52-6be837f644ac/public_url',
  },
  {
    img: '/certs/its-python.png',
    name: 'IT Specialist Python',
    url: 'https://www.credly.com/badges/7b8bbe2a-3bbd-4fdc-8ffc-7696c35876aa/public_url',
  },
  {
    img: '/certs/adobe-photoshop.png',
    name: 'Adobe Certified Professional in Visual Design Using Adobe Photoshop',
    url: 'https://www.credly.com/badges/4e2825dd-e2d1-4b42-922c-bdcb39fd899a/public_url',
  },
  {
    img: '/certs/mos-powerpoint.png',
    name: 'Microsoft Office Specialist: PowerPoint',
    url: 'https://www.credly.com/badges/5b7beead-dc12-4bbd-83a2-1301db598b52/public_url',
  },
];
---

<BaseLayout>
  <Banner />
  <div class="main container">
    <aside class="col col-left">
      <section class="module" aria-label="每日一句">
        <h2 class="module-title">每日一句</h2>
        <QuoteOfTheDay client:load />
      </section>

      <section class="module tools-module" aria-label="工具服務">
        <h2 class="module-title">工具服務</h2>
        <nav class="tools-grid" aria-label="工具服務列表">
          {
            services.map((s) => (
              <a
                class="tool-item"
                href={s.href}
                target={s.external ? '_blank' : undefined}
                rel={s.external ? 'noopener noreferrer' : undefined}
              >
                <span class="tool-icon">
                  <img src={s.icon} alt={s.name} width="56" height="56" loading="lazy" />
                  {s.external && <span class="tool-badge" aria-hidden="true">↗</span>}
                </span>
                <span class="tool-name">{s.name}</span>
                <span class="tool-desc">{s.desc}</span>
              </a>
            ))
          }
        </nav>
      </section>

      <section class="module contact-module" aria-label="聯絡表單">
        <h2 class="module-title">聯絡表單</h2>
        <ContactForm client:load />
      </section>
    </aside>

    <main class="col col-center">
      <Announcements />

      <section class="module gh-module" aria-label="GitHub 貢獻">
        <img
          class="gh-chart"
          src="https://ghchart.rshah.org/nasircy"
          alt="GitHub 貢獻看板"
          width="663"
          height="104"
          loading="lazy"
        />
      </section>

      <section class="module calendar-module" aria-label="行事曆">
        <h2 class="module-title">
          <span class="cal-head-left">
            <span class="cal-square" aria-hidden="true"></span>
            行事曆
          </span>
        </h2>
        <div class="cal-frame">
          <iframe
            src="https://calendar.google.com/calendar/embed?src=bb049ab126a644ff77ce9a3dd0ad5c2aa0b1bd0272dd636a38dcfbabdd5aa7aa%40group.calendar.google.com&ctz=Asia%2FTaipei"
            title="Google 行事曆"
            loading="lazy"
            frameborder="0"
            scrolling="no"
          ></iframe>
        </div>
      </section>
    </main>

    <aside class="col col-right">
      <section class="module" aria-label="資格認證">
        <h2 class="module-title">
          <span>資格認證</span>
        </h2>
        <ul class="badge-grid">
          {
            badges.map((b) => (
              <li class="badge-item">
                <img class="badge-img" src={b.img} alt={b.name} width="120" loading="lazy" />
                <p class="badge-name">{b.name}</p>
              </li>
            ))
          }
        </ul>
        <a class="badge-more" href="https://nasirlin.net" target="_blank" rel="noopener noreferrer">
          查看更多資格認證
          <span aria-hidden="true">↗</span>
        </a>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .main {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 1.4rem;
    align-items: start;
    padding: 2rem 0 3.5rem;
  }

  .col-left {
    animation-delay: 0.05s;
  }

  .col-center {
    animation-delay: 0.12s;
  }

  .col-right {
    animation-delay: 0.2s;
  }

  .col-left,
  .col-center,
  .col-right {
    min-width: 0;
    animation: col-in 0.5s var(--ease) both;
  }

  @keyframes col-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
    padding: 1.1rem 1rem;
  }

  .tool-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.9rem 0.3rem 0.8rem;
    text-align: center;
    text-decoration: none;
    border: none;
    background: transparent;
    border-radius: 6px;
    transition: background var(--t), transform var(--t);
  }

  .tool-item:hover {
    background: var(--bg-soft);
    transform: translateY(-2px);
  }

  .tool-icon {
    position: relative;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    border: none;
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .tool-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    box-sizing: border-box;
    padding: 6px;
    border-radius: 10px;
  }

  .tool-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    font-size: 0.62rem;
    line-height: 18px;
    text-align: center;
    border: 2px solid var(--surface);
  }

  .tool-name {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
    line-height: 1.3;
  }

  .tool-desc {
    font-size: 0.7rem;
    color: var(--ink-3);
    letter-spacing: 0.03em;
    line-height: 1.4;
  }

  .badge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    padding: 1rem;
    list-style: none;
  }

  .badge-item {
    text-align: center;
  }

  .badge-img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    margin-inline: auto;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.25rem;
  }

  .badge-name {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--ink-2);
    letter-spacing: 0.03em;
  }

  .badge-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    background: var(--bg-soft);
    transition: color var(--t), background var(--t);
  }

  .badge-more:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .cal-head-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .gh-module {
    padding: 0;
  }

  .gh-chart {
    display: block;
    width: 100%;
    height: auto;
  }

  .cal-square {
    width: 7px;
    height: 7px;
    background: #e5ccb1;
    transform: rotate(45deg);
  }

  .cal-frame {
    padding: 1rem;
  }

  .cal-frame iframe {
    width: 100%;
    height: 480px;
    border: 0;
    display: block;
  }

  @media (max-width: 700px) {
    .cal-frame {
      padding: 0.5rem;
    }

    .cal-frame iframe {
      height: 420px;
    }
  }

  @media (max-width: 900px) {
    .main {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.2rem 0 2.5rem;
    }

    .col-left {
      order: 2;
    }

    .col-center {
      order: 1;
    }

    .col-right {
      order: 3;
    }

    .main .module {
      margin-bottom: 1rem;
    }

    .badge-grid {
      grid-template-columns: repeat(3, 1fr);
      padding: 0.85rem;
      gap: 0.6rem;
    }

    .badge-name {
      font-size: 0.72rem;
    }
  }
</style>
