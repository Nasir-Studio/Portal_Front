---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Announcements from '../components/Announcements.astro';

const services = [
  { name: '羊監視你', desc: '即時監視影像', href: 'https://cctv.nsir.uk' },
  { name: '羊集章', desc: '集章活動紀錄', href: 'https://badges.nsir.uk' },
  { name: '羊愛考試', desc: '線上測驗系統', href: 'https://1ztests.nsir.uk' },
  { name: '羊-短網址', desc: '網址縮短服務', href: 'https://nsir.uk' },
];

const projects = [
  {
    name: 'NYTools',
    desc: 'P2P 即時工具集 — 客服排隊、檔案傳輸、點播、投影',
    href: '/nytools/',
  },
];

const badges = [
  {
    img: '/badges/adobe-creativity-with-ai.png',
    name: 'Adobe × Pearson：Creativity with AI',
    url: 'https://www.credly.com/badges/dc78c48f-1fbb-4eac-afbf-b25e13ef7e1b/public_url',
  },
  {
    img: '/badges/genai-foundations.png',
    name: 'Generative AI Foundations',
    url: 'https://www.credly.com/badges/04543121-d04c-45ee-bb2d-b499752a10ae/public_url',
  },
  {
    img: '/badges/adobe-video-design.png',
    name: 'Adobe 影片設計專業認證',
    url: 'https://www.credly.com/badges/fa17ef56-fbd4-4f47-b7ae-ed9adc6755bf/public_url',
  },
  {
    img: '/badges/cisco-ccst.png',
    name: 'Cisco CCST 網路安全',
    url: 'https://www.credly.com/badges/28f42e0c-29a2-442a-a670-c9db938f638a/public_url',
  },
  {
    img: '/badges/adobe-premiere.png',
    name: 'Adobe Premiere 數位影音',
    url: 'https://www.credly.com/badges/3e176af8-edca-411e-8e52-6be837f644ac/public_url',
  },
  {
    img: '/badges/its-python.png',
    name: 'IT Specialist Python',
    url: 'https://www.credly.com/badges/7b8bbe2a-3bbd-4fdc-8ffc-7696c35876aa/public_url',
  },
];
---

<BaseLayout>
  <Banner />
  <div class="main container">
    <aside class="col col-left">
      <section class="module services-module" aria-label="服務連結">
        <h2 class="module-title">服務連結</h2>
        <nav class="menu-list" aria-label="服務連結列表">
          {
            services.map((s) => (
              <a class="menu-item" href={s.href} target="_blank" rel="noopener noreferrer">
                <span class="menu-item-name">
                  {s.name}
                  <span class="menu-item-arrow" aria-hidden="true">↗</span>
                </span>
                <span class="menu-item-desc">{s.desc}</span>
              </a>
            ))
          }
        </nav>
      </section>

      <section class="module" aria-label="考古刷題">
        <h2 class="module-title">考古刷題</h2>
        <div class="pastpapers-card">
          <p class="pastpapers-desc">AI 應用規劃師考古題庫，收錄 338 題，支援單選與多選題型。</p>
          <a class="pastpapers-btn" href="/pastpapers/">
            進入測驗
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </aside>

    <main class="col col-center">
      <Announcements />

      <section class="module calendar-module" aria-label="行事曆">
        <h2 class="module-title">
          <span class="cal-head-left">
            <span class="cal-square" aria-hidden="true"></span>
            行事曆
          </span>
        </h2>
        <div class="cal-frame">
          <iframe
            src="https://calendar.google.com/calendar/embed?src=bb049ab126a644ff77ce9a3dd0ad5c2aa0b1bd0272dd636a38dcfbabdd5aa7aa%40group.calendar.google.com&ctz=Asia%2FTaipei"
            title="Google 行事曆"
            loading="lazy"
            frameborder="0"
            scrolling="no"
          ></iframe>
        </div>
      </section>
    </main>

    <aside class="col col-right">
      <section class="module" aria-label="資格認證">
        <h2 class="module-title">
          <span>資格認證</span>
          <span class="badge-count">{badges.length} 枚</span>
        </h2>
        <ul class="badge-grid">
          {
            badges.map((b) => (
              <li class="badge-item">
                <img class="badge-img" src={b.img} alt={b.name} width="120" loading="lazy" />
                <p class="badge-name">{b.name}</p>
              </li>
            ))
          }
        </ul>
        <a class="badge-more" href="https://nasirlin.net" target="_blank" rel="noopener noreferrer">
          查看更多資格認證
          <span aria-hidden="true">↗</span>
        </a>
      </section>

      <section class="module" aria-label="Side Project">
        <h2 class="module-title">Side Project</h2>
        <nav class="menu-list" aria-label="Side Project 列表">
          {
            projects.map((p) => (
              <a class="menu-item" href={p.href}>
                <span class="menu-item-name">
                  {p.name}
                  <span class="menu-item-arrow" aria-hidden="true">↗</span>
                </span>
                <span class="menu-item-desc">{p.desc}</span>
              </a>
            ))
          }
        </nav>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .main {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 1.4rem;
    align-items: start;
    padding: 2rem 0 3.5rem;
  }

  .col-left {
    animation-delay: 0.05s;
  }

  .col-center {
    animation-delay: 0.12s;
  }

  .col-right {
    animation-delay: 0.2s;
  }

  .col-left,
  .col-center,
  .col-right {
    min-width: 0;
    animation: col-in 0.5s var(--ease) both;
  }

  @keyframes col-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .menu-item {
    display: block;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .menu-item:hover {
    background: var(--bg-soft);
  }

  .menu-item-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  .menu-item-arrow {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .menu-item-desc {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .pastpapers-card {
    padding: 1rem;
  }

  .pastpapers-desc {
    font-size: 0.82rem;
    line-height: 1.8;
    color: var(--ink-2);
    letter-spacing: 0.04em;
    margin-bottom: 0.9rem;
  }

  .pastpapers-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--white);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    transition: background var(--t), color var(--t);
  }

  .pastpapers-btn:hover {
    background: #000;
  }

  .badge-count {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    border: 1px solid var(--border-strong);
    padding: 0.1rem 0.55rem;
  }

  .badge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    padding: 1rem;
    list-style: none;
  }

  .badge-item {
    text-align: center;
  }

  .badge-img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    margin-inline: auto;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.25rem;
  }

  .badge-name {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--ink-2);
    letter-spacing: 0.03em;
  }

  .badge-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    background: var(--bg-soft);
    transition: color var(--t), background var(--t);
  }

  .badge-more:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .cal-head-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .cal-square {
    width: 8px;
    height: 8px;
    background: var(--ink);
    transform: rotate(45deg);
  }

  .cal-frame {
    padding: 1rem;
  }

  .cal-frame iframe {
    width: 100%;
    height: 480px;
    border: 0;
    display: block;
  }

  @media (max-width: 700px) {
    .cal-frame {
      padding: 0.5rem;
    }

    .cal-frame iframe {
      height: 420px;
    }
  }

  @media (max-width: 900px) {
    .main {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.2rem 0 2.5rem;
    }

    .services-module {
      display: none;
    }

    .col-left {
      order: 2;
    }

    .col-center {
      order: 1;
    }

    .col-right {
      order: 3;
    }

    .main .module {
      margin-bottom: 1rem;
    }

    .badge-grid {
      grid-template-columns: repeat(3, 1fr);
      padding: 0.85rem;
      gap: 0.6rem;
    }

    .badge-name {
      font-size: 0.72rem;
    }
  }
</style>
