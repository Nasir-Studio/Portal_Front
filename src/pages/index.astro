---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Announcements from '../components/Announcements.astro';

const services = [
  { name: '羊監視你', desc: '即時監視影像', href: '/cctv', external: false },
  { name: '羊集章', desc: '集章活動紀錄', href: '/badges/', external: false },
  { name: '羊愛考試', desc: '線上測驗系統', href: 'https://1ztests.nsir.uk', external: true },
  { name: '羊-短網址', desc: '網址縮短服務', href: 'https://nsir.uk', external: true },
];

const badges = [
  {
    img: '/certs/adobe-creativity-with-ai.png',
    name: 'Adobe × Pearson：Creativity with AI',
    url: 'https://www.credly.com/badges/dc78c48f-1fbb-4eac-afbf-b25e13ef7e1b/public_url',
  },
  {
    img: '/certs/genai-foundations.png',
    name: 'Generative AI Foundations',
    url: 'https://www.credly.com/badges/04543121-d04c-45ee-bb2d-b499752a10ae/public_url',
  },
  {
    img: '/certs/adobe-video-design.png',
    name: 'Adobe 影片設計專業認證',
    url: 'https://www.credly.com/badges/fa17ef56-fbd4-4f47-b7ae-ed9adc6755bf/public_url',
  },
  {
    img: '/certs/cisco-ccst.png',
    name: 'Cisco CCST 網路安全',
    url: 'https://www.credly.com/badges/28f42e0c-29a2-442a-a670-c9db938f638a/public_url',
  },
  {
    img: '/certs/adobe-premiere.png',
    name: 'Adobe Premiere 數位影音',
    url: 'https://www.credly.com/badges/3e176af8-edca-411e-8e52-6be837f644ac/public_url',
  },
  {
    img: '/certs/its-python.png',
    name: 'IT Specialist Python',
    url: 'https://www.credly.com/badges/7b8bbe2a-3bbd-4fdc-8ffc-7696c35876aa/public_url',
  },
];

// GitHub 貢獻：build 時抓取 repo 列表（失敗則顯示連結）
const ghRepos = await fetch(
  'https://api.github.com/users/Nasir-VM/repos?sort=updated&per_page=4&type=owner',
  { headers: { 'User-Agent': 'Portal_Front' } }
)
  .then((r) => (r.ok ? r.json() : []))
  .catch(() => []);
const ghError = !Array.isArray(ghRepos) || ghRepos.length === 0;
---

<BaseLayout>
  <Banner />
  <div class="main container">
    <aside class="col col-left">
      <section class="module services-module" aria-label="服務連結">
        <h2 class="module-title">服務連結</h2>
        <nav class="menu-list" aria-label="服務連結列表">
          {
            services.map((s) => (
              <a
                class="menu-item"
                href={s.href}
                target={s.external ? '_blank' : undefined}
                rel={s.external ? 'noopener noreferrer' : undefined}
              >
                <span class="menu-item-name">
                  {s.name}
                  <span class="menu-item-arrow" aria-hidden="true">{s.external ? '↗' : ''}</span>
                </span>
                <span class="menu-item-desc">{s.desc}</span>
              </a>
            ))
          }
        </nav>
      </section>

      <section class="module" aria-label="音樂播放器">
        <h2 class="module-title">音樂播放器</h2>
        <div class="music-frame">
          <iframe
            src="https://open.spotify.com/embed/track/31A4dKZXe19JOJig4ZTZRy?utm_source=generator&theme=0"
            title="Spotify 播放器 — Moonlight Sonata"
            width="100%"
            height="152"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
          ></iframe>
          <p class="music-caption">Moonlight Sonata — Beethoven</p>
        </div>
      </section>

      <section class="module" aria-label="GitHub 貢獻">
        <h2 class="module-title">GitHub 貢獻</h2>
        {
          ghError ? (
            <a class="gh-profile" href="https://github.com/Nasir-VM" target="_blank" rel="noopener noreferrer">
              <span class="gh-profile-name">Nasir-VM</span>
              <span class="gh-profile-meta">前往 GitHub 個人頁面 ↗</span>
            </a>
          ) : (
            <ul class="gh-list">
              {
                ghRepos.map((r) => (
                  <li>
                    <a class="gh-item" href={r.html_url} target="_blank" rel="noopener noreferrer">
                      <span class="gh-item-name">{r.name}</span>
                      <span class="gh-item-meta">
                        {r.language || '—'}
                        {r.stargazers_count > 0 ? ` · ★ ${r.stargazers_count}` : ''}
                      </span>
                    </a>
                  </li>
                ))
              }
              <li>
                <a class="gh-more" href="https://github.com/Nasir-VM" target="_blank" rel="noopener noreferrer">
                  前往 GitHub 個人頁面 ↗
                </a>
              </li>
            </ul>
          )
        }
      </section>

      <section class="module" aria-label="Buy Me a Coffee">
        <h2 class="module-title">Buy Me a Coffee</h2>
        <div class="bmc-body">
          <p class="bmc-text">喜歡這個網站的話，可以請我一杯咖啡 ☕</p>
          <a
            class="bmc-btn"
            href="https://www.buymeacoffee.com/YOUR_USERNAME"
            target="_blank"
            rel="noopener noreferrer"
          >
            請我喝咖啡
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </aside>

    <main class="col col-center">
      <Announcements />

      <section class="module calendar-module" aria-label="行事曆">
        <h2 class="module-title">
          <span class="cal-head-left">
            <span class="cal-square" aria-hidden="true"></span>
            行事曆
          </span>
        </h2>
        <div class="cal-frame">
          <iframe
            src="https://calendar.google.com/calendar/embed?src=bb049ab126a644ff77ce9a3dd0ad5c2aa0b1bd0272dd636a38dcfbabdd5aa7aa%40group.calendar.google.com&ctz=Asia%2FTaipei"
            title="Google 行事曆"
            loading="lazy"
            frameborder="0"
            scrolling="no"
          ></iframe>
        </div>
      </section>
    </main>

    <aside class="col col-right">
      <section class="module" aria-label="資格認證">
        <h2 class="module-title">
          <span>資格認證</span>
        </h2>
        <ul class="badge-grid">
          {
            badges.map((b) => (
              <li class="badge-item">
                <img class="badge-img" src={b.img} alt={b.name} width="120" loading="lazy" />
                <p class="badge-name">{b.name}</p>
              </li>
            ))
          }
        </ul>
        <a class="badge-more" href="https://nasirlin.net" target="_blank" rel="noopener noreferrer">
          查看更多資格認證
          <span aria-hidden="true">↗</span>
        </a>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .main {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 1.4rem;
    align-items: start;
    padding: 2rem 0 3.5rem;
  }

  .col-left {
    animation-delay: 0.05s;
  }

  .col-center {
    animation-delay: 0.12s;
  }

  .col-right {
    animation-delay: 0.2s;
  }

  .col-left,
  .col-center,
  .col-right {
    min-width: 0;
    animation: col-in 0.5s var(--ease) both;
  }

  @keyframes col-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .menu-item {
    display: block;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .menu-item:hover {
    background: var(--bg-soft);
  }

  .menu-item-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  .menu-item-arrow {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .menu-item-desc {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .badge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    padding: 1rem;
    list-style: none;
  }

  .badge-item {
    text-align: center;
  }

  .badge-img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    margin-inline: auto;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.25rem;
  }

  .badge-name {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--ink-2);
    letter-spacing: 0.03em;
  }

  .badge-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    background: var(--bg-soft);
    transition: color var(--t), background var(--t);
  }

  .badge-more:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .cal-head-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .music-frame {
    padding: 1rem 0.75rem;
  }

  .music-frame iframe {
    display: block;
    border: 1px solid var(--border);
  }

  .music-caption {
    margin-top: 0.6rem;
    font-size: 0.72rem;
    color: var(--ink-3);
    letter-spacing: 0.06em;
    text-align: center;
  }

  .gh-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gh-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .gh-item:hover {
    background: var(--bg-soft);
  }

  .gh-item-name {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .gh-item-meta {
    font-size: 0.72rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .gh-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    background: var(--bg-soft);
    transition: color var(--t), background var(--t);
  }

  .gh-more:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .gh-profile {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .gh-profile:hover {
    background: var(--bg-soft);
  }

  .gh-profile-name {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .gh-profile-meta {
    font-size: 0.74rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .bmc-body {
    padding: 1rem;
    text-align: center;
  }

  .bmc-text {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--ink-2);
    letter-spacing: 0.04em;
    margin-bottom: 0.9rem;
  }

  .bmc-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem;
    background: var(--ink);
    color: var(--white);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    transition: background var(--t);
  }

  .bmc-btn:hover {
    background: #000;
  }

  .cal-square {
    width: 8px;
    height: 8px;
    background: var(--ink);
    transform: rotate(45deg);
  }

  .cal-frame {
    padding: 1rem;
  }

  .cal-frame iframe {
    width: 100%;
    height: 480px;
    border: 0;
    display: block;
  }

  @media (max-width: 700px) {
    .cal-frame {
      padding: 0.5rem;
    }

    .cal-frame iframe {
      height: 420px;
    }
  }

  @media (max-width: 900px) {
    .main {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.2rem 0 2.5rem;
    }

    .services-module {
      display: none;
    }

    .col-left {
      order: 2;
    }

    .col-center {
      order: 1;
    }

    .col-right {
      order: 3;
    }

    .main .module {
      margin-bottom: 1rem;
    }

    .badge-grid {
      grid-template-columns: repeat(3, 1fr);
      padding: 0.85rem;
      gap: 0.6rem;
    }

    .badge-name {
      font-size: 0.72rem;
    }
  }
</style>
