---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Announcements from '../components/Announcements.astro';

const badges = [
  {
    img: '/Portal_Front/badges/adobe-creativity-with-ai.png',
    name: 'Adobe × Pearson：Creativity with AI',
    url: 'https://www.credly.com/badges/dc78c48f-1fbb-4eac-afbf-b25e13ef7e1b/public_url',
  },
  {
    img: '/Portal_Front/badges/genai-foundations.png',
    name: 'Generative AI Foundations',
    url: 'https://www.credly.com/badges/04543121-d04c-45ee-bb2d-b499752a10ae/public_url',
  },
  {
    img: '/Portal_Front/badges/adobe-video-design.png',
    name: 'Adobe 影片設計專業認證',
    url: 'https://www.credly.com/badges/fa17ef56-fbd4-4f47-b7ae-ed9adc6755bf/public_url',
  },
  {
    img: '/Portal_Front/badges/cisco-ccst.png',
    name: 'Cisco CCST 網路安全',
    url: 'https://www.credly.com/badges/28f42e0c-29a2-442a-a670-c9db938f638a/public_url',
  },
  {
    img: '/Portal_Front/badges/adobe-premiere.png',
    name: 'Adobe Premiere 數位影音',
    url: 'https://www.credly.com/badges/3e176af8-edca-411e-8e52-6be837f644ac/public_url',
  },
  {
    img: '/Portal_Front/badges/its-python.png',
    name: 'IT Specialist Python',
    url: 'https://www.credly.com/badges/7b8bbe2a-3bbd-4fdc-8ffc-7696c35876aa/public_url',
  },
];
---

<BaseLayout>
  <Banner />
  <div class="main container">
    <main class="col col-center">
      <Announcements />
    </main>

    <aside class="col col-right">
      <section class="module" aria-label="我的徽章">
        <h2 class="module-title">
          <span>我的徽章</span>
          <span class="badge-count">{badges.length} 枚</span>
        </h2>
        <ul class="badge-grid">
          {
            badges.map((b) => (
              <li class="badge-item">
                <img class="badge-img" src={b.img} alt={b.name} width="120" loading="lazy" />
                <p class="badge-name">{b.name}</p>
              </li>
            ))
          }
        </ul>
        <a class="badge-more" href="https://www.credly.com/users/nasir-lin" target="_blank" rel="noopener noreferrer">
          查看全部徽章
          <span aria-hidden="true">↗</span>
        </a>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 1.4rem;
    align-items: start;
    padding: 2rem 0 3.5rem;
  }

  .badge-count {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    border: 1px solid var(--border-strong);
    padding: 0.1rem 0.55rem;
  }

  .badge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    padding: 1rem;
    list-style: none;
  }

  .badge-item {
    text-align: center;
  }

  .badge-img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    margin-inline: auto;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.25rem;
  }

  .badge-name {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--ink-2);
    letter-spacing: 0.03em;
  }

  .badge-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    background: var(--bg-soft);
    transition: color var(--t), background var(--t);
  }

  .badge-more:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  @media (max-width: 900px) {
    .main {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.2rem 0 2.5rem;
    }

    /* 手機版順序：最新消息 → 我的徽章 */
    .col-center {
      order: 1;
    }

    .col-right {
      order: 2;
    }

    .main .module {
      margin-bottom: 1rem;
    }

    .badge-grid {
      padding: 0.85rem;
      gap: 0.6rem;
    }

    .badge-name {
      font-size: 0.72rem;
    }
  }

  /* 手機徽章縮小：三欄排列 */
  @media (max-width: 700px) {
    .badge-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }

    .badge-name {
      font-size: 0.66rem;
    }
  }
</style>
