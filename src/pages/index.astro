---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Announcements from '../components/Announcements.astro';

const services = [
  { name: '羊監視你', desc: '即時監視影像', href: 'https://cctv.nsir.uk' },
  { name: '羊集章', desc: '集章活動紀錄', href: 'https://badges.nsir.uk' },
  { name: '羊愛考試', desc: '線上測驗系統', href: 'https://1ztests.nsir.uk' },
  { name: '羊-短網址(nsir.uk)', desc: '網址縮短服務', href: 'https://nsir.uk' },
];

const badges = [
  {
    img: '/Portal_Front/badges/adobe-creativity-with-ai.png',
    name: 'Adobe × Pearson：Creativity with AI',
    url: 'https://www.credly.com/badges/dc78c48f-1fbb-4eac-afbf-b25e13ef7e1b/public_url',
  },
  {
    img: '/Portal_Front/badges/genai-foundations.png',
    name: 'Generative AI Foundations',
    url: 'https://www.credly.com/badges/04543121-d04c-45ee-bb2d-b499752a10ae/public_url',
  },
  {
    img: '/Portal_Front/badges/adobe-video-design.png',
    name: 'Adobe 影片設計專業認證',
    url: 'https://www.credly.com/badges/fa17ef56-fbd4-4f47-b7ae-ed9adc6755bf/public_url',
  },
  {
    img: '/Portal_Front/badges/cisco-ccst.png',
    name: 'Cisco CCST 網路安全',
    url: 'https://www.credly.com/badges/28f42e0c-29a2-442a-a670-c9db938f638a/public_url',
  },
  {
    img: '/Portal_Front/badges/adobe-premiere.png',
    name: 'Adobe Premiere 數位影音',
    url: 'https://www.credly.com/badges/3e176af8-edca-411e-8e52-6be837f644ac/public_url',
  },
  {
    img: '/Portal_Front/badges/its-python.png',
    name: 'IT Specialist Python',
    url: 'https://www.credly.com/badges/7b8bbe2a-3bbd-4fdc-8ffc-7696c35876aa/public_url',
  },
];
---

<BaseLayout>
  <Banner />
  <div class="main container">
    <aside class="col col-left">
      <section class="module" aria-label="服務連結">
        <h2 class="module-title">服務連結</h2>
        <nav class="menu-list" aria-label="服務連結列表">
          {
            services.map((s) => (
              <a class="menu-item" href={s.href} target="_blank" rel="noopener noreferrer">
                <span class="menu-item-name">
                  {s.name}
                  <span class="menu-item-arrow" aria-hidden="true">↗</span>
                </span>
                <span class="menu-item-desc">{s.desc}</span>
              </a>
            ))
          }
        </nav>
      </section>
    </aside>

    <main class="col col-center">
      <Announcements />
    </main>

    <aside class="col col-right">
      <section class="module" aria-label="我的徽章">
        <h2 class="module-title">
          <span>我的徽章</span>
          <span class="badge-count">{badges.length} 枚</span>
        </h2>
        <ul class="badge-grid">
          {
            badges.map((b) => (
              <li class="badge-item">
                <a href={b.url} target="_blank" rel="noopener noreferrer" title={b.name}>
                  <img class="badge-img" src={b.img} alt={b.name} width="120" height="120" loading="lazy" />
                </a>
                <p class="badge-name">{b.name}</p>
              </li>
            ))
          }
        </ul>
        <a class="badge-more" href="https://www.credly.com/users/nasir-lin" target="_blank" rel="noopener noreferrer">
          查看全部徽章
          <span aria-hidden="true">↗</span>
        </a>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .main {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 1.4rem;
    align-items: start;
    padding: 2rem 0 3.5rem;
  }

  .menu-item {
    display: block;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .menu-item:hover {
    background: var(--bg-soft);
  }

  .menu-item-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  .menu-item-arrow {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .menu-item-desc {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .badge-count {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    border: 1px solid var(--border-strong);
    padding: 0.1rem 0.55rem;
  }

  .badge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    padding: 1rem;
    list-style: none;
  }

  .badge-item {
    text-align: center;
  }

  .badge-img {
    width: 100%;
    max-width: 88px;
    margin-inline: auto;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .badge-name {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--ink-2);
    letter-spacing: 0.03em;
  }

  .badge-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    background: var(--bg-soft);
    transition: color var(--t), background var(--t);
  }

  .badge-more:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  @media (max-width: 900px) {
    .main {
      grid-template-columns: 1fr;
    }
  }
</style>
