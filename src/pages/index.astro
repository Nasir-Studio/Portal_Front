---
import BaseLayout from '../layouts/BaseLayout.astro';
import SheepLogo from '../components/SheepLogo.astro';
import Announcements from '../components/Announcements.astro';

const services = [
  { name: '羊監視你', desc: '即時監視影像', href: 'https://cctv.nsir.uk' },
  { name: '羊集章', desc: '集章活動紀錄', href: 'https://badges.nsir.uk' },
  { name: '羊愛考試', desc: '線上測驗系統', href: 'https://1ztests.nsir.uk' },
  { name: '羊-短網址(nsir.uk)', desc: '網址縮短服務', href: 'https://nsir.uk' },
];
---

<BaseLayout>
  <div class="main container">
    <aside class="col col-left">
      <section class="module" aria-label="服務連結">
        <h2 class="module-title">服務連結</h2>
        <nav class="menu-list" aria-label="服務連結列表">
          {
            services.map((s) => (
              <a class="menu-item" href={s.href} target="_blank" rel="noopener noreferrer">
                <span class="menu-item-name">
                  {s.name}
                  <span class="menu-item-arrow" aria-hidden="true">↗</span>
                </span>
                <span class="menu-item-desc">{s.desc}</span>
              </a>
            ))
          }
        </nav>
      </section>
    </aside>

    <main class="col col-center">
      <div class="welcome">
        <span class="welcome-mark" aria-hidden="true">■</span>
        你好！很高興為您服務！歡迎來到羊家入口，在這邊你可以選擇想要去瀏覽哪個服務
      </div>
      <Announcements />
    </main>

    <aside class="col col-right">
      <section class="module" aria-label="校徽">
        <h2 class="module-title">羊家的入口</h2>
        <div class="crest">
          <SheepLogo size={84} />
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .main {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 1.4rem;
    align-items: start;
    padding: 2.4rem 0 3.5rem;
  }

  .menu-item {
    display: block;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .menu-item:hover {
    background: var(--bg-soft);
  }

  .menu-item-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  .menu-item-arrow {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .menu-item-desc {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .welcome {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--ink);
    padding: 0.8rem 1.2rem;
    margin-bottom: 1.4rem;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }

  .welcome-mark {
    font-size: 0.7rem;
    color: var(--ink);
  }

  .crest {
    display: flex;
    justify-content: center;
    padding: 1.3rem 1rem 1.5rem;
  }

  @media (max-width: 900px) {
    .main {
      grid-template-columns: 1fr;
    }
  }
</style>
