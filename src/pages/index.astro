---
import BaseLayout from '../layouts/BaseLayout.astro';
import Announcements from '../components/Announcements.astro';

const services = [
  { name: '羊監視你', desc: '即時監視影像', href: 'https://cctv.nsir.uk' },
  { name: '羊集章', desc: '集章活動紀錄', href: 'https://badges.nsir.uk' },
  { name: '羊愛考試', desc: '線上測驗系統', href: 'https://1ztests.nsir.uk' },
  { name: '羊-短網址(nsir.uk)', desc: '網址縮短服務', href: 'https://nsir.uk' },
];
---

<BaseLayout>
  <div class="main container">
    <aside class="side" aria-label="服務連結">
      <section class="side-card side-links">
        <p class="side-title">服務連結</p>
        <nav class="side-links-list" aria-label="服務連結列表">
          {
            services.map((s) => (
              <a class="side-link" href={s.href} target="_blank" rel="noopener noreferrer">
                <span class="side-link-name">
                  {s.name}
                  <span class="side-link-arrow" aria-hidden="true">↗</span>
                </span>
                <span class="side-link-desc">{s.desc}</span>
              </a>
            ))
          }
        </nav>
      </section>
    </aside>

    <main class="main-col">
      <div class="welcome">
        <span class="welcome-mark" aria-hidden="true">■</span>
        你好！很高興為您服務！歡迎來到羊家入口，在這邊你可以選擇想要去瀏覽哪個服務
      </div>
      <Announcements />
    </main>
  </div>
</BaseLayout>

<style>
  .main {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1.4rem;
    align-items: start;
    padding: 2.4rem 0 3.5rem;
  }

  .side-card {
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .side-links {
    padding: 0;
  }

  .side-title {
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
    padding: 0.6rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--ink-2);
  }

  .side-link {
    display: block;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--t);
  }

  .side-link:last-child {
    border-bottom: none;
  }

  .side-link:hover {
    background: var(--bg-soft);
  }

  .side-link-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  .side-link-arrow {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .side-link-desc {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .main-col {
    min-width: 0;
  }

  .welcome {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--ink);
    padding: 0.8rem 1.2rem;
    margin-bottom: 1.4rem;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }

  .welcome-mark {
    font-size: 0.7rem;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .main {
      grid-template-columns: 1fr;
    }
  }
</style>
