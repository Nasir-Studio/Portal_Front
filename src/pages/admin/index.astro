---
import BlogLayout from '../../layouts/BlogLayout.astro';
---

<BlogLayout title="管理後台 — OviNas" description="VIP 問題專區管理與後台設定。">
  <div class="main-content">
  <div class="container" id="page-shell" hidden>
    <h1 class="page-title">管理後台</h1>
    <p class="page-sub">VIP 問題專區管理</p>

    <div id="admin-app"></div>
  </div>
  </div>
</BlogLayout>

<style is:global>
  .page-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    padding: 3rem 0 0.4rem;
  }

  .page-sub {
    margin-bottom: 1.6rem;
    font-size: 0.9rem;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }

  .forbidden {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid #a33;
    padding: 3.5rem 1.5rem;
    text-align: center;
  }

  .forbidden-code {
    font-family: var(--font-serif);
    font-size: 3.4rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #a33;
    line-height: 1.1;
  }

  .forbidden-msg {
    margin: 0.9rem 0 1.6rem;
    color: var(--ink-2);
    letter-spacing: 0.06em;
  }

  .view-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .view-head-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .view-head-actions {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .btn--sm {
    padding: 0.55rem 1.1rem;
    font-size: 0.88rem;
  }

  .btn--ghost {
    background: var(--surface);
    color: var(--ink);
  }

  .btn--ghost:hover {
    background: var(--bg-soft);
    color: var(--ink);
    border-color: var(--ink);
  }

  .btn--danger {
    background: var(--surface);
    color: #a33;
    border-color: #c99;
  }

  .btn--danger:hover {
    background: #f8ecea;
    color: #a33;
    border-color: #a33;
  }

  .ticket-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .ticket-item {
    display: flex;
    flex-direction: column;
  }

  .ticket-item.open .ticket-row {
    border-color: var(--ink);
    box-shadow: var(--shadow-soft);
  }

  .ticket-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    transition: color var(--t);
    flex-shrink: 0;
  }

  .ticket-item.open .ticket-chevron {
    color: var(--ink);
  }

  .ticket-detail {
    border: 1px solid var(--border);
    border-top: none;
    background: var(--surface);
  }

  .ticket-detail:empty {
    display: none;
  }

  .ticket-create {
    border: 1px dashed var(--border-strong);
    background: var(--surface);
    margin-bottom: 1rem;
  }

  .slot-empty {
    color: var(--ink-3);
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    text-align: center;
    padding: 1.6rem 0;
  }

  .ticket-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: border-color var(--t), box-shadow var(--t);
  }

  .ticket-row:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-soft);
  }

  .ticket-row-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .ticket-row-subject {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .ticket-row-meta {
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .status-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid;
    white-space: nowrap;
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .status-open {
    color: #4a6d8c;
    border-color: #b8c9d8;
    background: #eef3f7;
  }

  .status-replied {
    color: #3f6e4f;
    border-color: #bfd3c5;
    background: #eef5f0;
  }

  .status-closed {
    color: #8b8983;
    border-color: #d8d7d2;
    background: #f1f0ee;
  }

  .status-inactive {
    color: #a33;
    border-color: #d8b8b8;
    background: #f8eeee;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--ink-2);
    letter-spacing: 0.05em;
    white-space: nowrap;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.35rem 0.75rem;
    text-decoration: none;
    transition: color var(--t), border-color var(--t);
  }

  .back-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .detail-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--ink);
    margin-bottom: 1.4rem;
  }

  .detail-head {
    padding: 1.2rem 1.3rem 1rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1rem;
    flex-wrap: wrap;
  }

  .detail-subject {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .detail-meta {
    font-size: 0.8rem;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .detail-title {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .detail-side {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .detail-body {
    padding: 1.1rem 1.3rem;
    font-size: 0.95rem;
    color: var(--ink);
    white-space: pre-wrap;
    line-height: 1.9;
  }

  .detail-images {
    padding: 0 1.3rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .detail-images img {
    max-width: 100%;
    max-height: 220px;
    object-fit: cover;
    border: 1px solid var(--border);
    cursor: zoom-in;
  }

  .reply-list {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding: 0.6rem 0;
  }

  .reply-item {
    padding: 0.9rem 1.3rem;
  }

  .reply-item + .reply-item {
    border-top: 1px solid var(--border);
  }

  .reply-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .reply-author {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .reply-author.admin {
    color: #4a6d8c;
  }

  .reply-time {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .reply-body {
    font-size: 0.93rem;
    white-space: pre-wrap;
    line-height: 1.85;
  }

  .detail-actions {
    padding: 1.1rem 1.3rem 1.3rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .reply-form {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .reply-form textarea {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 0;
    color: var(--ink);
    resize: vertical;
    min-height: 72px;
  }

  .reply-form textarea:focus {
    outline: 2px solid var(--ink);
    outline-offset: 0;
    border-color: var(--ink);
  }

  .book-actions {
    display: flex;
    gap: 0.7rem;
    align-items: center;
  }

  .form-msg {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .form-msg.err {
    color: #a33;
  }

  .admin-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .admin-owner {
    font-size: 0.82rem;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .admin-btns {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--ink);
    margin-bottom: 1.4rem;
    animation: module-in 0.3s var(--ease) both;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.3rem;
    border-bottom: 1px solid var(--border);
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .card-sub {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  .user-create-form {
    padding: 1rem 1.3rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    border-bottom: 1px solid var(--border);
  }

  .user-create-form input,
  .admin-create-form input,
  .admin-create-form select,
  .admin-create-form textarea {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.55rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 0;
    color: var(--ink);
  }

  .user-create-form input:focus,
  .admin-create-form input:focus,
  .admin-create-form select:focus,
  .admin-create-form textarea:focus {
    outline: 2px solid var(--ink);
    outline-offset: 0;
    border-color: var(--ink);
  }

  .admin-create-form {
    padding: 1rem 1.3rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .admin-create-form select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-3) 50%),
      linear-gradient(135deg, var(--ink-3) 50%, transparent 50%);
    background-position: calc(100% - 1rem) 55%, calc(100% - 0.65rem) 55%;
    background-size: 0.35rem 0.35rem;
    background-repeat: no-repeat;
    padding-right: 2.2rem;
    cursor: pointer;
  }

  .admin-create-form textarea {
    resize: vertical;
    line-height: 1.5;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-label {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }

  .user-list {
    display: flex;
    flex-direction: column;
  }

  .user-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1.3rem;
    flex-wrap: wrap;
  }

  .user-row + .user-row {
    border-top: 1px solid var(--border);
  }

  .user-row-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .user-row-email {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .user-row-meta {
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .user-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
</style>

<script>
  import { api, ApiError } from '../../scripts/api';
  import { currentUser, isAdmin, logout, requireAdmin } from '../../scripts/auth';
  import { connectTicketSocket } from '../../scripts/ticket-socket';

  requireAdmin('/admin/');
  const shell = document.getElementById('page-shell');
  if (shell) shell.hidden = false;

  type TicketSummary = {
    id: number;
    subject: string;
    status: 'open' | 'replied' | 'closed';
    createdAt: number;
    userId?: number;
  };

  type Reply = {
    id: number;
    authorRole: 'admin' | 'member';
    authorId: number | null;
    body: string;
    createdAt: number;
  };

  type TicketImage = {
    id: number;
    url: string;
    createdAt: number;
  };

  type TicketDetail = {
    id: number;
    subject: string;
    body: string;
    status: 'open' | 'replied' | 'closed';
    createdAt: number;
    replies: Reply[];
    images: TicketImage[];
  };

  type AdminUser = {
    id: number;
    email: string;
    role: 'admin' | 'member';
    displayName: string;
    active: boolean;
    createdAt: number;
    lastLoginAt: number | null;
  };

  const TZ = 'Asia/Taipei';
  const app = document.querySelector('#admin-app');
  if (app === null) throw new Error('admin-app not found');

  const STATUS_LABEL: Record<TicketSummary['status'], string> = {
    open: '待處理',
    replied: '已回覆',
    closed: '已關閉',
  };

  function fmtDate(ts: number): string {
    return new Intl.DateTimeFormat('zh-TW', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).format(ts * 1000);
  }

  function badge(status: TicketSummary['status']): HTMLSpanElement {
    const el = document.createElement('span');
    el.className = `status-badge status-${status}`;
    el.textContent = STATUS_LABEL[status];
    return el;
  }

  {
    const user = currentUser()!;
    const wrap = document.createElement('div');
    wrap.className = 'view-list';

    const head = document.createElement('div');
    head.className = 'view-head';
    const title = document.createElement('span');
    title.className = 'view-head-title';
    title.textContent = '全部工單';
    const actions = document.createElement('div');
    actions.className = 'view-head-actions';
    const usersBtn = document.createElement('button');
    usersBtn.className = 'btn btn--sm btn--ghost';
    usersBtn.type = 'button';
    usersBtn.textContent = '會員管理';
    const createTicketBtn = document.createElement('button');
    createTicketBtn.className = 'btn btn--sm';
    createTicketBtn.type = 'button';
    createTicketBtn.textContent = '＋ 開工單';
    createTicketBtn.addEventListener('click', () => {
      openCreateCard();
    });
    const logoutBtn = document.createElement('button');
    logoutBtn.className = 'btn btn--sm btn--ghost';
    logoutBtn.type = 'button';
    logoutBtn.textContent = `登出${user !== null ? `（${user.email}）` : ''}`;
    logoutBtn.addEventListener('click', async () => {
      await logout();
      window.location.href = '/login/';
    });
    actions.append(usersBtn, createTicketBtn, logoutBtn);
    head.append(title, actions);

    const listEl = document.createElement('div');
    listEl.className = 'ticket-list';
    listEl.innerHTML = '<p class="slot-empty">載入中…</p>';

    const createCard = document.createElement('div');
    createCard.className = 'card ticket-create';
    createCard.hidden = true;
    const createHead = document.createElement('div');
    createHead.className = 'card-head';
    const createTitle = document.createElement('h2');
    createTitle.className = 'card-title';
    createTitle.textContent = '開工單給會員';
    const createCancel = document.createElement('button');
    createCancel.className = 'btn btn--sm btn--ghost';
    createCancel.type = 'button';
    createCancel.textContent = '取消';
    createHead.append(createTitle, createCancel);
    const adminTicketForm = document.createElement('form');
    adminTicketForm.className = 'admin-create-form';
    const adminCreateSub = document.createElement('p');
    adminCreateSub.className = 'card-sub';
    adminCreateSub.textContent = '選擇會員並填寫主旨與內容，送出後會員會在工單區收到';
    const memberField = document.createElement('label');
    memberField.className = 'field';
    const memberLabel = document.createElement('span');
    memberLabel.className = 'field-label';
    memberLabel.textContent = '會員';
    const memberSelect = document.createElement('select');
    memberField.append(memberLabel, memberSelect);
    const subjectField = document.createElement('label');
    subjectField.className = 'field';
    const subjectLabel = document.createElement('span');
    subjectLabel.className = 'field-label';
    subjectLabel.textContent = '主旨';
    const subjectInput = document.createElement('input');
    subjectInput.type = 'text';
    subjectInput.maxLength = 100;
    subjectField.append(subjectLabel, subjectInput);
    const bodyField = document.createElement('label');
    bodyField.className = 'field';
    const bodyLabel = document.createElement('span');
    bodyLabel.className = 'field-label';
    bodyLabel.textContent = '內容';
    const bodyInput = document.createElement('textarea');
    bodyInput.rows = 4;
    bodyInput.maxLength = 2000;
    bodyField.append(bodyLabel, bodyInput);
    const adminCreateActions = document.createElement('div');
    adminCreateActions.className = 'book-actions';
    const adminCreateSubmit = document.createElement('button');
    adminCreateSubmit.className = 'btn';
    adminCreateSubmit.type = 'submit';
    adminCreateSubmit.textContent = '送出';
    const adminCreateMsg = document.createElement('span');
    adminCreateMsg.className = 'form-msg';
    adminCreateActions.append(adminCreateSubmit, adminCreateMsg);
    adminTicketForm.append(adminCreateSub, memberField, subjectField, bodyField, adminCreateActions);
    createCard.append(createHead, adminTicketForm);
    createCancel.addEventListener('click', () => {
      createCard.hidden = true;
      adminCreateMsg.hidden = false;
      adminCreateMsg.textContent = '';
    });
    adminTicketForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const userId = Number(memberSelect.value);
      const subject = subjectInput.value.trim();
      const body = bodyInput.value.trim();
      if (!Number.isInteger(userId) || userId <= 0) {
        adminCreateMsg.textContent = '請選擇會員';
        adminCreateMsg.className = 'form-msg err';
        adminCreateMsg.hidden = false;
        return;
      }
      if (subject.length === 0 || body.length === 0) {
        adminCreateMsg.textContent = '請填寫主旨與內容';
        adminCreateMsg.className = 'form-msg err';
        adminCreateMsg.hidden = false;
        return;
      }
      adminCreateSubmit.disabled = true;
      adminCreateMsg.hidden = true;
      try {
        const result = await api<{ ticket: { id: number } }>('/admin/tickets', {
          method: 'POST',
          body: { userId, subject, body },
          auth: true,
        });
        adminCreateMsg.textContent = `已開單 ${result.ticket.id}`;
        adminCreateMsg.className = 'form-msg';
        adminCreateMsg.hidden = false;
        memberSelect.value = '';
        subjectInput.value = '';
        bodyInput.value = '';
        void loadTickets();
      } catch (err) {
        if (err instanceof ApiError && err.status === 401) {
          window.location.href = '/login/';
          return;
        }
        adminCreateMsg.textContent = '開單失敗，請稍後再試';
        adminCreateMsg.className = 'form-msg err';
        adminCreateMsg.hidden = false;
        adminCreateSubmit.disabled = false;
      }
    });

    wrap.append(head, listEl, createCard);

    const usersCard = document.createElement('div');
    usersCard.className = 'card';
    usersCard.hidden = true;

    const usersHead = document.createElement('div');
    usersHead.className = 'card-head';
    const usersTitle = document.createElement('h2');
    usersTitle.className = 'card-title';
    usersTitle.textContent = '會員管理';
    const usersBack = document.createElement('button');
    usersBack.className = 'btn btn--sm btn--ghost';
    usersBack.type = 'button';
    usersBack.textContent = '← 返回工單';
    usersHead.append(usersTitle, usersBack);
    usersCard.append(usersHead);

    const createForm = document.createElement('form');
    createForm.className = 'user-create-form';
    const createSub = document.createElement('p');
    createSub.className = 'card-sub';
    createSub.textContent = '新增 VIP 會員帳號';
    const emailField = document.createElement('label');
    emailField.className = 'field';
    const emailLabel = document.createElement('span');
    emailLabel.className = 'field-label';
    emailLabel.textContent = 'Email';
    const emailInput = document.createElement('input');
    emailInput.type = 'email';
    emailInput.maxLength = 254;
    emailInput.autocomplete = 'off';
    emailInput.required = true;
    emailField.append(emailLabel, emailInput);
    const pwField = document.createElement('label');
    pwField.className = 'field';
    const pwLabel = document.createElement('span');
    pwLabel.className = 'field-label';
    pwLabel.textContent = '密碼（至少 6 碼）';
    const pwInput = document.createElement('input');
    pwInput.type = 'text';
    pwInput.minLength = 6;
    pwInput.maxLength = 200;
    pwInput.autocomplete = 'off';
    pwInput.required = true;
    pwField.append(pwLabel, pwInput);
    const nameField = document.createElement('label');
    nameField.className = 'field';
    const nameLabel = document.createElement('span');
    nameLabel.className = 'field-label';
    nameLabel.textContent = '顯示名稱（選填）';
    const nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.maxLength = 50;
    nameInput.autocomplete = 'off';
    nameField.append(nameLabel, nameInput);
    const createMsg = document.createElement('p');
    createMsg.className = 'form-msg';
    createMsg.hidden = true;
    const createActions = document.createElement('div');
    createActions.className = 'book-actions';
    const createBtn = document.createElement('button');
    createBtn.className = 'btn';
    createBtn.type = 'submit';
    createBtn.textContent = '建立帳號';
    createActions.append(createBtn);
    createForm.append(createSub, emailField, pwField, nameField, createMsg, createActions);
    usersCard.append(createForm);

    const userList = document.createElement('div');
    userList.className = 'user-list';
    userList.innerHTML = '<p class="slot-empty">載入中…</p>';
    usersCard.append(userList);

    wrap.append(usersCard);
    app.replaceChildren(wrap);

    let currentView: 'list' | 'users' = 'list';
    let expandedId: number | null = null;

    function showList(): void {
      currentView = 'list';
      listEl.hidden = false;
      usersCard.hidden = true;
      head.hidden = false;
      title.textContent = '全部工單';
      void loadTickets();
      window.scrollTo({ top: 0, behavior: 'instant' });
    }

    function showUsers(): void {
      currentView = 'users';
      expandedId = null;
      listEl.hidden = true;
      usersCard.hidden = false;
      head.hidden = true;
      void loadUsers();
      window.scrollTo({ top: 0, behavior: 'instant' });
    }

    function toggleTicket(id: number): void {
      if (expandedId === id) {
        collapseDetail();
        return;
      }
      collapseDetail();
      expandedId = id;
      void openDetail(id);
    }

    function collapseDetail(): void {
      if (expandedId === null) return;
      const item = findTicketItem(expandedId);
      if (item !== null) {
        item.classList.remove('open');
        const slot = item.querySelector<HTMLElement>('.ticket-detail');
        if (slot !== null) slot.hidden = true;
      }
      expandedId = null;
    }

    function findTicketItem(id: number): HTMLElement | null {
      return listEl.querySelector(`.ticket-item[data-id="${id}"]`);
    }

    async function loadTickets(): Promise<void> {
      const hasContent = listEl.querySelector('.ticket-row') !== null;
      if (!hasContent) listEl.innerHTML = '<p class="slot-empty">載入中…</p>';
      try {
        const data = await api<{ tickets: TicketSummary[] }>('/admin/tickets', { auth: true });
        renderList(data.tickets);
        if (expandedId !== null) {
          const item = findTicketItem(expandedId);
          if (item === null) {
            expandedId = null;
          } else {
            void openDetail(expandedId);
          }
        }
      } catch (err) {
        if (err instanceof ApiError && err.status === 401) {
          window.location.href = '/login/';
          return;
        }
        if (!hasContent) listEl.innerHTML = '<p class="slot-empty">無法載入工單，請稍後再試</p>';
      }
    }

    function renderList(tickets: TicketSummary[]): void {
      if (tickets.length === 0) {
        listEl.innerHTML = '<p class="slot-empty">尚無工單</p>';
        return;
      }
      listEl.replaceChildren(
        ...tickets.map((t) => {
          const item = document.createElement('div');
          item.className = 'ticket-item';
          item.dataset.id = String(t.id);

          const row = document.createElement('article');
          row.className = 'ticket-row';
          row.tabIndex = 0;
          row.setAttribute('role', 'button');
          row.setAttribute('aria-expanded', 'false');
          row.addEventListener('click', () => toggleTicket(t.id));
          row.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              toggleTicket(t.id);
            }
          });

          const info = document.createElement('div');
          info.className = 'ticket-row-info';
          const subject = document.createElement('span');
          subject.className = 'ticket-row-subject';
          subject.textContent = t.subject;
          const meta = document.createElement('span');
          meta.className = 'ticket-row-meta';
          meta.textContent = `#${t.id} · ${fmtDate(t.createdAt)}`;
          if (t.userId !== undefined) meta.textContent += ` · 會員 #${t.userId}`;
          info.append(subject, meta);

          const chevron = document.createElement('span');
          chevron.className = 'ticket-chevron';
          chevron.textContent = '▾';

          row.append(info, badge(t.status), chevron);

          const detail = document.createElement('div');
          detail.className = 'ticket-detail';
          detail.hidden = true;

          item.append(row, detail);
          return item;
        }),
      );
    }

    async function openDetail(id: number): Promise<void> {
      const item = findTicketItem(id);
      if (item === null) return;
      const slot = item.querySelector<HTMLElement>('.ticket-detail');
      if (slot === null) return;
      item.classList.add('open');
      const row = item.querySelector('.ticket-row');
      if (row !== null) row.setAttribute('aria-expanded', 'true');
      slot.hidden = false;
      const hasContent = slot.querySelector('.detail-subject') !== null;
      if (!hasContent) slot.innerHTML = '<p class="slot-empty">載入中…</p>';
      try {
        const data = await api<{ ticket: TicketDetail; userId?: number }>(`/admin/tickets/${id}`, {
          auth: true,
        });
        renderDetail(data.ticket, data.userId, slot);
      } catch (err) {
        if (err instanceof ApiError && err.status === 401) {
          window.location.href = '/login/';
          return;
        }
        if (!hasContent) slot.innerHTML = '<p class="slot-empty">無法載入工單</p>';
      }
    }

    function renderDetail(ticket: TicketDetail, ownerId: number | undefined, slot: HTMLElement): void {
      const card = document.createElement('div');
      card.className = 'detail-card-body';

      const headEl = document.createElement('div');
      headEl.className = 'detail-head';

      const titleWrap = document.createElement('div');
      titleWrap.className = 'detail-title';
      const subject = document.createElement('h2');
      subject.className = 'detail-subject';
      subject.textContent = ticket.subject;
      const meta = document.createElement('span');
      meta.className = 'detail-meta';
      meta.textContent = `#${ticket.id} · ${fmtDate(ticket.createdAt)}`;
      titleWrap.append(subject, meta);

      const sideWrap = document.createElement('div');
      sideWrap.className = 'detail-side';
      sideWrap.append(badge(ticket.status));

      headEl.append(titleWrap, sideWrap);

      const body = document.createElement('p');
      body.className = 'detail-body';
      body.textContent = ticket.body;

      const images = document.createElement('div');
      images.className = 'detail-images';
      for (const img of ticket.images) {
        const el = document.createElement('img');
        el.alt = `附件 ${img.id}`;
        el.src = img.url;
        el.addEventListener('click', () => window.open(img.url, '_blank'));
        images.append(el);
      }

      const replies = document.createElement('div');
      replies.className = 'reply-list';
      if (ticket.replies.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'slot-empty';
        empty.textContent = '尚無回覆';
        replies.append(empty);
      } else {
        for (const r of ticket.replies) {
          const item = document.createElement('div');
          item.className = 'reply-item';
          const rHead = document.createElement('div');
          rHead.className = 'reply-head';
          const author = document.createElement('span');
          author.className = `reply-author${r.authorRole === 'admin' ? ' admin' : ''}`;
          author.textContent = r.authorRole === 'admin' ? '管理員' : '會員';
          const time = document.createElement('span');
          time.className = 'reply-time';
          time.textContent = fmtDate(r.createdAt);
          rHead.append(author, time);
          const rBody = document.createElement('p');
          rBody.className = 'reply-body';
          rBody.textContent = r.body;
          item.append(rHead, rBody);
          replies.append(item);
        }
      }

      const actions = document.createElement('div');
      actions.className = 'detail-actions';

      const replyForm = document.createElement('form');
      replyForm.className = 'reply-form';
      const replyTextarea = document.createElement('textarea');
      replyTextarea.placeholder = '輸入回覆內容…';
      replyTextarea.rows = 3;
      const replyActions = document.createElement('div');
      replyActions.className = 'book-actions';
      const replySubmit = document.createElement('button');
      replySubmit.type = 'submit';
      replySubmit.className = 'btn';
      replySubmit.textContent = '送出回覆';
      const replyMsg = document.createElement('span');
      replyMsg.className = 'form-msg';
      replyActions.append(replySubmit, replyMsg);
      replyForm.append(replyTextarea, replyActions);
      replyForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const text = replyTextarea.value.trim();
        if (text.length === 0) return;
        replySubmit.disabled = true;
        replyMsg.textContent = '';
        try {
          await api<{ reply: { id: number } }>(`/admin/tickets/${ticket.id}/replies`, {
            method: 'POST',
            body: { body: text },
            auth: true,
          });
          await openDetail(ticket.id);
        } catch {
          replyMsg.textContent = '送出失敗，請稍後再試';
          replyMsg.className = 'form-msg err';
          replySubmit.disabled = false;
        }
      });
      actions.append(replyForm);

      const adminRow = document.createElement('div');
      adminRow.className = 'admin-row';
      const owner = document.createElement('span');
      owner.className = 'admin-owner';
      owner.textContent = ownerId !== undefined ? `會員編號 #${ownerId}` : '';
      const btnGroup = document.createElement('div');
      btnGroup.className = 'admin-btns';
      if (ticket.status !== 'closed') {
        const closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.className = 'btn btn--sm btn--danger';
        closeBtn.textContent = '關閉工單';
        closeBtn.addEventListener('click', async () => {
          closeBtn.disabled = true;
          try {
            await api<void>(`/admin/tickets/${ticket.id}/status`, {
              method: 'PATCH',
              body: { status: 'closed' },
              auth: true,
            });
            await openDetail(ticket.id);
          } catch {
            closeBtn.disabled = false;
          }
        });
        btnGroup.append(closeBtn);
      }
      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'btn btn--sm btn--danger';
      deleteBtn.textContent = '刪除工單';
      deleteBtn.addEventListener('click', async () => {
        if (!window.confirm(`確定要刪除工單 #${ticket.id} 嗎？此操作無法復原。`)) return;
        deleteBtn.disabled = true;
        try {
          await api<void>(`/admin/tickets/${ticket.id}`, { method: 'DELETE', auth: true });
          showList();
        } catch {
          deleteBtn.disabled = false;
          window.alert('刪除失敗，請稍後再試');
        }
      });
      btnGroup.append(deleteBtn);
      adminRow.append(owner, btnGroup);
      actions.append(adminRow);

      card.append(headEl, body, images, replies, actions);
      slot.replaceChildren(card);
    }

    function userStatusBadge(active: boolean): HTMLSpanElement {
      const el = document.createElement('span');
      el.className = `status-badge ${active ? 'status-replied' : 'status-inactive'}`;
      el.textContent = active ? '啟用中' : '已停用';
      return el;
    }

    async function loadUsers(): Promise<void> {
      userList.innerHTML = '<p class="slot-empty">載入中…</p>';
      try {
        const data = await api<{ users: AdminUser[] }>('/admin/users', { auth: true });
        renderUsers(data.users);
      } catch (err) {
        if (err instanceof ApiError && err.status === 401) {
          window.location.href = '/login/';
          return;
        }
        userList.innerHTML = '<p class="slot-empty">無法載入會員列表</p>';
      }
    }

    function renderUsers(users: AdminUser[]): void {
      if (users.length === 0) {
        userList.innerHTML = '<p class="slot-empty">尚無會員</p>';
        return;
      }
      userList.replaceChildren(
        ...users.map((u) => {
          const row = document.createElement('div');
          row.className = 'user-row';

          const info = document.createElement('div');
          info.className = 'user-row-info';
          const email = document.createElement('span');
          email.className = 'user-row-email';
          email.textContent = u.email;
          const meta = document.createElement('span');
          meta.className = 'user-row-meta';
          meta.textContent = `#${u.id} · ${u.role === 'admin' ? '管理員' : 'VIP 會員'} · 註冊 ${fmtDate(u.createdAt)}`;
          if (u.displayName.length > 0) meta.textContent += ` · ${u.displayName}`;
          meta.textContent += ` · 最後登入 ${u.lastLoginAt === null ? '從未登入' : fmtDate(u.lastLoginAt)}`;
          info.append(email, meta);

          const right = document.createElement('div');
          right.className = 'user-actions';
          right.append(userStatusBadge(u.active));

          if (u.role === 'member') {
            const toggleBtn = document.createElement('button');
            toggleBtn.type = 'button';
            toggleBtn.className = 'btn btn--sm btn--ghost';
            toggleBtn.textContent = u.active ? '停用' : '啟用';
            toggleBtn.addEventListener('click', async () => {
              if (!window.confirm(`確定要${u.active ? '停用' : '啟用'} ${u.email} 嗎？`)) return;
              toggleBtn.disabled = true;
              try {
                await api<void>(`/admin/users/${u.id}/active`, {
                  method: 'PATCH',
                  body: { active: !u.active },
                  auth: true,
                });
                await loadUsers();
              } catch {
                toggleBtn.disabled = false;
              }
            });
            right.append(toggleBtn);

            const pwBtn = document.createElement('button');
            pwBtn.type = 'button';
            pwBtn.className = 'btn btn--sm btn--ghost';
            pwBtn.textContent = '重置密碼';
            pwBtn.addEventListener('click', async () => {
              const next = window.prompt(`為 ${u.email} 設定新密碼（至少 6 碼）：`);
              if (next === null) return;
              if (next.length < 6) {
                window.alert('密碼至少 6 碼');
                return;
              }
              pwBtn.disabled = true;
              try {
                await api<void>(`/admin/users/${u.id}/password`, {
                  method: 'PATCH',
                  body: { password: next },
                  auth: true,
                });
                window.alert('密碼已更新');
              } catch {
                window.alert('更新失敗，請稍後再試');
              } finally {
                pwBtn.disabled = false;
              }
            });
            right.append(pwBtn);
          }

          row.append(info, right);
          return row;
        }),
      );
    }

    usersBtn.addEventListener('click', showUsers);
    usersBack.addEventListener('click', showList);

    createForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = emailInput.value.trim().toLowerCase();
      const password = pwInput.value;
      if (email.length === 0 || password.length === 0) {
        createMsg.textContent = '請填寫 Email 與密碼';
        createMsg.className = 'form-msg err';
        createMsg.hidden = false;
        return;
      }
      createBtn.disabled = true;
      createMsg.hidden = true;
      try {
        await api<{ user: { id: number; email: string } }>('/admin/users', {
          method: 'POST',
          body: {
            email,
            password,
            displayName: nameInput.value.trim(),
          },
          auth: true,
        });
        emailInput.value = '';
        pwInput.value = '';
        nameInput.value = '';
        createMsg.textContent = '帳號已建立';
        createMsg.className = 'form-msg';
        createMsg.hidden = false;
        void loadUsers();
      } catch (err) {
        if (err instanceof ApiError) {
          if (err.code === 'email_taken') createMsg.textContent = '此 Email 已被使用';
          else if (err.code === 'validation_failed') createMsg.textContent = '請檢查輸入內容（密碼至少 6 碼）';
          else createMsg.textContent = '建立失敗，請稍後再試';
        } else {
          createMsg.textContent = '建立失敗';
        }
        createMsg.className = 'form-msg err';
        createMsg.hidden = false;
        createBtn.disabled = false;
      }
    });

    void loadTickets();

    let refreshTimer: ReturnType<typeof setTimeout> | null = null;
    const refreshView = (): void => {
      if (refreshTimer !== null) clearTimeout(refreshTimer);
      refreshTimer = setTimeout(() => {
        refreshTimer = null;
        if (currentView === 'list') {
          void loadTickets();
        }
      }, 400);
    };

    function openCreateCard(): void {
      adminCreateMsg.hidden = true;
      adminCreateMsg.textContent = '';
      adminCreateSubmit.disabled = false;
      memberSelect.value = '';
      subjectInput.value = '';
      bodyInput.value = '';
      createCard.hidden = false;
      void populateMemberOptions();
    }

    async function populateMemberOptions(): Promise<void> {
      memberSelect.replaceChildren();
      const loading = document.createElement('option');
      loading.value = '';
      loading.textContent = '載入會員…';
      memberSelect.append(loading);
      try {
        const data = await api<{ users: AdminUser[] }>('/admin/users', { auth: true });
        memberSelect.replaceChildren();
        if (data.users.length === 0) {
          const none = document.createElement('option');
          none.value = '';
          none.textContent = '尚無會員';
          memberSelect.append(none);
          return;
        }
        for (const u of data.users) {
          const opt = document.createElement('option');
          opt.value = String(u.id);
          opt.textContent = `#${u.id} ${u.email}`;
          memberSelect.append(opt);
        }
      } catch {
        memberSelect.replaceChildren();
        const none = document.createElement('option');
        none.value = '';
        none.textContent = '無法載入會員';
        memberSelect.append(none);
      }
    }
    connectTicketSocket((event) => {
      if (currentView !== 'list') return;
      if (event.event === 'deleted' && expandedId === event.ticketId) {
        expandedId = null;
      }
      refreshView();
    });
  }
</script>
