---
import BlogLayout from '../layouts/BlogLayout.astro';
import posts from '../data/posts';

const popularPosts = posts.slice(0, 3);
---

<BlogLayout title="VIP 專區 — OviNas" description="OviNas VIP 會員專屬權限、技術支援工單與站長時段預約系統。">
  <div class="main-content">
    <div class="container">
      <!-- 麵包屑導航 (Breadcrumbs) -->
      <div class="breadcrumbs">
        <a href="/" class="home">首頁</a>
        <span class="sep">&gt;</span>
        <span class="current-post-name">VIP 專區</span>
      </div>

      <!-- 🔷 1. 左右交換 + 正方形 1:1 圖片之 Hero Header -->
      <section class="content-hero-header hero-reversed">
        <!-- 左側：1:1 正方形圖片 (Square Banner) -->
        <div class="hero-square-col">
          <div class="slider-wrap-header">
            <div class="slider-one">
              <div class="img-wrap square-wrap">
                <div class="bgs bgs1"></div>
                <div class="bgs bgs2"></div>
                <div class="bgs bgs3"></div>
                <div class="bgs bgs4"></div>
                <div class="bgs bgs5 hero-featured-link">
                  <div class="featured-img-container square-img-container">
                    <img src="/banners/hero-promo-v3.jpg?v=20260820light" alt="OviNas VIP" class="featured-main-img square-img" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 右側：VIP 標題與快捷按鈕 -->
        <div class="hero-text-col">
          <h3>VIP ZONE</h3>
          <h2>VIP</h2>
          <div class="hero-quick-btns">
            <a href="#ticketSection" class="btn-about-hero">問題工單 ↓</a>
            <a href="#calendarSection" class="btn-about-hero" style="background:#334155;">站長行事曆 ↓</a>
          </div>
        </div>
      </section>

      <!-- 📰 2. 雙欄主內容區 (左側 68% + 右側 28% 側邊欄) -->
      <div class="content-area-top">
        <div class="left">
          <!-- 👤 Section 1: VIP 會員中心基本資料 -->
          <div class="post-area-head">
            <h2 class="post-area-title">VIP 會員中心</h2>
          </div>

          <div class="vip-card-box" id="vip-card-box">
            <div class="vip-loading-state" id="vip-loading-text">
              正在驗證 VIP 會員身份，請稍候…
            </div>
            <div class="vip-user" id="vip-body" style="display: none;">
              <!-- JS 動態填入會員資料 -->
            </div>
          </div>

          <!-- 🎫 Section 2: 問題工單 (Tickets) -->
          <div class="post-area-head" id="ticketSection" style="margin-top: 3.5rem;">
            <h2 class="post-area-title">問題工單</h2>
            <button class="btn btn--sm" id="btn-toggle-ticket" type="button">+ 建立新工單</button>
          </div>

          <!-- 新建工單表單 (點擊切換展開) -->
          <div class="ticket-form-card" id="new-ticket-card" style="display: none;">
            <form id="new-ticket-form">
              <div class="form-field">
                <label for="nt-subject">問題主旨 *</label>
                <input id="nt-subject" type="text" name="subject" maxlength="120" placeholder="例如：網站部屬問題 / 資安諮詢" required class="form-input" />
              </div>
              <div class="form-field">
                <label for="nt-body">問題詳述 *</label>
                <textarea id="nt-body" name="body" rows="4" maxlength="4000" placeholder="請詳細描述您遇到的問題或需求…" required class="form-input form-textarea"></textarea>
              </div>
              <p class="form-msg err" id="nt-msg" style="display:none"></p>
              <div class="form-actions">
                <button class="btn" type="submit" id="nt-submit-btn">送出工單</button>
                <button class="btn btn--ghost" id="nt-cancel-btn" type="button">取消</button>
              </div>
            </form>
          </div>

          <!-- 我的工單列表 -->
          <div class="ticket-list" id="ticket-list">
            <p class="slot-empty">正在載入專屬工單紀錄…</p>
          </div>

          <!-- 📅 Section 3: 站長行事曆 -->
          <div class="post-area-head" id="calendarSection" style="margin-top: 4rem;">
            <h2 class="post-area-title">站長行事曆</h2>
          </div>

          <div class="blog-cal-frame" style="margin-bottom: 2.2rem;">
            <iframe
              src="https://calendar.google.com/calendar/embed?src=bb049ab126a644ff77ce9a3dd0ad5c2aa0b1bd0272dd636a38dcfbabdd5aa7aa%40group.calendar.google.com&ctz=Asia%2FTaipei"
              title="OviNas 站長行事曆"
              loading="lazy"
              frameborder="0"
              scrolling="no"
            ></iframe>
          </div>

          <!-- 開放預約時段列表 -->
          <div class="slot-list" id="slot-list">
            <p class="slot-empty">正在載入開放時段…</p>
          </div>

          <!-- VIP 會員歷史預約紀錄 -->
          <div id="mine-reservations-section" style="display:none; margin-top: 3rem;">
            <div class="post-area-head">
              <h2 class="post-area-title">我的預約紀錄</h2>
              <span class="cal-sub-label">您的專屬預約歷史與確認狀態</span>
            </div>
            <div class="mine-list" id="mine-reservations-list">
              <p class="slot-empty">載入中…</p>
            </div>
          </div>
        </div>

        <!-- 📌 右側側邊欄 (比照首頁 28% 側邊欄) -->
        <aside class="right sidebar-right">
          <!-- 站長專欄 -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長 Nasir</span></h2>
            <p class="history">網站架設 · 系統資安 · 筆記小分享</p>
            <div class="side-btn-wrap">
              <a href="/about/" class="btn-vip">關於站長</a>
            </div>
          </div>

          <!-- 熱門推薦文章 -->
          <div class="popular-posts" id="popular-side">
            <h3 class="popular-title">熱門推薦文章</h3>
            <ul class="wpp-list">
              {popularPosts.map((p) => (
                <li class="wpp-item">
                  <a href={`/posts/${p.slug}/`} class="wpp-thumb-link">
                    <div class="wpp-thumbnail-box">
                      <img src={`/banners/${p.slug}.jpg?v=20260820light`} alt={p.title} class="wpp-thumb-img" />
                    </div>
                  </a>
                  <div class="wpp-details">
                    <a href={`/posts/${p.slug}/`} class="wpp-post-title">
                      {p.title}
                    </a>
                    <span class="wpp-meta">{p.date}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
  .main-content {
    background-color: #ffffff;
    padding: 1.5rem 0 5rem;
  }

  .breadcrumbs {
    font-size: 14px;
    color: #999999;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .breadcrumbs a {
    color: #666666;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #ff6b00;
  }

  .breadcrumbs .sep {
    margin: 0 5px;
    color: #cccccc;
  }

  .breadcrumbs .current-post-name {
    color: #333333;
    font-weight: 500;
  }

  /* 🔷 1. 左右交換 + 正方形圖片之 Hero Header */
  .content-hero-header.hero-reversed {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 3rem;
    margin-bottom: 3.5rem;
    border-bottom: 1px solid #e2e2e2;
    padding-bottom: 3rem;
  }

  .hero-square-col {
    width: 240px;
    height: 240px;
    flex-shrink: 0;
  }

  .square-wrap {
    width: 240px !important;
    height: 240px !important;
    aspect-ratio: 1 / 1 !important;
    max-height: 240px !important;
    background: #f0f0f0;
  }

  .square-img-container {
    width: 100% !important;
    height: 100% !important;
  }

  .square-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-text-col h3 {
    font-size: 1.1rem;
    color: #ff6b00;
    margin: 0 0 0.5rem;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .hero-text-col h2 {
    font-size: 2.2rem;
    line-height: 1.2;
    color: #111111;
    margin: 0 0 1.5rem;
    font-weight: 700;
  }

  .hero-quick-btns {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .btn-about-hero {
    display: inline-block;
    padding: 0.55rem 1.3rem;
    background: #111111;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.15s ease;
  }

  .btn-about-hero:hover {
    background: #ff6b00;
  }

  .hero-featured-link {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* 📰 2. 雙欄主內容區 (完全比照首頁) */
  .content-area-top {
    display: flex;
    justify-content: space-between;
  }

  .content-area-top > .left {
    width: 68%;
    padding-right: 3.5%;
    border-right: 1px solid #e2e2e2;
  }

  .content-area-top > .right.sidebar-right {
    width: 28%;
    padding-top: 0.5rem;
  }

  .post-area-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid #111111;
    padding-bottom: 0.6rem;
    margin-bottom: 1.8rem;
  }

  .post-area-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: #111111;
    border-left: 5px solid #ff6b00;
    padding-left: 12px;
    margin: 0;
    line-height: 1.2;
  }

  .cal-sub-label {
    font-size: 0.85rem;
    color: #888888;
  }

  /* VIP 會員資料卡片 */
  .vip-card-box {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1.6rem 1.8rem;
    margin-bottom: 2rem;
  }

  .vip-loading-state {
    color: #666666;
    font-size: 0.95rem;
    text-align: center;
    padding: 1.5rem 0;
  }

  .vip-user-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.5rem;
  }

  .vip-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .vip-field-label {
    font-size: 0.82rem;
    color: #888888;
  }

  .vip-field-val {
    font-size: 1.05rem;
    font-weight: 600;
    color: #111111;
  }

  /* 工單表單與列表 */
  .ticket-form-card {
    background: #fdfdfd;
    border: 1px solid #e0e0e0;
    border-top: 3px solid #ff6b00;
    padding: 1.6rem 1.8rem;
    margin-bottom: 1.8rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
  }

  .form-field label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
  }

  .form-input {
    padding: 0.65rem 0.85rem;
    border: 1px solid #cbd5e1;
    font-size: 0.95rem;
    color: #0f172a;
    background: #ffffff;
    font-family: inherit;
    outline: none;
  }

  .form-input:focus {
    border-color: #ff6b00;
  }

  .form-textarea {
    resize: vertical;
    min-height: 90px;
  }

  .form-actions {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .ticket-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .ticket-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1.2rem 1.4rem;
    transition: border-color 0.15s ease;
  }

  .ticket-card:hover {
    border-color: #ff6b00;
  }

  .ticket-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .ticket-subject {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111111;
    margin: 0;
  }

  .ticket-status-badge {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 2px 8px;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #334155;
    white-space: nowrap;
  }

  .ticket-status-badge.open {
    color: #ea580c;
    border-color: #fed7aa;
    background: #fff7ed;
  }

  .ticket-status-badge.resolved {
    color: #16a34a;
    border-color: #bbf7d0;
    background: #f0fdf4;
  }

  .ticket-meta {
    font-size: 0.82rem;
    color: #888888;
  }

  /* 📅 行事曆與時段 */
  .blog-cal-frame {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1rem;
  }

  .blog-cal-frame iframe {
    width: 100%;
    height: 460px;
    border: none;
    display: block;
  }

  .slot-list,
  .mine-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .slot-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    transition: border-color 0.15s ease;
  }

  .slot-card:hover {
    border-color: #ff6b00;
  }

  .slot-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem 0.5rem;
  }

  .slot-title {
    font-size: 1.12rem;
    font-weight: 600;
    color: #111111;
    margin: 0;
  }

  .slot-meta {
    font-size: 0.84rem;
    color: #666666;
    background: #f8fafc;
    padding: 3px 8px;
    border: 1px solid #e2e8f0;
  }

  .slot-desc {
    padding: 0 1.3rem 0.75rem;
    font-size: 0.92rem;
    color: #555555;
    line-height: 1.6;
    margin: 0;
  }

  .slot-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.3rem;
    border-top: 1px solid #f1f5f9;
    background: #fafafa;
  }

  .slot-remaining {
    font-size: 0.88rem;
    color: #555555;
    font-weight: 500;
  }

  .slot-remaining.full {
    color: #dc2626;
  }

  .mine-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.3rem;
    border: 1px solid #e0e0e0;
    background: #ffffff;
    margin-bottom: 0.8rem;
  }

  .mine-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .mine-name {
    font-weight: 600;
    color: #111111;
  }

  .mine-note {
    font-size: 0.84rem;
    color: #777777;
  }

  .btn {
    display: inline-block;
    padding: 0.55rem 1.3rem;
    background: #111111;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    border: none;
    transition: background 0.15s ease;
  }

  .btn:hover {
    background: #ff6b00;
  }

  .btn--sm {
    padding: 0.4rem 0.9rem;
    font-size: 0.84rem;
  }

  .btn--ghost {
    background: #f1f5f9;
    color: #334155 !important;
    border: 1px solid #cbd5e1;
  }

  .btn--ghost:hover {
    background: #e2e8f0;
    color: #0f172a !important;
  }

  .slot-empty {
    color: #888888;
    font-size: 0.95rem;
    text-align: center;
    padding: 2rem 0;
  }

  /* 側邊欄樣式 (完全比照首頁) */
  .side-author-box {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1.8rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .side-author-box .photo img {
    border-radius: 50%;
    margin-bottom: 0.8rem;
  }

  .side-author-box h2 {
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
    color: #111111;
  }

  .side-author-box .history {
    font-size: 0.85rem;
    color: #888888;
    margin: 0 0 1rem;
  }

  .side-author-box .btn-vip {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .popular-posts {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1.5rem;
  }

  .popular-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111111;
    border-bottom: 2px solid #111111;
    padding-bottom: 0.6rem;
    margin: 0 0 1.2rem;
  }

  .wpp-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .wpp-item {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .wpp-thumbnail-box {
    width: 65px;
    height: 65px;
    flex-shrink: 0;
    overflow: hidden;
    background: #f0f0f0;
  }

  .wpp-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wpp-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .wpp-post-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: #222222;
    text-decoration: none;
    line-height: 1.4;
  }

  .wpp-post-title:hover {
    color: #ff6b00;
  }

  .wpp-meta {
    font-size: 0.78rem;
    color: #999999;
  }

  @media (max-width: 850px) {
    .content-hero-header.hero-reversed {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .content-area-top {
      flex-direction: column;
    }
    .content-area-top > .left {
      width: 100%;
      padding-right: 0;
      border-right: none;
    }
    .content-area-top > .right.sidebar-right {
      width: 100%;
      margin-top: 3rem;
    }
  }
</style>

<script>
  import { api, ApiError } from '../scripts/api';
  import { currentUser } from '../scripts/auth';

  const TZ = 'Asia/Taipei';

  type Slot = {
    id: number;
    title: string;
    description: string;
    startsAt: number;
    durationMinutes: number;
    maxBookings: number;
    bookingCount: number;
    active: number;
  };

  type Reservation = {
    id: number;
    slotId: number;
    slotTitle: string;
    slotStartsAt: number;
    slotDurationMinutes: number;
    name: string;
    email: string;
    note: string;
    status: string;
    createdAt: number;
  };

  type Ticket = {
    id: number;
    subject: string;
    status: 'open' | 'resolved';
    created_at: number;
    updated_at: number;
  };

  const vipBody = document.querySelector('#vip-body');
  const loadingText = document.querySelector('#vip-loading-text');
  const ticketList = document.querySelector('#ticket-list');
  const slotList = document.querySelector('#slot-list');
  const mineReservationsSection = document.querySelector('#mine-reservations-section');
  const mineReservationsList = document.querySelector('#mine-reservations-list');

  const btnToggleTicket = document.querySelector('#btn-toggle-ticket');
  const newTicketCard = document.querySelector<HTMLDivElement>('#new-ticket-card');
  const newTicketForm = document.querySelector<HTMLFormElement>('#new-ticket-form');
  const ntCancelBtn = document.querySelector('#nt-cancel-btn');

  const user = currentUser();
  if (user === null) {
    window.location.replace('/login/?redirect=/vip/');
  } else {
    if (loadingText) loadingText.remove();
    if (vipBody) (vipBody as HTMLElement).style.display = 'block';
    renderVipUser();
    loadTickets();
    loadSlots();
    if (mineReservationsSection) {
      (mineReservationsSection as HTMLElement).style.display = 'block';
      loadMineReservations();
    }
  }

  function renderVipUser(): void {
    if (vipBody === null) return;
    const u = currentUser();
    if (u === null) return;

    vipBody.innerHTML = `
      <div class="vip-user-detail">
        <div class="vip-field">
          <span class="vip-field-label">會員姓名</span>
          <span class="vip-field-val">${escapeHtml(u.displayName || '未設定')}</span>
        </div>
        <div class="vip-field">
          <span class="vip-field-label">電子郵件</span>
          <span class="vip-field-val">${escapeHtml(u.email)}</span>
        </div>
        <div class="vip-field">
          <span class="vip-field-label">會員編號</span>
          <span class="vip-field-val">#${u.id}</span>
        </div>
        <div class="vip-field">
          <span class="vip-field-label">會員等級</span>
          <span class="vip-field-val">${u.role === 'admin' ? '系統管理員' : '尊榮 VIP 會員'}</span>
        </div>
      </div>
    `;
  }

  // 🎫 工單系統邏輯
  if (btnToggleTicket && newTicketCard) {
    btnToggleTicket.addEventListener('click', () => {
      newTicketCard.style.display = newTicketCard.style.display === 'none' ? 'block' : 'none';
    });
  }

  if (ntCancelBtn && newTicketCard) {
    ntCancelBtn.addEventListener('click', () => {
      newTicketCard.style.display = 'none';
    });
  }

  if (newTicketForm) {
    newTicketForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.querySelector<HTMLButtonElement>('#nt-submit-btn')!;
      const msg = document.querySelector<HTMLParagraphElement>('#nt-msg')!;
      submitBtn.disabled = true;
      submitBtn.textContent = '送出中…';
      msg.style.display = 'none';

      const formData = new FormData(newTicketForm);
      try {
        await api<{ ticket: { id: number } }>('/tickets', {
          auth: true,
          method: 'POST',
          body: {
            subject: (formData.get('subject') as string).trim(),
            body: (formData.get('body') as string).trim(),
          },
        });
        newTicketForm.reset();
        if (newTicketCard) newTicketCard.style.display = 'none';
        loadTickets();
      } catch (err) {
        msg.textContent = err instanceof ApiError ? err.message : '送出工單失敗，請稍後再試。';
        msg.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '送出工單';
      }
    });
  }

  async function loadTickets(): Promise<void> {
    if (ticketList === null) return;
    try {
      const data = await api<{ tickets: Ticket[] }>('/tickets', { auth: true });
      renderTickets(data.tickets || []);
    } catch {
      ticketList.innerHTML = '<p class="slot-empty">無法載入工單紀錄，請檢查登入狀態。</p>';
    }
  }

  function renderTickets(tickets: Ticket[]): void {
    if (ticketList === null) return;
    ticketList.replaceChildren();

    if (tickets.length === 0) {
      ticketList.innerHTML = '<p class="slot-empty">目前尚無工單紀錄。如有問題歡迎隨時點擊上方「+ 建立新工單」。</p>';
      return;
    }

    for (const t of tickets) {
      const card = document.createElement('div');
      card.className = 'ticket-card';
      const isOpen = t.status === 'open';
      const statusText = isOpen ? '處理中' : '已結案';
      const statusClass = isOpen ? 'open' : 'resolved';
      const timeMs = (t.created_at || 0) * 1000;

      card.innerHTML = `
        <div class="ticket-card-head">
          <h4 class="ticket-subject">${escapeHtml(t.subject)}</h4>
          <span class="ticket-status-badge ${statusClass}">${statusText}</span>
        </div>
        <div class="ticket-meta">工單編號 #${t.id} · 建立時間：${formatDateTime(timeMs)}</div>
      `;
      ticketList.appendChild(card);
    }
  }

  // 📅 預約時段邏輯
  async function loadSlots(): Promise<void> {
    if (slotList === null) return;
    try {
      const data = await api<{ slots: Slot[] }>('/slots');
      const now = Date.now();
      const future = (data.slots || []).filter(
        (s) => s.active === 1 && s.startsAt + s.durationMinutes * 60 * 1000 > now,
      );
      renderSlots(future);
    } catch {
      slotList.innerHTML = '<p class="slot-empty">目前尚無開放預約時段。</p>';
    }
  }

  function renderSlots(slots: Slot[]): void {
    if (slotList === null) return;
    slotList.replaceChildren();

    if (slots.length === 0) {
      slotList.innerHTML = '<p class="slot-empty">目前尚無開放預約的時段。</p>';
      return;
    }

    for (const slot of slots) {
      const remaining = slot.maxBookings - slot.bookingCount;
      const isFull = remaining <= 0;

      const card = document.createElement('div');
      card.className = 'slot-card';

      const head = document.createElement('div');
      head.className = 'slot-head';
      head.innerHTML = `
        <h3 class="slot-title">${escapeHtml(slot.title)}</h3>
        <span class="slot-meta">${formatDateTime(slot.startsAt)} · ${slot.durationMinutes} 分鐘</span>
      `;
      card.appendChild(head);

      if (slot.description) {
        const desc = document.createElement('p');
        desc.className = 'slot-desc';
        desc.textContent = slot.description;
        card.appendChild(desc);
      }

      const foot = document.createElement('div');
      foot.className = 'slot-foot';

      const remSpan = document.createElement('span');
      remSpan.className = 'slot-remaining' + (isFull ? ' full' : '');
      remSpan.textContent = isFull ? '已額滿' : `尚餘 ${remaining} 個名額`;
      foot.appendChild(remSpan);

      if (!isFull) {
        const btn = document.createElement('button');
        btn.className = 'btn btn--sm';
        btn.textContent = '預約此時段';
        btn.addEventListener('click', () => {
          const existing = card.querySelector('.ticket-form-card');
          if (existing !== null) {
            existing.remove();
            return;
          }
          card.appendChild(createBookingForm(slot, card));
        });
        foot.appendChild(btn);
      }

      card.appendChild(foot);
      slotList.appendChild(card);
    }
  }

  function createBookingForm(slot: Slot, card: HTMLElement): HTMLElement {
    const form = document.createElement('form');
    form.className = 'ticket-form-card';
    form.style.marginTop = '1rem';

    const u = currentUser();
    const defaultName = u?.displayName || '';
    const defaultEmail = u?.email || '';

    form.innerHTML = `
      <div class="form-field">
        <label>您的稱呼 *</label>
        <input type="text" name="name" required maxlength="50" value="${escapeHtml(defaultName)}" class="form-input" />
      </div>
      <div class="form-field">
        <label>聯絡 Email *</label>
        <input type="email" name="email" required maxlength="100" value="${escapeHtml(defaultEmail)}" class="form-input" />
      </div>
      <div class="form-field">
        <label>備註提問（選填）</label>
        <textarea name="note" maxlength="300" class="form-input form-textarea" placeholder="預先想討論的主題或諮詢內容…"></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn--sm">確認預約</button>
        <button type="button" class="btn btn--ghost btn--sm cancel-btn">取消</button>
      </div>
      <div class="form-msg" style="display:none; margin-top:0.8rem; font-size:0.88rem;"></div>
    `;

    form.querySelector('.cancel-btn')?.addEventListener('click', () => {
      form.remove();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector<HTMLDivElement>('.form-msg')!;
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      msg.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.textContent = '預約中…';

      const formData = new FormData(form);
      try {
        await api('/reservations', {
          method: 'POST',
          body: {
            slotId: slot.id,
            name: (formData.get('name') as string).trim(),
            email: (formData.get('email') as string).trim(),
            note: (formData.get('note') as string || '').trim(),
          },
        });
        msg.style.color = '#16a34a';
        msg.textContent = '✓ 預約成功！已發送確認信件。';
        msg.style.display = 'block';
        form.querySelector<HTMLElement>('.form-actions')!.style.display = 'none';
        loadSlots();
        loadMineReservations();
      } catch (err) {
        msg.style.color = '#dc2626';
        msg.textContent = err instanceof ApiError ? err.message : '預約失敗，請稍後再試。';
        msg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = '確認預約';
      }
    });

    return form;
  }

  async function loadMineReservations(): Promise<void> {
    if (mineReservationsList === null) return;
    try {
      const data = await api<{ reservations: Reservation[] }>('/reservations/mine', { auth: true });
      renderMineReservations(data.reservations || []);
    } catch {
      mineReservationsList.innerHTML = '<p class="slot-empty">無法載入預約紀錄。</p>';
    }
  }

  function renderMineReservations(items: Reservation[]): void {
    if (mineReservationsList === null) return;
    mineReservationsList.replaceChildren();

    if (items.length === 0) {
      mineReservationsList.innerHTML = '<p class="slot-empty">您目前沒有任何時段預約紀錄。</p>';
      return;
    }

    for (const res of items) {
      const row = document.createElement('div');
      row.className = 'mine-row';
      const isCancelled = res.status === 'cancelled';
      const statusLabel = isCancelled ? '已取消' : '已確認';

      row.innerHTML = `
        <div class="mine-info">
          <span class="mine-name">${escapeHtml(res.slotTitle)}</span>
          <span class="mine-note">${formatDateTime(res.slotStartsAt)} · ${res.slotDurationMinutes} 分鐘${res.note ? ' · 備註：' + escapeHtml(res.note) : ''}</span>
        </div>
        <span class="ticket-status-badge ${isCancelled ? '' : 'resolved'}">${statusLabel}</span>
      `;
      mineReservationsList.appendChild(row);
    }
  }

  function formatDateTime(ms: number): string {
    const d = new Date(ms);
    return d.toLocaleString('zh-TW', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
</script>
