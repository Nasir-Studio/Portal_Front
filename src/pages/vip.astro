---
import BlogLayout from '../layouts/BlogLayout.astro';
import posts from '../data/posts';

const popularPosts = posts.slice(0, 3);
---

<BlogLayout title="VIP 專區 — OviNas" description="OviNas VIP 會員專屬權限與問題工單支援中心。">
  <!-- 未登入秒速防護轉跳 (防止未登入畫面閃爍) -->
  <script is:inline>
    (function() {
      try {
        var token = localStorage.getItem('sheep_portal_token');
        if (!token) {
          window.location.replace('/login/?redirect=/vip/');
        }
      } catch(e) {}
    })();
  </script>

  <div class="main-content">
    <div class="container">
      <!-- 麵包屑導航 (Breadcrumbs) -->
      <div class="breadcrumbs">
        <a href="/" class="home">首頁</a>
        <span class="sep">&gt;</span>
        <span class="current-post-name">VIP 專區</span>
      </div>

      <!-- 🔷 1. 純文字極簡 VIP Hero Header (無圖片) -->
      <section class="vip-pure-hero">
        <div class="hero-text-col">
          <h3>VIP ZONE</h3>
          <h2>VIP</h2>
          <div class="hero-quick-btns">
            <a href="#ticketSection" class="btn-about-hero">建立問題工單 ↓</a>
          </div>
        </div>
      </section>

      <!-- 📰 2. 雙欄主內容區 (左側 68% + 右側 28% 側邊欄) -->
      <div class="content-area-top">
        <div class="left">
          <!-- 👤 Section 1: VIP 會員中心基本資料 -->
          <div class="post-area-head">
            <h2 class="post-area-title">VIP 會員中心</h2>
          </div>

          <div class="vip-card-box" id="vip-card-box">
            <div class="vip-loading-state" id="vip-loading-text">
              正在驗證 VIP 會員身份，請稍候…
            </div>
            <div class="vip-user" id="vip-body" style="display: none;">
              <!-- JS 動態填入會員資料 -->
            </div>
          </div>

          <!-- 🎫 Section 2: 問題工單 (Tickets) -->
          <div class="post-area-head" id="ticketSection" style="margin-top: 3rem;">
            <h2 class="post-area-title">問題工單</h2>
            <button class="btn btn--sm" id="btn-toggle-ticket" type="button">+ 建立新工單</button>
          </div>

          <!-- 新建工單表單 (點擊切換展開) -->
          <div class="ticket-form-card" id="new-ticket-card" style="display: none;">
            <form id="new-ticket-form">
              <div class="form-field">
                <label for="nt-subject">問題主旨 *</label>
                <input id="nt-subject" type="text" name="subject" maxlength="120" placeholder="例如：網站部屬問題 / 技術諮詢" required class="form-input" />
              </div>
              <div class="form-field">
                <label for="nt-body">問題詳述 *</label>
                <textarea id="nt-body" name="body" rows="4" maxlength="4000" placeholder="請詳細描述您遇到的問題或需求…" required class="form-input form-textarea"></textarea>
              </div>
              <p class="form-msg err" id="nt-msg" style="display:none"></p>
              <div class="form-actions">
                <button class="btn" type="submit" id="nt-submit-btn">送出工單</button>
                <button class="btn btn--ghost" id="nt-cancel-btn" type="button">取消</button>
              </div>
            </form>
          </div>

          <!-- 我的工單列表 -->
          <div class="ticket-list" id="ticket-list">
            <p class="slot-empty">正在載入專屬工單紀錄…</p>
          </div>
        </div>

        <!-- 📌 右側側邊欄 (比照首頁 28% 側邊欄) -->
        <aside class="right sidebar-right">
          <!-- 站長專欄 -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長 Nasir</span></h2>
            <p class="history">網站架設 · 系統資安 · 筆記小分享</p>
            <div class="side-btn-wrap">
              <a href="/about/" class="btn-vip">關於站長</a>
            </div>
          </div>

          <!-- 熱門推薦文章 -->
          <div class="popular-posts" id="popular-side">
            <h3 class="popular-title">熱門推薦文章</h3>
            <ul class="wpp-list">
              {popularPosts.map((p) => (
                <li class="wpp-item">
                  <a href={`/posts/${p.slug}/`} class="wpp-thumb-link">
                    <div class="wpp-thumbnail-box">
                      <img src={`/banners/${p.slug}.jpg?v=20260820light`} alt={p.title} class="wpp-thumb-img" />
                    </div>
                  </a>
                  <div class="wpp-details">
                    <a href={`/posts/${p.slug}/`} class="wpp-post-title">
                      {p.title}
                    </a>
                    <span class="wpp-meta">{p.date}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
  .main-content {
    background-color: #ffffff;
    padding: 1.5rem 0 5rem;
  }

  .breadcrumbs {
    font-size: 14px;
    color: #999999;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .breadcrumbs a {
    color: #666666;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #ff6b00;
  }

  .breadcrumbs .sep {
    margin: 0 5px;
    color: #cccccc;
  }

  .breadcrumbs .current-post-name {
    color: #333333;
    font-weight: 500;
  }

  /* 🔷 1. 純文字極簡 VIP Hero Header (無圖片) */
  .vip-pure-hero {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid #e2e2e2;
    padding-bottom: 2rem;
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-text-col h3 {
    font-size: 1.1rem;
    color: #ff6b00;
    margin: 0 0 0.5rem;
    font-weight: 500;
    letter-spacing: 1px;
  }

  .hero-text-col h2 {
    font-size: 2.2rem;
    line-height: 1.2;
    color: #111111;
    margin: 0 0 1.5rem;
    font-weight: 500;
  }

  .hero-quick-btns {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .btn-about-hero {
    display: inline-block;
    padding: 0.55rem 1.3rem;
    background: #111111;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.15s ease;
  }

  .btn-about-hero:hover {
    background: #ff6b00;
  }

  .hero-featured-link {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* 📰 2. 雙欄主內容區 (完全比照首頁) */
  .content-area-top {
    display: flex;
    justify-content: space-between;
  }

  .content-area-top > .left {
    width: 68%;
    padding-right: 3.5%;
    border-right: 1px solid #e2e2e2;
  }

  .content-area-top > .right.sidebar-right {
    width: 28%;
    padding-top: 0.5rem;
  }

  .post-area-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid #111111;
    padding-bottom: 0.6rem;
    margin-bottom: 1.8rem;
  }

  .post-area-title {
    font-size: 1.45rem;
    font-weight: 500;
    color: #111111;
    border-left: 5px solid #ff6b00;
    padding-left: 12px;
    margin: 0;
    line-height: 1.2;
  }

  /* VIP 會員資料卡片 */
  .vip-card-box {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1.6rem 1.8rem;
    margin-bottom: 2rem;
  }

  .vip-loading-state {
    color: #666666;
    font-size: 0.95rem;
    text-align: center;
    padding: 1.5rem 0;
  }

  .vip-user-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.5rem;
  }

  .vip-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .vip-field-label {
    font-size: 0.82rem;
    color: #888888;
  }

  .vip-field-val {
    font-size: 1.05rem;
    font-weight: 500;
    color: #111111;
  }

  /* 工單表單與列表 */
  .ticket-form-card {
    background: #fdfdfd;
    border: 1px solid #e0e0e0;
    border-top: 3px solid #ff6b00;
    padding: 1.6rem 1.8rem;
    margin-bottom: 1.8rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
  }

  .form-field label {
    font-size: 0.85rem;
    font-weight: 500;
    color: #334155;
  }

  .form-input {
    padding: 0.65rem 0.85rem;
    border: 1px solid #cbd5e1;
    font-size: 0.95rem;
    color: #0f172a;
    background: #ffffff;
    font-family: inherit;
    outline: none;
  }

  .form-input:focus {
    border-color: #ff6b00;
  }

  .form-textarea {
    resize: vertical;
    min-height: 90px;
  }

  .form-actions {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .ticket-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .ticket-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1.2rem 1.4rem;
    transition: border-color 0.15s ease;
  }

  .ticket-card:hover {
    border-color: #ff6b00;
  }

  .ticket-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .ticket-subject {
    font-size: 1.05rem;
    font-weight: 500;
    color: #111111;
    margin: 0;
  }

  .ticket-status-badge {
    font-size: 0.78rem;
    font-weight: 500;
    padding: 2px 8px;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #334155;
    white-space: nowrap;
  }

  .ticket-status-badge.open {
    color: #ea580c;
    border-color: #fed7aa;
    background: #fff7ed;
  }

  .ticket-status-badge.resolved {
    color: #16a34a;
    border-color: #bbf7d0;
    background: #f0fdf4;
  }

  .ticket-meta {
    font-size: 0.82rem;
    color: #888888;
  }

  .btn {
    display: inline-block;
    padding: 0.55rem 1.3rem;
    background: #111111;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    border: none;
    transition: background 0.15s ease;
  }

  .btn:hover {
    background: #ff6b00;
  }

  .btn--sm {
    padding: 0.4rem 0.9rem;
    font-size: 0.84rem;
  }

  .btn--ghost {
    background: #f1f5f9;
    color: #334155 !important;
    border: 1px solid #cbd5e1;
  }

  .btn--ghost:hover {
    background: #e2e8f0;
    color: #0f172a !important;
  }

  .slot-empty {
    color: #888888;
    font-size: 0.95rem;
    text-align: center;
    padding: 2rem 0;
  }

  /* 側邊欄樣式 (完全比照首頁) */
  .side-author-box {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1.8rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .side-author-box .photo img {
    border-radius: 50%;
    margin-bottom: 0.8rem;
  }

  .side-author-box h2 {
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
    color: #111111;
    font-weight: 500;
  }

  .side-author-box .history {
    font-size: 0.85rem;
    color: #888888;
    margin: 0 0 1rem;
  }

  .side-author-box .btn-vip {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .popular-posts {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1.5rem;
  }

  .popular-title {
    font-size: 1.1rem;
    font-weight: 500;
    color: #111111;
    border-bottom: 2px solid #111111;
    padding-bottom: 0.6rem;
    margin: 0 0 1.2rem;
  }

  .wpp-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .wpp-item {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .wpp-thumbnail-box {
    width: 65px;
    height: 65px;
    flex-shrink: 0;
    overflow: hidden;
    background: #f0f0f0;
  }

  .wpp-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wpp-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .wpp-post-title {
    font-size: 0.88rem;
    font-weight: 500;
    color: #222222;
    text-decoration: none;
    line-height: 1.4;
  }

  .wpp-post-title:hover {
    color: #ff6b00;
  }

  .wpp-meta {
    font-size: 0.78rem;
    color: #999999;
  }

  @media (max-width: 850px) {
    .content-hero-header.hero-reversed {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .content-area-top {
      flex-direction: column;
    }
    .content-area-top > .left {
      width: 100%;
      padding-right: 0;
      border-right: none;
    }
    .content-area-top > .right.sidebar-right {
      width: 100%;
      margin-top: 3rem;
    }
  }
</style>

<script>
  import { api, ApiError } from '../scripts/api';
  import { currentUser } from '../scripts/auth';

  const TZ = 'Asia/Taipei';

  type Ticket = {
    id: number;
    subject: string;
    status: 'open' | 'resolved';
    created_at: number;
    updated_at: number;
  };

  const vipBody = document.querySelector('#vip-body');
  const loadingText = document.querySelector('#vip-loading-text');
  const ticketList = document.querySelector('#ticket-list');

  const btnToggleTicket = document.querySelector('#btn-toggle-ticket');
  const newTicketCard = document.querySelector<HTMLDivElement>('#new-ticket-card');
  const newTicketForm = document.querySelector<HTMLFormElement>('#new-ticket-form');
  const ntCancelBtn = document.querySelector('#nt-cancel-btn');

  const user = currentUser();
  if (user === null) {
    window.location.replace('/login/?redirect=/vip/');
  } else {
    if (loadingText) loadingText.remove();
    if (vipBody) (vipBody as HTMLElement).style.display = 'block';
    renderVipUser();
    loadTickets();
  }

  function renderVipUser(): void {
    if (vipBody === null) return;
    const u = currentUser();
    if (u === null) return;

    vipBody.innerHTML = `
      <div class="vip-user-detail">
        <div class="vip-field">
          <span class="vip-field-label">會員姓名</span>
          <span class="vip-field-val">${escapeHtml(u.displayName || '未設定')}</span>
        </div>
        <div class="vip-field">
          <span class="vip-field-label">電子郵件</span>
          <span class="vip-field-val">${escapeHtml(u.email)}</span>
        </div>
        <div class="vip-field">
          <span class="vip-field-label">會員編號</span>
          <span class="vip-field-val">#${u.id}</span>
        </div>
        <div class="vip-field">
          <span class="vip-field-label">會員等級</span>
          <span class="vip-field-val">${u.role === 'admin' ? '系統管理員' : '尊榮 VIP 會員'}</span>
        </div>
      </div>
    `;
  }

  // 🎫 工單系統邏輯
  if (btnToggleTicket && newTicketCard) {
    btnToggleTicket.addEventListener('click', () => {
      newTicketCard.style.display = newTicketCard.style.display === 'none' ? 'block' : 'none';
    });
  }

  if (ntCancelBtn && newTicketCard) {
    ntCancelBtn.addEventListener('click', () => {
      newTicketCard.style.display = 'none';
    });
  }

  if (newTicketForm) {
    newTicketForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.querySelector<HTMLButtonElement>('#nt-submit-btn')!;
      const msg = document.querySelector<HTMLParagraphElement>('#nt-msg')!;
      submitBtn.disabled = true;
      submitBtn.textContent = '送出中…';
      msg.style.display = 'none';

      const formData = new FormData(newTicketForm);
      try {
        await api<{ ticket: { id: number } }>('/tickets', {
          auth: true,
          method: 'POST',
          body: {
            subject: (formData.get('subject') as string).trim(),
            body: (formData.get('body') as string).trim(),
          },
        });
        newTicketForm.reset();
        if (newTicketCard) newTicketCard.style.display = 'none';
        loadTickets();
      } catch (err) {
        msg.textContent = err instanceof ApiError ? err.message : '送出工單失敗，請稍後再試。';
        msg.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '送出工單';
      }
    });
  }

  async function loadTickets(): Promise<void> {
    if (ticketList === null) return;
    try {
      const data = await api<{ tickets: Ticket[] }>('/tickets', { auth: true });
      renderTickets(data.tickets || []);
    } catch {
      ticketList.innerHTML = '<p class="slot-empty">無法載入工單紀錄，請檢查登入狀態。</p>';
    }
  }

  function renderTickets(tickets: Ticket[]): void {
    if (ticketList === null) return;
    ticketList.replaceChildren();

    if (tickets.length === 0) {
      ticketList.innerHTML = '<p class="slot-empty">目前尚無工單紀錄。如有問題歡迎隨時點擊上方「+ 建立新工單」。</p>';
      return;
    }

    for (const t of tickets) {
      const card = document.createElement('div');
      card.className = 'ticket-card';
      const isOpen = t.status === 'open';
      const statusText = isOpen ? '處理中' : '已結案';
      const statusClass = isOpen ? 'open' : 'resolved';
      const timeMs = (t.created_at || 0) * 1000;

      card.innerHTML = `
        <div class="ticket-card-head">
          <h4 class="ticket-subject">${escapeHtml(t.subject)}</h4>
          <span class="ticket-status-badge ${statusClass}">${statusText}</span>
        </div>
        <div class="ticket-meta">工單編號 #${t.id} · 建立時間：${formatDateTime(timeMs)}</div>
      `;
      ticketList.appendChild(card);
    }
  }

  function formatDateTime(ms: number): string {
    const d = new Date(ms);
    return d.toLocaleString('zh-TW', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
</script>
