<script is:inline>
  var GOOGLE_FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeeWapjagLqPsg7i2y_TYhNq2xKW-nNFj6JywiqiDZ8Hkiheg/formResponse';
  var form = document.getElementById('aboutPageContactForm');
  var btn = document.getElementById('apSubmitBtn');
  var status = document.getElementById('apStatus');

  if (form && btn) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      var name = document.getElementById('apName').value.trim();
      var email = document.getElementById('apEmail').value.trim();
      var msg = document.getElementById('apMsg').value.trim();

      if (!name || !email || !msg) return;

      btn.disabled = true;
      btn.textContent = '傳送中…';
      if (status) {
        status.textContent = '';
        status.style.color = '#ff6b00';
      }

      try {
        var formData = new FormData();
        formData.append('entry.57084769', name);
        formData.append('entry.135399445', email);
        formData.append('entry.1753446536', msg);

        await fetch(GOOGLE_FORM_URL, {
          method: 'POST',
          mode: 'no-cors',
          body: formData
        });

        if (status) {
          status.textContent = '✓ 訊息已成功送出！我會盡快回覆您。';
          status.style.color = '#16a34a';
        }
        form.reset();
        btn.textContent = '已送出';
      } catch (err) {
        if (status) {
          status.textContent = '✕ 傳送失敗，請直接來信 hi@nasirlin.net';
          status.style.color = '#ef4444';
        }
        btn.disabled = false;
        btn.textContent = '重新送出';
      }
    });
  }
</script>
