---
import BlogLayout from '../../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.nsir.uk';
  const fallbackPaths = [{ params: { slug: 'samsungddr34gbram' } }, { params: { slug: '_placeholder' } }];
  try {
    const pageSize = 48;
    const paths: { params: { slug: string } }[] = [];
    let page = 1;
    let pages = 1;
    do {
      const res = await fetch(`${apiUrl}/api/products?page=${page}&page_size=${pageSize}`);
      if (!res.ok) throw new Error(`API returned ${res.status}`);
      const data = await res.json();
      const items: { slug: string }[] = data.items || [];
      items.forEach((p) => paths.push({ params: { slug: p.slug } }));
      pages = data.pages || 1;
      page += 1;
    } while (page <= pages);
    return paths.length > 0 ? paths : fallbackPaths;
  } catch (e) {
    return fallbackPaths;
  }
}
---

<BlogLayout title="商品詳情 — Ovis Shop" description="Ovis Shop優質良品與0元物資分享。">
  <div class="main-content">
    <div class="container" id="product-container">
      <!-- 麵包屑導航 (Breadcrumbs) -->
      <div class="breadcrumbs">
        <a href="/" class="home">首頁</a>
        <span class="sep">&gt;</span>
        <a href="/shop/">Ovis Shop</a>
        <span class="sep">&gt;</span>
        <a href="/shop/">全部商品</a>
        <span class="sep">&gt;</span>
        <span class="current-post-name" id="product-bc-name">商品載入中…</span>
      </div>

      <div class="product-detail-area">
        <!-- 左側商品圖片畫廊 -->
        <div class="product-gallery">
          <div class="product-main-image-box" id="main-image-wrap">
            <div class="product-placeholder">
              <span id="product-img-loading">正在載入商品圖片…</span>
            </div>
          </div>
          <div class="product-thumbnails" id="product-thumbs"></div>
        </div>

        <!-- 右側商品購買與詳細資訊 -->
        <div class="product-info-panel">
          <span class="product-category-tag" id="product-category">農場物資</span>
          <h1 class="product-title" id="product-name">商品名稱</h1>
          
          <div class="product-pricing-row">
            <span class="product-current-price" id="product-price">NT$ 0</span>
            <span class="product-original-price" id="product-orig-price" style="display:none"></span>
          </div>

          <div class="product-meta-list">
            <div class="meta-row">
              <span class="meta-label">商品狀況</span>
              <span class="meta-value" id="product-condition">二手良品</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">庫存數量</span>
              <span class="meta-value" id="product-stock">現貨供應</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">運送方式</span>
              <span class="meta-value">7-11 店到店（運費 $60 + 包材 $15 = $75）</span>
            </div>
          </div>

          <div class="product-action-section">
            <div class="qty-selector">
              <button class="qty-btn" id="qty-minus" type="button">−</button>
              <input type="number" class="qty-input" id="qty-input" value="1" min="1" max="10" />
              <button class="qty-btn" id="qty-plus" type="button">+</button>
            </div>
            <button class="btn btn-add-cart" id="add-to-cart-btn" type="button">加入購物車</button>
          </div>

          <div class="product-desc-box">
            <h3>商品詳細說明</h3>
            <p id="product-desc">功能經站長檢測完全正常，歡迎選購。</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BlogLayout>

<style is:global>
  .main-content {
    background-color: #ffffff;
    padding: 1.5rem 0 5rem;
  }

  .breadcrumbs {
    font-size: 14px;
    color: #999999;
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .breadcrumbs a {
    color: #666666;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #ff6b00;
  }

  .breadcrumbs .sep {
    margin: 0 5px;
    color: #cccccc;
  }

  .breadcrumbs .current-post-name {
    color: #333333;
    font-weight: 500;
  }

  /* 商品詳情排版 */
  .product-detail-area {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 3.5rem;
    align-items: start;
  }

  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-main-image-box {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 420px;
    background: #fafafa;
    border: 1px solid #e0e0e0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-main-image-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fafafa;
    display: block;
  }

  .product-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #94a3b8;
    font-size: 0.95rem;
  }

  .product-thumbnails {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .thumbnail-item {
    width: 72px;
    height: 72px;
    border: 1px solid #e0e0e0;
    overflow: hidden;
    cursor: pointer;
    background: #fafafa;
    opacity: 0.7;
    transition: all 0.15s ease;
  }

  .thumbnail-item:hover,
  .thumbnail-item.active {
    opacity: 1;
    border-color: #ff6b00;
  }

  .thumbnail-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-info-panel {
    display: flex;
    flex-direction: column;
  }

  .product-category-tag {
    font-size: 0.85rem;
    font-weight: 400;
    color: #ff6b00;
    margin-bottom: 0.5rem;
  }

  .product-title {
    font-size: 1.85rem;
    font-weight: 500;
    color: #111111;
    line-height: 1.35;
    margin: 0 0 1.2rem;
  }

  .product-pricing-row {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 1.6rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .product-current-price {
    font-size: 1.8rem;
    font-weight: 500;
    color: #ea580c;
  }

  .product-original-price {
    font-size: 1.1rem;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .product-meta-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    font-size: 0.92rem;
  }

  .meta-label {
    width: 90px;
    color: #64748b;
  }

  .meta-value {
    color: #0f172a;
    font-weight: 500;
  }

  .product-action-section {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .qty-selector {
    display: flex;
    align-items: center;
    border: 1px solid #cbd5e1;
    background: #ffffff;
  }

  .qty-btn {
    width: 40px;
    height: 42px;
    background: none;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    color: #334155;
  }

  .qty-btn:hover {
    background: #f1f5f9;
  }

  .qty-input {
    width: 48px;
    height: 42px;
    border: none;
    border-left: 1px solid #cbd5e1;
    border-right: 1px solid #cbd5e1;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 400;
    outline: none;
  }

  .btn-add-cart {
    flex: 1;
    padding: 0.75rem 1.8rem;
    background: #111111;
    color: #ffffff !important;
    border: none;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-add-cart:hover {
    background: #ff6b00;
  }

  .product-desc-box {
    background: #fafafa;
    border: 1px solid #e5e7eb;
    padding: 1.6rem 1.8rem;
  }

  .product-desc-box h3 {
    font-size: 1.1rem;
    font-weight: 500;
    color: #111111;
    margin: 0 0 0.8rem;
  }

  .product-desc-box p {
    font-size: 0.94rem;
    color: #555555;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 850px) {
    .product-detail-area {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

<script is:inline>
  var API_URL = 'https://api.nsir.uk';

  window.escHtml = function(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  };

  var __cc = window.__currency;
  function _fmt(ntd) {
    if (ntd === 0) return '0 元免費';
    if (__cc && __cc._rates) return __cc.format(ntd);
    return 'NT$ ' + (ntd || 0).toLocaleString();
  }

  var conditionLabels = { new: '全新', like_new: '近乎全新', used: '二手良品', refurbished: '整新品' };

  document.addEventListener('DOMContentLoaded', async function() {
    var slug = window.location.pathname.split('/').filter(Boolean).pop();

    var fallbackProduct = {
      id: 1,
      name: 'Samsung DDR3 4GB 筆電/桌機記憶體',
      slug: 'samsungddr34gbram',
      price: 0,
      sale_price: null,
      stock: 1,
      condition: 'used',
      category_name: '電腦零組件 · 0 元活動',
      description: '功能經站長實機檢測完全正常，原廠顆粒良品。適合老舊電腦升級或實驗專案使用。',
      image_url: ''
    };

    var p = fallbackProduct;

    try {
      var res = await fetch(API_URL + '/api/products/' + slug);
      if (res.ok) {
        p = await res.json();
      }
    } catch(e) {}

    document.title = p.name + ' — Ovis Shop';
    var bcName = document.getElementById('product-bc-name');
    if (bcName) bcName.textContent = p.name;

    var nameEl = document.getElementById('product-name');
    if (nameEl) nameEl.textContent = p.name;

    var catEl = document.getElementById('product-category');
    if (catEl) catEl.textContent = p.category_name || '農場物資';

    var priceEl = document.getElementById('product-price');
    if (priceEl) priceEl.textContent = _fmt(p.price);

    var condEl = document.getElementById('product-condition');
    if (condEl) condEl.textContent = conditionLabels[p.condition] || '二手良品';

    var stockEl = document.getElementById('product-stock');
    if (stockEl) stockEl.textContent = (p.stock > 0) ? '剩餘 ' + p.stock + ' 件' : '已結案';

    var descEl = document.getElementById('product-desc');
    if (descEl) descEl.textContent = p.description || p.summary || '功能完好，歡迎索取。';

    var mainImgWrap = document.getElementById('main-image-wrap');
    if (mainImgWrap) {
      if (p.image_url) {
        mainImgWrap.innerHTML = '<img src="' + p.image_url + '" alt="' + escHtml(p.name) + '" loading="lazy" />';
      } else {
        mainImgWrap.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:#f8fafc;color:#64748b;font-weight: 500;font-size:1.3rem;">' + escHtml(p.name) + '</div>';
      }
    }

    var minusBtn = document.getElementById('qty-minus');
    var plusBtn = document.getElementById('qty-plus');
    var input = document.getElementById('qty-input');
    var addBtn = document.getElementById('add-to-cart-btn');

    if (minusBtn && input) minusBtn.addEventListener('click', function() { var v = parseInt(input.value) || 1; if (v > 1) input.value = String(v - 1); });
    if (plusBtn && input) plusBtn.addEventListener('click', function() { var v = parseInt(input.value) || 1; if (v < (p.stock || 1)) input.value = String(v + 1); });

    if (addBtn) {
      addBtn.addEventListener('click', function() {
        var count = parseInt(localStorage.getItem('shop_cart_count') || '0', 10) + 1;
        localStorage.setItem('shop_cart_count', String(count));
        addBtn.textContent = '✓ 已加入購物車！';
        setTimeout(function() { addBtn.textContent = '加入購物車'; }, 1500);
      });
    }
  });
</script>
