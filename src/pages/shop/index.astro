</style>

<script is:inline>
  var API_URL = 'https://api.nsir.uk';

  window.escHtml = function(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  };

  var __cc = window.__currency;
  function _fmt(ntd) {
    if (ntd === 0) return 'NT$ 0';
    if (__cc && __cc._rates) return __cc.format(ntd);
    return 'NT$ ' + (ntd || 0).toLocaleString();
  }

  var conditionLabels = { new: '全新良品', like_new: '近乎全新', used: '二手良品', refurbished: '整新品' };

  document.addEventListener('DOMContentLoaded', async function() {
    // 購物車數量標記
    var cartCount = localStorage.getItem('shop_cart_count');
    if (cartCount) {
      var cartBtns = document.querySelectorAll('.btn-side-cart');
      cartBtns.forEach(function(btn) {
        btn.textContent = '🛒 查看購物車 (' + cartCount + ')';
      });
    }

    var container = document.getElementById('featured-products');
    if (!container) return;

    try {
      var res = await fetch(API_URL + '/api/products?page_size=24&sort=newest');
      if (res.ok) {
        var data = await res.json();
        var items = data.items || data;
        if (Array.isArray(items) && items.length > 0) {
          container.innerHTML = items.map(function(p) {
            var priceText = _fmt(p.price);
            var imgHtml = p.image_url
              ? '<img src="' + p.image_url + '" alt="' + escHtml(p.name) + '" class="card-img" loading="lazy" />'
              : '<div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:#f8fafc;color:#64748b;font-weight: 400;font-size:0.95rem;">' + escHtml(p.name) + '</div>';

            var condLabel = conditionLabels[p.condition] || '二手良品';

            return '<article class="post-card">' +
              '<div class="img-wrap">' +
              '<a class="card-thumb-link" href="/shop/products/' + p.slug + '/">' +
              '<div class="card-img-box">' + imgHtml + '</div>' +
              '</a>' +
              '</div>' +
              '<ul class="post-categories">' +
              '<li><a href="/shop/products/' + p.slug + '/">' + escHtml(p.category_name || '精選物資') + ' · ' + condLabel + '</a></li>' +
              '</ul>' +
              '<h3 class="post-title">' +
              '<a href="/shop/products/' + p.slug + '/">' + escHtml(p.name) + '</a>' +
              '</h3>' +
              '<div class="shop-price-tag">' + priceText + '</div>' +
              '<p class="post-excerpt">' + escHtml(p.summary || p.description || '功能完好，歡迎探索詳細規格與狀況。') + '</p>' +
              '<a href="/shop/products/' + p.slug + '/" class="read-more">查看商品詳情 →</a>' +
              '</article>';
          }).join('');
        }
      }
    } catch (e) {
      console.error('Failed to load dynamic shop products:', e);
    }
  });
</script>
