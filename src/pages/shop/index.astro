---
import BlogLayout from '../../layouts/BlogLayout.astro';

// 預設精選商品列表 (只保留官方真實商品)
const defaultProducts = [
  {
    name: 'Samsung DDR3 4GB 記憶體',
    slug: 'samsungddr34gbram',
    category: '電腦零組件 · 二手良品',
    price: 150,
    summary: '功能經實機檢測完全正常，原廠顆粒良品，適合老舊電腦升級或實驗專案。',
    img: '/banners/samsungddr34gbram.jpg'
  }
];
---

<BlogLayout title="Ovis Shop — 物品價值，淋漓盡致" description="Ovis Shop，讓每件物品的價值淋漓盡致。二手良品與實用物資流轉。">
  <div class="main-content">
    <div class="container">
      <!-- 麵包屑導航 (Breadcrumbs) -->
      <div class="breadcrumbs">
        <a href="/" class="home">首頁</a>
        <span class="sep">&gt;</span>
        <span class="current-post-name">Ovis Shop</span>
      </div>

      <!-- 📰 主內容區 (左側 68% + 右側 28% 商城側邊欄) -->
      <div class="content-area-top" style="margin-top: 1rem;">
        <div class="left">
          <!-- 📑 商城快捷分頁分類標籤 -->
          <div class="tech-main-tab-bar">
            <div class="tech-main-tabs">
              <a href="/shop/" class="tech-main-tab-item active">全部商品</a>
              <a href="/shop/shopping-guide/" class="tech-main-tab-item">購物須知</a>
              
            </div>
            <a href="/shop/" class="cat-read-all">所有商品列表 →</a>
          </div>

          <!-- 精選商品標題列 -->
          <div class="post-area-head">
            <h2 class="post-area-title">商品</h2>
          </div>

          <!-- 商品卡片 3 欄緊湊網格 (即時預渲染 + JS 動態加載) -->
          <div class="post-list col3" id="featured-products">
            {defaultProducts.map((p) => (
              <article class="post-card">
                <div class="img-wrap">
                  <a class="card-thumb-link" href={`/shop/products/${p.slug}/`}>
                    <div class="card-img-box">
                      <img src={p.img} alt={p.name} class="card-img" loading="lazy" />
                    </div>
                  </a>
                </div>
                <ul class="post-categories">
                  <li><a href={`/shop/products/${p.slug}/`}>{p.category}</a></li>
                </ul>
                <h3 class="post-title">
                  <a href={`/shop/products/${p.slug}/`}>{p.name}</a>
                </h3>
                <div class="shop-price-tag">NT$ {p.price}</div>
                <p class="post-excerpt">{p.summary}</p>
                <a href={`/shop/products/${p.slug}/`} class="read-more">查看商品詳情 →</a>
              </article>
            ))}
          </div>
        </div>

        <!-- 📌 右側側邊欄 -->
        <aside class="right sidebar-right">
          <!-- Ovis Shop 簡介 -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="Ovis Shop" width="90" height="90" />
            </div>
            <h2>Ovis Shop</h2>
            <p class="history">這個是 Ovis 的商城</p>
            <div class="side-btn-wrap" style="display: flex; flex-direction: column; align-items: center; gap: 10px; width: 100%; margin-top: 1.2rem;">
              <a href="/shop/cart/" class="btn-side-cart">🛒 查看購物車</a>
              <a href="/about/" class="side-plain-link">關於OviNas</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BlogLayout>

