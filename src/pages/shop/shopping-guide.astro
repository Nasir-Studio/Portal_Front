  }

  .hero-quick-btns {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .content-hero-header {
      flex-direction: column;
    }
    .content-hero-header .left {
      width: 100%;
      padding-right: 0;
