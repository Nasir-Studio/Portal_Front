  }

  .shop-side-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .shop-side-menu li a {
    color: #334155;
    font-size: 0.92rem;
