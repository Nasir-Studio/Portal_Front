---
import BlogLayout from '../layouts/BlogLayout.astro';
---

<style is:global>
  #tools-app {
    min-height: 60vh;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    margin-top: 2rem;
    margin-bottom: 3.5rem;
    overflow: hidden;
  }

  .tools-nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 1rem 1.6rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    font-size: 0.88rem;
    letter-spacing: 0.04em;
  }

  .tools-nav a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .tools-nav a:hover {
    color: #ff6b00;
  }

  .tools-nav-sep {
    color: #cbd5e1;
  }

  .tools-nav-current {
    color: #0f172a;
    font-weight: 600;
  }

  .tools-body {
    padding: 2.2rem 1.8rem;
    background: #ffffff;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.4rem;
  }

  .tool-card {
    position: relative;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.9rem 1.7rem;
    text-decoration: none;
    color: #0f172a;
    transition: all 0.2s ease;
    animation: fadeUp 0.5s ease-out forwards;
    opacity: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .tool-card:hover {
    border-color: #ff6b00;
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(255, 107, 0, 0.12);
  }

  .tool-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.5rem 0;
  }

  .tool-card p {
    color: #475569;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }

  .tool-card .tag {
    display: inline-block;
    margin-top: 1.2rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #ff6b00;
    background: #fff7ed;
    border-radius: 4px;
    padding: 0.3rem 0.75rem;
  }

  #tools-app {
    min-height: 60vh;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: 0 14px 44px -20px rgba(28, 28, 28, 0.28);
    margin-top: 2.4rem;
    margin-bottom: 3.5rem;
    overflow: hidden;
  }

  .tools-nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 1rem 1.6rem;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  .tools-nav a {
    color: var(--ink-2);
    border-bottom: 1px solid var(--border-strong);
    transition: border-color var(--t), color var(--t);
  }

  .tools-nav a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .tools-nav-sep {
    color: var(--ink-3);
  }

  .tools-nav-current {
    color: var(--ink-3);
  }

  .tools-body {
    padding: 2.2rem 1.8rem;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.4rem;
  }

  .tool-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.9rem 1.7rem;
    text-decoration: none;
    color: var(--ink);
    transition: transform var(--t), border-color var(--t), box-shadow var(--t);
    animation: fadeUp 0.5s ease-out forwards;
    opacity: 0;
    box-shadow: 0 6px 24px -18px rgba(28, 28, 28, 0.22);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tool-card:nth-child(1) {
    animation-delay: 0.1s;
  }
  .tool-card:nth-child(2) {
    animation-delay: 0.2s;
  }
  .tool-card:nth-child(3) {
    animation-delay: 0.3s;
  }

  .tool-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-4px);
    box-shadow: 0 18px 44px -20px rgba(28, 28, 28, 0.3);
  }

  .tool-card .icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.35rem;
    transition: transform var(--t);
  }

  .tool-card:hover .icon {
    transform: scale(1.06);
  }

  .tool-card .icon svg {
    width: 26px;
    height: 26px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-drop {
    background: #eef4ff;
    color: #0a63d6;
  }

  .icon-screen {
    background: #f4efff;
    color: #6d46d4;
  }

  .tool-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0 0 0.45rem 0;
    font-family: var(--font-sans);
    color: var(--ink);
  }

  .tool-card p {
    color: var(--ink-2);
    font-size: 0.88rem;
    line-height: 1.65;
    margin: 0;
  }

  .tool-card .tag {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    background: var(--bg-soft);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
  }

  .tool-card-featured {
    border-color: rgba(11, 138, 77, 0.35);
    background: linear-gradient(180deg, #f3fbf6 0%, var(--surface) 60%);
  }

  .tool-card-featured:hover {
    border-color: #0b8a4d;
    box-shadow: 0 18px 44px -18px rgba(11, 138, 77, 0.32);
  }

  .tool-card-featured .icon-wifi {
    background: #0b8a4d;
    color: #ffffff;
  }

  .tool-card-featured .tag {
    color: #0b8a4d;
    background: #e8f8ef;
  }

  @media (max-width: 640px) {
    #tools-app {
      margin-top: 1.2rem;
      margin-bottom: 2.5rem;
    }

    .tools-nav {
      padding: 0.8rem 1rem;
    }

    .tools-body {
      padding: 1.2rem 0.9rem;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<BlogLayout title="NYTools ｜ OviNas" description="OviNas 實用線上工具箱：NY DROP、NY WIFI DROP、NY Screen 等免安裝檔案傳輸與無線投影工具。">
  <div class="main-content">
  <div class="tools container" id="tools-app">
    <nav class="tools-nav" aria-label="麵包屑">
      <a href="/">首頁</a>
      <span class="tools-nav-sep" aria-hidden="true">/</span>
      <span class="tools-nav-current" aria-current="page">NYTools</span>
    </nav>
    <div class="tools-body">
      <div class="tools-grid">
        <a href="/nytools/drop/" class="tool-card">
          <div class="icon icon-drop">
            <svg viewBox="0 0 24 24">
              <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
            </svg>
          </div>
          <h3>NY DROP</h3>
          <p>6 位數代碼配對，檔案直接從 A 電腦傳送到 B 電腦，點對點即時傳輸。</p>
          <span class="tag">P2P Transfer</span>
        </a>

        <a href="/wifi/" class="tool-card tool-card-featured">
          <div class="icon icon-wifi">
            <svg viewBox="0 0 24 24">
              <path d="M5 12.55a11 11 0 0 1 14.08 0" />
              <path d="M1.42 9a16 16 0 0 1 21.16 0" />
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0" />
              <line x1="12" y1="20" x2="12.01" y2="20" />
            </svg>
          </div>
          <h3>NY WIFI DROP</h3>
          <p>同一個 Wi-Fi 內的使用者自動上線，點擊即可互傳大檔案，點對點直連不經伺服器。</p>
          <span class="tag">LAN Transfer</span>
        </a>

        <a href="/nytools/screen/" class="tool-card">
          <div class="icon icon-screen">
            <svg viewBox="0 0 24 24">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
              <line x1="8" y1="21" x2="16" y2="21" />
              <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
          </div>
          <h3>NY Screen</h3>
          <p>免安裝、免登入、免配對碼，開網頁就能投影，支援全螢幕顯示。</p>
          <span class="tag">Screen Share</span>
        </a>
      </div>
    </div>
  </div>
  </div>
</BlogLayout>
