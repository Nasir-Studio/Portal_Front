---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .tool-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0px;
    padding: 2rem 1.75rem;
    text-decoration: none;
    color: var(--ink);
    transition: background var(--t), border-color var(--t);
    opacity: 0;
    animation: fadeUp 0.5s ease-out forwards;
  }

  .tool-card:nth-child(1) { animation-delay: 0.1s; }
  .tool-card:nth-child(2) { animation-delay: 0.2s; }

  .tool-card:hover {
    border-color: var(--ink);
    background: var(--bg-soft);
  }

  .tool-card .icon {
    width: 48px;
    height: 48px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .tool-card .icon svg {
    width: 24px;
    height: 24px;
    stroke: var(--ink);
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tool-card h3 {
    font-size: 1.15rem;
    margin: 0 0 0.5rem 0;
    font-family: var(--font-serif);
  }

  .tool-card p {
    color: var(--ink-3);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }

  .tool-card .tag {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--ink);
    background: var(--bg-soft);
    padding: 0.25rem 0.6rem;
    border-radius: 0px;
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<BaseLayout title="NYTools ｜ 羊家的入口">
  <section class="container">
    <div class="tools-grid">
      <a href="/nytools/drop" class="tool-card">
        <div class="icon">
          <svg viewBox="0 0 24 24">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
          </svg>
        </div>
        <h3>NY DROP</h3>
        <p>P2P 檔案傳輸工具。透過 6 位數代碼快速配對，檔案直接從 A 電腦傳送到 B 電腦，無伺服器儲存、無容量限制，隱私安全滿分。</p>
        <span class="tag">P2P Transfer</span>
      </a>

      <a href="/nytools/screen" class="tool-card">
        <div class="icon">
          <svg viewBox="0 0 24 24">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
            <line x1="8" y1="21" x2="16" y2="21" />
            <line x1="12" y1="17" x2="12" y2="21" />
          </svg>
        </div>
        <h3>NY Screen</h3>
        <p>投影神器。免安裝、免登入、免配對碼，開網頁就能投影。支援全螢幕顯示，使用 PeerJS + STUN/TURN 跨網段連線。</p>
        <span class="tag">Screen Share</span>
      </a>
    </div>
  </section>
</BaseLayout>
