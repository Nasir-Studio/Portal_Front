---
import BlogLayout from '../../layouts/BlogLayout.astro';

const files = [
  {
    type: 'dir',
    icon: '[PARENTDIR]',
    iconSymbol: '📁',
    name: 'Parent Directory',
    href: '/',
    date: '-',
    size: '-',
    sizeBytes: 0,
    desc: '返回上一層首頁目錄'
  },
  {
    type: 'zip',
    icon: '[ZIP]',
    iconSymbol: '📦',
    name: 'IGUnsend.zip',
    href: '/files/IGUnsend.zip',
    date: '2026-08-17 10:30',
    size: '1.2M',
    sizeBytes: 1258291,
    desc: 'IG 自動訊息收回工具（Chrome 擴充套件未封裝版）'
  },
  {
    type: 'zip',
    icon: '[ZIP]',
    iconSymbol: '📦',
    name: 'NTUB_Audit.zip',
    href: '/files/NTUB_Audit.zip',
    date: '2026-08-19 15:45',
    size: '8.4M',
    sizeBytes: 8808038,
    desc: '-'
  },
  {
    type: 'bat',
    icon: '[BAT]',
    iconSymbol: '⚙️',
    name: 'NTUB_Audit.bat',
    href: '/files/NTUB_Audit.bat',
    date: '2026-08-19 16:10',
    size: '2.4K',
    sizeBytes: 2457,
    desc: '-'
  }
];
---

<BlogLayout title="Index of /downloads/ — OviNas" description="Index of /downloads/ 檔案下載目錄列表">
  <div class="apache-wrapper">
    <div class="container apache-container">

      <h1 class="apache-title">Index of /downloads/</h1>

      <!-- 🖥️ 桌面端經典 Apache 表格模式 -->
      <div class="apache-desktop-view">
        <table class="apache-table" id="apacheTable">
          <thead>
            <tr>
              <th class="col-icon"><img src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='20' height='22'></svg>" alt="[ICO]" class="apache-ico" /></th>
              <th class="col-name"><a href="#sort-name" id="sortName">Name</a></th>
              <th class="col-date"><a href="#sort-date" id="sortDate">Last modified</a></th>
              <th class="col-size"><a href="#sort-size" id="sortSize">Size</a></th>
              <th class="col-desc"><a href="#sort-desc" id="sortDesc">Description</a></th>
            </tr>
            <tr>
              <th colspan="5"><hr class="apache-hr" /></th>
            </tr>
          </thead>
          <tbody id="apacheTbody">
            {files.map((file) => (
              <tr class="apache-row" data-name={file.name} data-date={file.date} data-size={file.sizeBytes} data-desc={file.desc}>
                <td class="col-icon" valign="top">
                  <span class="apache-ico-badge" title={file.icon}>{file.iconSymbol}</span>
                </td>
                <td class="col-name">
                  <a href={file.href} download={file.type !== 'dir' ? file.name : undefined} class="apache-link">
                    {file.name}
                  </a>
                </td>
                <td class="col-date" align="right">
                  {file.date}
                </td>
                <td class="col-size" align="right">
                  {file.size}
                </td>
                <td class="col-desc">
                  {file.desc}
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th colspan="5"><hr class="apache-hr" /></th>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- 📱 行動端專屬 RWD 響應式清單 (保持極簡 Apache 風格但觸控友善) -->
      <div class="apache-mobile-view">
        <hr class="apache-hr" />
        <ul class="apache-mobile-list">
          {files.map((file) => (
            <li class="apache-mobile-item">
              <div class="m-item-head">
                <span class="m-icon">{file.iconSymbol}</span>
                <a href={file.href} download={file.type !== 'dir' ? file.name : undefined} class="apache-link m-name">
                  {file.name}
                </a>
              </div>
              {file.type !== 'dir' && (
                <div class="m-item-meta">
                  <span class="m-date">🕒 {file.date}</span>
                  <span class="m-size">💾 {file.size}</span>
                </div>
              )}
              {file.desc && file.desc !== '-' && (<div class="m-desc">{file.desc}</div>)}
              <hr class="apache-hr m-divider" />
            </li>
          ))}
        </ul>
      </div>

      <address class="apache-server-sig">
        Apache/2.4.58 (Ubuntu) Server at ovis.nsir.uk Port 443
      </address>

    </div>
  </div>
</BlogLayout>

<style>
  .apache-wrapper {
    background-color: #ffffff;
    padding: 2rem 0 4.5rem;
    font-family: 'Courier New', Courier, monospace, 'Space Grotesk', system-ui;
    color: #000000;
  }

  .apache-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .apache-title {
    font-family: 'Courier New', Courier, monospace, 'Space Grotesk', serif;
    font-size: 1.9rem;
    font-weight: 700;
    margin: 0 0 0.8rem;
    color: #000000;
    letter-spacing: -0.02em;
  }

  /* 🖥️ 桌面端表格樣式 */
  .apache-desktop-view {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .apache-table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Courier New', Courier, monospace, 'Space Grotesk', monospace;
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .apache-table th {
    font-weight: bold;
    text-align: left;
    padding: 4px 10px;
    color: #000000;
  }

  .apache-table th a {
    color: #0000ee;
    text-decoration: underline;
    font-weight: bold;
  }

  .apache-table th a:hover {
    color: #ff0000;
  }

  .apache-table td {
    padding: 6px 10px;
    white-space: nowrap;
  }

  .col-icon {
    width: 36px;
    text-align: center;
  }

  .apache-ico-badge {
    font-size: 16px;
    display: inline-block;
    vertical-align: middle;
  }

  .col-name {
    padding-right: 25px !important;
  }

  .apache-link {
    color: #0000ee;
    text-decoration: underline;
    font-weight: 600;
  }

  .apache-link:visited {
    color: #551a8b;
  }

  .apache-link:hover {
    color: #ff0000;
  }

  .col-date {
    color: #333333;
    padding-right: 25px !important;
    text-align: right;
  }

  .col-size {
    color: #333333;
    padding-right: 25px !important;
    text-align: right;
  }

  .col-desc {
    color: #555555;
    white-space: normal !important;
  }

  .apache-hr {
    border: 0;
    border-top: 1px solid #aaaaaa;
    margin: 8px 0;
    width: 100%;
  }

  /* 📱 行動端 RWD 樣式 */
  .apache-mobile-view {
    display: none;
  }

  .apache-mobile-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .apache-mobile-item {
    padding: 0.6rem 0;
  }

  .m-item-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }

  .m-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .m-name {
    font-size: 1.05rem;
    word-break: break-all;
  }

  .m-item-meta {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 0.82rem;
    color: #555555;
    margin: 0.2rem 0 0.4rem 1.8rem;
  }

  .m-desc {
    font-size: 0.85rem;
    color: #444444;
    margin-left: 1.8rem;
    line-height: 1.5;
  }

  .m-divider {
    border-top-color: #dddddd;
    margin-top: 0.8rem;
  }

  .apache-server-sig {
    font-style: italic;
    font-size: 13.5px;
    color: #444444;
    margin-top: 1.2rem;
    font-family: 'Courier New', Courier, monospace, system-ui;
    line-height: 1.5;
  }

  /* 📲 響應式斷點切換 (<= 680px) */
  @media (max-width: 680px) {
    .apache-desktop-view {
      display: none;
    }
    .apache-mobile-view {
      display: block;
    }
    .apache-title {
      font-size: 1.5rem;
    }
    .apache-server-sig {
      font-size: 12px;
    }
  }
</style>

<script>
  // ⚡ 經典 Apache 點擊表頭排序互動 (Name, Date, Size, Desc)
  const tbody = document.getElementById('apacheTbody');
  const sortNameBtn = document.getElementById('sortName');
  const sortDateBtn = document.getElementById('sortDate');
  const sortSizeBtn = document.getElementById('sortSize');
  const sortDescBtn = document.getElementById('sortDesc');

  let sortOrders = { name: 1, date: 1, size: 1, desc: 1 };

  function sortTable(key: 'name' | 'date' | 'size' | 'desc') {
    if (!tbody) return;
    const rows = Array.from(tbody.querySelectorAll('.apache-row'));
    const parentDir = rows.find(r => r.getAttribute('data-name') === 'Parent Directory');
    const contentRows = rows.filter(r => r.getAttribute('data-name') !== 'Parent Directory');

    const order = sortOrders[key];
    sortOrders[key] = -order;

    contentRows.sort((a, b) => {
      let valA: any = a.getAttribute(`data-${key}`) || '';
      let valB: any = b.getAttribute(`data-${key}`) || '';

      if (key === 'size') {
        valA = parseInt(valA, 10) || 0;
        valB = parseInt(valB, 10) || 0;
        return (valA - valB) * order;
      }
      return valA.localeCompare(valB) * order;
    });

    tbody.innerHTML = '';
    if (parentDir) tbody.appendChild(parentDir);
    contentRows.forEach(r => tbody.appendChild(r));
  }

  sortNameBtn?.addEventListener('click', (e) => { e.preventDefault(); sortTable('name'); });
  sortDateBtn?.addEventListener('click', (e) => { e.preventDefault(); sortTable('date'); });
  sortSizeBtn?.addEventListener('click', (e) => { e.preventDefault(); sortTable('size'); });
  sortDescBtn?.addEventListener('click', (e) => { e.preventDefault(); sortTable('desc'); });
</script>
