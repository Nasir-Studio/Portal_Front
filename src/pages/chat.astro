---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="AI 電腦助手 — OviNas">
  <div class="container">
    <h1 class="page-title">AI 電腦助手</h1>
    <p class="page-sub">文字問答、圖片辨識 — 服務準備中，敬請期待</p>

    <div class="ai-wrap">
      <div class="ai-status">
        <span class="status-dot"></span>
        <span>準備中</span>
        <span class="status-badge">即將上線</span>
      </div>

      <div class="ai-features">
        <div class="feature">
          <span class="feature-icon" aria-hidden="true">⌨</span>
          <div class="feature-body">
            <span class="feature-name">文字問答</span>
            <span class="feature-desc">詢問電腦相關問題，獲得即時解答</span>
          </div>
        </div>
        <div class="feature">
          <span class="feature-icon" aria-hidden="true">▣</span>
          <div class="feature-body">
            <span class="feature-name">圖片辨識</span>
            <span class="feature-desc">上傳截圖或照片，AI 幫你分析內容</span>
          </div>
        </div>
      </div>

      <div class="ai-input">
        <label class="field">
          <span class="field-label">輸入你的問題</span>
          <textarea id="ai-text" rows="3" maxlength="2000" placeholder="例如：我的電腦開不了機，該怎麼排除？"></textarea>
        </label>

        <div class="upload-zone" id="upload-zone">
          <input type="file" id="upload-input" accept="image/*" hidden />
          <button class="upload-btn" id="upload-btn" type="button" aria-label="上傳圖片">
            <span aria-hidden="true">▣</span> 上傳圖片
          </button>
          <span class="upload-hint" id="upload-hint">支援圖片辨識（準備中）</span>
        </div>

        <div class="preview" id="preview" hidden>
          <img id="preview-img" alt="已選擇的圖片" />
          <button class="preview-remove" id="preview-remove" type="button" aria-label="移除圖片">✕</button>
        </div>

        <p class="form-msg" id="form-msg" role="status" hidden></p>

        <button class="btn btn--block" id="submit-btn" type="button" disabled>送出問題</button>
        <p class="ai-note">AI 服務正在建置中，上線後即可使用。有任何問題歡迎先使用工單系統聯絡我們。</p>
      </div>

      <a class="ai-fallback" href="/tickets/">
        前往工單系統
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    padding: 3rem 0 0.4rem;
  }

  .page-sub {
    margin-bottom: 1.6rem;
    font-size: 0.9rem;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }

  .ai-wrap {
    max-width: 720px;
    margin-inline: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;
  }

  .ai-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.1rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
    font-size: 0.85rem;
    color: var(--ink-2);
    letter-spacing: 0.08em;
  }

  .status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #b9b8b2;
    flex-shrink: 0;
  }

  .status-badge {
    margin-left: auto;
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border-strong);
    color: var(--ink-3);
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .ai-features {
    display: flex;
    flex-direction: column;
    padding: 1.1rem;
    gap: 0.7rem;
    border-bottom: 1px solid var(--border);
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-strong);
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .feature-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .feature-name {
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .feature-desc {
    font-size: 0.82rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }

  .ai-input {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-label {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }

  .ai-input textarea {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 0;
    color: var(--ink);
    resize: vertical;
    min-height: 72px;
  }

  .ai-input textarea:focus {
    outline: 2px solid var(--ink);
    outline-offset: 0;
    border-color: var(--ink);
  }

  .upload-zone {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem;
    border: 1px dashed var(--border-strong);
    background: var(--bg-soft);
  }

  .upload-btn {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    padding: 0.45rem 0.8rem;
    cursor: pointer;
    letter-spacing: 0.08em;
    transition: border-color var(--t), color var(--t);
  }

  .upload-btn:hover {
    border-color: var(--ink);
  }

  .upload-hint {
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.05em;
  }

  .preview {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .preview img {
    display: block;
    max-width: 100%;
    max-height: 220px;
    border: 1px solid var(--border-strong);
  }

  .preview-remove {
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    width: 26px;
    height: 26px;
    background: var(--ink);
    color: var(--white);
    border: none;
    cursor: pointer;
    font-size: 0.8rem;
    line-height: 1;
  }

  .form-msg {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .btn--block {
    width: 100%;
  }

  .ai-note {
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.04em;
    line-height: 1.7;
    text-align: center;
  }

  .ai-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0 auto 1.4rem;
    font-size: 0.88rem;
    color: var(--ink);
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ai-fallback:hover {
    color: var(--ink-2);
  }
</style>

<script>
  const textInput = document.querySelector('#ai-text') as HTMLTextAreaElement;
  const submitBtn = document.querySelector('#submit-btn') as HTMLButtonElement;
  const msg = document.querySelector('#form-msg') as HTMLParagraphElement;
  const uploadBtn = document.querySelector('#upload-btn') as HTMLButtonElement;
  const uploadInput = document.querySelector('#upload-input') as HTMLInputElement;
  const uploadHint = document.querySelector('#upload-hint') as HTMLSpanElement;
  const preview = document.querySelector('#preview') as HTMLDivElement;
  const previewImg = document.querySelector('#preview-img') as HTMLImageElement;
  const previewRemove = document.querySelector('#preview-remove') as HTMLButtonElement;

  let hasImage = false;

  textInput?.addEventListener('input', () => {
    updateState();
  });

  uploadBtn?.addEventListener('click', () => {
    uploadInput?.click();
  });

  uploadInput?.addEventListener('change', () => {
    const file = uploadInput.files?.[0];
    if (file === undefined) return;
    const url = URL.createObjectURL(file);
    if (previewImg !== null) previewImg.src = url;
    if (preview !== null) preview.hidden = false;
    if (uploadHint !== null) uploadHint.textContent = `${file.name}`;
    hasImage = true;
    updateState();
  });

  previewRemove?.addEventListener('click', () => {
    if (preview !== null) preview.hidden = true;
    if (previewImg !== null) previewImg.src = '';
    if (uploadInput !== null) uploadInput.value = '';
    if (uploadHint !== null) uploadHint.textContent = '支援圖片辨識（準備中）';
    hasImage = false;
    updateState();
  });

  function updateState(): void {
    const hasText = (textInput?.value ?? '').trim().length > 0;
    if (submitBtn === null) return;
    submitBtn.disabled = !(hasText || hasImage);
  }

  submitBtn?.addEventListener('click', () => {
    if (msg === null) return;
    msg.hidden = false;
    msg.textContent = 'AI 服務準備中，即將上線。請稍後再試，或先使用工單系統聯絡我們。';
  });
</script>
