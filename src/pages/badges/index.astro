---
import App from '../../badges/App.svelte';
import '../../badges/app.css';
import '@fontsource-variable/space-grotesk';

const title = '羊-集章';
const description = '羊-集章 — 捷運紀念章電子集章冊：收集台北捷運與新北捷運的紀念章，記錄你的足跡。';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/icons/icon-192.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f5f4f1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="羊-集章" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/badges/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <div id="app">
      <App client:only="svelte" />
    </div>
    <script>
      // PWA：註冊 badges 專屬 service worker（scope: /badges/）
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker
            .register('/badges/sw.js', { updateViaCache: 'none' })
            .catch(function (err) {
              console.warn('Badges SW registration failed:', err);
            });
        });
      }
    </script>
    <style is:global>
      /* 羊家入口風格的變數（不覆蓋 badges app.css 的 --ink，避免衝突） */
      :root {
        --sheep-ink: #1c1c1c;
        --sheep-ink-2: #4c4b47;
        --sheep-ink-3: #8b8983;
        --sheep-white: #ffffff;
        --sheep-serif: 'Noto Serif TC', 'Songti TC', 'STSong', Georgia, serif;
        --sheep-sans: 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', system-ui, sans-serif;
        --sheep-ease: cubic-bezier(0.4, 0, 0.2, 1);
        --sheep-t: 200ms cubic-bezier(0.4, 0, 0.2, 1);
      }
    </style>
  </body>
</html>
