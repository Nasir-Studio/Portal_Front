---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="登入 — OviNas">
  <div class="container">
    <div class="login-wrap">
      <!-- 溫暖精緻登入卡片 (無厚重黑底壓迫感) -->
      <div class="login-card">
        <div class="login-header">
          <div class="login-avatar">
            <img src="/sheep-hd.png" alt="OviNas" width="34" height="34" />
          </div>
          <div class="login-header-text">
            <h1 class="login-title" data-i18n="login.title">帳號登入</h1>
            <p class="login-sub" data-i18n="login.sub">使用 VIP 帳號登入</p>
          </div>
        </div>

        <form class="login-form" id="login-form" novalidate>
          <label class="field">
            <span class="field-label" data-i18n="login.email">電子郵件</span>
            <input
              id="email"
              type="email"
              name="email"
              autocomplete="email"
              placeholder="example@email.com"
              required
            />
          </label>
          <label class="field">
            <span class="field-label" data-i18n="login.password">密碼</span>
            <input
              id="password"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="••••••••"
              required
            />
          </label>
          <p class="form-error" id="form-error" role="alert" hidden></p>
          <button class="login-submit-btn" id="submit-btn" type="submit" data-i18n="login.submit">
            登入
          </button>
        </form>
      </div>

      <p class="page-note">
        <span data-i18n="login.reserve_note">訪客不需登入即可預約 — </span>
        <a class="note-link" href="/reserve/" data-i18n="login.reserve_link">前往預約系統</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .login-wrap {
    max-width: 420px;
    margin-inline: auto;
    padding: 3.5rem 0 4.5rem;
    animation: login-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes login-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 溫潤柔和的卡片設計 (無刺眼重黑、無壓迫感) */
  .login-card {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 6px 24px rgba(28, 28, 28, 0.06), 0 1px 3px rgba(28, 28, 28, 0.04);
    overflow: hidden;
    backdrop-filter: blur(12px);
  }

  /* 輕柔典雅的標題列 (白底柔和灰線，告別厚重全黑標題) */
  .login-header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.4rem 1.6rem 1.2rem;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
  }

  .login-avatar {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(28, 28, 28, 0.04);
  }

  .login-avatar img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .login-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .login-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink);
    margin: 0;
  }

  .login-sub {
    font-size: 0.78rem;
    color: var(--ink-3);
    letter-spacing: 0.06em;
    margin: 0;
  }

  .login-form {
    padding: 1.5rem 1.6rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    background: var(--surface);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  .field input {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    padding: 0.65rem 0.85rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--ink);
    outline: none;
    box-sizing: border-box;
    transition: all var(--t);
  }

  .field input:focus {
    border-color: var(--ink);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(28, 28, 28, 0.08);
  }

  .login-submit-btn {
    appearance: none;
    background: var(--ink);
    color: var(--white);
    border: 1px solid var(--ink);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-family: var(--font-serif);
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    cursor: pointer;
    margin-top: 0.4rem;
    box-shadow: 0 4px 12px rgba(28, 28, 28, 0.15);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .login-submit-btn:hover:not(:disabled) {
    background: #000000;
    transform: translateY(-1.5px);
    box-shadow: 0 6px 18px rgba(28, 28, 28, 0.22);
  }

  .login-submit-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .login-submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .form-error {
    font-size: 0.82rem;
    color: #c33;
    letter-spacing: 0.04em;
    padding: 0.45rem 0.6rem;
    background: #fdf2f2;
    border-radius: 6px;
    border: 1px solid #f9d6d6;
    margin: 0;
  }

  .page-note {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .note-link {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--t);
  }

  .note-link:hover {
    color: #000;
  }
</style>

<script>
  import { login, currentUser } from '../scripts/auth';
  import { ApiError } from '../scripts/api';

  const form = document.querySelector('#login-form') as HTMLFormElement;
  const emailInput = document.querySelector('#email') as HTMLInputElement;
  const passwordInput = document.querySelector('#password') as HTMLInputElement;
  const errorBox = document.querySelector('#form-error') as HTMLParagraphElement;
  const submitBtn = document.querySelector('#submit-btn') as HTMLButtonElement;

  function showError(message: string): void {
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  async function redirectByRole(role: 'admin' | 'member'): Promise<void> {
    if (role === 'admin') {
      window.location.href = '/admin/';
      return;
    }
    const params = new URLSearchParams(window.location.search);
    const redirect = params.get('redirect');
    if (redirect && redirect.startsWith('/')) {
      window.location.href = redirect;
    } else {
      window.location.href = '/vip/';
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.hidden = true;

    const email = emailInput.value.trim();
    const password = passwordInput.value;
    if (email.length === 0 || password.length === 0) {
      showError('請填寫 Email 與密碼');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '登入中…';
    try {
      const user = await login(email, password);
      await redirectByRole(user.role);
    } catch (err) {
      if (err instanceof ApiError) {
        if (err.code === 'invalid_credentials') showError('Email 或密碼錯誤');
        else if (err.code === 'network_error') showError('無法連線到伺服器');
        else showError(err.message);
      } else {
        showError('發生未知錯誤，請稍後再試');
      }
      submitBtn.disabled = false;
      submitBtn.textContent = '登入';
    }
  });

  if (currentUser() !== null) {
    const user = currentUser();
    if (user !== null) {
      void redirectByRole(user.role);
    }
  }
</script>
