---
import BlogLayout from '../layouts/BlogLayout.astro';
---

<BlogLayout title="VIP 登入 — OviNas" description="使用 VIP 帳號登入 OviNas 專區與技術工單系統。">
  <div class="main-content">
    <div class="container">
      <!-- 麵包屑導航 (Breadcrumbs) -->
      <div class="breadcrumbs">
        <a href="/" class="home">首頁</a>
        <span class="sep">&gt;</span>
        <span class="current-post-name">會員登入</span>
      </div>

      <div class="login-wrapper">
        <div class="login-card">
          <!-- 頂部品牌頭部 -->
          <div class="login-header">
            <div class="login-logo-circle">
              <img src="/sheep-hd.png" alt="OviNas" width="48" height="48" />
            </div>
            <h1 class="login-title">VIP 會員登入</h1>
            <p class="login-subtitle">登入以使用 VIP 專區與專屬問題工單服務</p>
          </div>

          <!-- 登入表單 -->
          <form class="login-form" id="login-form" novalidate>
            <div class="form-group">
              <label for="email" class="form-label">電子郵件 / Email</label>
              <input
                id="email"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="請輸入註冊的 Email"
                required
                class="form-input"
              />
            </div>

            <div class="form-group">
              <label for="password" class="form-label">登入密碼 / Password</label>
              <input
                id="password"
                type="password"
                name="password"
                autocomplete="current-password"
                placeholder="請輸入會員密碼"
                required
                class="form-input"
              />
            </div>

            <div class="form-error" id="form-error" role="alert" style="display: none;"></div>

            <button class="login-btn" id="submit-btn" type="submit">
              立即登入 →
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
  .main-content {
    background-color: #ffffff;
    padding: 1.5rem 0 5rem;
    min-height: 75vh;
  }

  .breadcrumbs {
    font-size: 14px;
    color: #999999;
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .breadcrumbs a {
    color: #666666;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #ff6b00;
  }

  .breadcrumbs .sep {
    margin: 0 5px;
    color: #cccccc;
  }

  .breadcrumbs .current-post-name {
    color: #333333;
    font-weight: 500;
  }

  /* 登入卡片容器 */
  .login-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem 0 3rem;
  }

  .login-card {
    width: 100%;
    max-width: 440px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-top: 3px solid #ff6b00;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
    padding: 2.4rem 2.2rem 2.6rem;
  }

  .login-header {
    text-align: center;
    margin-bottom: 2.2rem;
  }

  .login-logo-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    background: #fafafa;
    border: 1px solid #e2e8f0;
    border-radius: 50%;
    margin-bottom: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .login-logo-circle img {
    border-radius: 50%;
  }

  .login-title {
    font-size: 1.55rem;
    font-weight: 500;
    color: #0f172a;
    margin: 0 0 0.5rem;
    letter-spacing: 0.02em;
  }

  .login-subtitle {
    font-size: 0.88rem;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-label {
    font-size: 0.84rem;
    font-weight: 500;
    color: #334155;
    letter-spacing: 0.02em;
  }

  .form-input {
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
    font-size: 0.94rem;
    padding: 0.75rem 0.95rem;
    background: #fafafa;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    outline: none;
    transition: all 0.15s ease;
  }

  .form-input:focus {
    background: #ffffff;
    border-color: #ff6b00;
    box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.12);
  }

  .form-error {
    font-size: 0.86rem;
    color: #dc2626;
    background: #fef2f2;
    border-left: 3px solid #ef4444;
    padding: 8px 12px;
    letter-spacing: 0.02em;
  }

  .login-btn {
    width: 100%;
    padding: 0.85rem;
    background: #111111;
    color: #ffffff;
    border: none;
    font-size: 0.94rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
    text-align: center;
    margin-top: 0.6rem;
  }

  .login-btn:hover {
    background: #ff6b00;
  }

  .login-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 500px) {
    .login-card {
      padding: 1.8rem 1.4rem 2rem;
    }
  }
</style>

<script>
  import { login, currentUser } from '../scripts/auth';
  import { ApiError } from '../scripts/api';

  const form = document.querySelector('#login-form') as HTMLFormElement;
  const emailInput = document.querySelector('#email') as HTMLInputElement;
  const passwordInput = document.querySelector('#password') as HTMLInputElement;
  const errorBox = document.querySelector('#form-error') as HTMLParagraphElement;
  const submitBtn = document.querySelector('#submit-btn') as HTMLButtonElement;

  function showError(message: string): void {
    if (errorBox) {
      errorBox.textContent = message;
      errorBox.style.display = 'block';
    }
  }

  async function redirectByRole(role: 'admin' | 'member'): Promise<void> {
    if (role === 'admin') {
      window.location.href = '/admin/';
      return;
    }
    const params = new URLSearchParams(window.location.search);
    const redirect = params.get('redirect');
    if (redirect && redirect.startsWith('/')) {
      window.location.href = redirect;
    } else {
      window.location.href = '/vip/';
    }
  }

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorBox) errorBox.style.display = 'none';

      const email = emailInput.value.trim();
      const password = passwordInput.value;
      if (email.length === 0 || password.length === 0) {
        showError('請填寫 Email 與密碼');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = '登入中…';
      try {
        const user = await login(email, password);
        await redirectByRole(user.role);
      } catch (err) {
        if (err instanceof ApiError) {
          if (err.code === 'invalid_credentials') showError('Email 或密碼錯誤');
          else if (err.code === 'network_error') showError('無法連線到伺服器');
          else showError(err.message);
        } else {
          showError('發生未知錯誤，請稍後再試');
        }
        submitBtn.disabled = false;
        submitBtn.textContent = '立即登入 →';
      }
    });
  }
</script>
