---
import BlogLayout from '../../layouts/BlogLayout.astro';
import Credits from '../../ntub/components/Credits.svelte';
import '../../ntub/app.css';
import '@fontsource-variable/space-grotesk';

const title = '預算學分 — NTUB 學分戰士';
const description = 'NTUB 學分學程試算與修課規劃。';
---

<BlogLayout title={title} description={description}>
  <div class="main-content">
    <div class="container" style="padding: 1.5rem 0 3.5rem;">
      <div id="app">
        <Credits client:only="svelte" />
      </div>
    </div>
  </div>
</BlogLayout>

<style is:global>
  #app {
    min-height: 60vh;
  }
</style>
