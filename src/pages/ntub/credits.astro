---
import Credits from '../../ntub/components/Credits.svelte';
import '../../ntub/app.css';
import '@fontsource-variable/space-grotesk';

const title = '學分勾選 — 學分學程學分戰士';
const description = 'NTUB 學分勾選：勾選已修課程，即時計算學分進度。';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y3XYZ3RKPZ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag("js", new Date());
    gtag("config", "G-Y3XYZ3RKPZ");
  </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;500;600;700&family=Noto+Sans+TC:wght@300;400;500;700&family=Zen+Old+Mincho:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <div id="app">
      <Credits client:only="svelte" />
    </div>
    <style is:global>
      body {
        background: #f7f5f0;
      }
    </style>
  <script is:inline>
    // 全站背景訪客計數
    var hc = new Image();
    hc.src = "https://www.hitwebcounter.com/counter/counter.php?page=21514902&style=0001&nbdigits=8&type=page";
  </script>
  </body>
</html>
