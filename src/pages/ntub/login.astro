---
import Login from '../../ntub/components/Login.svelte';
import '../../ntub/app.css';
import '@fontsource-variable/space-grotesk';

const title = '登入 — 學分學程學分戰士';
const description = 'NTUB 學分學程登入：登入後勾選的學分進度雲端同步。';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;500;600;700&family=Noto+Sans+TC:wght@300;400;500;700&family=Zen+Old+Mincho:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <div id="app">
      <Login client:only="svelte" />
    </div>
    <style is:global>
      body {
        background: #f7f5f0;
      }
    </style>
  </body>
</html>
