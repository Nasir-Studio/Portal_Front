---
import BlogLayout from '../../layouts/BlogLayout.astro';
import Brochure from '../../ntub/components/Brochure.svelte';
import '../../ntub/app.css';
import '@fontsource-variable/space-grotesk';

const title = '簡章 — NTUB 學分學程';
const description = 'NTUB 學分學程簡章：收錄各學分學程及微學程之設置要點暨計畫書內容。';
---

<BlogLayout title={title} description={description}>
  <div class="main-content">
    <div class="container" style="padding: 1.5rem 0 3.5rem;">
      <div id="app">
        <Brochure client:only="svelte" />
      </div>
    </div>
  </div>
</BlogLayout>

<style is:global>
  #app {
    min-height: 60vh;
  }
</style>
