</style>

<script>
  import { api, ApiError } from '../scripts/api';
  import { currentUser } from '../scripts/auth';

  const TZ = 'Asia/Taipei';

  type Slot = {
    id: number;
    title: string;
    description: string;
    startsAt: number;
    durationMinutes: number;
    maxBookings: number;
    bookingCount: number;
    active: number;
  };

  type Reservation = {
    id: number;
    slotId: number;
    slotTitle: string;
    slotStartsAt: number;
    slotDurationMinutes: number;
    name: string;
    email: string;
    note: string;
    status: string;
    createdAt: number;
  };

  const slotList = document.querySelector<HTMLDivElement>('#slot-list');
  const mineSection = document.querySelector<HTMLDivElement>('#mine-section');
  const mineList = document.querySelector<HTMLDivElement>('#mine-list');

  const user = currentUser();
  if (user !== null && mineSection) {
    mineSection.style.display = 'block';
    loadMine();
  }

  loadSlots();

  async function loadSlots(): Promise<void> {
    if (slotList === null) return;
    try {
      const data = await api.get<{ slots: Slot[] }>('/api/reservations/slots');
      const now = Date.now();
      const future = (data.slots || []).filter(
        (s) => s.active === 1 && s.startsAt + s.durationMinutes * 60 * 1000 > now,
      );
      renderSlots(future);
    } catch {
      slotList.innerHTML = '<p class="slot-empty">無法載入時段，請稍後再試。</p>';
    }
  }

  function renderSlots(slots: Slot[]): void {
    if (slotList === null) return;
    slotList.replaceChildren();

    if (slots.length === 0) {
      slotList.innerHTML = '<p class="slot-empty">目前尚無開放預約的時段。</p>';
      return;
    }

    for (const slot of slots) {
      const remaining = slot.maxBookings - slot.bookingCount;
      const isFull = remaining <= 0;

      const card = document.createElement('div');
      card.className = 'slot-card';

      const head = document.createElement('div');
      head.className = 'slot-head';
      head.innerHTML = `
        <h3 class="slot-title">${escapeHtml(slot.title)}</h3>
        <span class="slot-meta">${formatDateTime(slot.startsAt)} · ${slot.durationMinutes} 分鐘</span>
      `;
      card.appendChild(head);

      if (slot.description) {
        const desc = document.createElement('p');
        desc.className = 'slot-desc';
        desc.textContent = slot.description;
        card.appendChild(desc);
      }

      const foot = document.createElement('div');
      foot.className = 'slot-foot';

      const remSpan = document.createElement('span');
      remSpan.className = 'slot-remaining' + (isFull ? ' full' : '');
      remSpan.textContent = isFull ? '已額滿' : `尚餘 ${remaining} 個名額`;
      foot.appendChild(remSpan);

      if (!isFull) {
        const btn = document.createElement('button');
        btn.className = 'btn';
        btn.textContent = '預約此時段';
        btn.addEventListener('click', () => {
          const existing = card.querySelector('.book-form');
          if (existing !== null) {
            existing.remove();
            return;
          }
          card.appendChild(createBookingForm(slot, card));
        });
        foot.appendChild(btn);
      }

      card.appendChild(foot);
      slotList.appendChild(card);
    }
  }

  function createBookingForm(slot: Slot, card: HTMLElement): HTMLElement {
    const form = document.createElement('form');
    form.className = 'book-form';

    const u = currentUser();
    const defaultName = u?.displayName || '';
    const defaultEmail = u?.email || '';

    form.innerHTML = `
      <div class="field">
        <label class="field-label">您的稱呼 *</label>
        <input type="text" name="name" required maxlength="50" value="${escapeHtml(defaultName)}" placeholder="例如：王小明" />
      </div>
      <div class="field">
        <label class="field-label">聯絡 Email *</label>
        <input type="email" name="email" required maxlength="100" value="${escapeHtml(defaultEmail)}" placeholder="name@example.com" />
      </div>
      <div class="field">
        <label class="field-label">備註（選填）</label>
        <textarea name="note" maxlength="300" placeholder="想先討論的內容或提問…"></textarea>
      </div>
      <div class="book-actions">
        <button type="submit" class="btn">確認預約</button>
        <button type="button" class="btn btn--ghost cancel-btn">取消</button>
      </div>
      <div class="form-msg" style="display:none"></div>
    `;

    form.querySelector('.cancel-btn')?.addEventListener('click', () => {
      form.remove();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector<HTMLDivElement>('.form-msg')!;
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      msg.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.textContent = '送出中…';

      const formData = new FormData(form);
      try {
        await api.post('/api/reservations/book', {
          slotId: slot.id,
          name: (formData.get('name') as string).trim(),
          email: (formData.get('email') as string).trim(),
          note: (formData.get('note') as string || '').trim(),
        });
        msg.className = 'form-msg ok';
        msg.textContent = '預約成功！我們將透過 Email 與您聯絡。';
        msg.style.display = 'block';
        form.querySelector<HTMLElement>('.book-actions')!.style.display = 'none';
        loadSlots();
        if (currentUser() !== null) loadMine();
      } catch (err) {
        msg.className = 'form-msg err';
        msg.textContent = err instanceof ApiError ? err.message : '預約失敗，請稍後再試。';
        msg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = '確認預約';
      }
    });

    return form;
  }

  async function loadMine(): Promise<void> {
    if (mineList === null) return;
    try {
      const data = await api.get<{ reservations: Reservation[] }>('/api/reservations/mine');
      renderMine(data.reservations || []);
    } catch {
      mineList.innerHTML = '<p class="slot-empty">無法載入預約紀錄。</p>';
    }
  }

  function renderMine(items: Reservation[]): void {
    if (mineList === null) return;
    mineList.replaceChildren();

    if (items.length === 0) {
      mineList.innerHTML = '<p class="slot-empty">您目前沒有任何預約紀錄。</p>';
      return;
    }

    for (const res of items) {
      const row = document.createElement('div');
      row.className = 'mine-row';

      const isCancelled = res.status === 'cancelled';
      const statusLabel = isCancelled ? '已取消' : '已確認';

      row.innerHTML = `
        <div class="mine-info">
          <span class="mine-name">${escapeHtml(res.slotTitle)}</span>
          <span class="mine-note">${formatDateTime(res.slotStartsAt)} · ${res.slotDurationMinutes} 分鐘${res.note ? ' · 備註：' + escapeHtml(res.note) : ''}</span>
        </div>
        <span class="mine-status ${isCancelled ? 'cancelled' : ''}">${statusLabel}</span>
      `;
      mineList.appendChild(row);
    }
  }

  function formatDateTime(ms: number): string {
    const d = new Date(ms);
    return d.toLocaleString('zh-TW', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
</script>
