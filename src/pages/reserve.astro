---
import BlogLayout from '../layouts/BlogLayout.astro';
import posts from '../data/posts';

const popularPosts = posts.slice(0, 3);
---

<BlogLayout title="預約系統 — OviNas" description="選擇時段預約，VIP 會員可查看預約紀錄。">
  <div class="main-content">
    <div class="container">
      <!-- 麵包屑導航 (Breadcrumbs) -->
      <div class="breadcrumbs">
        <a href="/" class="home">首頁</a>
        <span class="sep">&gt;</span>
        <span class="current-post-name">預約系統</span>
      </div>

      <!-- 🔷 1. 經典 Hero Header 區塊 (左側 30% 介紹 + 右側 70% 橫幅大圖) -->
      <section class="content-hero-header">
        <div class="left">
          <h3>RESERVATION</h3>
          <h2>線上時段預約與諮詢服務</h2>
          <a href="#slotsSection" class="btn-about-hero">瀏覽預約時段</a>
        </div>
        <div class="right">
          <div class="slider-wrap-header">
            <div class="slider-one">
              <div class="img-wrap">
                <div class="bgs bgs1"></div>
                <div class="bgs bgs2"></div>
                <div class="bgs bgs3"></div>
                <div class="bgs bgs4"></div>
                <div class="bgs bgs5 hero-featured-link">
                  <div class="featured-img-container">
                    <img src="/banners/hero-promo-v3.jpg?v=20260820light" alt="OviNas 預約諮詢服務" class="featured-main-img" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 📰 2. 雙欄主內容區 (左側 70% 預約主體 + 右側 30% 側邊欄) -->
      <div class="content-area-top">
        <div class="left">
          <!-- 📅 站長行事曆 (Google Calendar) -->
          <div class="post-area-head">
            <h2 class="post-area-title">站長行事曆</h2>
            <span class="cal-sub-label">預先掌握站長行程，以利預約合適時間</span>
          </div>

          <div class="blog-cal-frame" style="margin-bottom: 3rem;">
            <iframe
              src="https://calendar.google.com/calendar/embed?src=bb049ab126a644ff77ce9a3dd0ad5c2aa0b1bd0272dd636a38dcfbabdd5aa7aa%40group.calendar.google.com&ctz=Asia%2FTaipei"
              title="OviNas 站長行事曆"
              loading="lazy"
              frameborder="0"
              scrolling="no"
            ></iframe>
          </div>

          <!-- ⏰ 開放預約時段 -->
          <div class="post-area-head" id="slotsSection">
            <h2 class="post-area-title">開放預約時段</h2>
            <span class="cal-sub-label">選擇合適時段並填寫預約資料</span>
          </div>

          <div class="slot-list" id="slot-list">
            <p class="slot-empty">正在載入開放時段…</p>
          </div>

          <!-- 👤 我的預約紀錄 (VIP 會員可見) -->
          <div id="mine-section" style="display: none; margin-top: 3.5rem;">
            <div class="post-area-head">
              <h2 class="post-area-title">我的預約紀錄</h2>
              <span class="cal-sub-label">您的專屬預約歷史與狀態</span>
            </div>
            <div class="mine-list" id="mine-list">
              <p class="slot-empty">載入中…</p>
            </div>
          </div>
        </div>

        <!-- 📌 右側側邊欄 (比照首頁 28% 側邊欄) -->
        <aside class="right sidebar-right">
          <!-- 站長專欄 -->
          <div class="side-author-box">
            <div class="photo">
              <img src="/sheep-hd.png" alt="OviNas" width="90" height="90" />
            </div>
            <h2>OviNas <span class="eng-name">/ 站長 Nasir</span></h2>
            <p class="history">網站架設 · 系統資安 · 筆記小分享</p>
            <div class="side-btn-wrap">
              <a href="/about/" class="btn-vip">關於站長</a>
            </div>
          </div>

          <!-- 熱門推薦文章 -->
          <div class="popular-posts" id="popular-side">
            <h3 class="popular-title">熱門推薦文章</h3>
            <ul class="wpp-list">
              {popularPosts.map((p) => (
                <li class="wpp-item">
                  <a href={`/posts/${p.slug}/`} class="wpp-thumb-link">
                    <div class="wpp-thumbnail-box">
                      <img src={`/banners/${p.slug}.jpg?v=20260820light`} alt={p.title} class="wpp-thumb-img" />
                    </div>
                  </a>
                  <div class="wpp-details">
                    <a href={`/posts/${p.slug}/`} class="wpp-post-title">
                      {p.title}
                    </a>
                    <span class="wpp-meta">{p.date}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
