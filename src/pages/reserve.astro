  /* 側邊欄樣式 (完全比照首頁) */
  .side-author-box {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    padding: 1.8rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .side-author-box .photo img {
    border-radius: 50%;
