    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wpp-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .wpp-post-title {
    font-size: 0.88rem;
    font-weight: 600;
