    background-color: #ffffff;
    padding: 1.5rem 0 5rem;
  }

  .breadcrumbs {
    font-size: 14px;
    color: #999999;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .breadcrumbs a {
    color: #666666;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #ff6b00;
  }

  .breadcrumbs .sep {
    margin: 0 5px;
    color: #cccccc;
  }

  .breadcrumbs .current-post-name {
    color: #333333;
    font-weight: 500;
  }

  /* 🔷 1. Hero Header 區塊 (完全比照首頁) */
  .content-hero-header {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    margin-bottom: 3.5rem;
    border-bottom: 1px solid #e2e2e2;
    padding-bottom: 3rem;
  }

  .content-hero-header .left {
