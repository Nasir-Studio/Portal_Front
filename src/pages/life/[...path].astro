---
import LifeApp from '../../components/life/App.svelte';
import '../../components/life/globals.css';

export function getStaticPaths() {
  return [
    { params: { path: undefined } },
    { params: { path: 'trash' } },
    { params: { path: 'track' } },
    { params: { path: 'schedule' } },
    { params: { path: 'bus' } },
    { params: { path: 'bus/search' } },
    { params: { path: 'bus/map' } },
    { params: { path: 'bus/plan' } },
  ];
}
